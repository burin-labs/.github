import { parse, parser } from "std/cli/argparse"
import { command_run } from "std/command"
import {
  OBSERVER_REPOSITORIES,
  observation_succeeded,
  observation_summary,
} from "./observer-contract.harn"
import { ObserverAdapters, ObserverLocations, observe_repository } from "./observer-runner.harn"

pub fn observer_command_options(token: string?, args: list<string>) -> dict {
  require len(args) >= 2, "observer command is incomplete"
  require (args[0] == "gh" && args[1] == "api")
    || (args[0] == "harn" && args[1] == "run"),
    "observer command is outside the read-only adapter"
  // Credential-shaped variables are deliberately absent from child environments.
  // Pass only this workflow's read-only token to its API reader and measurement engine.
  return {
    timeout_ms: 600000,
    env_mode: "patch",
    env: token == nil || token == "" ? {} : {GH_TOKEN: token},
  }
}

fn receipt_details(receipt: dict) -> string {
  if receipt.error != nil {
    return to_string(receipt.error)
  }
  let evidence: list<string> = []
  for breach in receipt.breaches ?? [] {
    evidence = evidence
      + [
        to_string(breach.metric) + "=" + to_string(breach.observed_ms)
          + "ms >= "
          + to_string(breach.threshold_ms)
          + "ms (n="
          + to_string(breach.sample_count)
          + ")",
      ]
  }
  for debt in receipt.target_debt ?? [] {
    evidence = evidence
      + [
        to_string(debt.metric) + "=" + to_string(debt.observed_ms)
          + "ms, target "
          + to_string(debt.target_ms)
          + "ms, gap +"
          + to_string(debt.gap_ms)
          + "ms",
      ]
  }
  return evidence.join("; ")
}

fn summary_markdown(receipts: list<dict>) -> string {
  let lines = [
    "## CI latency",
    "",
    "| Repository | Status | Samples | Details |",
    "| --- | --- | ---: | --- |",
  ]
  for receipt in receipts {
    const details = receipt_details(receipt).replace("|", "\\|").replace("\n", " ")
    lines = lines
      + [
        "| " + to_string(receipt.repository) + " | "
          + to_string(receipt.status)
          + " | "
          + to_string(receipt.sample_count)
          + " | "
          + details
          + " |",
      ]
  }
  return lines.join("\n") + "\n"
}

fn main(harness: Harness) -> int {
  const spec = parser(
    {
      name: "ci-latency-observer",
      args: [
        {name: "reports", kind: "flag", long: "--reports", required: true},
        {name: "policies", kind: "flag", long: "--policies", required: true},
        {name: "harn_script", kind: "flag", long: "--harn-script", required: true},
        {name: "summary_path", kind: "flag", long: "--summary-path", required: false},
      ],
    },
  )
  const options = unwrap(parse(spec, argv)).options
  const locations: ObserverLocations = {
    reports: to_string(options.reports),
    policies: to_string(options.policies),
    harn_script: to_string(options.harn_script),
  }
  harness.fs.mkdir(locations.reports, true)
  harness.fs.mkdir(locations.policies, true)
  const token = harness.env.get("GH_TOKEN")
  const adapters: ObserverAdapters = {
    run: fn(args) {
      const result = command_run(harness.tools, args, observer_command_options(token, args))
      require result != nil, "observer command did not return a measured result"
      return {stdout: result.stdout, stderr: result.stderr, success: result.success}
    },
    sleep_ms: fn(ms) { harness.clock.sleep_ms(ms) },
    now: fn() { return harness.clock.date_iso() },
  }
  const settled = parallel settle OBSERVER_REPOSITORIES with { max_concurrent: 4 } { name ->
    observe_repository(harness.fs, adapters, name, locations)
  }
  require len(settled.results) == len(OBSERVER_REPOSITORIES), "observer census is incomplete"
  const receipts = settled.results.map(fn(result) { return unwrap(result) }).to_list()
  const summary = observation_summary(receipts)
  harness.fs.write_text(
    path_join(locations.reports, "org-summary.json"),
    json_stringify(summary) + "\n",
  )
  const rendered = summary_markdown(receipts)
  harness.stdio.println(rendered)
  if options.summary_path != nil && to_string(options.summary_path) != "" {
    const summary_path = to_string(options.summary_path)
    const previous = harness.fs.exists(summary_path) ? harness.fs.read_text(summary_path) : ""
    harness.fs.write_text(summary_path, previous + rendered)
  }
  harness.stdio.println(json_stringify(summary))
  return observation_succeeded(receipts) ? 0 : 1
}
