/**
 * Decide whether a queue-skipping override label may act. `force-merge` and
 * `bypass-merge-queue` land a pull request without the merge queue, so each
 * needs a justifying incident and must not land a head the queue already
 * rejected. `force-merge` also lands a head whose own checks are red, so it
 * must not add a red: every check that failed on the head must be red on the
 * default branch's newest verdict for that same job. Every session posts as
 * the same account, so the rule lives here rather than in prose.
 *
 * `measure` reads GitHub through a `Reader`; `decide` is pure.
 */
pub const GUARDED_LABELS = ["force-merge", "bypass-merge-queue"]

pub const RELEASE_BLOCKER = "release-blocker"

pub const FOUNDER_OVERRIDE = "founder-override"

/** How many default-branch commits to walk back past commits with no completed CI run. */
pub const MAIN_WALK_LIMIT = 10

const RED = ["failure", "timed_out"]

// GitHub counts these conclusions as satisfying a required check.
const PASSING = ["success", "neutral", "skipped"]

const PAGE_LIMIT = 10

const SHA = "^[0-9a-f]{40}$"

/** Everything the guard asks of GitHub: one REST GET, parsed. Throws on failure. */
pub type Reader = {api: fn(string) -> unknown}

pub type Request = {
  repository: string,
  pr: int,
  head_sha: string,
  label: string,
  main_ci_workflow: string,
  /** Workflow file of the calling override dispatcher, whose own attempts are not CI evidence. */
  override_workflow: string,
}

pub type MainState = {red: bool, detail: string}

pub type QueueState = {rejected: bool, run_ids: list<int>, detail: string}

pub type ChecksState = {green: bool, detail: string}

/** One check failing on the head, set against the same job on the default branch. */
pub type CheckComparison = {check: string, head: string, main: string, inherited: bool}

/**
 * `force-merge` evidence: every non-passing completed check on the head, and
 * the checks still running there, which no comparison can judge yet.
 */
pub type InheritanceState = {rows: list<CheckComparison>, pending: list<string>}

pub type Evidence = {
  label: string,
  head_sha: string,
  release_blocker: bool,
  founder_override: bool,
  founder_actor: string,
  main: MainState?,
  queue: QueueState?,
  checks: ChecksState?,
  inheritance: InheritanceState?,
}

/** `verdict` is `allowed` or `refused`. */
pub type Decision = {
  verdict: string,
  founder_override: bool,
  founder_actor: string,
  reason: string,
  retry: string,
  evidence: list<string>,
  comparison: string,
}

fn short(sha: string) -> string {
  return sha[0:12]
}

fn get_dict(reader: Reader, path: string) -> dict {
  const value = reader.api(path)
  if type_of(value) != "dict" {
    throw "GET " + path + " did not return an object"
  }
  return value
}

fn get_list(reader: Reader, path: string) -> list {
  const value = reader.api(path)
  if type_of(value) != "list" {
    throw "GET " + path + " did not return an array"
  }
  return value
}

/**
 * Read every item of a paginated endpoint whose pages carry `total_count`.
 * A census that cannot reach its own reported total throws instead of
 * returning a short list that would read as "nothing found".
 */
fn counted_pages(reader: Reader, path: string, field: string) -> list {
  let items = []
  let page = 1
  while page <= PAGE_LIMIT {
    const separator = path.contains("?") ? "&" : "?"
    const body = get_dict(reader, path + separator + "per_page=100&page=" + to_string(page))
    const batch = body[field]
    const total = body.total_count
    if type_of(batch) != "list" || type_of(total) != "int" {
      throw "GET " + path + " page " + to_string(page) + " omitted " + field + " or total_count"
    }
    items = items + batch
    if len(items) >= total || len(batch) == 0 {
      if len(items) < total {
        throw "GET " + path + " measured " + to_string(len(items)) + " of " + to_string(total)
          + " reported items"
      }
      return items
    }
    page = page + 1
  }
  throw "GET " + path + " has more than " + to_string(PAGE_LIMIT * 100) + " items"
}

fn latest_by(items: list, field: string) -> dict? {
  let best = nil
  for item in items {
    if best == nil || (item[field] ?? "") > (best[field] ?? "") {
      best = item
    }
  }
  return best
}

fn founder_actor(reader: Reader, request: Request) -> string {
  let latest = nil
  let page = 1
  while page <= PAGE_LIMIT {
    const events = get_list(
      reader,
      "repos/" + request.repository + "/issues/" + to_string(request.pr)
        + "/events?per_page=100&page="
        + to_string(page),
    )
    for event in events {
      if event?.event == "labeled" && event?.label?.name == FOUNDER_OVERRIDE {
        if latest == nil || (event.created_at ?? "") >= (latest.created_at ?? "") {
          latest = event
        }
      }
    }
    if len(events) < 100 {
      break
    }
    page = page + 1
  }
  return latest?.actor?.login ?? "unknown"
}

/**
 * Is the default branch red? The newest default-branch commit with a
 * completed push run of the main CI workflow decides. Commits whose run is
 * still going, or that path filters skipped, are walked past so a docs-only
 * or freshly merged commit does not hide a red parent.
 */
fn main_state(reader: Reader, request: Request, default_branch: string) -> MainState {
  const repo = "repos/" + request.repository
  const commits = get_list(
    reader,
    repo + "/commits?sha=" + default_branch + "&per_page=" + to_string(MAIN_WALK_LIMIT),
  )
  if len(commits) == 0 {
    throw default_branch + " has no commits"
  }
  const tip = commits[0].sha
  for commit in commits {
    const sha = commit.sha
    if regex_match(SHA, sha ?? "") == nil {
      throw default_branch + " history returned a commit without a SHA"
    }
    const run = completed_main_run(reader, request, default_branch, sha)
    if run == nil {
      continue
    }
    const where = sha == tip ? default_branch + " tip " + short(sha) : default_branch + " commit "
      + short(sha)
      + " (newest with a completed run; tip is "
      + short(tip)
      + ")"
    return {
      red: RED.contains(run.conclusion),
      detail: request.main_ci_workflow + " push run " + to_string(run.id) + " on " + where
        + " concluded "
        + to_string(run.conclusion),
    }
  }
  return {
    red: false,
    detail: "no completed " + request.main_ci_workflow + " push run on the last "
      + to_string(len(commits))
      + " commits of "
      + default_branch,
  }
}

/**
 * Has the merge queue already rejected this head? Queue refs are
 * `gh-readonly-queue/<base>/pr-<N>-<group base SHA>`: the SHA names the
 * commit the group was built on, not the pull request head. So a failed
 * merge-group run for this pull request counts against the current head when
 * it started after GitHub first saw that head. A push removes a pull request
 * from the queue, so every later group for it tested this head.
 */
fn queue_state(reader: Reader, request: Request, base: string) -> QueueState {
  const repo = "repos/" + request.repository
  const suites = counted_pages(
    reader,
    repo + "/commits/" + request.head_sha + "/check-suites",
    "check_suites",
  )
  let seen = ""
  for suite in suites {
    if seen == "" || suite.created_at < seen {
      seen = suite.created_at
    }
  }
  if seen == "" {
    // No suite was ever created for this head. Its committer date is no later
    // than the push, so this widens the window rather than narrowing it.
    seen = get_dict(reader, repo + "/commits/" + request.head_sha)?.commit?.committer?.date ?? ""
  }
  if type_of(seen) != "string" || seen == "" {
    throw "could not date head " + request.head_sha
  }
  const since: string = seen
  const prefix = "gh-readonly-queue/" + base + "/pr-" + to_string(request.pr) + "-"
  let rejected = []
  for conclusion in RED {
    const runs = counted_pages(
      reader,
      repo + "/actions/runs?event=merge_group&status=" + conclusion + "&created=%3E%3D" + since,
      "workflow_runs",
    )
    for run in runs {
      if (run?.head_branch ?? "").starts_with(prefix) && run.created_at >= since
        && run.conclusion == conclusion {
        rejected = rejected + [run]
      }
    }
  }
  if len(rejected) == 0 {
    return {
      rejected: false,
      run_ids: [],
      detail: "no merge-group run for #" + to_string(request.pr) + " failed since head "
        + short(request.head_sha)
        + " appeared at "
        + since,
    }
  }
  const ids = rejected.map({ run -> run.id }).sorted()
  return {
    rejected: true,
    run_ids: ids,
    detail: "the merge queue already rejected head " + short(request.head_sha)
      + ": merge-group run"
      + (len(ids) == 1 ? " " : "s ")
      + join(ids.map({ id -> to_string(id) }), ", ")
      + " concluded "
      + join(rejected.map({ run -> run.conclusion }).to_list().sorted(), ", "),
  }
}

/** Are all checks the base branch's rulesets require green on the head? */
fn checks_state(reader: Reader, request: Request, base: string) -> ChecksState {
  const repo = "repos/" + request.repository
  let required = []
  for rule in get_list(reader, repo + "/rules/branches/" + base) {
    if rule?.type == "required_status_checks" {
      for check in rule?.parameters?.required_status_checks ?? [] {
        if !required.contains(check.context) {
          required = required + [check.context]
        }
      }
    }
  }
  if len(required) == 0 {
    return {green: true, detail: base + " requires no status checks"}
  }
  const runs = counted_pages(
    reader,
    repo + "/commits/" + request.head_sha + "/check-runs?filter=latest",
    "check_runs",
  )
  // Only check runs are read: the calling workflows grant no `statuses`
  // permission, so a required context reported as a legacy commit status
  // reads as missing and refuses rather than passing unseen.
  let problems = []
  for context in required.sorted() {
    const run = latest_by(runs.filter({ run -> run?.name == context }).to_list(), "started_at")
    if run == nil {
      problems = problems + [context + " has not reported"]
    } else if run.status != "completed" {
      problems = problems + [context + " is " + to_string(run.status)]
    } else if !PASSING.contains(run.conclusion) {
      problems = problems + [context + " concluded " + to_string(run.conclusion)]
    }
  }
  if len(problems) == 0 {
    return {
      green: true,
      detail: "required checks green on " + short(request.head_sha) + ": "
        + join(required.sorted(), ", "),
    }
  }
  return {
    green: false,
    detail: "required checks not green on " + short(request.head_sha) + ": "
      + join(problems, "; "),
  }
}

/** Answer a repeated GET from memory, so walks that revisit a page read it once. */
fn memoized(reader: Reader) -> Reader {
  let seen = {}
  return {
    api: fn(path) {
      if !contains(keys(seen), path) {
        seen = seen + {[path]: reader.api(path)}
      }
      return seen[path]
    },
  }
}

/** The newest completed push run of the main CI workflow on one default-branch commit. */
fn completed_main_run(
  reader: Reader,
  request: Request,
  default_branch: string,
  sha: string,
) -> dict? {
  const runs = counted_pages(
    reader,
    "repos/" + request.repository + "/actions/workflows/" + request.main_ci_workflow
      + "/runs?head_sha="
      + sha
      + "&event=push&branch="
      + default_branch,
    "workflow_runs",
  )
  // An empty head_sha filter returns every run; never trust a census that
  // contains another commit.
  if runs.any({ run -> run?.head_sha != sha }) {
    throw request.main_ci_workflow + " runs for " + sha + " included another commit"
  }
  return latest_by(runs.filter({ run -> run.status == "completed" }).to_list(), "created_at")
}

/**
 * The newest completed merge-group run of the main CI workflow whose group
 * head is this default-branch commit: the queue run that tested exactly the
 * tree the default branch now holds. Jobs the push run skips run here.
 */
fn merged_group_run(
  reader: Reader,
  request: Request,
  default_branch: string,
  sha: string,
) -> dict? {
  const runs = counted_pages(
    reader,
    "repos/" + request.repository + "/actions/workflows/" + request.main_ci_workflow
      + "/runs?head_sha="
      + sha
      + "&event=merge_group",
    "workflow_runs",
  )
  if runs.any({ run -> run?.head_sha != sha }) {
    throw request.main_ci_workflow + " merge-group runs for " + sha + " included another commit"
  }
  const prefix = "gh-readonly-queue/" + default_branch + "/"
  return latest_by(
    runs.filter(
      { run -> run.status == "completed" && (run?.head_branch ?? "").starts_with(prefix) },
    )
      .to_list(),
    "created_at",
  )
}

fn completed_job(reader: Reader, request: Request, run: dict, check: string) -> dict? {
  const jobs = counted_pages(
    reader,
    "repos/" + request.repository + "/actions/runs/" + to_string(run.id) + "/jobs?filter=latest",
    "jobs",
  )
  return latest_by(
    jobs.filter(
      { job -> job?.name == check && job?.status == "completed" && job?.conclusion != "skipped" },
    )
      .to_list(),
    "started_at",
  )
}

/**
 * Where did `check` last run to a verdict on the default branch? Walks back
 * from the tip. On each commit the push run answers first; a job the push run
 * skipped or omitted is read from the merge-group run that produced that
 * commit, since jobs that run only in the merge queue never run on push.
 * Nothing found reads as "never shown red", not as green.
 */
fn main_job_state(reader: Reader, request: Request, default_branch: string, check: string) -> dict {
  const repo = "repos/" + request.repository
  const commits = get_list(
    reader,
    repo + "/commits?sha=" + default_branch + "&per_page=" + to_string(MAIN_WALK_LIMIT),
  )
  for commit in commits {
    // The merge-group run is read only when the push run did not run the job.
    for source in ["push", "merge_group"] {
      const run = source == "push" ? completed_main_run(
        reader,
        request,
        default_branch,
        commit.sha,
      ) : merged_group_run(reader, request, default_branch, commit.sha)
      if run == nil {
        continue
      }
      const candidate = {source: source, run: run}
      const job = completed_job(reader, request, candidate.run, check)
      if job != nil {
        return {
          red: RED.contains(job.conclusion),
          detail: to_string(job.conclusion) + " in " + candidate.source + " run "
            + to_string(candidate.run.id)
            + " on "
            + short(commit.sha),
        }
      }
    }
  }
  return {
    red: false,
    detail: "no push or merge-group run on the last " + to_string(len(commits)) + " commits of "
      + default_branch
      + " ran it",
  }
}

/**
 * For `force-merge`: compare every check that did not pass on the head with
 * the same job on the default branch. A check counts as inherited only when
 * main's newest verdict for that job is itself red. A check from another
 * workflow or app has no default-branch run to compare, so it never counts.
 */
fn inheritance_state(reader: Reader, request: Request, default_branch: string) -> InheritanceState {
  const repo = "repos/" + request.repository
  const runs = counted_pages(
    reader,
    repo + "/actions/runs?head_sha=" + request.head_sha,
    "workflow_runs",
  )
  if runs.any({ run -> run?.head_sha != request.head_sha }) {
    throw "workflow runs for " + request.head_sha + " included another commit"
  }
  let workflow_by_suite = {}
  for run in runs {
    workflow_by_suite = workflow_by_suite + {[to_string(run.check_suite_id)]: run.path ?? ""}
  }
  const checks = counted_pages(
    reader,
    repo + "/commits/" + request.head_sha + "/check-runs?filter=latest",
    "check_runs",
  )
  const ci_path = ".github/workflows/" + request.main_ci_workflow
  let names = []
  for check in checks {
    if !names.contains(check.name) {
      names = names + [check.name]
    }
  }
  let rows = []
  let pending = []
  for name in names.sorted() {
    const check = latest_by(checks.filter({ run -> run?.name == name }).to_list(), "started_at")
    const workflow = workflow_by_suite[to_string(check?.check_suite?.id)] ?? ""
    if workflow != "" && workflow == request.override_workflow {
      continue
    }
    if check.status != "completed" {
      pending = pending + [name]
      continue
    }
    if PASSING.contains(check.conclusion) {
      continue
    }
    if workflow != ci_path {
      rows = rows
        + [
          {
            check: name,
            head: to_string(check.conclusion),
            main: "not a " + request.main_ci_workflow + " job ("
              + (workflow == "" ? "no workflow" : workflow)
              + "), so main cannot show it red",
            inherited: false,
          },
        ]
      continue
    }
    const main = main_job_state(reader, request, default_branch, name)
    rows = rows
      + [{check: name, head: to_string(check.conclusion), main: main.detail, inherited: main.red}]
  }
  return {rows: rows, pending: pending}
}

fn comparison_markdown(head_sha: string, state: InheritanceState) -> string {
  let lines = [
    "#### Failing head checks against " + "the default branch (" + short(head_sha) + ")",
    "",
  ]
  if len(state.rows) == 0 {
    lines = lines + ["No completed check failed on the head."]
  } else {
    lines = lines + ["| Check | Head | Default branch | Verdict |", "| --- | --- | --- | --- |"]
    for row in state.rows {
      lines = lines
        + [
          "| " + row.check + " | " + row.head + " | " + row.main + " | "
            + (row.inherited ? "inherited red" : "new red")
            + " |",
        ]
    }
  }
  if len(state.pending) > 0 {
    lines = lines
      + ["", "Still running on the head, not compared: " + join(state.pending, ", ") + "."]
  }
  return join(lines, "\n")
}

/** Measure what the guard needs. Throws when GitHub cannot be read completely. */
pub fn measure(source: Reader, request: Request) -> Evidence {
  const reader = memoized(source)
  if !GUARDED_LABELS.contains(request.label) {
    throw request.label + " is not a queue-skipping label"
  }
  if regex_match(SHA, request.head_sha) == nil {
    throw "head SHA must be 40 lowercase hex characters, got " + request.head_sha
  }
  const repo = "repos/" + request.repository
  const labels = (get_dict(reader, repo + "/issues/" + to_string(request.pr))?.labels ?? []).map(
    { label -> label?.name },
  )
  const evidence = {
    label: request.label,
    head_sha: request.head_sha,
    release_blocker: labels.contains(RELEASE_BLOCKER),
    founder_override: labels.contains(FOUNDER_OVERRIDE),
    founder_actor: "",
    main: nil,
    queue: nil,
    checks: nil,
    inheritance: nil,
  }
  if evidence.founder_override {
    // The escape hatch skips every other read: an emergency must not depend
    // on the health of the endpoints the guard would otherwise consult.
    return evidence + {founder_actor: founder_actor(reader, request)}
  }
  const default_branch = get_dict(reader, repo)?.default_branch
  const base = get_dict(reader, repo + "/pulls/" + to_string(request.pr))?.base?.ref
  if type_of(default_branch) != "string" || type_of(base) != "string" {
    throw "could not read the default branch or the pull request base"
  }
  return evidence
    + {
      main: main_state(reader, request, default_branch),
      queue: queue_state(reader, request, base),
      checks: request.label == "bypass-merge-queue" ? checks_state(reader, request, base) : nil,
      inheritance: request.label == "force-merge" ? inheritance_state(
        reader,
        request,
        default_branch,
      ) : nil,
    }
}

/** Apply the policy to measured evidence. */
pub fn decide(evidence: Evidence) -> Decision {
  if evidence.founder_override {
    return {
      verdict: "allowed",
      founder_override: true,
      founder_actor: evidence.founder_actor,
      reason: "`" + FOUNDER_OVERRIDE + "` applied by @" + evidence.founder_actor
        + " skipped the queue-bypass guard",
      retry: "",
      evidence: ["guard skipped by `" + FOUNDER_OVERRIDE + "`"],
      comparison: "",
    }
  }
  const main = evidence.main
  const queue = evidence.queue
  if main == nil || queue == nil {
    throw "evidence is incomplete: main and queue state are required"
  }
  if evidence.label == "bypass-merge-queue" && evidence.checks == nil {
    throw "evidence is incomplete: bypass-merge-queue needs required-check state"
  }
  if evidence.label == "force-merge" && evidence.inheritance == nil {
    throw "evidence is incomplete: force-merge needs the head-against-main check comparison"
  }
  let lines = [
    "default branch: " + main.detail,
    "`" + RELEASE_BLOCKER + "` label: " + (evidence.release_blocker ? "present" : "absent"),
    "merge queue: " + queue.detail,
  ]
  if evidence.checks != nil {
    lines = lines + ["required checks: " + evidence.checks.detail]
  }
  let refusals = []
  let retries = []
  if queue.rejected {
    refusals = refusals + [queue.detail]
    retries = retries
      + ["fix what the queue caught and push; a new head clears the queue's verdict"]
  }
  if !main.red && !evidence.release_blocker {
    refusals = refusals
      + [
        "no incident justifies skipping the queue: the default branch is not red ("
          + main.detail
          + ") and the pull request has no `"
          + RELEASE_BLOCKER
          + "` label",
      ]
    retries = retries
      + [
        "land through the merge queue, or add `" + RELEASE_BLOCKER
          + "` only if this pull request unblocks a release",
      ]
  }
  if evidence.checks != nil && !evidence.checks.green {
    refusals = refusals + [evidence.checks.detail]
    retries = retries + ["wait for every required check to pass"]
  }
  let comparison = ""
  if evidence.inheritance != nil {
    const inheritance = evidence.inheritance
    comparison = comparison_markdown(evidence.head_sha, inheritance)
    const fresh = inheritance.rows.filter({ row -> !row.inherited }).to_list()
    lines = lines
      + [
        "head checks against the default branch: " + to_string(len(inheritance.rows))
          + " failing, "
          + to_string(len(fresh))
          + " not red on the default branch, "
          + to_string(len(inheritance.pending))
          + " still running",
      ]
    if len(fresh) > 0 {
      refusals = refusals
        + [
          "the head is red where the default branch is not: "
            + join(
              fresh.map({ row -> row.check + " (head " + row.head + "; " + row.main + ")" }),
              "; ",
            ),
        ]
      retries = retries
        + [
          "fix those checks on the head, or land through the merge queue; `force-merge` only skips reds the default branch already has",
        ]
    }
  }
  if len(refusals) > 0 {
    return {
      verdict: "refused",
      founder_override: false,
      founder_actor: "",
      reason: "`" + evidence.label + "` refused: " + join(refusals, "; ") + ".",
      retry: join(retries, "; ") + ", then re-apply `" + evidence.label + "`.",
      evidence: lines,
      comparison: comparison,
    }
  }
  const because = main.red ? "the default branch is red (" + main.detail
    + ")" : "the pull request carries `" + RELEASE_BLOCKER + "`"
  return {
    verdict: "allowed",
    founder_override: false,
    founder_actor: "",
    reason: "`" + evidence.label + "` allowed: " + because + ".",
    retry: "",
    evidence: lines,
    comparison: comparison,
  }
}
