import { assert_error_contains } from "std/testing"
import { Request, decide, measure } from "./guard.harn"

const REPO = "repos/burin-labs/example"

const HEAD = "1111111111111111111111111111111111111111"

const NEWER_HEAD = "2222222222222222222222222222222222222222"

const TIP = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

const PARENT = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

const GROUP_BASE = "cccccccccccccccccccccccccccccccccccccccc"

const HEAD_SEEN = "2026-10-02T08:39:04Z"

const CI_WORKFLOW = ".github/workflows/ci.yml"

const OVERRIDE_WORKFLOW = ".github/workflows/merge-override-dispatch.yml"

fn request(label: string = "force-merge", head: string = HEAD) -> Request {
  return {
    repository: "burin-labs/example",
    pr: 42,
    head_sha: head,
    label: label,
    main_ci_workflow: "ci.yml",
    override_workflow: OVERRIDE_WORKFLOW,
  }
}

fn label(name: string) -> dict {
  return {name: name}
}

fn page(field: string, items: list) -> dict {
  return {total_count: len(items), [field]: items}
}

fn main_runs(sha: string, runs: list) -> dict {
  return {
    [REPO + "/actions/workflows/ci.yml/runs?head_sha=" + sha
      + "&event=push&branch=main&per_page=100&page=1"]: page(
      "workflow_runs",
      runs.map({ run -> run + {head_sha: sha} }),
    ),
  }
}

fn queue_runs(conclusion: string, runs: list, since: string = HEAD_SEEN) -> dict {
  return {
    [REPO + "/actions/runs?event=merge_group&status=" + conclusion + "&created=%3E%3D" + since
      + "&per_page=100&page=1"]: page(
      "workflow_runs",
      runs,
    ),
  }
}

fn head_seen(head: string, created: string) -> dict {
  return {
    [REPO + "/commits/" + head + "/check-suites?per_page=100&page=1"]: page(
      "check_suites",
      [{created_at: created}, {created_at: "2026-10-02T23:00:00Z"}],
    ),
  }
}

/**
 * A repository whose default branch tip has a completed CI push run with
 * `main_conclusion`, and whose merge queue has failed no groups for PR 42.
 */
fn world(labels: list<string>, main_conclusion: string, head: string = HEAD) -> dict {
  return {
    [REPO]: {default_branch: "main"},
    [REPO + "/issues/42"]: {labels: labels.map({ name -> label(name) })},
    [REPO + "/pulls/42"]: {base: {ref: "main"}},
    [REPO + "/commits?sha=main&per_page=10"]: [{sha: TIP}, {sha: PARENT}],
  }
    + main_runs(
      TIP,
      [
        {
          id: 900,
          status: "completed",
          conclusion: main_conclusion,
          created_at: "2026-10-02T10:00:00Z",
        },
      ],
    )
    + head_seen(head, HEAD_SEEN)
    + queue_runs("failure", [])
    + queue_runs("timed_out", [])
    + head_checks(head, [])
}

/**
 * The head's check runs, each a `[name, conclusion, workflow path]` triple;
 * a nil conclusion is a check still running. Each check gets its own suite,
 * tied to a workflow run on the head with that path.
 */
fn head_checks(head: string, checks: list) -> dict {
  let runs = []
  let check_runs = []
  let suite = 500
  for check in checks {
    suite = suite + 1
    runs = runs + [{id: suite + 1000, head_sha: head, check_suite_id: suite, path: check[2]}]
    check_runs = check_runs
      + [
        {
          name: check[0],
          status: check[1] == nil ? "in_progress" : "completed",
          conclusion: check[1],
          started_at: "2026-10-02T09:10:00Z",
          check_suite: {id: suite},
        },
      ]
  }
  return {
    [REPO + "/actions/runs?head_sha=" + head + "&per_page=100&page=1"]: page("workflow_runs", runs),
    [REPO + "/commits/" + head + "/check-runs?filter=latest&per_page=100&page=1"]: page(
      "check_runs",
      check_runs,
    ),
  }
}

/** Merge-group runs of the main CI workflow whose group head is `sha`. */
fn group_runs(sha: string, runs: list) -> dict {
  return {
    [REPO + "/actions/workflows/ci.yml/runs?head_sha=" + sha
      + "&event=merge_group&per_page=100&page=1"]: page(
      "workflow_runs",
      runs.map({ run -> run + {head_sha: sha} }),
    ),
  }
}

/** The jobs of one default-branch CI run, each a `[name, conclusion]` pair. */
fn main_jobs(run_id: int, jobs: list) -> dict {
  return {
    [REPO + "/actions/runs/" + to_string(run_id) + "/jobs?filter=latest&per_page=100&page=1"]: page(
      "jobs",
      jobs.map(
        { job ->
          {
            name: job[0],
            status: "completed",
            conclusion: job[1],
            started_at: "2026-10-02T10:01:00Z",
          }
        },
      ),
    ),
  }
}

fn queue_failure(head_branch: string, created_at: string) -> dict {
  return {id: 777, head_branch: head_branch, conclusion: "failure", created_at: created_at}
}

fn required_checks(head: string, ci_conclusion: string) -> dict {
  return {
    [REPO + "/rules/branches/main"]: [
      {type: "pull_request"},
      {
        type: "required_status_checks",
        parameters: {required_status_checks: [{context: "CI status"}, {context: "drift"}]},
      },
    ],
    [REPO + "/commits/" + head + "/check-runs?filter=latest&per_page=100&page=1"]: page(
      "check_runs",
      [
        {
          name: "CI status",
          status: "completed",
          conclusion: ci_conclusion,
          started_at: "2026-10-02T09:10:00Z",
        },
        {
          name: "drift",
          status: "completed",
          conclusion: "skipped",
          started_at: "2026-10-02T09:10:00Z",
        },
      ],
    ),
  }
}

/** A reader that answers only the paths it was given and records every read. */
fn reader(responses: dict) -> dict {
  let reads = []
  return {
    reader: {
      api: fn(path) {
        reads = reads + [path]
        if !contains(keys(responses), path) {
          throw "unexpected GET " + path
        }
        return responses[path]
      },
    },
    reads: fn() { return reads },
  }
}

fn verdict(responses: dict, req: Request = request()) -> dict {
  return decide(measure(reader(responses).reader, req))
}

pipeline test_a_red_default_branch_allows_a_bypass() {
  const decision = verdict(world([], "failure"))
  assert_eq(decision.verdict, "allowed")
  assert(decision.reason.contains("default branch is red"), decision.reason)
  assert(decision.reason.contains("run 900"), decision.reason)
  assert_eq(decision.founder_override, false)
}

pipeline test_a_green_default_branch_without_release_blocker_refuses() {
  const decision = verdict(world([], "success"))
  assert_eq(decision.verdict, "refused")
  assert(decision.reason.contains("no incident justifies skipping the queue"), decision.reason)
  assert(decision.reason.contains("concluded success"), decision.reason)
  assert(decision.retry.contains("land through the merge queue"), decision.retry)
  assert(decision.retry.ends_with("re-apply `force-merge`."), decision.retry)
}

pipeline test_release_blocker_allows_a_bypass_while_main_is_green() {
  const decision = verdict(world(["release-blocker"], "success"))
  assert_eq(decision.verdict, "allowed")
  assert(decision.reason.contains("`release-blocker`"), decision.reason)
}

pipeline test_a_head_the_queue_rejected_is_refused_even_while_main_is_red() {
  const responses = world(["release-blocker"], "failure")
    + queue_runs(
      "failure",
      [
        queue_failure("gh-readonly-queue/main/pr-42-" + GROUP_BASE, "2026-10-02T09:45:06Z"),
        // Another pull request's group and a lookalike number do not count.
        queue_failure("gh-readonly-queue/main/pr-43-" + GROUP_BASE, "2026-10-02T09:46:00Z"),
        queue_failure("gh-readonly-queue/main/pr-421-" + GROUP_BASE, "2026-10-02T09:46:00Z"),
      ],
    )
  const decision = verdict(responses)
  assert_eq(decision.verdict, "refused")
  assert(
    decision.reason.contains("the merge queue already rejected head 111111111111"),
    decision.reason,
  )
  assert(decision.reason.contains("run 777"), decision.reason)
  assert(!decision.reason.contains("no incident"), decision.reason)
  assert(decision.retry.contains("a new head clears"), decision.retry)
}

pipeline test_a_timed_out_queue_group_also_rejects_the_head() {
  const responses = world([], "failure")
    + queue_runs(
      "timed_out",
      [
        {
          id: 778,
          head_branch: "gh-readonly-queue/main/pr-42-" + GROUP_BASE,
          conclusion: "timed_out",
          created_at: "2026-10-02T09:45:06Z",
        },
      ],
    )
  assert_eq(verdict(responses).verdict, "refused")
}

pipeline test_a_newer_head_clears_an_older_queue_rejection() {
  const newer_seen = "2026-10-02T11:00:00Z"
  // The group failed at 09:45, before GitHub first saw the newer head at 11:00.
  const responses = world([], "failure", NEWER_HEAD)
    + head_seen(NEWER_HEAD, newer_seen)
    + queue_runs("failure", [], newer_seen)
    + queue_runs("timed_out", [], newer_seen)
    + queue_runs(
      "failure",
      [queue_failure("gh-readonly-queue/main/pr-42-" + GROUP_BASE, "2026-10-02T09:45:06Z")],
      newer_seen,
    )
  // The `created` filter already narrows to the window; the guard still checks
  // each run's own timestamp rather than trusting the filter.
  const decision = verdict(responses, request("force-merge", NEWER_HEAD))
  assert_eq(decision.verdict, "allowed")
  assert(decision.evidence.any({ line -> line.contains("no merge-group run for #42 failed") }))
}

pipeline test_founder_override_skips_the_guard_and_names_who_applied_it() {
  const responses = {
    [REPO + "/issues/42"]: {labels: [label("force-merge"), label("founder-override")]},
    [REPO + "/issues/42/events?per_page=100&page=1"]: [
      {
        event: "labeled",
        label: {name: "force-merge"},
        actor: {login: "agent"},
        created_at: "2026-10-02T10:00:01Z",
      },
      {
        event: "labeled",
        label: {name: "founder-override"},
        actor: {login: "kennethsinder"},
        created_at: "2026-10-02T10:00:00Z",
      },
    ],
  }
  const world = reader(responses)
  const decision = decide(measure(world.reader, request()))
  assert_eq(decision.verdict, "allowed")
  assert_eq(decision.founder_override, true)
  assert_eq(decision.founder_actor, "kennethsinder")
  assert(decision.reason.contains("skipped the queue-bypass guard"), decision.reason)
  // An emergency must not depend on the endpoints the guard would consult.
  assert_eq(world.reads(), [REPO + "/issues/42", REPO + "/issues/42/events?per_page=100&page=1"])
}

pipeline test_bypass_merge_queue_requires_every_required_check_green() {
  const red = verdict(
    world([], "failure") + required_checks(HEAD, "failure"),
    request("bypass-merge-queue"),
  )
  assert_eq(red.verdict, "refused")
  assert(red.reason.contains("CI status concluded failure"), red.reason)
  const green = verdict(
    world([], "failure") + required_checks(HEAD, "success"),
    request("bypass-merge-queue"),
  )
  assert_eq(green.verdict, "allowed")
  assert(green.evidence.any({ line -> line.contains("CI status, drift") }))
}

pipeline test_a_required_check_that_never_reported_refuses() {
  const responses = world([], "failure") + required_checks(HEAD, "success")
    + {
      [REPO + "/commits/" + HEAD + "/check-runs?filter=latest&per_page=100&page=1"]: page(
        "check_runs",
        [],
      ),
    }
  const decision = verdict(responses, request("bypass-merge-queue"))
  assert_eq(decision.verdict, "refused")
  assert(decision.reason.contains("CI status has not reported"), decision.reason)
}

pipeline test_a_tip_without_a_completed_run_defers_to_the_newest_completed_commit() {
  const responses = world([], "success")
    + main_runs(
      TIP,
      [{id: 901, status: "in_progress", conclusion: nil, created_at: "2026-10-02T11:00:00Z"}],
    )
    + main_runs(
      PARENT,
      [{id: 899, status: "completed", conclusion: "failure", created_at: "2026-10-02T10:00:00Z"}],
    )
  const decision = verdict(responses)
  assert_eq(decision.verdict, "allowed")
  assert(decision.reason.contains("newest with a completed run"), decision.reason)
}

pipeline test_a_run_census_naming_another_commit_fails_closed() {
  // An empty head_sha filter returns every run in the repository.
  const responses = world([], "failure")
    + {
      [REPO + "/actions/workflows/ci.yml/runs?head_sha=" + TIP
        + "&event=push&branch=main&per_page=100&page=1"]: page(
        "workflow_runs",
        [{id: 1, head_sha: PARENT, status: "completed", conclusion: "failure"}],
      ),
    }
  assert_error_contains(fn() { verdict(responses) }, "included another commit")
}

pipeline test_a_short_census_fails_closed() {
  const responses = world([], "failure")
    + {
      [REPO + "/actions/runs?event=merge_group&status=failure&created=%3E%3D" + HEAD_SEEN
        + "&per_page=100&page=1"]: {
        total_count: 3,
        workflow_runs: [],
      },
    }
  assert_error_contains(fn() { verdict(responses) }, "measured 0 of 3")
}

pipeline test_only_queue_skipping_labels_are_guarded() {
  assert_error_contains(
    fn() { measure(reader({}).reader, request("bypass-ci")) },
    "not a queue-skipping label",
  )
}

pipeline test_force_merge_refuses_a_head_red_where_main_is_green() {
  // The #9580 shape: main is red elsewhere, so an incident exists, but the
  // head fails a census main passes. Landing it reds every later queue entry.
  const responses = world([], "failure")
    + head_checks(
      HEAD,
      [["Supply chain", "failure", CI_WORKFLOW], ["Lint", "success", CI_WORKFLOW]],
    )
    + main_jobs(900, [["Supply chain", "success"], ["Lint", "success"], ["Build", "failure"]])
  const decision = verdict(responses)
  assert_eq(decision.verdict, "refused")
  assert(
    decision.reason.contains("the head is red where the default branch is not"),
    decision.reason,
  )
  assert(
    decision.reason.contains("Supply chain (head failure; success in push run 900"),
    decision.reason,
  )
  assert(decision.retry.contains("only skips reds the default branch already has"), decision.retry)
  assert(
    decision.comparison.contains(
      "| Supply chain | failure | success in push run 900 on aaaaaaaaaaaa | new red |",
    ),
    decision.comparison,
  )
  assert(!decision.comparison.contains("Lint"), decision.comparison)
}

pipeline test_force_merge_allows_a_head_whose_only_reds_main_already_has() {
  const responses = world([], "failure")
    + head_checks(HEAD, [["Build", "failure", CI_WORKFLOW], ["Lint", "timed_out", CI_WORKFLOW]])
    + main_jobs(900, [["Build", "failure"], ["Lint", "timed_out"]])
  const decision = verdict(responses)
  assert_eq(decision.verdict, "allowed")
  assert(
    decision.comparison.contains(
      "| Build | failure | failure in push run 900 on aaaaaaaaaaaa | inherited red |",
    ),
    decision.comparison,
  )
  assert(
    decision.evidence.any({ line -> line.contains("2 failing, 0 not red on the default branch") }),
  )
}

pipeline test_a_head_that_fixes_mains_red_has_nothing_to_compare() {
  const responses = world([], "failure") + head_checks(HEAD, [["Build", "success", CI_WORKFLOW]])
  const decision = verdict(responses)
  assert_eq(decision.verdict, "allowed")
  assert(
    decision.comparison.contains("No completed check failed on the head."),
    decision.comparison,
  )
}

pipeline test_a_job_main_skipped_is_judged_by_the_newest_run_that_ran_it() {
  const responses = world([], "failure")
    + head_checks(HEAD, [["Heavy", "failure", CI_WORKFLOW]])
    + main_jobs(900, [["Heavy", "skipped"]])
    + group_runs(TIP, [])
    + main_runs(
      PARENT,
      [{id: 899, status: "completed", conclusion: "failure", created_at: "2026-10-02T09:00:00Z"}],
    )
    + main_jobs(899, [["Heavy", "failure"]])
  const decision = verdict(responses)
  assert_eq(decision.verdict, "allowed")
  assert(
    decision.comparison.contains("failure in push run 899 on bbbbbbbbbbbb"),
    decision.comparison,
  )
}

pipeline test_a_job_main_never_ran_is_not_an_inherited_red() {
  // Absence must not read as an inherited red: main cannot show this job red.
  const responses = world([], "failure")
    + head_checks(HEAD, [["Heavy", "failure", CI_WORKFLOW]])
    + main_jobs(900, [["Heavy", "skipped"]])
    + group_runs(TIP, [])
    + main_runs(PARENT, [])
    + group_runs(PARENT, [])
  const decision = verdict(responses)
  assert_eq(decision.verdict, "refused")
  assert(
    decision.reason.contains("no push or merge-group run on the last 2 commits of main ran it"),
    decision.reason,
  )
}

pipeline test_a_failing_check_outside_main_ci_never_counts_as_inherited() {
  const responses = world([], "failure")
    + head_checks(
      HEAD,
      [
        ["Review", "failure", ".github/workflows/review.yml"],
        // Earlier refused override attempts post a failed check on the head too.
        ["Apply merge override", "failure", OVERRIDE_WORKFLOW],
        ["Still going", nil, CI_WORKFLOW],
      ],
    )
  const decision = verdict(responses)
  assert_eq(decision.verdict, "refused")
  assert(
    decision.reason.contains(
      "Review (head failure; not a ci.yml job (.github/workflows/review.yml)",
    ),
    decision.reason,
  )
  assert(!decision.comparison.contains("Apply merge override"), decision.comparison)
  assert(
    decision.comparison.contains("Still running on the head, not compared: Still going."),
    decision.comparison,
  )
}

pipeline test_bypass_merge_queue_does_not_compare_head_checks_with_main() {
  const responses = world([], "failure") + required_checks(HEAD, "success")
  const decision = verdict(responses, request("bypass-merge-queue"))
  assert_eq(decision.verdict, "allowed")
  assert_eq(decision.comparison, "")
}

pipeline test_a_queue_only_job_is_judged_by_the_merged_group_run_of_main() {
  // The push run skips the heavy tier; the merge-group run that produced the
  // tip ran it. A group on another base never counts as main evidence.
  const responses = world([], "failure")
    + head_checks(HEAD, [["Heavy", "failure", CI_WORKFLOW], ["Census", "failure", CI_WORKFLOW]])
    + main_jobs(900, [["Heavy", "skipped"], ["Census", "skipped"]])
    + group_runs(
      TIP,
      [
        {
          id: 950,
          status: "completed",
          conclusion: "failure",
          head_branch: "gh-readonly-queue/main/pr-41-" + PARENT,
          created_at: "2026-10-02T09:30:00Z",
        },
        {
          id: 951,
          status: "completed",
          conclusion: "success",
          head_branch: "gh-readonly-queue/release/pr-40-" + PARENT,
          created_at: "2026-10-02T09:40:00Z",
        },
      ],
    )
    + main_jobs(950, [["Heavy", "failure"], ["Census", "success"]])
  const decision = verdict(responses)
  assert_eq(decision.verdict, "refused")
  assert(
    decision.comparison.contains(
      "| Heavy | failure | failure in merge_group run 950 on aaaaaaaaaaaa | inherited red |",
    ),
    decision.comparison,
  )
  assert(
    decision.comparison.contains(
      "| Census | failure | success in merge_group run 950 on aaaaaaaaaaaa | new red |",
    ),
    decision.comparison,
  )
}
