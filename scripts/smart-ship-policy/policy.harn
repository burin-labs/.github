import { GitHub } from "../merge-override/github.harn"

type DirectoryEntry = {name: string, path: string, type: string, sha: string, git_url: string}

type Directory = list<DirectoryEntry>

type Blob = {sha: string, size: int, encoding: string, content: string}

pub type PolicyReading = {
  repository: string,
  branch: string,
  state: string,
  entries: int,
  blob: string?,
  bytes: int,
  content: string,
}

fn is_sha(value: string) -> bool {
  return len(regex_captures("^[0-9a-f]{40}$", value) ?? []) == 1
}

/**
 * Absence requires a nonempty, scoped directory census. A selected policy is
 * read by immutable blob ID in that same repository, never by a second moving
 * branch lookup. The GitHub transport throws on denied or unavailable reads.
 */
pub fn read_policy(github: GitHub, repository: string, branch: string) -> PolicyReading {
  if len(regex_captures("^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$", repository) ?? []) != 1
    || repository.split("/").contains(".")
    || repository.split("/").contains("..")
    || trim(branch) == ""
    || branch != trim(branch) {
    throw "policy source requires owner/name and a nonempty default branch"
  }
  const root = "repos/" + repository
  const entries = schema_expect(
    github.read(root + "/contents/.github?ref=" + url_encode(branch)),
    schema_of(Directory),
  )
  // GitHub's contents endpoint caps directory responses at 1,000 entries.
  if len(entries) == 0 || len(entries) >= 1000 {
    throw "policy directory census is empty or may be truncated"
  }
  let names = []
  for entry in entries {
    if entry.name == "" || entry.name == "." || entry.name == ".."
      || entry.name.contains("/")
      || entry.name.contains("\\")
      || entry.path != ".github/" + entry.name
      || !is_sha(entry.sha)
      || !["file", "dir", "symlink", "submodule"].contains(entry.type) {
      throw "policy directory census contains an invalid or out-of-scope entry"
    }
    if names.contains(entry.name) {
      throw "policy directory census contains duplicate entries"
    }
    names = names + [entry.name]
  }
  const selected = entries.filter(fn(entry) { return entry.name == "smart-ship.toml" }).to_list()
  if len(selected) == 0 {
    return {
      repository: repository,
      branch: branch,
      state: "absent",
      entries: len(entries),
      blob: nil,
      bytes: 0,
      content: "",
    }
  }
  const entry = selected[0]
  const blob_path = root + "/git/blobs/" + entry.sha
  if entry.type != "file" || entry.git_url != "https://api.github.com/" + blob_path {
    throw "policy entry does not bind a file blob in the caller repository"
  }
  const blob = schema_expect(github.read(blob_path), schema_of(Blob))
  if blob.sha != entry.sha || blob.encoding != "base64" || blob.size < 0 {
    throw "policy blob identity or encoding does not match its directory entry"
  }
  const bytes = bytes_from_base64(blob.content.replace("\n", "").replace("\r", ""))
  if bytes_len(bytes) != blob.size {
    throw "policy blob byte count does not match its declared size"
  }
  return {
    repository: repository,
    branch: branch,
    state: "present",
    entries: len(entries),
    blob: blob.sha,
    bytes: blob.size,
    content: bytes_to_string(bytes),
  }
}
