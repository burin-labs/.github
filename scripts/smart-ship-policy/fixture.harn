pub const READ_CASES = [
  "present",
  "absent",
  "denied",
  "hidden",
  "network",
  "json",
  "empty",
  "base64",
  "scope",
  "identity",
]

pub type PolicyFixture = {
  output: string,
  content: string,
  prepare: fn(string) -> dict,
  paths: fn() -> list<string>,
}

/** One fake GitHub transport for actual CLI and workflow refusal controls. */
pub fn policy_fixture(harness: Harness, temp: string) -> PolicyFixture {
  const bin = path_join(temp, "bin")
  harness.fs.mkdir(bin, true)
  const calls = path_join(temp, "github-calls")
  const directory = path_join(temp, "directory.json")
  const blob = path_join(temp, "blob.json")
  const output = path_join(temp, "ship.toml")
  const sha = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  const content = "# café\r\n[release]\ntargets = [\"app\"]\n"
  const policy = {
    name: "smart-ship.toml",
    path: ".github/smart-ship.toml",
    type: "file",
    sha: sha,
    git_url: "https://api.github.com/repos/example/consumer/git/blobs/" + sha,
  }
  const gh = path_join(bin, "gh")
  harness.fs.write_text(
    gh,
    "#!/bin/sh\n"
      + "printf '%s\\n' \"$2\" >> \"$CALLS\"\n"
      + "case \"$READ_CASE\" in denied) echo 'HTTP 403 denied' >&2; exit 1;;"
      + " hidden) echo 'HTTP 404' >&2; exit 1;; network) echo 'network timeout' >&2; exit 1;;"
      + " json) echo 'invalid JSON'; exit 0;; esac\n"
      + "case \"$2\" in repos/example/consumer/contents/.github?ref=main) cat \"$DIRECTORY\";;"
      + " repos/example/consumer/git/blobs/"
      + sha
      + ") cat \"$BLOB\";; *) exit 9;; esac\n",
  )
  if !harness.process.run({program: "/bin/chmod", args: ["755", gh]}).success {
    throw "could not make the GitHub fixture executable"
  }
  return {
    output: output,
    content: content,
    paths: fn() { return harness.fs.read_text(calls).split("\n").filter(
      fn(line) { return line != "" },
    )
      .to_list() },
    prepare: fn(scenario) {
      if !READ_CASES.contains(scenario) {
        throw "unknown policy fixture scenario: " + scenario
      }
      harness.fs.write_text(calls, "")
      harness.fs.write_text(output, "previous measured policy\n")
      harness.fs.write_text(
        directory,
        json_stringify(
          scenario == "empty" ? [] : scenario == "absent" ? [
            policy + {name: "workflows", path: ".github/workflows", type: "dir"},
          ] : [scenario == "scope" ? policy + {path: "outside/smart-ship.toml"} : policy],
        ),
      )
      harness.fs.write_text(
        blob,
        json_stringify(
          {
            sha: scenario == "identity" ? "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb" : sha,
            encoding: "base64",
            size: scenario == "base64" ? 1 : bytes_len(bytes_from_string(content)),
            content: scenario == "base64" ? "%%%" : base64_encode(content),
          },
        ),
      )
      return {
        PATH: bin + ":" + to_string(harness.env.get("PATH") ?? ""),
        HOME: temp,
        GH_TOKEN: "fixture-token",
        HARN_SECRET_PROVIDERS: "env",
        HARN_LLM_CALLS_DISABLED: "1",
        CALLS: calls,
        DIRECTORY: directory,
        BLOB: blob,
        READ_CASE: scenario,
      }
    },
  }
}
