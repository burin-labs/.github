import { read_yaml } from "std/fs"
import { with_temp_dir } from "std/testing"
import { READ_CASES, policy_fixture } from "./fixture.harn"

pipeline test_actual_workflow_refuses_before_any_shepherd_when_policy_read_fails(harness: Harness) {
  const steps = read_yaml(harness.fs, "../../.github/workflows/smart-ship.yml").jobs.ship.steps
  const reconcile_step = steps.find(
    { step -> step?.name == "Reconcile the Smart Ship control label" },
  )
  const worker_steps = read_yaml(harness.fs, "../../.github/workflows/smart-ship-look.yml").jobs
    .look.steps
  const step = worker_steps.find(
    { entry -> entry?.name == "Read the default-branch shipping policy" },
  )
  const look = worker_steps.find({ entry -> entry?.name == "Look at the pull request" })
  assert(reconcile_step != nil && step != nil && look != nil)
  assert(worker_steps.index_of(step) < worker_steps.index_of(look))
  const reconcile = reconcile_step.run.replace("$" + "{{ inputs.ship-label }}", "ship")
  assert_eq(step.env.DEFAULT_BRANCH, "$" + "{{ github.event.repository.default_branch }}")
  with_temp_dir(
    harness.fs,
    fn(temp) {
      const driver = "#!/bin/sh\n"
        + "if [ \"$3\" = .smart-ship-runner/scripts/smart-ship-label/cli.harn ]; then\n"
        + "  printf 'reconciled\\n' > \"$LABELLED\"; exit 0\nfi\n"
        + "if [ \"$3\" = .smart-ship-runner/scripts/smart-ship-policy/cli.harn ]; then\n"
        + "  printf '%s\\n' \"$5\" \"$6\" \"$7\" > \"$ACQUIRED\"\n"
        + "  exec \"$HARN_BINARY\" \"$@\"\nfi\n"
        + "printf '%s\\n' \"$LOOK_PR\" >> \"$SHEPHERD_CALLS\"\nexit 0\n"
      let measured = 0
      for scenario in READ_CASES + ["missing-helper"] {
        const workspace = path_join(temp, scenario)
        harness.fs.mkdir(workspace, true)
        const fixture = policy_fixture(harness, workspace)
        const scripts = path_join(workspace, "scripts")
        harness.fs.mkdir(scripts, true)
        const child_calls = path_join(workspace, "shepherd-calls")
        const acquired = path_join(workspace, "acquired")
        const labelled = path_join(workspace, "labelled")
        const output = path_join(workspace, "github-output")
        const harnw = path_join(scripts, "harnw")
        harness.fs.write_text(harnw, driver)
        assert(harness.process.run({program: "/bin/chmod", args: ["755", harnw]}).success)
        const control = path_join(workspace, ".smart-ship-runner/scripts")
        harness.fs.mkdir(path_join(control, "smart-ship-policy"), true)
        harness.fs.mkdir(path_join(control, "merge-override"), true)
        for file in ["cli.harn", "policy.harn", "../merge-override/github.harn"] {
          if scenario != "missing-helper" || file != "cli.harn" {
            harness.fs.write_text(
              path_join(control, "smart-ship-policy", file),
              harness.fs.read_text(path_join(harness.fs.source_dir(), file)),
            )
          }
        }
        harness.fs.write_text(child_calls, "")
        harness.fs.write_text(acquired, "")
        harness.fs.write_text(output, "")
        const result = harness.process.run(
          {
            program: "/usr/bin/env",
            args: [
              "bash",
              "-e",
              "-o",
              "pipefail",
              "-c",
              reconcile + "\n" + step.run + "\n" + look.run,
            ],
            cwd: workspace,
            env: fixture.prepare(scenario == "missing-helper" ? "present" : scenario)
              + {
                HARN_BINARY: harness.env.get("HARN_BIN") ?? "harn",
                ACQUIRED: acquired,
                LABELLED: labelled,
                SHEPHERD_CALLS: child_calls,
                GITHUB_OUTPUT: output,
                GITHUB_WORKSPACE: workspace,
                RUNNER_TEMP: workspace,
                REPO: "example/consumer",
                DEFAULT_BRANCH: "main",
                LABEL: "ship",
                NUMBERS: "1 2 3",
                REPAIR: "false",
                LOOK_PR: "2",
              },
            timeout_ms: 30000,
          },
        )
        const expected = scenario == "present" || scenario == "absent"
        assert_eq(harness.fs.read_text(labelled), "reconciled\n")
        assert_eq(
          result.success,
          expected,
          scenario + " exit " + to_string(result.exit_code)
            + ": "
            + result.stdout
            + result.stderr,
        )
        assert_eq(
          harness.fs.read_text(acquired),
          "example/consumer\nmain\n" + fixture.output + "\n",
        )
        const paths = fixture.paths()
        if scenario == "missing-helper" {
          assert_eq(result.exit_code, 125)
          assert(
            result.stderr.contains(
              "Error reading .smart-ship-runner/scripts/smart-ship-policy/cli.harn",
            ),
          )
          assert_eq(len(paths), 0)
        } else {
          assert_eq(paths[0], "repos/example/consumer/contents/.github?ref=main", scenario)
          assert_eq(
            len(paths),
            ["present", "base64", "identity"].contains(scenario) ? 2 : 1,
            scenario,
          )
        }
        const children = harness.fs.read_text(child_calls).split("\n").filter(
          fn(line) { return line != "" },
        )
          .to_list()
        assert_eq(len(children), expected ? 1 : 0, scenario)
        if expected {
          assert_eq(
            harness.fs.read_text(fixture.output),
            scenario == "present" ? fixture.content : "",
          )
          assert_eq(children, ["2"])
        } else {
          assert_eq(harness.fs.read_text(fixture.output), "previous measured policy\n", scenario)
          assert_eq(harness.fs.read_text(output), "", scenario)
        }
        harness.stdio.println(
          json_stringify(
            {
              scenario: scenario,
              exit_code: result.exit_code,
              label_reconciled: true,
              policy_requests: len(paths),
              children: len(children),
            },
          ),
        )
        measured = measured + 1
      }
      assert_eq(measured, 11)
    },
  )
}
