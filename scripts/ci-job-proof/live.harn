import {
  Artifact,
  CheckpointEnrollment,
  ProofUniverse,
  Registration,
  Run,
  RunContext,
  TestedSource,
  closed,
  qualify_universe_run,
  sha,
} from "./contract.harn"
import { ProofSource, repository, workflow } from "./reader.harn"

const API_ROOT = "https://api.github.com"

const MAX_REGISTRATION_BYTES = 1048576

type CheckpointRun = Run & {head_branch: string, actor: {id: int, login: string}}

type MainComparison = {status: string}

/** Reauthenticate the caller's enrolled full checkpoint and its actual clean checkout on main. */
pub fn checkpoint_enrollment(
  source: ProofSource,
  current: RunContext,
  tested: TestedSource,
  raw: string,
) -> CheckpointEnrollment? {
  if raw == "" || current.event != "workflow_dispatch" {
    return nil
  }
  const parsed = json_parse(raw)
  schema_expect(parsed, closed(schema_of(CheckpointEnrollment)))
  const expected = schema_expect(parsed, schema_of(CheckpointEnrollment))
  require expected.actorId > 0 && expected.actorLogin != "" && expected.headBranch != "",
    "checkpoint enrollment is incomplete"
  const run = schema_expect(
    source.json(
      "/repos/${current.repository}/actions/runs/${current.runId}/attempts/${current.attempt}",
    ),
    schema_of(CheckpointRun),
  )
  if tested.commit != current.commit || run.id != current.runId
    || run.run_attempt != current.attempt
    || run.head_sha != current.commit
    || run.event != current.event
    || run.repository.full_name != current.repository
    || run.head_repository.full_name != current.repository
    || run.path != ".github/workflows/${current.workflow}"
    || run.actor.id != expected.actorId
    || run.actor.login != expected.actorLogin
    || run.head_branch != expected.headBranch {
    return nil
  }
  const comparison = schema_expect(
    source.json("/repos/${current.repository}/compare/${sha(current.commit)}...main"),
    schema_of(MainComparison),
  )
  return ["ahead", "identical"].contains(comparison.status) ? expected : nil
}

fn required(env: HarnessEnv, name: string) -> string {
  const value = env.get(name) ?? ""
  require trim(value) != "", name + " is required"
  return value
}

/** One authentication boundary owns API identity and proof-generation admission. */
pub fn authenticate_run(
  source: ProofSource,
  current: RunContext,
  universe: ProofUniverse? = nil,
) -> RunContext {
  const repo = repository(current.repository)
  const file = workflow(current.workflow)
  const commit = sha(current.commit)
  require current.runId > 0 && current.attempt > 0, "invalid current run or attempt"
  const raw = source.json(
    "/repos/${repo}/actions/runs/${current.runId}/attempts/${current.attempt}",
  )
  const run = schema_expect(raw, schema_of(Run))
  require run.id == current.runId && run.run_attempt == current.attempt && run.head_sha == commit
    && run.event == current.event
    && run.repository.full_name == repo
    && run.head_repository.full_name == repo
    && run.path == ".github/workflows/" + file,
    "current workflow context differs from the authenticated run"
  if universe != nil {
    const original_raw = source.json("/repos/${repo}/actions/runs/${current.runId}")
    const original = schema_expect(original_raw, schema_of(Run))
    require original.id == run.id && original.run_attempt == run.run_attempt
      && original.head_sha == run.head_sha
      && original.event == run.event
      && original.path == run.path
      && original.repository.full_name == run.repository.full_name
      && original.head_repository.full_name == run.head_repository.full_name,
      "original run identity changed during proof admission"
    qualify_universe_run(original_raw, universe)
  }
  return current
}

/** Authenticate the current API run without inventing checkout facts for read-only callers. */
pub fn current_run(
  env: HarnessEnv,
  source: ProofSource,
  universe: ProofUniverse? = nil,
) -> RunContext {
  return authenticate_run(
    source,
    {
      repository: required(env, "CI_JOB_PROOF_REPOSITORY"),
      workflow: required(env, "CI_JOB_PROOF_WORKFLOW"),
      event: required(env, "CI_JOB_PROOF_EVENT"),
      commit: required(env, "CI_JOB_PROOF_COMMIT"),
      runId: to_int(required(env, "CI_JOB_PROOF_RUN_ID")),
      attempt: to_int(required(env, "CI_JOB_PROOF_ATTEMPT")),
      registrarJob: required(env, "CI_JOB_PROOF_REGISTRAR_JOB"),
      registrarStep: required(env, "CI_JOB_PROOF_REGISTRAR_STEP"),
    },
    universe,
  )
}

fn options(token: string, limit: int) -> dict {
  return {
    headers: {
      Accept: "application/vnd.github+json",
      Authorization: "Bearer " + token,
      "X-GitHub-Api-Version": "2026-03-10",
      "User-Agent": "burin-ci-job-proof",
    },
    timeout_ms: 5000,
    retry: {max: 0},
    follow_redirects: true,
    max_redirects: 5,
    max_response_bytes: limit,
  }
}

fn json(net: HarnessNet, token: string, endpoint: string) -> unknown {
  const response = net.get(API_ROOT + endpoint, options(token, 33554432))
  if !response.ok {
    throw "GitHub proof read failed with HTTP " + to_string(response.status)
  }
  return json_parse(response.body)
}

/** Verify GitHub's compressed archive digest and require one named JSON document. */
pub fn document_from_archive(
  fs: HarnessFs,
  path: string,
  digest: string,
  expected_path: string,
) -> unknown {
  const archive = fs.read_bytes(path)
  if len(archive) == 0 || len(archive) > MAX_REGISTRATION_BYTES {
    throw "CI proof artifact exceeds its compressed byte bound"
  }
  if !regex_match("^sha256:[0-9a-f]{64}$", digest)
    || "sha256:" + sha256(archive) != digest {
    throw "CI proof artifact digest mismatch"
  }
  const entries = zip_extract(archive, {max_decompressed_bytes: MAX_REGISTRATION_BYTES})
  if len(entries) != 1 || entries[0].path != expected_path {
    throw "CI proof artifact must contain exactly its named document"
  }
  return json_parse(bytes_to_string(entries[0].content))
}

/** Preserve the original typed registration boundary. */
pub fn registration_from_archive(fs: HarnessFs, path: string, digest: string) -> unknown {
  return registration_document(document_from_archive(fs, path, digest, "registration.json"))
}

fn registration_document(raw: unknown) -> unknown {
  schema_expect(raw, closed(schema_of(Registration)))
  return raw
}

fn download_document(
  net: HarnessNet,
  fs: HarnessFs,
  token: string,
  repo: string,
  artifact: Artifact,
  filename: string,
) -> unknown {
  if artifact.id <= 0 || artifact.expired || artifact.size_in_bytes <= 0
    || artifact.size_in_bytes > MAX_REGISTRATION_BYTES {
    throw "CI artifact cannot be downloaded safely"
  }
  const directory = fs.mkdtemp_in_workspace("ci-job-artifact-")
  const path = directory + "/document.zip"
  defer {
    fs.delete(directory)
  }
  const response = net.download(
    API_ROOT + "/repos/" + repo + "/actions/artifacts/"
      + to_string(artifact.id)
      + "/zip",
    path,
    options(token, MAX_REGISTRATION_BYTES),
  )
  if !response.ok || response.bytes_written <= 0
    || response.bytes_written > MAX_REGISTRATION_BYTES {
    throw "CI artifact download failed or exceeded its bound"
  }
  return document_from_archive(fs, path, artifact.digest, filename)
}

/** Bounded GitHub reads authenticate archive bytes before exposing registration data. */
pub fn live_source(net: HarnessNet, fs: HarnessFs, token: string) -> ProofSource {
  return {
    json: fn(endpoint) { return json(net, token, endpoint) },
    registration: fn(repo, artifact) { return registration_document(
      download_document(net, fs, token, repo, artifact, "registration.json"),
    ) },
    cache_publication: fn(repo, artifact) { return download_document(
      net,
      fs,
      token,
      repo,
      artifact,
      "cache-publication.json",
    ) },
    graphql: fn(query) {
      const request_options = options(token, 1048576)
      const response = net.post(
        API_ROOT + "/graphql",
        json_stringify({query: query}),
        request_options + {headers: request_options.headers + {"Content-Type": "application/json"}},
      )
      require response.ok, "GitHub cache approval read failed"
      return json_parse(response.body)
    },
  }
}
