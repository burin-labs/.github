import { write_json } from "std/fs"
import { gha_write_output } from "std/gha"
import {
  JobIdentity,
  ProofUniverse,
  RECEIPT_SCHEMA,
  REGISTRATION_EVENTS,
  Registration,
  identities,
  proof_universe,
  registration,
  registration_artifact_name,
  universe_identities,
} from "./contract.harn"
import { checkpoint_enrollment, current_run, live_source } from "./live.harn"
import { READ_BUDGET, discover, merge_group_pull } from "./reader.harn"
import { tested_source } from "./source.harn"

type Decision = {discovery: dict, requested: int?, reused: list<string>, unproven: int?}

fn required(env: HarnessEnv, name: string) -> string {
  const value = env.get(name) ?? ""
  if trim(value) == "" {
    throw name + " is required"
  }
  return value
}

fn output(harness: Harness, name: string, value: unknown) {
  if !gha_write_output(harness, name, value) {
    throw "could not write job proof output"
  }
}

fn register(harness: Harness, published: Registration) {
  const directory = harness.fs.mkdtemp_in_workspace("ci-job-inputs-")
  const path = directory + "/registration.json"
  write_json(harness.fs, path, published, {pretty: true, trailing_newline: true})
  output(harness, "registration", path)
  output(
    harness,
    "registration-name",
    registration_artifact_name(published.runId, published.attempt),
  )
}

fn resolve(harness: Harness, wanted: list<JobIdentity>, universe: ProofUniverse?) -> Decision {
  const source = live_source(harness.net, harness.fs, required(harness.env, "GH_TOKEN"))
  const current = current_run(harness.env, source, universe)
  if !REGISTRATION_EVENTS.contains(current.event) {
    harness.stdio.println(
      "This event neither registers nor reuses job proofs; every selected job runs.",
    )
    return {
      discovery: {reason: "unsupported_event", probed: 0, reads: 0, budget: READ_BUDGET},
      requested: len(wanted),
      reused: [],
      unproven: len(wanted),
    }
  }
  const workspace = required(harness.env, "GITHUB_WORKSPACE")
  const actual_source = tested_source(harness.process, workspace)
  const checkpoint = checkpoint_enrollment(
    source,
    current,
    actual_source,
    harness.env.get("CI_JOB_PROOF_CHECKPOINT_ENROLLMENT") ?? "",
  )
  const discovery = try {
    discover(
      source,
      current,
      wanted,
      merge_group_pull(harness.env.get("CI_JOB_PROOF_MERGE_GROUP_HEAD_REF") ?? ""),
      fn() { return harness.clock.now_ms() },
      checkpoint,
      universe,
    )
  }
  const found = is_ok(discovery) ? unwrap(discovery) : {
    admitted: [],
    probed: 0,
    reads: nil,
    budget: READ_BUDGET,
    reason: "discovery_failed",
    blocked: [],
    negative_runs: nil,
    negative_probed: nil,
  }
  const decision: Decision = {
    discovery: pick(
      found,
      ["probed", "reads", "budget", "reason", "blocked", "negative_runs", "negative_probed"],
    ),
    requested: len(wanted),
    reused: found.admitted.map({ admission -> admission.id }).to_list(),
    unproven: len(wanted) - len(found.admitted),
  }
  // Registration records where each reused job actually ran, so a later run
  // proves it there instead of trusting this run's pointer.
  require tested_source(harness.process, workspace) == actual_source,
    "tested checkout changed during proof discovery"
  const published = registration(current, wanted, found.admitted, actual_source)
  register(harness, published)
  if len(found.admitted) == 0 {
    harness.stdio.println("No qualified job proof; selected jobs will run.")
    return decision
  }
  const directory = harness.fs.mkdtemp_in_workspace("ci-job-proof-")
  const path = directory + "/proof.json"
  write_json(
    harness.fs,
    path,
    {schema: RECEIPT_SCHEMA, current: published, admitted: found.admitted},
    {pretty: true, trailing_newline: true},
  )
  output(harness, "receipt", path)
  output(harness, "reused", json_stringify(found.admitted.map({ admission -> admission.id })))
  for admission in found.admitted {
    harness.stdio.println(
      "Reusing " + admission.id + " from run " + to_string(admission.provenance.runId)
        + " attempt "
        + to_string(admission.provenance.attempt),
    )
  }
  return decision
}

fn main(harness: Harness) {
  harness.net.egress_policy({default: "allow", block_private: "private"})
  output(harness, "reused", "[]")
  let decision: Decision = {
    discovery: {reason: "identities_unmeasured", probed: nil, reads: nil, budget: READ_BUDGET},
    requested: nil,
    reused: [],
    unproven: nil,
  }
  const raw = trim(harness.env.get("CI_JOB_PROOF_IDENTITIES") ?? "")
  if raw == "" {
    harness.stdio.println("Job identities are unmeasured; selected jobs will run.")
  } else {
    try {
      const universe = proof_universe(harness.env.get("CI_JOB_PROOF_UNIVERSE") ?? "")
      decision = resolve(
        harness,
        universe_identities(identities(json_parse(raw)), universe),
        universe,
      )
    } catch (_error) {
      // Diagnostics never expose API responses, tokens, or caller-provided plan values.
      decision = {
        discovery: {
          reason: "registration_unqualified",
          probed: nil,
          reads: nil,
          budget: READ_BUDGET,
          negative_runs: nil,
          negative_probed: nil,
        },
        requested: nil,
        reused: [],
        unproven: nil,
      }
      harness.stdio.println("Job proofs could not be qualified; selected jobs will run.")
    }
  }
  output(harness, "discovery", json_stringify(decision.discovery))
  harness.stdio.println(json_stringify({schema: "burin.ci_job_proof_discovery.v1", ...decision}))
}
