import { assert_error_contains } from "std/testing"
import { JobIdentity, ProducerPolicy, Registration, Run } from "./contract.harn"
import { inspect_original_run } from "./lib.harn"
import { registration_from_archive } from "./live.harn"
import { ProofSource, inspect_run, read_run } from "./reader.harn"

fn archive_source(fs: HarnessFs, path: string, pages: dict) -> ProofSource {
  return {
    json: fn(endpoint) {
      if pages[endpoint] == nil {
        throw "unexpected fixture endpoint"
      }
      return pages[endpoint]
    },
    registration: fn(repo, item) {
      assert_eq(repo, "acme/product")
      assert_eq(item.id, 101)
      return registration_from_archive(fs, path, item.digest)
    },
  }
}

pipeline test_reader_reaches_actual_archive_and_job_proof(harness: Harness) {
  const digest = "a".repeat(64)
  const wanted: list<JobIdentity> = [{id: "rust", names: ["Rust"], digest: digest}]
  const current: Registration = {
    schema: "burin.ci_job_proof_registration.v3",
    tested_source: {commit: "e".repeat(40), tree: "f".repeat(40)},
    repository: "acme/product",
    workflow: "ci.yml",
    event: "merge_group",
    commit: "d".repeat(40),
    runId: 20,
    attempt: 1,
    registrarJob: "Changes",
    registrarStep: "Register",
    jobs: [],
  }
  const recorded = {
    ...current,
    event: "pull_request",
    commit: "a".repeat(40),
    runId: 10,
    attempt: 2,
    jobs: [{id: "rust", names: ["Rust"], digest: digest, provenance: nil}],
  }
  const producer: Run = {
    id: 10,
    run_attempt: 2,
    head_sha: "a".repeat(40),
    event: "pull_request",
    path: ".github/workflows/ci.yml",
    status: "completed",
    conclusion: "failure",
    repository: {full_name: "acme/product"},
    head_repository: {full_name: "acme/product"},
  }
  const directory = harness.fs.mkdtemp_in_workspace("ci-job-reader-product-")
  const path = directory + "/registration.zip"
  const archive = zip_create([{path: "registration.json", content: json_stringify(recorded)}])
  harness.fs.write_bytes(path, archive)
  const artifact = {
    id: 101,
    name: "ci-job-inputs-10-2",
    size_in_bytes: len(archive),
    expired: false,
    digest: "sha256:" + sha256(archive),
    created_at: "2026-10-09T10:00:00Z",
    workflow_run: {id: 10, head_sha: "a".repeat(40)},
  }
  const base = {
    run_id: 10,
    run_attempt: 2,
    head_sha: "a".repeat(40),
    status: "completed",
    conclusion: "success",
    started_at: "2026-10-09T10:00:02Z",
    completed_at: "2026-10-09T10:00:03Z",
  }
  const rows = [
    {
      ...base,
      id: 1,
      name: "Changes",
      completed_at: "2026-10-09T10:00:01Z",
      steps: [{name: "Register", status: "completed", conclusion: "success"}],
    },
    {...base, id: 2, name: "Rust", steps: []},
    {...base, id: 3, name: "Calibration", conclusion: "failure", steps: []},
  ]
  const pages = {
    "/repos/acme/product/actions/runs/10/artifacts?per_page=100&page=1": {
      total_count: 1,
      artifacts: [artifact],
    },
    "/repos/acme/product/actions/runs/10/attempts/2/jobs?per_page=30&page=1": {
      total_count: 3,
      jobs: rows,
    },
  }
  const transport = archive_source(harness.fs, path, pages)
  // A pull request's passing job proves the merge group's identical job; its
  // unrelated failure does not.
  const outcome = read_run(transport, current, producer, wanted)
  assert_eq(outcome.admitted.map({ admission -> admission.jobIds }), [[2]])
  const inspected = inspect_run(transport, current, producer)
  assert_eq(inspected.census.declared, 3)
  assert_eq(inspected.census.jobs, rows)
  assert_eq(inspected.registered.artifact.digest, artifact.digest)
  assert_eq(inspected.registered.registration.tested_source, recorded.tested_source)
  assert(inspected.registered.registration.tested_source.commit != producer.head_sha)
  assert_eq(inspected.admission, outcome)
  // An observer need not pretend it is a distinct run of the producer workflow.
  // Its trusted policy can enroll an original dispatch, without granting reuse.
  const policy: ProducerPolicy = {
    repository: "acme/product",
    workflow: "ci.yml",
    events: ["workflow_dispatch"],
    registrarJob: "Changes",
    registrarStep: "Register",
  }
  const dispatch = producer + {event: "workflow_dispatch"}
  const dispatch_record = recorded + {event: "workflow_dispatch"}
  const dispatch_archive = zip_create(
    [{path: "registration.json", content: json_stringify(dispatch_record)}],
  )
  harness.fs.write_bytes(path, dispatch_archive)
  const dispatch_artifact = artifact
    + {size_in_bytes: len(dispatch_archive), digest: "sha256:" + sha256(dispatch_archive)}
  const dispatch_pages = pages
    + {
      "/repos/acme/product/actions/runs/10/artifacts?per_page=100&page=1": {
        total_count: 1,
        artifacts: [dispatch_artifact],
      },
    }
  const dispatch_transport = archive_source(harness.fs, path, dispatch_pages)
  const original = inspect_original_run(dispatch_transport, policy, dispatch)
  assert_eq(original.census.declared, 3)
  assert_eq(original.census.jobs, rows)
  assert_eq(original.registered.registration.tested_source, recorded.tested_source)
  assert_eq(original.registered.artifact.digest, dispatch_artifact.digest)
  assert_eq(original.admission.admitted, outcome.admitted)
  assert_eq(original.producer.event, "workflow_dispatch")
  assert_error_contains(
    fn() { inspect_run(dispatch_transport, current, dispatch) },
    "producer source, workflow, repository or attempt mismatch",
  )
  for refused in [policy + {events: ["push"]}, policy + {workflow: "another.yml"}] {
    assert_error_contains(
      fn() { inspect_original_run(dispatch_transport, refused, dispatch) },
      "producer source, workflow, repository or attempt mismatch",
    )
  }
  for refused in [
    policy + {events: []},
    policy + {events: ["workflow_dispatch", "workflow_dispatch"]},
  ] {
    assert_error_contains(
      fn() { inspect_original_run(dispatch_transport, refused, dispatch) },
      "producer policy is incomplete or ambiguous",
    )
  }
  assert_error_contains(
    fn() { inspect_original_run(dispatch_transport, policy, dispatch + {run_attempt: 3}) },
    "registration artifact missing or ambiguous",
  )
  assert_error_contains(
    fn() { inspect_original_run(dispatch_transport, policy, dispatch + {status: "in_progress"}) },
    "producer source, workflow, repository or attempt mismatch",
  )
  harness.fs.write_bytes(path, archive)
  assert_error_contains(
    fn() { read_run(transport, current + {runId: producer.id}, producer, wanted) },
    "producer source, workflow, repository or attempt mismatch",
  )
  const changed = [wanted[0]! + {digest: "b".repeat(64)}]
  assert_eq(read_run(transport, current, producer, changed).admitted, [])
  const tampered = zip_create(
    [{path: "registration.json", content: json_stringify({...recorded, commit: "f".repeat(40)})}],
  )
  harness.fs.write_bytes(path, tampered)
  assert_error_contains(fn() { read_run(transport, current, producer, wanted) }, "digest mismatch")
}
