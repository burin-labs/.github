import {
  JobIdentity,
  REGISTRATION_EVENTS,
  REUSE_PRODUCER_EVENTS,
  Registration,
  Run,
  registration,
  universe_identities,
} from "./contract.harn"
import { ProofSource, READ_BUDGET, discover } from "./reader.harn"

const DIGEST = "a".repeat(64)

const COMMIT = "c".repeat(40)

const CHECKPOINT = {actorId: 42, actorLogin: "release[bot]", headBranch: "main"}

const UNIVERSE = {generation: "fixture-v1", notBefore: "2026-10-09T00:00:00Z"}

fn checkpoint_now() -> int {
  return to_int(date_parse("2026-10-09T12:00:00Z") * 1000)
}

pipeline test_dispatch_registers_original_jobs_without_searching_or_reusing_history() {
  const context = current() + {event: "workflow_dispatch"}
  const forbidden: ProofSource = {
    json: fn(_endpoint) {
      throw "dispatch must not read reuse history"
    },
    registration: fn(_repo, _artifact) {
      throw "dispatch must not read reused registration"
    },
  }
  const result = discover(forbidden, context, wanted(), nil, fn() { return 0 })
  assert_eq(result.admitted, [])
  assert_eq(result.reads, 0)
  assert_eq(result.reason, "unsupported_event")
  assert(REGISTRATION_EVENTS.contains(context.event))
  assert(!REUSE_PRODUCER_EVENTS.contains(context.event))
  const published = registration(context, wanted(), result.admitted, context.tested_source)
  assert_eq(published.event, "workflow_dispatch")
  assert_eq(published.tested_source, context.tested_source)
  assert_eq(len(published.jobs), 2)
  assert(published.jobs.all({ job -> job.provenance == nil }))
}

fn wanted() -> list<JobIdentity> {
  return [
    {id: "lint", names: ["Lint"], digest: DIGEST},
    {id: "suite", names: ["Suite"], digest: DIGEST},
  ]
}

fn current() -> Registration {
  return {
    schema: "burin.ci_job_proof_registration.v3",
    tested_source: {commit: "e".repeat(40), tree: "f".repeat(40)},
    repository: "acme/product",
    workflow: "ci.yml",
    event: "push",
    commit: COMMIT,
    runId: 30,
    attempt: 1,
    registrarJob: "Changes",
    registrarStep: "Register",
    jobs: [],
  }
}

fn run(id: int, event: string) -> Run {
  return {
    id: id,
    run_attempt: 1,
    head_sha: to_string(id % 10).repeat(40),
    event: event,
    path: ".github/workflows/ci.yml",
    status: "completed",
    conclusion: "success",
    repository: {full_name: "acme/product"},
    head_repository: {full_name: "acme/product"},
    created_at: "2026-10-09T09:00:00Z",
    updated_at: "2026-10-09T11:00:00Z",
    head_branch: "main",
    actor: {id: 42, login: "release[bot]"},
  }
}

/** One producer: what it recorded per job, and which jobs ran here. */
fn producer(run: Run, claims: dict, ran: list<string>) -> dict {
  const job = fn(id: int, name: string, started: string, completed: string) { return {
    id: id,
    run_id: run.id,
    run_attempt: run.run_attempt,
    head_sha: run.head_sha,
    name: name,
    status: "completed",
    conclusion: "success",
    started_at: started,
    completed_at: completed,
    steps: [{name: "Register", status: "completed", conclusion: "success"}],
  } }
  const base = run.id * 1000 + run.run_attempt * 100
  const registrar = job(base, "Changes", "2026-10-09T10:00:00Z", "2026-10-09T10:01:00Z")
  const legs = ran.map(
    { name -> job(base + len(name), name, "2026-10-09T10:05:00Z", "2026-10-09T10:09:00Z") },
  )
    .to_list()
  return {
    run: run,
    registration: {
      ...current(),
      event: run.event,
      commit: run.head_sha,
      runId: run.id,
      attempt: run.run_attempt,
      jobs: wanted().map(
        { identity ->
          {
            id: identity.id,
            names: identity.names,
            digest: claims[identity.id]?.digest ?? "f".repeat(64),
            provenance: claims[identity.id]?.provenance,
          }
        },
      )
        .to_list(),
    },
    jobs: [registrar] + legs,
  }
}

fn source(producers: list, calls: fn(string) -> nil) -> ProofSource {
  const at = fn(id: int, attempt: int) { return producers.filter(
    { item -> item.run.id == id && item.run.run_attempt == attempt },
  )
    .to_list()[0] }
  return {
    json: fn(endpoint) {
      calls(endpoint)
      if endpoint.contains("per_page=100&created=") {
        let latest = {}
        for item in producers {
          const selected = endpoint.contains("event=workflow_dispatch") ? item.run.event
            == "workflow_dispatch" : ["push", "workflow_dispatch", "schedule"].contains(
            item.run.event,
          )
          if selected
            && (latest[to_string(item.run.id)] == nil
              || latest[to_string(item.run.id)].run_attempt < item.run.run_attempt) {
            latest = latest + {[to_string(item.run.id)]: item.run}
          }
        }
        return {total_count: len(latest), workflow_runs: latest.values().to_list()}
      }
      if endpoint.contains("event=push&branch=main") {
        let latest = {}
        for item in producers.filter({ item -> item.run.event == "push" }) {
          const key = to_string(item.run.id)
          if latest[key] == nil || latest[key].run_attempt < item.run.run_attempt {
            latest = latest + {[key]: item.run}
          }
        }
        const rows = latest.values().to_list().sorted_by({ item -> -item.id })
        return {total_count: len(rows), workflow_runs: rows.slice(0, 5)}
      }
      if endpoint.contains("event=push&head_sha=" + COMMIT) {
        return {total_count: 0, workflow_runs: []}
      }
      if endpoint.contains("event=merge_group&head_sha=" + COMMIT) {
        const rows = producers.filter({ item -> item.run.event == "merge_group" }).map(
          { item -> item.run },
        )
          .to_list()
        return {total_count: len(rows), workflow_runs: rows.slice(0, 5)}
      }
      const found = regex_captures("/actions/runs/([0-9]+)/", endpoint)
      const id = to_int(found[0].groups[0])
      const attempt_found = regex_captures("/attempts/([0-9]+)", endpoint)
      const attempt = len(attempt_found) == 1 ? to_int(attempt_found[0].groups[0]) : 1
      if endpoint.contains("/artifacts?") {
        // Every attempt of a run uploads its own registration.
        const attempts = producers.filter({ item -> item.run.id == id }).to_list()
        return {
          total_count: len(attempts),
          artifacts: attempts.map(
            { item ->
              {
                id: id * 10 + item.run.run_attempt,
                name: "ci-job-inputs-" + to_string(id) + "-" + to_string(item.run.run_attempt),
                size_in_bytes: 100,
                expired: false,
                digest: "sha256:" + "e".repeat(64),
                created_at: "2026-10-09T10:02:00Z",
                workflow_run: {id: id, head_sha: item.run.head_sha},
              }
            },
          )
            .to_list(),
        }
      }
      if endpoint.contains("/jobs?") {
        return {total_count: len(at(id, attempt).jobs), jobs: at(id, attempt).jobs}
      }
      return at(id, attempt).run
    },
    registration:
      fn(_repo, artifact) { return at(artifact.id / 10, artifact.id % 10).registration },
  }
}

fn failing(item: dict, names: list<string>, completed: string = "2026-10-09T11:00:00Z") -> dict {
  return item
    + {
      run: item.run + {conclusion: "failure"},
      jobs: item.jobs.map(
        { job ->
          names.contains(job.name) ? job + {conclusion: "failure", completed_at: completed} : job
        },
      )
        .to_list(),
    }
}

pipeline test_enrolled_checkpoint_reuses_only_qualified_inputs_and_keeps_failed_inputs_fresh() {
  const context = current() + {event: "workflow_dispatch"}
  const older = producer(
    run(20, "merge_group"),
    {lint: {digest: DIGEST}, suite: {digest: DIGEST}},
    ["Lint", "Suite"],
  )
  const latest = producer(run(25, "push"), {lint: {digest: DIGEST}}, ["Lint"])
  const accepted = discover(
    source([latest, older], fn(_endpoint) { return nil }),
    context,
    wanted(),
    nil,
    checkpoint_now,
    CHECKPOINT,
    UNIVERSE,
  )
  assert_eq(
    accepted.admitted.map({ proof -> [proof.id, proof.provenance.runId] }),
    [["lint", 25], ["suite", 20]],
  )
  assert_eq(accepted.blocked, [])
  assert(accepted.reads > 0 && accepted.reads <= READ_BUDGET)
  const failed = failing(latest, ["Lint"])
  const refused = discover(
    source([failed, older], fn(_endpoint) { return nil }),
    context,
    wanted(),
    nil,
    checkpoint_now,
    CHECKPOINT,
    UNIVERSE,
  )
  assert_eq(refused.blocked, ["lint"])
  assert_eq(refused.admitted.map({ proof -> proof.id }), ["suite"])
  const complete = source([failed, older], fn(_endpoint) { return nil })
  const unreadable: ProofSource = {
    json: complete.json,
    registration: fn(repo, artifact) {
      if artifact.workflow_run.id == 25 {
        throw "failed producer registration is unreadable"
      }
      return complete.registration(repo, artifact)
    },
  }
  const unknown = discover(unreadable, context, wanted(), nil, checkpoint_now, CHECKPOINT, UNIVERSE)
  assert_eq(unknown.blocked, ["lint", "suite"])
  assert_eq(unknown.admitted, [])
  const changed = discover(
    source([latest, older], fn(_endpoint) { return nil }),
    context,
    [{id: "lint", names: ["Lint"], digest: "b".repeat(64)}],
    nil,
    checkpoint_now,
    CHECKPOINT,
    UNIVERSE,
  )
  assert_eq(changed.admitted, [])
}

pipeline test_checkpoint_checks_newer_failed_attempt_before_old_success_of_the_same_run() {
  const earlier = producer(
    run(25, "push"),
    {lint: {digest: DIGEST}, suite: {digest: DIGEST}},
    ["Lint", "Suite"],
  )
  const later = failing(
    producer(
      run(25, "push") + {run_attempt: 2, conclusion: "failure"},
      {lint: {digest: DIGEST}, suite: {digest: DIGEST}},
      ["Lint", "Suite"],
    ),
    ["Lint", "Suite"],
  )
  const complete = source([earlier, later], fn(_endpoint) { return nil })
  const changing: ProofSource = {
    json: fn(endpoint) {
      if endpoint.contains("per_page=100&created=") {
        return complete.json(endpoint)
      }
      if endpoint.contains("event=push&head_sha=" + COMMIT) {
        return {total_count: 1, workflow_runs: [earlier.run]}
      }
      if endpoint.contains("event=push&branch=main") {
        return {total_count: 1, workflow_runs: [later.run]}
      }
      return complete.json(endpoint)
    },
    registration: complete.registration,
  }
  const result = discover(
    changing,
    current() + {event: "workflow_dispatch"},
    wanted(),
    nil,
    checkpoint_now,
    CHECKPOINT,
    UNIVERSE,
  )
  assert_eq(result.blocked, ["lint", "suite"])
  assert_eq(result.admitted, [])
}

pipeline test_later_failed_checkpoint_is_negative_evidence_but_never_positive_proof() {
  const good = producer(
    run(20, "merge_group"),
    {lint: {digest: DIGEST}, suite: {digest: DIGEST}},
    ["Lint", "Suite"],
  )
  const bad = failing(
    producer(
      run(25, "workflow_dispatch"),
      {lint: {digest: DIGEST}, suite: {digest: DIGEST}},
      ["Lint", "Suite"],
    ),
    ["Lint"],
  )
  const observed = discover(
    source([good, bad], fn(_endpoint) { return nil }),
    current() + {event: "workflow_dispatch"},
    wanted(),
    nil,
    checkpoint_now,
    CHECKPOINT,
    UNIVERSE,
  )
  assert_eq(observed.blocked, ["lint"])
  assert_eq(observed.admitted.map({ proof -> [proof.id, proof.provenance.runId] }), [["suite", 20]])
  const only_dispatch = discover(
    source(
      [producer(run(25, "workflow_dispatch"), {lint: {digest: DIGEST}}, ["Lint"])],
      fn(_endpoint) { return nil },
    ),
    current() + {event: "workflow_dispatch"},
    wanted(),
    nil,
    checkpoint_now,
    CHECKPOINT,
    UNIVERSE,
  )
  assert_eq(only_dispatch.admitted, [])
}

pipeline test_lower_run_id_later_failed_rerun_revokes_direct_and_deferred_proof() {
  const good = producer(
    run(20, "push"),
    {lint: {digest: DIGEST}, suite: {digest: DIGEST}},
    ["Lint", "Suite"],
  )
  const earlier = producer(
    run(10, "push"),
    {lint: {digest: DIGEST}, suite: {digest: DIGEST}},
    ["Lint", "Suite"],
  )
  const bad = failing(
    producer(
      run(10, "push") + {run_attempt: 2},
      {lint: {digest: DIGEST}, suite: {digest: DIGEST}},
      ["Lint", "Suite"],
    ),
    ["Lint"],
  )
  const observed = discover(
    source([good, earlier, bad], fn(_endpoint) { return nil }),
    current() + {event: "workflow_dispatch"},
    wanted(),
    nil,
    checkpoint_now,
    CHECKPOINT,
    UNIVERSE,
  )
  assert_eq(observed.blocked, ["lint"])
  assert_eq(observed.admitted.map({ proof -> proof.id }), ["suite"])
  const pointer = producer(
    run(20, "merge_group"),
    {lint: {digest: DIGEST, provenance: {runId: 7, attempt: 1}}},
    [],
  )
  const original = producer(run(7, "push"), {lint: {digest: DIGEST}}, ["Lint"])
  const deferred = discover(
    source([pointer, original, earlier, bad], fn(_endpoint) { return nil }),
    current() + {event: "workflow_dispatch"},
    [wanted()[0]],
    nil,
    checkpoint_now,
    CHECKPOINT,
    UNIVERSE,
  )
  assert_eq(deferred.admitted, [])
  assert_eq(deferred.blocked, ["lint"])
}

pipeline test_current_checkpoint_previous_failed_attempt_cannot_reuse_old_success() {
  const good = producer(
    run(20, "merge_group"),
    {lint: {digest: DIGEST}, suite: {digest: DIGEST}},
    ["Lint", "Suite"],
  )
  const bad = failing(
    producer(
      run(30, "workflow_dispatch"),
      {lint: {digest: DIGEST}, suite: {digest: DIGEST}},
      ["Lint", "Suite"],
    ),
    ["Lint"],
  )
  const active = producer(
    run(30, "workflow_dispatch") + {run_attempt: 2, status: "in_progress", conclusion: nil},
    {},
    [],
  )
  const observed = discover(
    source([good, bad, active], fn(_endpoint) { return nil }),
    current() + {event: "workflow_dispatch", attempt: 2},
    wanted(),
    nil,
    checkpoint_now,
    CHECKPOINT,
    UNIVERSE,
  )
  assert_eq(observed.blocked, ["lint"])
  assert_eq(observed.admitted.map({ proof -> proof.id }), ["suite"])
}

pipeline test_unrelated_job_failure_and_changed_input_do_not_discard_passing_job() {
  const good = producer(
    run(20, "merge_group"),
    {lint: {digest: DIGEST}, suite: {digest: DIGEST}},
    ["Lint", "Suite"],
  )
  const mixed = failing(
    producer(run(25, "push"), {lint: {digest: DIGEST}, suite: {digest: DIGEST}}, ["Lint", "Suite"]),
    ["Suite"],
  )
  const observed = discover(
    source([good, mixed], fn(_endpoint) { return nil }),
    current() + {event: "workflow_dispatch"},
    wanted(),
    nil,
    checkpoint_now,
    CHECKPOINT,
    UNIVERSE,
  )
  assert_eq(observed.blocked, ["suite"])
  assert_eq(observed.admitted.map({ proof -> proof.id }), ["lint"])
  const changed = failing(
    producer(run(25, "push"), {lint: {digest: "b".repeat(64)}}, ["Lint"]),
    ["Lint"],
  )
  const unchanged = discover(
    source([good, changed], fn(_endpoint) { return nil }),
    current() + {event: "workflow_dispatch"},
    [wanted()[0]],
    nil,
    checkpoint_now,
    CHECKPOINT,
    UNIVERSE,
  )
  assert_eq(unchanged.blocked, [])
  assert_eq(unchanged.admitted.map({ proof -> proof.id }), ["lint"])
}

pipeline test_one_failed_matrix_leg_blocks_that_logical_job() {
  const matrix = {id: "suite", names: ["^Suite \\([a-z]+\\)$"], digest: DIGEST}
  const decorate = fn(item) { return item
    + {
      registration: item.registration
        + {
          jobs: item.registration.jobs.map(
            { claim -> claim.id == "suite" ? claim + {names: matrix.names} : claim },
          )
            .to_list(),
        },
    } }
  const good = decorate(
    producer(run(20, "merge_group"), {suite: {digest: DIGEST}}, ["Suite (a)", "Suite (long)"]),
  )
  const bad = failing(
    decorate(producer(run(25, "push"), {suite: {digest: DIGEST}}, ["Suite (a)", "Suite (long)"])),
    ["Suite (long)"],
  )
  const result = discover(
    source([good, bad], fn(_endpoint) { return nil }),
    current() + {event: "workflow_dispatch"},
    [matrix],
    nil,
    checkpoint_now,
    CHECKPOINT,
    UNIVERSE,
  )
  assert_eq(result.blocked, ["suite"])
  assert_eq(result.admitted, [])
}

pipeline test_advancing_floor_with_same_generation_cannot_retain_old_matching_positive() {
  const original_wanted = universe_identities([wanted()[0]], UNIVERSE)
  const advanced = UNIVERSE + {notBefore: "2026-10-09T10:30:00Z"}
  const next_wanted = universe_identities([wanted()[0]], advanced)
  const good = producer(
    run(20, "merge_group"),
    {lint: {digest: original_wanted[0].digest}},
    ["Lint"],
  )
  const bad = failing(
    producer(run(25, "workflow_dispatch"), {lint: {digest: original_wanted[0].digest}}, ["Lint"]),
    ["Lint"],
  )
  const complete = source([good, bad], fn(_endpoint) { return nil })
  const original = discover(
    complete,
    current() + {event: "workflow_dispatch"},
    original_wanted,
    nil,
    checkpoint_now,
    CHECKPOINT,
    UNIVERSE,
  )
  assert_eq(original.blocked, ["lint"])
  let excluded_reads = 0
  const excluded: ProofSource = {
    json: fn(endpoint) {
      if endpoint.contains("per_page=100&created=") {
        excluded_reads = excluded_reads + 1
        return {total_count: 0, workflow_runs: []}
      }
      return complete.json(endpoint)
    },
    registration: complete.registration,
  }
  const next = discover(
    excluded,
    current() + {event: "workflow_dispatch"},
    next_wanted,
    nil,
    checkpoint_now,
    CHECKPOINT,
    advanced,
  )
  assert_eq(next.admitted, [])
  assert_eq(next.reason, "no_qualified_registration")
  assert_eq(excluded_reads, 0)
}

pipeline test_incomplete_negative_inventory_cannot_return_provisional_success() {
  const good = producer(run(20, "merge_group"), {lint: {digest: DIGEST}}, ["Lint"])
  const complete = source([good], fn(_endpoint) { return nil })
  const partial: ProofSource = {
    json: fn(endpoint) {
      if endpoint.contains("per_page=100&created=") {
        return {total_count: 1, workflow_runs: []}
      }
      return complete.json(endpoint)
    },
    registration: complete.registration,
  }
  const result = discover(
    partial,
    current() + {event: "workflow_dispatch"},
    [wanted()[0]],
    nil,
    checkpoint_now,
    CHECKPOINT,
    UNIVERSE,
  )
  assert_eq(result.admitted, [])
  assert_eq(result.reason, "negative_history_unmeasured")
  assert_eq(result.negative_runs, nil)
}

pipeline test_a_reused_job_is_proven_at_the_run_that_executed_it() {
  let calls: list<string> = []
  const producers = [
    // The merge group at this commit ran lint; it reused suite from run 7.
    producer(
      run(20, "merge_group"),
      {lint: {digest: DIGEST}, suite: {digest: DIGEST, provenance: {runId: 7, attempt: 1}}},
      ["Lint"],
    ),
    producer(run(25, "push"), {}, ["Lint", "Suite"]),
    producer(run(7, "push"), {suite: {digest: DIGEST}}, ["Suite"]),
  ]
  const result = discover(
    source(producers, fn(endpoint) { calls = calls + [endpoint] }),
    current(),
    wanted(),
    nil,
    fn() { return 0 },
  )
  assert_eq(result.reason, "qualified")
  assert_eq(
    result.admitted.map({ admission -> [admission.id, admission.provenance.runId] }),
    [["lint", 20], ["suite", 7]],
  )
  // Run 25 recorded different digests, so it proves nothing even though both jobs passed there.
  assert_eq(result.probed, 3)
  assert(result.reads <= 40)
}

pipeline test_a_pointer_to_a_run_that_did_not_execute_the_job_proves_nothing() {
  const producers = [
    producer(
      run(20, "merge_group"),
      {suite: {digest: DIGEST, provenance: {runId: 7, attempt: 1}}},
      [],
    ),
    producer(run(25, "push"), {}, []),
    // Run 7 claims the digest but its job never ran.
    producer(run(7, "push"), {suite: {digest: DIGEST}}, []),
  ]
  const result = discover(
    source(producers, fn(_endpoint) { return nil }),
    current(),
    wanted(),
    nil,
    fn() { return 0 },
  )
  assert_eq(result.admitted, [])
  assert_eq(result.reason, "no_qualified_registration")
}

pipeline test_history_failure_is_not_a_measured_zero() {
  const source: ProofSource = {
    json: fn(_endpoint) {
      throw "fixture HTTP failure"
    },
    registration: fn(_repo, _artifact) {
      throw "unexpected archive read"
    },
  }
  const result = discover(source, current(), wanted(), nil, fn() { return 0 })
  assert_eq(result.reason, "history_unmeasured")
  assert_eq(result.admitted, [])
}

pipeline test_discovery_stops_at_its_deadline() {
  let ticks = 0
  const producers = [producer(run(20, "merge_group"), {}, []), producer(run(25, "push"), {}, [])]
  const result = discover(
    source(producers, fn(_endpoint) { return nil }),
    current(),
    wanted(),
    nil,
    fn() {
      ticks = ticks + 1
      return ticks * 20000
    },
  )
  assert_eq(result.reason, "discovery_budget_exhausted")
  assert_eq(result.admitted, [])
}

pipeline test_two_attempts_of_one_run_are_two_producers() {
  const rerun = run(7, "push") + {run_attempt: 2}
  const producers = [
    // The merge group reused lint from run 7's first attempt and suite from its rerun.
    producer(
      run(20, "merge_group"),
      {
        lint: {digest: DIGEST, provenance: {runId: 7, attempt: 1}},
        suite: {digest: DIGEST, provenance: {runId: 7, attempt: 2}},
      },
      [],
    ),
    producer(run(25, "push"), {}, []),
    producer(run(7, "push"), {lint: {digest: DIGEST}}, ["Lint"]),
    producer(rerun, {suite: {digest: DIGEST}}, ["Suite"]),
  ]
  const result = discover(
    source(producers, fn(_endpoint) { return nil }),
    current(),
    wanted(),
    nil,
    fn() { return 0 },
  )
  assert_eq(
    result.admitted.map({ admission -> [admission.id, admission.provenance] }),
    [["lint", {runId: 7, attempt: 1}], ["suite", {runId: 7, attempt: 2}]],
  )
}
