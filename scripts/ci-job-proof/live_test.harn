import { read_yaml } from "std/fs"
import { assert_error_contains } from "std/testing"
import { RunContext } from "./contract.harn"
import { authenticate_run, checkpoint_enrollment, registration_from_archive } from "./live.harn"
import { ProofSource } from "./reader.harn"

fn checkpoint_enrolled(
  source: ProofSource,
  current: RunContext,
  tested: {commit: string, tree: string},
  raw: string,
) -> bool {
  return checkpoint_enrollment(source, current, tested, raw) != nil
}

pipeline test_registrar_refuses_old_run_even_when_rerun_uses_new_generation_source() {
  const context: RunContext = {
    repository: "acme/product",
    workflow: "ci.yml",
    event: "push",
    commit: "a".repeat(40),
    runId: 30,
    attempt: 2,
    registrarJob: "Changes",
    registrarStep: "Register",
  }
  const run = {
    id: 30,
    run_attempt: 2,
    head_sha: context.commit,
    event: "push",
    path: ".github/workflows/ci.yml",
    status: "in_progress",
    conclusion: nil,
    repository: {full_name: context.repository},
    head_repository: {full_name: context.repository},
    created_at: "2026-10-08T23:59:59Z",
  }
  const source = fn(value) -> ProofSource { return {
    json: fn(endpoint) { return endpoint.contains("/attempts/") ? value
      + {created_at: "2026-10-09T01:00:00Z"} : value },
    registration: fn(_repo, _artifact) {
      throw "no artifact before admission"
    },
  } }
  const universe = {generation: "fixture-v1", notBefore: "2026-10-09T00:00:00Z"}
  assert_error_contains(
    fn() { authenticate_run(source(run), context, universe) },
    "predates the proof generation",
  )
  assert_eq(
    authenticate_run(source(run + {created_at: "2026-10-09T00:00:00Z"}), context, universe),
    context,
  )
  assert_eq(authenticate_run(source(run), context), context)
}

pipeline test_checkpoint_enrollment_authenticates_actual_run_checkout_and_main_ancestry() {
  const commit = "a".repeat(40)
  const context: RunContext = {
    repository: "acme/product",
    workflow: "ci.yml",
    event: "workflow_dispatch",
    commit: commit,
    runId: 30,
    attempt: 1,
    registrarJob: "Changes",
    registrarStep: "Register",
  }
  const tested = {commit: commit, tree: "b".repeat(40)}
  const expected = {actorId: 42, actorLogin: "release[bot]", headBranch: "main"}
  const run = {
    ...context,
    id: 30,
    run_attempt: 1,
    head_sha: commit,
    path: ".github/workflows/ci.yml",
    status: "in_progress",
    conclusion: nil,
    head_branch: "main",
    actor: {id: 42, login: "release[bot]"},
    repository: {full_name: "acme/product"},
    head_repository: {full_name: "acme/product"},
  }
  const source = fn(actual, relation) -> ProofSource { return {
    json: fn(endpoint) { return endpoint.contains("/compare/") ? {status: relation} : actual },
    registration: fn(_repo, _artifact) {
      throw "enrollment reads no producer artifact"
    },
  } }
  assert(checkpoint_enrolled(source(run, "identical"), context, tested, json_stringify(expected)))
  assert(checkpoint_enrolled(source(run, "ahead"), context, tested, json_stringify(expected)))
  for altered in [
    run + {actor: {id: 43, login: "release[bot]"}},
    run + {actor: {id: 42, login: "someone"}},
    run + {head_branch: "another"},
    run + {head_sha: "c".repeat(40)},
    run + {run_attempt: 2},
    run + {event: "push"},
    run + {path: ".github/workflows/other.yml"},
    run + {head_repository: {full_name: "foreign/product"}},
  ] {
    assert(
      !checkpoint_enrolled(source(altered, "ahead"), context, tested, json_stringify(expected)),
    )
  }
  for relation in ["behind", "diverged"] {
    assert(!checkpoint_enrolled(source(run, relation), context, tested, json_stringify(expected)))
  }
  assert(
    !checkpoint_enrolled(
      source(run, "ahead"),
      context,
      tested + {commit: "c".repeat(40)},
      json_stringify(expected),
    ),
  )
  const forbidden: ProofSource = {
    json: fn(_endpoint) {
      throw "unenrolled event must not read history"
    },
    registration: fn(_repo, _artifact) {
      throw "unenrolled event must not read artifacts"
    },
  }
  assert(!checkpoint_enrolled(forbidden, context, tested, ""))
  assert(
    !checkpoint_enrolled(
      forbidden,
      context + {event: "schedule"},
      tested,
      json_stringify(expected),
    ),
  )
}

fn document() -> dict {
  return {
    schema: "burin.ci_job_proof_registration.v3",
    tested_source: {commit: "e".repeat(40), tree: "f".repeat(40)},
    repository: "acme/product",
    workflow: "ci.yml",
    event: "merge_group",
    commit: "a".repeat(40),
    runId: 10,
    attempt: 1,
    registrarJob: "Changes",
    registrarStep: "Register",
    jobs: [{id: "rust", names: ["Rust"], digest: "b".repeat(64), provenance: nil}],
  }
}

pipeline test_actual_archive_digest_and_closed_document_are_required(harness: Harness) {
  const directory = harness.fs.mkdtemp_in_workspace("exact-tree-archive-controls-")
  const path = directory + "/registration.zip"
  const archive = zip_create([{path: "registration.json", content: json_stringify(document())}])
  harness.fs.write_bytes(path, archive)
  const digest = "sha256:" + sha256(archive)
  assert_eq(registration_from_archive(harness.fs, path, digest), document())
  assert_error_contains(
    fn() { registration_from_archive(harness.fs, path, "sha256:" + "f".repeat(64)) },
    "digest mismatch",
  )
  const wrong = zip_create(
    [{path: "registration.json", content: json_stringify({...document(), extra: true})}],
  )
  harness.fs.write_bytes(path, wrong)
  assert(
    is_err(
      try {
        registration_from_archive(harness.fs, path, "sha256:" + sha256(wrong))
      },
    ),
  )
  for altered_document in [
    pick(document(), document().keys().filter({ name -> name != "tested_source" })),
    document() + {tested_source: document().tested_source + {extra: true}},
    document() + {jobs: [document().jobs[0] + {provenance: {runId: 9, attempt: 1, extra: true}}]},
  ] {
    const invalid = zip_create(
      [{path: "registration.json", content: json_stringify(altered_document)}],
    )
    harness.fs.write_bytes(path, invalid)
    assert(
      is_err(
        try {
          registration_from_archive(harness.fs, path, "sha256:" + sha256(invalid))
        },
      ),
    )
  }
  const unrelated = zip_create([{path: "other.json", content: "{}"}])
  harness.fs.write_bytes(path, unrelated)
  assert_error_contains(
    fn() { registration_from_archive(harness.fs, path, "sha256:" + sha256(unrelated)) },
    "exactly its named document",
  )
  const oversized = zip_create([{path: "registration.json", content: "x".repeat(1048577)}])
  assert(len(oversized) < 1048576)
  harness.fs.write_bytes(path, oversized)
  assert_error_contains(
    fn() { registration_from_archive(harness.fs, path, "sha256:" + sha256(oversized)) },
    "max_decompressed_bytes",
  )
  const two = zip_create(
    [
      {path: "registration.json", content: json_stringify(document())},
      {path: "registration.jsox", content: json_stringify(document())},
    ],
  )
  const duplicate = bytes_from_hex(
    replace(
      bytes_to_hex(two),
      bytes_to_hex(bytes_from_string("registration.jsox")),
      bytes_to_hex(bytes_from_string("registration.json")),
    ),
  )
  harness.fs.write_bytes(path, duplicate)
  assert_error_contains(
    fn() { registration_from_archive(harness.fs, path, "sha256:" + sha256(duplicate)) },
    "duplicate members",
  )
}

pipeline test_composite_projects_identities_and_persists_attempt_bound_receipts(harness: Harness) {
  const action = read_yaml(harness.fs, "../../.github/actions/ci-job-proof/action.yml", nil)
  const steps = action.runs.steps
  assert_eq(
    steps[0].uses,
    "burin-labs/harn/.github/actions/setup-harn@11681af676a5e4dc4200cfee683150cdec26763f",
  )
  assert_eq(steps[0]["with"].version, "0.10.159")
  assert_eq(steps[1].env.CI_JOB_PROOF_IDENTITIES, "$" + "{{ inputs.job-identities }}")
  assert_eq(steps[1].env.CI_JOB_PROOF_RUN_ID, "$" + "{{ github.run_id }}")
  assert_eq(steps[1].env.CI_JOB_PROOF_ATTEMPT, "$" + "{{ github.run_attempt }}")
  assert_eq(steps[1].run, "bash \"$GITHUB_ACTION_PATH/run.sh\"")
  for step in [steps[2], steps[3]] {
    assert_eq(step.uses, "actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a")
    assert_eq(step["with"]["if-no-files-found"], "error")
  }
  assert_eq(steps[2]["with"].name, "$" + "{{ steps.resolve.outputs.registration-name }}")
  assert_eq(
    steps[3]["with"].name,
    "ci-job-proof-" + "$" + "{{ github.run_id }}-" + "$" + "{{ github.run_attempt }}",
  )
  const bootstrap = harness.fs.read_text("../../.github/actions/ci-job-proof/run.sh")
  assert(bootstrap.contains("harn run"))
  assert(bootstrap.contains("--read-only-root \"$package_root\""))
  assert(bootstrap.contains("--write-root \"$workspace\""))
  assert(bootstrap.contains("GITHUB_OUTPUT=\"$staged_output\""))
  // Every variable the action sets reaches the sandboxed script.
  for name in steps[1].env.keys().filter({ name -> name.starts_with("CI_JOB_PROOF_") }) {
    assert(bootstrap.contains("env:" + name + ","), name)
  }
}
