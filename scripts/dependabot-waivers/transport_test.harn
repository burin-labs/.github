import { assert_error_contains } from "std/testing"
import { optional_response } from "../merge-override/github.harn"
import { decode_contents } from "./audit.harn"
import { alert, contents, document, waiver } from "./fixtures.harn"

pipeline test_nonempty_contents_reads_complete_json_before_base64(harness: Harness) {
  const response = optional_response(
    true,
    "HTTP/2.0 200 OK\r\nContent-Type: application/json\r\n\r\n"
      + json_stringify(contents(document())),
  )
  assert_eq(response.state, "present")
  assert_eq(decode_contents(response.value, "acme/project").waivers[0]?.alert_number, 2)
  // The retired --jq path emits this raw string, which is not JSON.
  assert_error_contains(fn() { json_parse(base64_encode(json_stringify(document()))) }, "")
}

pipeline test_only_structured_404_means_missing(harness: Harness) {
  assert_eq(
    optional_response(
      false,
      "HTTP/2.0 404 Not Found\n\n{\"message\":\"Not Found\",\"status\":\"404\"}",
    ).state,
    "missing",
  )
  for response in [
    "HTTP/2.0 403 Forbidden\n\n{\"message\":\"Not Found\",\"status\":\"403\"}",
    "HTTP/2.0 500 Internal Server Error\n\n{}",
    "network failure: Not Found",
    "Not Found\n\n{}",
    "HTTP/2.0 404 Not Found\n\n{}",
    "HTTP/2.0 404 Not Found\n\nnot JSON",
  ] {
    assert_error_contains(fn() { optional_response(false, response) }, "")
  }
  assert_error_contains(fn() { optional_response(true, "HTTP/2.0 404 Not Found\n\n{}") }, "failed")
  assert_error_contains(fn() { optional_response(false, "HTTP/2.0 200 OK\n\n{}") }, "failed")
}

pipeline test_malformed_contents_and_wrong_repository_fail_closed(harness: Harness) {
  for value in [
    {},
    contents(document()) + {encoding: "none"},
    contents(document()) + {type: "dir"},
    contents(document()) + {content: "%%%"},
    contents([]),
    contents(document() + {repository: "acme/other"}),
  ] {
    assert_error_contains(fn() { decode_contents(value, "acme/project") }, "")
  }
}

pipeline test_real_cli_transport_reads_pages_and_enforces_private_execution(harness: Harness) {
  const root = harness.fs.mkdtemp_in_workspace("waiver-cli-")
  const bin = path_join(root, "bin")
  harness.fs.mkdir(bin, true)
  const calls = path_join(root, "calls")
  const blob = path_join(root, "blob.json")
  const alerts = path_join(root, "alerts.json")
  const gh = path_join(bin, "gh")
  harness.fs.write_text(blob, json_stringify(contents(document([]))))
  harness.fs.write_text(alerts, json_stringify([[alert()]]))
  harness.fs.write_text(
    gh,
    "#!/bin/sh\n"
      + "fixture=\"$(dirname \"$0\")/..\"\nCALLS=\"$fixture/calls\"\nBLOB=\"$fixture/blob.json\"\nALERTS=\"$fixture/alerts.json\"\nSCENARIO=\"$(cat \"$fixture/scenario\")\"\n"
      + "printf '%s\\n' \"$*\" >> \"$CALLS\"\n"
      + "case \"$*\" in\n"
      + " 'api repos/acme/audit') case \"$SCENARIO\" in public) echo '{\"private\":false}';; missing-private) echo '{}';; *) echo '{\"private\":true}';; esac;;\n"
      + " 'api --paginate --slurp orgs/acme/repos?per_page=100&type=all') echo '[[{\"full_name\":\"acme/project\",\"archived\":false}],[{\"full_name\":\"acme/skipped\",\"archived\":false},{\"full_name\":\"acme/archive\",\"archived\":true}]]';;\n"
      + " 'api --include repos/acme/project/contents/.github/dependabot-waivers.json')\n"
      + " case \"$SCENARIO\" in denied) printf 'HTTP/2.0 403 Forbidden\\n\\n{\"message\":\"Not Found\",\"status\":\"403\"}'; exit 1;; network) echo 'network error Not Found' >&2; exit 1;; esac\n"
      + " printf 'HTTP/2.0 200 OK\\nContent-Type: application/json\\n\\n'; cat \"$BLOB\";;\n"
      + " 'api --include repos/acme/skipped/contents/.github/dependabot-waivers.json') printf 'HTTP/2.0 404 Not Found\\n\\n{\"message\":\"Not Found\",\"status\":\"404\"}'; exit 1;;\n"
      + " 'api --paginate --slurp repos/acme/project/dependabot/alerts?state=dismissed&per_page=100')\n"
      + " case \"$SCENARIO\" in unwaived|pending) cat \"$ALERTS\";; torn) echo '[] []';; *) echo '[[],[]]';; esac;;\n"
      + " *) echo 'unexpected gh request' >&2; exit 9;; esac\n",
  )
  assert(harness.process.run({program: "/bin/chmod", args: ["755", gh]}).success)
  const action = path_normalize(
    path_join(harness.fs.cwd(), "../../.github/actions/dependabot-waiver-audit"),
  )
  const runtime = harness.env.get("HARN_BIN") ?? "harn"
  for scenario in [
    "private",
    "public",
    "missing-private",
    "denied",
    "network",
    "unwaived",
    "torn",
    "pending",
  ] {
    harness.fs.write_text(calls, "")
    harness.fs.write_text(path_join(root, "scenario"), scenario)
    harness.fs.write_text(
      alerts,
      json_stringify(
        scenario == "unwaived" ? [[alert({number: 7})], [alert({number: 9})]] : [[alert()]],
      ),
    )
    harness.fs.write_text(
      blob,
      json_stringify(
        contents(document(scenario == "pending" ? [waiver({package: "mistyped/package"})] : [])),
      ),
    )
    const output_path = path_join(root, "outputs-${scenario}")
    const result = harness.process.run(
      {
        program: "/bin/bash",
        args: [path_join(action, "run.sh")],
        cwd: root,
        env: {
          PATH: bin + ":" + dirname(runtime) + ":" + (harness.env.get("PATH") ?? ""),
          HOME: root,
          GH_TOKEN: "fixture-token",
          GITHUB_REPOSITORY: "acme/audit",
          CALLS: calls,
          BLOB: blob,
          ALERTS: alerts,
          SCENARIO: scenario,
          GITHUB_ACTION_PATH: action,
          GITHUB_WORKSPACE: root,
          RUNNER_TEMP: root,
          DEPENDABOT_WAIVER_ORGANIZATION: "acme",
          DEPENDABOT_WAIVER_APPLY: "true",
          GITHUB_OUTPUT: output_path,
          GITHUB_STEP_SUMMARY: path_join(root, "summary-${scenario}"),
        },
        timeout_ms: 30000,
      },
    )
    assert_eq(result.exit_code, scenario == "private" ? 0 : 1, scenario + ": " + result.stderr)
    const requests = harness.fs.read_text(calls).split("\n").filter(fn(line) { return line != "" })
      .to_list()
    if ["public", "missing-private"].contains(scenario) {
      assert_eq(
        harness.fs.read_text(output_path),
        "",
        "public execution must not publish a private report",
      )
      assert_eq(
        requests,
        ["api repos/acme/audit"],
        "private execution must be checked before any alert or registry read",
      )
    }
    if scenario == "pending" {
      const report = json_parse(result.stdout)
      assert_eq(report.pending, 1)
      assert_eq(report.pending_names, ["acme/project#2"])
      assert_eq(report.ok, 0)
      assert_eq(report.reopened, 0)
      assert(to_string(report.results[0]?.detail).contains("waiver names go:mistyped/package"))
      assert_eq(report.failing_names, ["acme/project#2:pending"])
      const output = trim(harness.fs.read_text(output_path)).split("\n")
      assert_eq(len(output), 3)
      const header = output[0] ?? ""
      assert(header.starts_with("report<<"))
      assert_eq(output[2], header[8:len(header)])
      const report_path = output[1] ?? ""
      assert_eq(json_parse(harness.fs.read_text(report_path)), report)
      assert(harness.fs.read_text(path_join(root, "summary-${scenario}")).contains("pending"))
    }
    if ["private", "unwaived"].contains(scenario) {
      const report = json_parse(result.stdout)
      assert_eq(report.inventory.repositories, 2)
      assert_eq(report.inventory.registries, 1)
      assert_eq(report.inventory.skipped_repositories, ["acme/skipped"])
      assert_eq(report.inventory.dismissed_alerts, scenario == "unwaived" ? 2 : 0)
      assert_eq(report.unwaived, scenario == "unwaived" ? 2 : 0)
      assert_eq(report.pending, 0)
      if scenario == "unwaived" {
        assert_eq(report.failing_names, ["acme/project#7:unwaived", "acme/project#9:unwaived"])
      }
    }
  }
}
