import { assert_error_contains } from "std/testing"
import { Source, audit, decode_alerts } from "./audit.harn"
import { alert, blocked, contents, document, waiver } from "./fixtures.harn"

pipeline test_partial_live_alerts_fail_before_registry_probes_or_mutation(harness: Harness) {
  const good = alert()
  const no_patch = good
    + {
      security_vulnerability: {
        package: {name: "example/package", ecosystem: "go"},
        first_patched_version: nil,
      },
    }
  assert_eq(decode_alerts([no_patch])[0]?.security_vulnerability?.first_patched_version, nil)
  for malformed in [
    {number: 2, state: "dismissed"},
    good + {security_advisory: {ghsa_id: "GHSA-test-test-test"}},
    good + {security_advisory: {severity: "high"}},
    good + {security_advisory: {ghsa_id: "GHSA-test-test-test", severity: "unknown"}},
    good + {security_advisory: {ghsa_id: nil, severity: "high"}},
    good + {security_advisory: {ghsa_id: "GHSA-", severity: "high"}},
    good + {security_vulnerability: {package: {name: "example/package", ecosystem: "go"}}},
    good
      + {
        security_vulnerability: {
          package: {name: "example/package", ecosystem: "go"},
          first_patched_version: {},
        },
      },
    good + {security_vulnerability: {package: {ecosystem: "go"}, first_patched_version: nil}},
    good
      + {
        security_vulnerability: {
          package: {name: "example/package", ecosystem: "go"},
          first_patched_version: "2",
        },
      },
    good
      + {security_vulnerability: {package: {name: "example/package"}, first_patched_version: nil}},
    good
      + {
        security_vulnerability: {
          package: {name: "example/package", ecosystem: 17},
          first_patched_version: nil,
        },
      },
    good
      + {
        security_vulnerability: {
          package: {name: "example/package", ecosystem: " "},
          first_patched_version: nil,
        },
      },
    good + {state: "unknown"},
  ] {
    let writes = 0
    let probes = 0
    const source: Source = {
      github: {
        read: fn(_) { return {private: true} },
        pages: fn(path) { return path.starts_with("orgs/") ? [
          [{full_name: "acme/project", archived: false}],
        ] : [[malformed]] },
        send: fn(_, _, _) {
          writes = writes + 1
          return {}
        },
        graphql: fn(_, _) {
          throw "not used"
        },
      },
      contents: fn(_) { return {state: "present", value: contents(document())} },
      fix_installable: fn(_, _, _) {
        probes = probes + 1
        return {state: "known", installable: false}
      },
      blocker_state: fn(_) {
        probes = probes + 1
        return {state: "pending", detail: "not used"}
      },
    }
    assert_error_contains(fn() { audit(source, "acme/audit", "acme", "2026-08-15", true) }, "")
    assert_eq(writes, 0)
    assert_eq(probes, 0)
  }
}

pipeline test_unknown_evidence_is_named_pending_without_reopening_or_certifying(harness: Harness) {
  for blocked_fix in [false, true] {
    for today in ["2026-08-15", "2026-11-16"] {
      let writes = 0
      const source: Source = {
        github: {
          read: fn(_) { return {private: true} },
          pages: fn(path) { return path.starts_with("orgs/") ? [
            [{full_name: "acme/project", archived: false}],
          ] : [[alert()]] },
          send: fn(_, _, _) {
            writes = writes + 1
            return {}
          },
          graphql: fn(_, _) {
            throw "not used"
          },
        },
        contents: fn(_) { return {
          state: "present",
          value: contents(document([blocked_fix ? blocked() : waiver()])),
        } },
        fix_installable: fn(_, _, _) { return blocked_fix ? {state: "known", installable: true} : {
          state: "pending",
          detail: "fix lookup timeout",
        } },
        blocker_state: fn(_) { return {state: "pending", detail: "blocker lookup timeout"} },
      }
      const report = audit(source, "acme/audit", "acme", today, true)
      assert_eq(writes, 0)
      assert_eq(report.pending, 1)
      assert_eq(report.pending_names, ["acme/project#2"])
      assert_eq(report.ok, 0)
      assert_eq(report.reopened, 0)
      assert_eq(report.results[0]?.verdict, today == "2026-08-15" ? "pending" : "overdue")
      assert_eq(
        report.failing_names,
        [today == "2026-08-15" ? "acme/project#2:pending" : "acme/project#2:overdue"],
      )
      assert(
        (report.results[0]?.detail ?? "").contains(
          blocked_fix ? "blocker lookup timeout" : "fix lookup timeout",
        ),
      )
    }
  }
}

pipeline test_identity_mismatch_preserves_expiry_without_probes_or_mutation() {
  for package in [
    {name: "wrong/package", ecosystem: "go"},
    {name: "example/package", ecosystem: "cargo"},
  ] {
    for changed_advisory in [false, true] {
      for today in ["2026-11-14", "2026-11-15", "2026-11-16"] {
        for apply in [false, true] {
          let probes = 0
          let writes = 0
          const live = alert(
            {
              security_advisory: {
                ghsa_id: changed_advisory ? "GHSA-othr-test-test" : "GHSA-test-test-test",
                severity: changed_advisory ? "critical" : "high",
              },
              security_vulnerability: {
                package: package,
                first_patched_version: {identifier: "2.0.0"},
              },
            },
          )
          const source: Source = {
            github: {
              read: fn(_) { return {private: true} },
              pages: fn(path) { return path.starts_with("orgs/") ? [
                [{full_name: "acme/project", archived: false}],
              ] : [[live]] },
              send: fn(_, _, _) {
                writes = writes + 1
                return {}
              },
              graphql: fn(_, _) {
                throw "not used"
              },
            },
            contents: fn(_) { return {state: "present", value: contents(document([blocked()]))} },
            fix_installable: fn(_, _, _) {
              probes = probes + 1
              return {state: "known", installable: true}
            },
            blocker_state: fn(_) {
              probes = probes + 1
              return {state: "known", value: {version: "2.0.0", requirement: "^2"}}
            },
          }
          const report = audit(source, "acme/audit", "acme", today, apply)
          const expired = today == "2026-11-16"
          const verdict = expired ? "overdue" : "pending"
          assert_eq(report.checked, 1)
          assert_eq([probes, writes, report.ok, report.reopened], [0, 0, 0, 0])
          assert_eq(report.overdue, expired ? 1 : 0)
          assert_eq(report.pending, 1)
          assert_eq(report.pending_names, ["acme/project#2"])
          assert_eq(report.failing_names, ["acme/project#2:${verdict}"])
          assert_eq(report.results[0]?.verdict, verdict)
          assert((report.results[0]?.detail ?? "").contains("waiver names go:example/package"))
          if expired {
            assert((report.results[0]?.detail ?? "").contains("review_by 2026-11-15 has passed"))
          }
        }
      }
    }
  }
}

pipeline test_audit_apply_reopens_only_changed_waivers_and_dry_run_never_writes(harness: Harness) {
  for apply in [false, true] {
    let writes: list = []
    let reads: list<string> = []
    const source: Source = {
      github: {
        read: fn(path) {
          reads.push(path)
          return {private: true}
        },
        pages: fn(path) {
          reads.push(path)
          if path == "orgs/acme/repos?per_page=100&type=all" {
            return [[{full_name: "acme/project", archived: false}]]
          }
          if path == "repos/acme/project/dependabot/alerts?state=dismissed&per_page=100" {
            return [[alert()], [alert({number: 7})]]
          }
          throw "unexpected read"
        },
        send: fn(method, path, body) {
          writes.push({method: method, path: path, body: body})
          return {}
        },
        graphql: fn(_, _) {
          throw "not used"
        },
      },
      contents: fn(path) {
        reads.push(path)
        return {state: "present", value: contents(document())}
      },
      fix_installable: fn(ecosystem, package, version) {
        assert_eq([ecosystem, package, version], ["go", "example/package", "2.0.0"])
        return {state: "known", installable: true}
      },
      blocker_state: fn(_) {
        throw "not used"
      },
    }
    const report = audit(source, "acme/audit", "acme", "2026-08-15", apply)
    assert_eq(reads[0], "repos/acme/audit")
    assert_eq(report.checked, 2)
    assert_eq(report.unwaived, 1)
    assert_eq(report.reopened, 1)
    assert_eq(report.results[1]?.reopened, apply)
    assert_eq(
      writes,
      apply ? [
        {method: "PATCH", path: "repos/acme/project/dependabot/alerts/2", body: {state: "open"}},
      ] : [],
    )
  }
}

pipeline test_missing_registry_skips_alerts_but_zero_inventory_is_not_success(harness: Harness) {
  for empty in [true, false] {
    let contents_reads = 0
    const source: Source = {
      github: {
        read: fn(_) { return {private: true} },
        pages: fn(path) {
          assert_eq(path, "orgs/acme/repos?per_page=100&type=all")
          return empty ? [[]] : [[{full_name: "acme/project", archived: false}]]
        },
        send: fn(_, _, _) {
          throw "must not mutate"
        },
        graphql: fn(_, _) {
          throw "not used"
        },
      },
      contents: fn(_) {
        contents_reads = contents_reads + 1
        return {state: "missing", value: nil}
      },
      fix_installable: fn(_, _, _) {
        throw "must not probe registries"
      },
      blocker_state: fn(_) {
        throw "must not probe blockers"
      },
    }
    if empty {
      assert_error_contains(
        fn() { audit(source, "acme/audit", "acme", "2026-08-15", false) },
        "zero active repositories",
      )
      assert_eq(contents_reads, 0)
    } else {
      const report = audit(source, "acme/audit", "acme", "2026-08-15", false)
      assert_eq(contents_reads, 1)
      assert_eq(report.checked, 0)
      assert_eq(report.inventory.repositories, 1)
      assert_eq(report.inventory.skipped_repositories, ["acme/project"])
    }
  }
}

pipeline test_public_missing_or_unreadable_execution_repository_never_reads_alerts(
  harness: Harness,
) {
  for metadata in [{private: false}, {}, nil, {private: "true"}] {
    const source: Source = {
      github: {
        read: fn(path) {
          assert_eq(path, "repos/acme/audit")
          return metadata
        },
        pages: fn(_) {
          throw "must not read inventory or alerts"
        },
        send: fn(_, _, _) {
          throw "must not mutate"
        },
        graphql: fn(_, _) {
          throw "not used"
        },
      },
      contents: fn(_) {
        throw "must not read waivers"
      },
      fix_installable: fn(_, _, _) {
        throw "must not probe registries"
      },
      blocker_state: fn(_) {
        throw "must not probe blockers"
      },
    }
    assert_error_contains(fn() { audit(source, "acme/audit", "acme", "2026-08-15", true) }, "")
  }
}
