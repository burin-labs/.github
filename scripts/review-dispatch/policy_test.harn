import { read_yaml } from "std/fs"
import { assert_error_contains } from "std/testing"
import { dispatch, resolve, resolve_target } from "./policy.harn"

const REPOSITORY = "burin-labs/.github"

const HEAD = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

const PULL = {
  number: 183,
  state: "open",
  draft: false,
  user: {type: "User", login: "burin-labs-agent"},
  base: {repo: {full_name: REPOSITORY}},
  head: {sha: HEAD, repo: {full_name: REPOSITORY}},
}

pipeline test_manual_target_defaults_to_the_caller_and_refuses_foreign_or_malformed_repositories() {
  assert_eq(
    resolve_target(REPOSITORY, ""),
    {repository: REPOSITORY, owner: "burin-labs", name: ".github", cross_repository: false},
  )
  assert_eq(
    resolve_target(REPOSITORY, "burin-labs/smart-ship-sandbox"),
    {
      repository: "burin-labs/smart-ship-sandbox",
      owner: "burin-labs",
      name: "smart-ship-sandbox",
      cross_repository: true,
    },
  )
  for requested in [
    "other-org/project",
    "burin-labs/..",
    "burin-labs/.",
    "burin-labs/project/extra",
    "https://github.com/burin-labs/project",
    "burin-labs/project\nowner=foreign",
  ] {
    assert_error_contains({ -> resolve_target(REPOSITORY, requested) }, "review target")
  }
  assert_error_contains({ -> resolve_target("", REPOSITORY) }, "review target")
}

pipeline test_trusted_live_head_dispatches_only_exact_review_inputs() {
  const request = resolve(REPOSITORY, 183, PULL)
  assert_eq(request, {repository: REPOSITORY, number: 183, head_sha: HEAD})
  let calls = []
  const github = {
    read: fn(_path) {
      throw "dispatch must not read with its write credential"
    },
    pages: fn(_path) { return [] },
    graphql: fn(_query, _vars) { return nil },
    send: fn(method, path, body) {
      calls = calls + [{method: method, path: path, body: body}]
      return nil
    },
  }
  if request == nil {
    throw "positive control was not reached"
  }
  dispatch(github, request)
  assert_eq(
    calls,
    [
      {
        method: "POST",
        path: "repos/burin-labs/burin-code/actions/workflows/burin-review.yml/dispatches",
        body: {ref: "main", inputs: {repository: REPOSITORY, pr: "183", head_sha: HEAD}},
      },
    ],
  )
}

pipeline test_fork_draft_bot_closed_and_unread_heads_never_become_requests() {
  for pull in [
    PULL + {head: {sha: HEAD, repo: {full_name: "example/fork"}}},
    PULL + {draft: true},
    PULL + {draft: nil},
    PULL + {state: "closed"},
    PULL + {user: {type: "Bot", login: "dependabot[bot]"}},
    PULL + {user: {type: "User", login: "pretend[bot]"}},
    PULL + {user: nil},
  ] {
    assert_eq(resolve(REPOSITORY, 183, pull), nil)
  }
  for pull in [
    nil,
    {},
    PULL + {number: 184},
    PULL + {base: nil},
    PULL + {head: {sha: "main", repo: {full_name: REPOSITORY}}},
  ] {
    assert_error_contains({ -> resolve(REPOSITORY, 183, pull) }, "review request")
  }
}

pipeline test_workflow_uses_trusted_base_and_mints_only_a_scoped_eligible_token(harness: Harness) {
  const workflow = read_yaml(harness.fs, "../../.github/workflows/review-dispatch.yml")
  assert_eq(workflow.permissions, {})
  assert_eq(
    workflow.on.pull_request_target.types,
    ["opened", "reopened", "ready_for_review", "synchronize", "labeled"],
  )
  assert_eq(workflow.on.workflow_dispatch.inputs["pull-request"].required, true)
  assert_eq(workflow.on.workflow_dispatch.inputs.repository.required, false)
  const job = workflow.jobs.dispatch
  assert_eq(job.permissions, {contents: "read", "pull-requests": "read"})
  assert_eq(
    job["if"],
    "github.ref == format('refs/heads/{0}', github.event.repository.default_branch) "
      + "&& (github.event.action != 'labeled' "
      + "|| (github.event.label.name == 'ship' && github.event.pull_request.state == 'open'))",
  )
  const steps = job.steps
  const checkout = steps[0]
  const expression_start = "$" + "{{ "
  assert_eq(
    checkout["with"].ref,
    expression_start + "github.event.pull_request.base.sha || github.sha }}",
  )
  assert_eq(checkout["with"]["persist-credentials"], false)
  const action = read_yaml(harness.fs, "../../.github/actions/review-dispatch/action.yml")
  assert_eq(steps[1]["uses"], "./.github/actions/review-dispatch")
  assert_eq(
    steps[1]["with"].repository,
    expression_start + "github.event_name == 'workflow_dispatch' && inputs.repository || '' }}",
  )
  const action_steps = action.runs.steps
  const target = action_steps.filter({ step -> step?.id == "target" }).to_list()[0]
  const read = action_steps.filter({ step -> step?.id == "target-read" }).to_list()[0]
  assert_eq(target.env.CALLER_REPOSITORY, expression_start + "github.repository }}")
  assert_eq(read["if"], "steps.target.outputs.cross_repository == 'true'")
  assert_eq(read["with"]["permission-pull-requests"], "read")
  assert_eq(read["with"]["permission-actions"], nil)
  assert_eq(read["with"].repositories, expression_start + "steps.target.outputs.name }}")
  assert_eq(read["with"].owner, expression_start + "steps.target.outputs.owner }}")
  assert(action_steps.index_of(target) < action_steps.index_of(read))
  const resolve_step = action_steps.filter({ step -> step?.id == "request" }).to_list()[0]
  assert_eq(
    resolve_step.env.GH_TOKEN,
    expression_start
      + "steps.target-read.outputs.token || (steps.target.outputs.cross_repository != 'true' && github.token || '') }}",
  )
  assert_eq(
    resolve_step.env.TARGET_REPOSITORY,
    expression_start + "steps.target.outputs.repository }}",
  )
  const mint = action_steps.filter({ step -> step?.id == "app" }).to_list()[0]
  assert_eq(mint["if"], "steps.request.outputs.eligible == 'true'")
  assert_eq(mint["with"].repositories, "burin-code")
  assert_eq(mint["with"]["permission-actions"], "write")
  const submit = action_steps[len(action_steps) - 1]
  assert_eq(submit["if"], mint["if"])
  assert_eq(submit.env.HEAD_SHA, expression_start + "steps.request.outputs.head_sha }}")
  assert_eq(submit.env.TARGET_REPOSITORY, expression_start + "steps.target.outputs.repository }}")
  assert(
    action_steps.index_of(mint)
      > action_steps.index_of(action_steps.filter({ step -> step?.id == "request" }).to_list()[0]),
  )
}
