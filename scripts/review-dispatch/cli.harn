import { live_github } from "../merge-override/github.harn"
import { Resolution, dispatch, ineligibility_code, resolve, resolve_target } from "./policy.harn"

fn required(env: HarnessEnv, name: string) -> string {
  const value = trim(env.get(name) ?? "")
  if value == "" {
    throw name + " is required"
  }
  return value
}

fn main(harness: Harness) {
  if argv == ["target"] {
    const target = resolve_target(
      required(harness.env, "CALLER_REPOSITORY"),
      harness.env.get("REQUESTED_REPOSITORY") ?? "",
    )
    harness.fs.append(
      required(harness.env, "GITHUB_OUTPUT"),
      "repository=" + target.repository + "\nowner=" + target.owner
        + "\nname="
        + target.name
        + "\ncross_repository="
        + to_string(target.cross_repository)
        + "\n",
    )
    harness.stdio.println(json_stringify(target))
    return
  }
  const repository = required(harness.env, "TARGET_REPOSITORY")
  const number_text = required(harness.env, "PR_NUMBER")
  if !regex_match("^[1-9][0-9]{0,8}$", number_text) {
    throw "invalid pull request number"
  }
  const number = to_int(number_text)
  const scratch = harness.fs.mkdtemp_in_workspace("review-dispatch-")
  const github = live_github(
    pick(harness, ["fs", "tools"]),
    required(harness.env, "GH_TOKEN"),
    scratch,
  )
  if argv == ["resolve"] {
    const resolution = resolve(
      repository,
      number,
      github.read("repos/" + repository + "/pulls/" + number_text),
    )
    const output = required(harness.env, "GITHUB_OUTPUT")
    match resolution {
      Resolution.Eligible(request) -> {
        harness.fs.append(output, "eligible=true\nhead_sha=" + request.head_sha + "\n")
        harness.stdio.println(json_stringify({eligible: true, request: request}))
      }
      Resolution.Ineligible(reason) -> {
        const code = ineligibility_code(reason)
        harness.fs.append(output, "eligible=false\nreason=" + code + "\n")
        harness.stdio.println(json_stringify({eligible: false, reason: code}))
      }
    }
  } else if argv == ["dispatch"] {
    const head = required(harness.env, "HEAD_SHA")
    if !regex_match("^[0-9a-f]{40}$", head) {
      throw "invalid head SHA"
    }
    const request = {repository: repository, number: number, head_sha: head}
    dispatch(github, request)
    harness.stdio.println(json_stringify({requested: request}))
  } else {
    throw "expected target, resolve, or dispatch"
  }
}
