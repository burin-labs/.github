pub type Reader = {api: fn(string) -> unknown}

/** Exhaust the REST list and hydrate each identity before trusting the census. */
pub fn snapshot(reader: Reader) -> dict {
  const repo = "repos/burin-labs/harn"
  let summaries = []
  let complete = false
  let page = 1
  while page <= 10 {
    const batch = reader.api(repo + "/rulesets?includes_parents=true&per_page=100&page=" + to_string(page))
    if type_of(batch) != "list" {
      throw "ruleset page is unread"
    }
    summaries = summaries + batch
    if len(batch) < 100 {
      complete = true
      break
    }
    page = page + 1
  }
  if !complete || len(summaries) == 0 {
    throw "ruleset census is empty or pagination did not finish"
  }
  let rulesets = []
  let ids = []
  for summary in summaries {
    if type_of(summary?.id) != "int" || summary.id <= 0 || ids.contains(summary.id) {
      throw "ruleset page has missing or duplicate identity"
    }
    const detail = reader.api(repo + "/rulesets/" + to_string(summary.id))
    if type_of(detail) != "dict" || detail?.id != summary.id || detail?.name != summary?.name
      || detail?.source != summary?.source || detail?.source_type != summary?.source_type {
      throw "ruleset changed or was unread while hydrating the census"
    }
    rulesets = rulesets + [detail]
    ids = ids + [summary.id]
  }
  return {rulesets: rulesets, effective_rules: reader.api(repo + "/rules/branches/main"),
    release_app: reader.api("apps/harn-release-bot")}
}
