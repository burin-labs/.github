import { GitHub, live_github } from "../merge-override/github.harn"
import {
  QUALIFIED_GUARD_LIMIT,
  QUALIFIED_GUARD_PATH,
  QUALIFIED_GUARD_SCHEMA,
  QUALIFIED_GUARD_SOURCE,
  QualifiedGuard,
  qualified_guards,
} from "./launch-profile.harn"

pub const QUALIFY_REPOSITORY = "burin-labs/.github"

pub const QUALIFY_BRANCH = "automation/qualify-gh-budget-guard"

const COMMIT_MUTATION = "mutation($input: CreateCommitOnBranchInput!) "
  + "{ createCommitOnBranch(input: $input) { commit { oid } } }"

/**
 * The record with `candidate` as the newest qualified version. The same bytes
 * keep their first qualifying revision, so a rerun changes nothing.
 */
pub fn qualify(raw: any, candidate: QualifiedGuard) -> dict {
  qualified_guards(
    {schema: QUALIFIED_GUARD_SCHEMA, source: QUALIFIED_GUARD_SOURCE, guards: [candidate]},
  )
  const guards: list<QualifiedGuard> = raw == nil ? [] : qualified_guards(raw)
  const same = { other ->
    other.gh_budget_py_sha256 == candidate.gh_budget_py_sha256
      && other.gh_sha256 == candidate.gh_sha256
  }
  if len(guards) > 0 && same(guards[0]) {
    return {schema: QUALIFIED_GUARD_SCHEMA, source: QUALIFIED_GUARD_SOURCE, guards: guards}
  }
  const newest = [candidate] + guards.filter({ other -> !same(other) })
  return {
    schema: QUALIFIED_GUARD_SCHEMA,
    source: QUALIFIED_GUARD_SOURCE,
    guards: newest.slice(0, min(len(newest), QUALIFIED_GUARD_LIMIT)),
  }
}

/**
 * Propose `text` as the record on one rolling branch cut from main, as a
 * GitHub-signed commit, and hand the pull request to Smart Ship.
 */
pub fn publish(github: GitHub, text: string, revision: string) -> dict {
  const repository = "repos/" + QUALIFY_REPOSITORY
  const base = to_string(github.read(repository + "/git/ref/heads/main")?.object?.sha ?? "")
  if regex_match("^[0-9a-f]{40}$", base) == nil {
    throw "main head of " + QUALIFY_REPOSITORY + " is unreadable"
  }
  const existing = try {
    github.read(repository + "/git/ref/heads/" + QUALIFY_BRANCH)
  } catch (e) {
    nil
  }
  if existing == nil {
    github.send("POST", repository + "/git/refs", {ref: "refs/heads/" + QUALIFY_BRANCH, sha: base})
  } else {
    github.send("PATCH", repository + "/git/refs/heads/" + QUALIFY_BRANCH, {sha: base, force: true})
  }
  const created = github.send(
    "POST",
    "graphql",
    {
      query: COMMIT_MUTATION,
      variables: {
        input: {
          branch: {repositoryNameWithOwner: QUALIFY_REPOSITORY, branchName: QUALIFY_BRANCH},
          message: {headline: "Qualify the GitHub budget guard from burin-code " + revision[0:12]},
          fileChanges: {additions: [{path: QUALIFIED_GUARD_PATH, contents: base64_encode(text)}]},
          expectedHeadOid: base,
        },
      },
    },
  )
  const commit = to_string(created?.data?.createCommitOnBranch?.commit?.oid ?? "")
  if regex_match("^[0-9a-f]{40}$", commit) == nil {
    throw "signed commit was not created: " + json_stringify(created?.errors ?? created)
  }
  const open = github.read(
    repository + "/pulls?state=open&base=main&head=burin-labs:" + QUALIFY_BRANCH,
  )
  let number = len(open ?? []) == 1 ? open[0]?.number : nil
  if number == nil {
    number = github.send(
      "POST",
      repository + "/pulls",
      {
        title: "[CI] Qualify the installed GitHub budget guard from burin-code main",
        head: QUALIFY_BRANCH,
        base: "main",
        body: "Generated by `qualify-gh-budget-guard.yml` from burin-code "
          + revision
          + ". The review-rule launcher accepts an installed GitHub budget wrapper only when "
          + "its bytes match a version in `"
          + QUALIFIED_GUARD_PATH
          + "`; this adds the wrapper now on burin-code main.",
      },
    )?.number
  }
  github.send("POST", repository + "/issues/" + to_string(number) + "/labels", {labels: ["ship"]})
  return {state: "published", commit: commit, pull_request: number}
}

/**
 * Usage: qualify-guard.harn -- <burin-code checkout> <revision> [--publish]
 * Run from this repository's root. The caller checked out `revision`, the
 * current head of burin-code main, inside this workspace.
 */
fn main(harness: Harness) {
  if len(argv) < 2 || len(argv) > 3 || (len(argv) == 3 && argv[2] != "--publish") {
    throw "usage: qualify-guard.harn -- <burin-code checkout> <revision> [--publish]"
  }
  const revision = argv[1]
  const wrapper = path_join(argv[0], "scripts/gh-budget")
  const record = QUALIFIED_GUARD_PATH
  const before = harness.fs.exists(record) ? harness.fs.read_text(record) : ""
  const updated = qualify(
    before == "" ? nil : json_parse(before),
    {
      revision: revision,
      gh_budget_py_sha256: sha256(harness.fs.read_bytes(path_join(wrapper, "gh_budget.py"))),
      gh_sha256: sha256(harness.fs.read_bytes(path_join(wrapper, "gh"))),
    },
  )
  const text = json_stringify_pretty(updated) + "\n"
  if before == text {
    harness.stdio.println(json_stringify({state: "unchanged", revision: revision}))
    return
  }
  harness.fs.write_text(record, text)
  if len(argv) == 2 {
    harness.stdio.println(json_stringify({state: "qualified", revision: revision}))
    return
  }
  const token = trim(harness.env.get("GH_TOKEN") ?? "")
  if token == "" {
    throw "GH_TOKEN is required to publish"
  }
  const github = live_github(
    pick(harness, ["fs", "tools"]),
    token,
    harness.fs.mkdtemp_in_workspace("qualify-guard-gh-"),
  )
  harness.stdio.println(json_stringify(publish(github, text, revision)))
}
