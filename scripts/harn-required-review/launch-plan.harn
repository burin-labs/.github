import {
  launch_profile,
  verify_control_source,
  verify_installed_guard,
} from "./launch-profile.harn"

fn main(harness: Harness) {
  if len(argv) != 1 {
    throw "trusted launch planner requires its fixed repository root"
  }
  const root = argv[0]
  const profile = launch_profile(
    root,
    to_string(harness.env.get("HOME") ?? ""),
    to_string(harness.env.get("REVIEW_RULESET_MODE") ?? ""),
  )
  verify_control_source(harness.fs, root)
  if profile.mode != "plan" {
    verify_installed_guard(harness.fs, profile.bundle_root)
  }
  for argument in profile.argv {
    harness.stdio.println(argument)
  }
}
