pub type LaunchProfile = {
  source_root: string,
  mode: string,
  bundle_root: string,
  ledger_root: string,
  command_path: string,
  argv: list<string>,
}

/**
 * Generated by `qualify-guard.harn` from burin-code main, never edited by hand:
 * the wrapper versions whose installed bytes may receive the process grants.
 */
pub const QUALIFIED_GUARD_PATH = "scripts/harn-required-review/qualified-guard.json"

pub const QUALIFIED_GUARD_SCHEMA = "burin-labs.gh-budget-qualified-guard.v1"

pub const QUALIFIED_GUARD_SOURCE = "burin-labs/burin-code"

/** A host reinstalls after its next deploy, so the previous versions stay valid. */
pub const QUALIFIED_GUARD_LIMIT = 3

pub type QualifiedGuard = {revision: string, gh_budget_py_sha256: string, gh_sha256: string}

/** Validate the generated record once; every consumer trusts the result. */
pub fn qualified_guards(raw: any) -> list<QualifiedGuard> {
  if type_of(raw) != "dict" || raw?.schema != QUALIFIED_GUARD_SCHEMA
    || raw?.source != QUALIFIED_GUARD_SOURCE
    || type_of(raw?.guards) != "list" {
    throw "qualified GitHub budget guard record has the wrong schema or source"
  }
  const guards = raw.guards
  if len(guards) == 0 || len(guards) > QUALIFIED_GUARD_LIMIT {
    throw "qualified GitHub budget guard record must name 1 to "
      + to_string(QUALIFIED_GUARD_LIMIT)
      + " versions"
  }
  let qualified: list<QualifiedGuard> = []
  for entry in guards {
    if type_of(entry) != "dict"
      || regex_match("^[0-9a-f]{40}$", to_string(entry?.revision ?? "")) == nil
      || regex_match("^[0-9a-f]{64}$", to_string(entry?.gh_budget_py_sha256 ?? "")) == nil
      || regex_match("^[0-9a-f]{64}$", to_string(entry?.gh_sha256 ?? "")) == nil
      || len(entry.keys()) != 3 {
      throw "qualified GitHub budget guard entry is malformed"
    }
    qualified = qualified
      + [
        {
          revision: entry.revision,
          gh_budget_py_sha256: entry.gh_budget_py_sha256,
          gh_sha256: entry.gh_sha256,
        },
      ]
  }
  return qualified
}

pub fn read_qualified_guards(fs: HarnessFs, root: string) -> list<QualifiedGuard> {
  const raw = try {
    json_parse(fs.read_text(path_join(root, QUALIFIED_GUARD_PATH)))
  } catch (e) {
    throw "qualified GitHub budget guard record is missing or unreadable"
  }
  return qualified_guards(raw)
}

/** Bootstrap reports directory identity; policy rejects redirected grants. */
pub fn verify_control_directories(profile: LaunchProfile, bundle: string, ledger: string) {
  if bundle != profile.bundle_root || ledger != profile.ledger_root {
    throw "trusted review-rule directories must exist at their canonical installed paths"
  }
}

pub fn require_qualified_guard(fs: HarnessFs, root: string) {
  read_qualified_guards(fs, root)
}

/** Both installed files must come from one qualified version, not a mix. */
pub fn verify_installed_guard(fs: HarnessFs, root: string, bundle: string) -> QualifiedGuard {
  const guards = read_qualified_guards(fs, root)
  const installed = sha256(fs.read_bytes(path_join(bundle, "gh_budget.py")))
  const entrypoint = sha256(fs.read_bytes(path_join(bundle, "gh")))
  for qualified in guards {
    if qualified.gh_budget_py_sha256 == installed && qualified.gh_sha256 == entrypoint {
      return qualified
    }
  }
  if !guards.any({ qualified -> qualified.gh_budget_py_sha256 == installed }) {
    throw "installed GitHub budget guard differs from every qualified source"
  }
  throw "installed GitHub budget entrypoint differs from the qualified source of its guard"
}

/** Only this deterministic control command receives these process grants. */
pub fn launch_profile(source_root: string, home: string, mode: string) -> LaunchProfile {
  if mode != "plan" && mode != "snapshot" && mode != "verify" {
    throw "REVIEW_RULESET_MODE must be plan, snapshot, or verify"
  }
  for path in [source_root, home] {
    if !path.starts_with("/") || path.contains("\n") || path.contains("\r") || path.contains(":") {
      throw "trusted launcher roots must be absolute paths without line or PATH delimiters"
    }
  }
  const bundle = path_join(home, ".local/share/gh-budget")
  const ledger = path_join(home, ".local/state/gh-budget")
  let args = ["run", "--standalone"]
  if mode != "plan" {
    args = args
      + ["--sandbox-read-root", bundle, "--sandbox-write-root", ledger, "--allow-process-network"]
  }
  return {
    source_root: source_root,
    mode: mode,
    bundle_root: bundle,
    ledger_root: ledger,
    command_path: bundle + ":/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin",
    argv: args + [path_join(source_root, "scripts/harn-required-review/cli.harn")],
  }
}

const CONTROL_SOURCES = {
  "scripts/harn-required-review/cli.harn":
    "0a53d3464684d2aa929ec731c8addbf1442f7e5581224a3fcad161b3cdeec28a",
  "scripts/harn-required-review/measure.harn":
    "20865341d64321daf27a73c4c04f51560e456b37fd11d6e173ab266f71e14931",
  "scripts/harn-required-review/policy.harn":
    "a34a7c5f935cd6ba5235b9a751fa71af10d0d1fc9ffda22b9bd3c9a429f04af7",
  "scripts/merge-override/github.harn":
    "02749d57ca9e80fef98555d1a37d8910d53547e476e052b98b8e63a041f6d5dc",
}

type VerifiedSource = {path: string, content: bytes}

fn control_bytes(fs: HarnessFs, root: string) -> list<VerifiedSource> {
  let verified: list<VerifiedSource> = []
  for source in CONTROL_SOURCES.entries() {
    const content = fs.read_bytes(path_join(root, source.key))
    if sha256(content) != source.value {
      throw "trusted review-rule source seal mismatch: " + source.key
    }
    verified = verified + [{path: source.key, content: content}]
  }
  return verified
}

/** A source change needs a reviewed seal update before privileged dispatch. */
pub fn verify_control_source(fs: HarnessFs, root: string) {
  control_bytes(fs, root)
}

/** Dispatch the measured bytes, without reopening the mutable checkout. */
pub fn snapshot_control_source(fs: HarnessFs, root: string) -> string {
  const verified = control_bytes(fs, root)
  const snapshot = fs.mkdtemp_in_workspace("review-control-source-")
  for source in verified {
    const target = path_join(snapshot, source.path)
    fs.mkdir(dirname(target), true)
    fs.write_bytes(target, source.content)
  }
  return snapshot
}
