import { desired_ruleset, verify_installed, verify_transition } from "./policy.harn"

fn existing() -> dict {
  return {
    id: 2,
    name: "merge queue",
    source: "burin-labs/harn",
    source_type: "Repository",
    target: "branch",
    enforcement: "active",
    conditions: {ref_name: {include: ["~DEFAULT_BRANCH"], exclude: []}},
    bypass_actors: [],
    rules: [{type: "merge_queue", parameters: {max_entries_to_build: 5}}],
  }
}

fn installed() -> dict {
  return desired_ruleset() + {id: 3, source: "burin-labs/harn", source_type: "Repository"}
}

fn effective() -> list {
  return [
    {type: "required_signatures"},
    {type: "required_linear_history"},
    {type: "deletion"},
    {type: "non_fast_forward"},
    {type: "merge_queue"},
    {
      type: "required_status_checks",
      parameters: {required_status_checks: [{context: "CI status"}, {context: "drift"}]},
    },
    {type: "pull_request", parameters: {required_approving_review_count: 1}},
  ]
}

fn refused(action: fn() -> any) {
  let caught = false
  try {
    action()
  } catch (error) {
    caught = true
  }
  assert(caught, "the negative control must refuse")
}

pipeline test_installed_rule_and_preserved_queue_are_measured(harness: Harness) {
  const after = [existing(), installed()]
  verify_transition([existing()], after)
  assert_eq(
    verify_installed(after, effective(), {id: 3472013, slug: "harn-release-bot"}),
    {ruleset_id: 3, measured_rulesets: 2, measured_effective_rules: 7, pending: 0, failing: []},
  )
}

pipeline test_plan_keeps_review_required_for_every_actor(harness: Harness) {
  const plan = desired_ruleset()
  assert_eq(plan.name, "Main review approval required")
  assert_eq(plan.bypass_actors, [])
  assert_eq(plan.conditions.ref_name.include, ["refs/heads/main"])
}

pipeline test_admin_and_all_app_bypasses_are_refused(harness: Harness) {
  for bypass in [
    [{actor_type: "OrganizationAdmin", actor_id: nil, bypass_mode: "pull_request"}],
    [{actor_type: "Integration", actor_id: 1236702, bypass_mode: "always"}],
    [{actor_type: "Integration", actor_id: 3472013, bypass_mode: "always"}],
  ] {
    refused(
      fn() { verify_installed(
        [existing(), installed() + {bypass_actors: bypass}],
        effective(),
        {id: 3472013, slug: "harn-release-bot"},
      ) },
    )
  }
}

pipeline test_legacy_rule_cannot_live_beside_the_current_owner(harness: Harness) {
  const legacy = installed() + {id: 4, name: "review required (harn)"}
  refused(
    fn() { verify_installed(
      [existing(), legacy, installed()],
      effective(),
      {id: 3472013, slug: "harn-release-bot"},
    ) },
  )
}

pipeline test_named_required_checks_cannot_be_replaced_by_an_empty_category(harness: Harness) {
  const withoutChecks = effective().filter({ rule -> rule.type != "required_status_checks" })
    .to_list()
  for checkRule in [
    {type: "required_status_checks"},
    {type: "required_status_checks", parameters: {required_status_checks: []}},
    {
      type: "required_status_checks",
      parameters: {required_status_checks: [{context: "CI status"}]},
    },
    {type: "required_status_checks", parameters: {required_status_checks: [{context: "drift"}]}},
    {type: "required_status_checks", parameters: {required_status_checks: [{context: nil}]}},
  ] {
    refused(
      fn() { verify_installed(
        [existing(), installed()],
        withoutChecks + [checkRule],
        {id: 3472013, slug: "harn-release-bot"},
      ) },
    )
  }
}

pipeline test_missing_or_weakened_review_and_scope_refuse(harness: Harness) {
  for change in [
    {enforcement: "evaluate"},
    {target: "tag"},
    {conditions: {ref_name: {include: ["refs/heads/*"], exclude: []}}},
    {rules: [{type: "pull_request", parameters: {required_approving_review_count: 0}}]},
    {source_type: "Organization", source: "burin-labs"},
  ] {
    refused(
      fn() { verify_installed(
        [existing(), installed() + change],
        effective(),
        {id: 3472013, slug: "harn-release-bot"},
      ) },
    )
  }
  refused(
    fn() { verify_installed([existing()], effective(), {id: 3472013, slug: "harn-release-bot"}) },
  )
}

pipeline test_empty_partial_duplicate_and_wrong_app_reads_refuse(harness: Harness) {
  for census in [[], [nil], [existing() + {rules: nil}], [existing(), existing(), installed()]] {
    refused(fn() { verify_installed(census, effective(), {id: 3472013, slug: "harn-release-bot"}) })
  }
  refused(
    fn() { verify_installed([existing(), installed()], [], {id: 3472013, slug: "harn-release-bot"}) },
  )
  refused(
    fn() { verify_installed([existing(), installed()], effective(), {id: 3472013, slug: "different"}) },
  )
  refused(
    fn() { verify_installed(
      [existing(), installed()],
      [{type: "pull_request", parameters: {required_approving_review_count: 1}}],
      {id: 3472013, slug: "harn-release-bot"},
    ) },
  )
}

pipeline test_unrelated_protection_and_bypass_changes_refuse(harness: Harness) {
  for change in [
    {rules: [{type: "merge_queue", parameters: {max_entries_to_build: 3}}]},
    {bypass_actors: [{actor_type: "OrganizationAdmin", actor_id: nil, bypass_mode: "always"}]},
    {enforcement: "disabled"},
  ] {
    refused(fn() { verify_transition([existing()], [existing() + change, installed()]) })
  }
  refused(fn() { verify_transition([existing()], [installed()]) })
}
