  const root = harness.fs.mkdtemp_in_workspace("heavy-control-")
  const plan = plan_checks(
    """jobs:
  probe:
    steps:
      - name: Heavy check
        run: exit 0
""",
    parse_policy(
      """{
    "version": 1,
    "jobs": {"probe": {"disposition": {"kind": "check", "heavy": true}}},
    "actions": {},
    "environment": {}
  }""",
    ),
  )
  const result = run_checks(
    harness,
    plan,
    {root: root, platform: "macos", build_wrapper: [], group: nil},
  )
  assert_eq(result.pending, 1)
  assert_eq(result.results[0]?.reason, "heavy check requires a build wrapper")
  assert(!result.ok)
}

pipeline test_unresolved_workflow_timeout_is_named_and_unmeasured(harness: Harness) {
  const root = harness.fs.mkdtemp_in_workspace("timeout-control-")
  const expression = "$" + "{{ vars.USE_FAST && 10 || 20 }}"
  const plan = plan_checks(
    "jobs:\n  probe:\n    timeout-minutes: \"" + expression
      + "\"\n    steps:\n      - name: Timed check\n        run: exit 0\n",
    parse_policy(
      """{
    "version": 1, "jobs": {"probe": {}}, "actions": {}, "environment": {}
  }""",
    ),
  )
  const result = run_checks(
    harness,
    plan,
    {root: root, platform: "macos", build_wrapper: [], group: nil},
  )
  assert_eq(result.pending, 1)
  assert_eq(result.results[0]?.reason, "unresolved workflow timeout: " + expression)
  assert(!result.ok)
}

pipeline test_group_runs_a_strict_subset_without_skipping_the_census(harness: Harness) {
  const root = harness.fs.mkdtemp_in_workspace("group-control-")
  const plan = plan_checks(
    """jobs:
  probe:
    steps:
      - name: Fast check
        run: exit 0
      - name: Full check
        run: exit 19
""",
    parse_policy(
      """{
    "version": 1,
    "jobs": {"probe": {"steps": {
      "Fast check": {"kind": "check", "groups": ["precommit"]}
    }}},
    "actions": {},
    "environment": {}
  }""",
    ),
  )
  const result = run_checks(
    harness,
    plan,
    {root: root, platform: "macos", build_wrapper: [], group: "precommit"},
  )
  assert_eq(result.passed, 1)
  assert_eq(result.failed, 0)
  assert_eq(result.results.map(fn(row) { row.name }), ["probe / Fast check"])
  assert(result.ok)
  const empty = run_checks(
    harness,
    plan,
    {root: root, platform: "macos", build_wrapper: [], group: "unknown"},
  )
  assert_eq(empty.results, [])
  assert(!empty.ok)
  const missing = run_checks(
    harness,
    {jobs: plan.jobs, checks: plan.checks, missing: ["new-job: missing job"]},
    {root: root, platform: "macos", build_wrapper: [], group: "precommit"},
  )
  assert_eq(missing.pending, 1)
  assert(!missing.ok)
}
