fn read(fs: HarnessFs, path: string) -> string {
  return fs.read_text(path_join(path_normalize(path_join(fs.cwd(), "../..")), path))
}

fn expression(body: string) -> string {
  return "$" + "{{ " + body + " }}"
}

fn promote(fs: HarnessFs) -> dict {
  return yaml_parse(read(fs, ".github/workflows/promote-release.yml"))
}

fn named_step(steps: list, name: string) -> dict {
  const matches = steps.filter({ step -> step.name == name }).to_list()
  assert_eq(len(matches), 1, name)
  return matches[0]!
}

pipeline test_promotion_is_callable_only_with_the_minimum_inputs(harness: Harness) {
  const workflow = promote(harness.fs)
  assert_eq(keys(workflow.on), ["workflow_call"])
  const call = workflow.on.workflow_call
  assert_eq(
    keys(call.inputs).sorted(),
    [
      "consumer-repair",
      "inspect-only",
      "original-consumer-context",
      "run-id",
      "sha",
      "standalone-harn",
      "tag",
    ],
  )
  for name in ["run-id", "sha", "tag"] {
    assert_eq(call.inputs[name].required, true)
    assert_eq(call.inputs[name].type, "string")
  }
  for name in ["original-consumer-context", "consumer-repair"] {
    assert_eq(call.inputs[name].required, false)
    assert_eq(call.inputs[name].type, "string")
    assert_eq(call.inputs[name].default, "")
  }
  for name in ["RELEASE_APP_CLIENT_ID", "RELEASE_APP_PRIVATE_KEY"] {
    assert_eq(call.secrets[name].required, true)
  }
  assert_eq(
    call.inputs["standalone-harn"],
    {
      description:
        "Qualify Harn's own source and immutable archives independently of downstream adoption.",
      required: false,
      default: false,
      type: "boolean",
    },
  )
  assert_eq(call.secrets.CONSUMER_CANARY_REPOSITORY.required, false)
  assert_eq(call.inputs["inspect-only"].type, "boolean")
  assert_eq(call.inputs["inspect-only"].default, false)
  assert_eq(call.inputs["inspect-only"].required, false)
  assert_eq(call.outputs.tag.value, expression("jobs.promote.outputs.tag"))
  assert_eq(call.outputs["release-url"].value, expression("jobs.promote.outputs.release-url"))
  assert_eq(workflow.permissions, {contents: "read"})
}

pipeline test_promotion_verifies_before_it_can_write_and_never_builds(harness: Harness) {
  const job = promote(harness.fs).jobs.promote
  assert_eq(job["runs-on"], "ubuntu-24.04")
  assert_eq(job.permissions, {contents: "read", actions: "read", attestations: "read"})
  // The complete step list is the contract: a build step cannot be added
  // without changing this test, and the write token exists only after the
  // verification step has passed.
  assert_eq(
    job.steps.map({ step -> step.name }),
    [
      "Require standalone inspection scope",
      "Require called-workflow identity",
      "Check out workflow implementation",
      "Set up exact Harn release",
      "Check out the immutable consumer reader",
      "Set up the consumer reader runtime",
      "Mint consumer read authority",
      "Verify the run and its files",
      "Preserve the verified publication intent",
      "Mint the release token",
      "Inspect or publish the verified files",
    ],
  )
  assert_eq(
    named_step(job.steps, "Require standalone inspection scope").if,
    "inputs.inspect-only && (!inputs.standalone-harn || github.repository != 'burin-labs/harn')",
  )
  assert(named_step(job.steps, "Require standalone inspection scope").run.contains("exit 2"))
  const implementation = named_step(job.steps, "Check out workflow implementation")
  assert_eq(
    implementation["with"],
    {
      repository: expression("fromJSON(toJSON(job)).workflow_repository"),
      ref: expression("fromJSON(toJSON(job)).workflow_sha"),
      path: ".harn/promote-release/implementation",
      "persist-credentials": false,
    },
  )
  const reader = named_step(job.steps, "Check out the immutable consumer reader")
  const runtime = named_step(job.steps, "Set up the consumer reader runtime")
  const reader_token = named_step(job.steps, "Mint consumer read authority")
  const verify = named_step(job.steps, "Verify the run and its files")
  const checkpoint = named_step(job.steps, "Preserve the verified publication intent")
  const token = named_step(job.steps, "Mint the release token")
  const publish = named_step(job.steps, "Inspect or publish the verified files")
  assert_eq(
    job.concurrency,
    {
      group: "publish-tested-files-" + expression("github.repository") + "-"
        + expression("inputs.tag"),
      "cancel-in-progress": false,
    },
  )
  assert_eq(checkpoint.uses, "actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a")
  assert_eq(checkpoint.with.path, ".harn/promote-release/candidate/publication-intent.json")
  assert_eq(checkpoint.with["if-no-files-found"], "error")
  assert_eq(checkpoint.with["include-hidden-files"], true)
  assert_eq(checkpoint.with["retention-days"], 30)
  for step in [reader, runtime] {
    assert_eq(
      step.if,
      "(inputs.original-consumer-context != '' || inputs.consumer-repair != '' || inputs.standalone-harn) && github.repository == 'burin-labs/harn'",
    )
  }
  assert_eq(
    reader_token.if,
    "(inputs.original-consumer-context != '' || inputs.consumer-repair != '') && github.repository == 'burin-labs/harn'",
  )
  assert_eq(reader.uses, implementation.uses)
  assert_eq(
    reader.with,
    {
      repository: "burin-labs/harn",
      ref: "94407392829a72a243b2e8d0fd3f18ebfd22e806",
      path: ".harn/promote-release/consumer-reader",
      "persist-credentials": false,
    },
  )
  assert_eq(runtime.uses, "actions/setup-node@820762786026740c76f36085b0efc47a31fe5020")
  assert_eq(runtime.with, {"node-version": "22"})
  assert_eq(reader_token.uses, token.uses)
  assert_eq(reader_token.id, "consumer-token")
  assert_eq(
    reader_token.with,
    {
      "client-id": expression("secrets.RELEASE_APP_CLIENT_ID"),
      "private-key": expression("secrets.RELEASE_APP_PRIVATE_KEY"),
      owner: expression("github.repository_owner"),
      repositories: "harn\n" + expression("secrets.CONSUMER_CANARY_REPOSITORY") + "\n",
      "permission-actions": "read",
      "permission-contents": "read",
      "permission-pull-requests": "read",
    },
  )
  const entry = "bash .harn/promote-release/implementation/scripts/release-promotion/run.sh"
  assert_eq(verify.run, entry)
  assert_eq(publish.run, entry)
  assert_eq(verify.env.PROMOTE_MODE, "verify")
  assert_eq(verify.env.GH_TOKEN, expression("github.token"))
  assert_eq(publish.env.PROMOTE_MODE, expression("inputs.inspect-only && 'inspect' || 'publish'"))
  assert_eq(publish.env.GH_TOKEN, expression("steps.token.outputs.token"))
  for name in [
    "PROMOTE_REPOSITORY",
    "PROMOTE_SHA",
    "PROMOTE_RUN_ID",
    "PROMOTE_ORIGINAL_CONSUMER_CONTEXT",
    "PROMOTE_CONSUMER_REPAIR",
    "PROMOTE_STANDALONE_HARN",
    "PROMOTE_QUALIFICATION_TOKEN",
    "PROMOTE_HARN_READER_ROOT",
    "PROMOTE_CONSUMER_TOKEN",
    "PROMOTE_CONSUMER_REPOSITORY",
    "PROMOTE_CONSUMER_WORKFLOW",
    "PROMOTE_CONSUMER_READER",
    "PROMOTE_TAG",
    "PROMOTE_DIRECTORY",
  ] {
    assert_eq(verify.env[name], publish.env[name])
  }
  assert_eq(verify.env.PROMOTE_REPOSITORY, expression("github.repository"))
  assert_eq(
    verify.env.PROMOTE_ORIGINAL_CONSUMER_CONTEXT,
    expression("inputs.original-consumer-context"),
  )
  assert_eq(verify.env.PROMOTE_CONSUMER_TOKEN, expression("steps.consumer-token.outputs.token"))
  assert_eq(verify.env.PROMOTE_CONSUMER_REPAIR, expression("inputs.consumer-repair"))
  assert_eq(
    verify.env.PROMOTE_CONSUMER_REPOSITORY,
    expression("github.repository_owner") + "/" + expression("secrets.CONSUMER_CANARY_REPOSITORY"),
  )
  assert_eq(verify.env.PROMOTE_CONSUMER_WORKFLOW, expression("vars.CONSUMER_CANARY_WORKFLOW"))
  assert_eq(
    verify.env.PROMOTE_CONSUMER_READER,
    expression("github.workspace")
      + "/.harn/promote-release/consumer-reader/scripts/ci/consumer-observer-read-decision.mjs",
  )
  const grants = keys(token["with"]).filter({ key -> key.starts_with("permission-") })
  // Publish mode re-verifies the run with this token before it publishes.
  assert_eq(
    grants.sorted().to_list(),
    ["permission-actions", "permission-contents", "permission-workflows"],
  )
  assert_eq(token["with"]["permission-actions"], "read")
  assert_eq(token["with"]["permission-contents"], "write")
  assert_eq(token["with"]["permission-workflows"], "write")
  assert_eq(token["with"].repositories, expression("github.event.repository.name"))
  assert_eq(job.outputs.tag, expression("steps.publish.outputs.tag"))
  assert_eq(job.outputs["release-url"], expression("steps.publish.outputs.release-url"))
}

pipeline test_promotion_bootstrap_only_dispatches_harn(harness: Harness) {
  const bootstrap = read(harness.fs, "scripts/release-promotion/run.sh")
  assert(bootstrap.contains("scripts/release-promotion/cli.harn"))
  assert(bootstrap.contains("--allow-process-network"))
  for variable in [
    "GH_TOKEN",
    "PROMOTE_MODE",
    "PROMOTE_REPOSITORY",
    "PROMOTE_SHA",
    "PROMOTE_RUN_ID",
    "PROMOTE_ORIGINAL_CONSUMER_CONTEXT",
    "PROMOTE_CONSUMER_REPAIR",
    "PROMOTE_CONSUMER_TOKEN",
    "PROMOTE_CONSUMER_REPOSITORY",
    "PROMOTE_CONSUMER_WORKFLOW",
    "PROMOTE_CONSUMER_READER",
    "PROMOTE_STANDALONE_HARN",
    "PROMOTE_QUALIFICATION_TOKEN",
    "PROMOTE_HARN_READER_ROOT",
    "PROMOTE_TAG",
    "PROMOTE_DIRECTORY",
    "GITHUB_OUTPUT",
  ] {
    assert(bootstrap.contains("=env:" + variable + ",expose=" + variable), variable)
  }
  for forbidden in ["gh ", "curl", "cargo", "make "] {
    assert(!bootstrap.contains(forbidden), forbidden)
  }
}

pipeline test_manifest_action_runs_the_one_validator_without_a_token(harness: Harness) {
  const action = yaml_parse(
    read(harness.fs, ".github/actions/validate-candidate-manifest/action.yml"),
  )
  assert_eq(action.runs.using, "composite")
  assert_eq(
    keys(action.inputs).sorted(),
    ["harn-version", "harn-version-file", "manifest", "repository", "run-id", "source-commit"],
  )
  assert_eq(action.inputs.manifest.required, true)
  const steps = action.runs.steps
  assert_eq(
    steps.map({ step -> step.name }),
    ["Set up exact Harn release", "Validate the manifest"],
  )
  assert(to_string(steps[0].uses).starts_with("burin-labs/harn/.github/actions/setup-harn@"))
  assert_eq(steps[1].run, "bash \"$GITHUB_ACTION_PATH/run.sh\"")
  assert(!keys(steps[1].env).any({ name -> name.contains("TOKEN") }))
  const bootstrap = read(harness.fs, ".github/actions/validate-candidate-manifest/run.sh")
  assert(bootstrap.contains("scripts/release-promotion/validate.harn"))
  assert(!bootstrap.contains("--allow-process-network"))
  // The validator is imported, never restated: the entrypoint holds no schema.
  const entry = read(harness.fs, "scripts/release-promotion/validate.harn")
  assert(entry.contains("validate_candidate_manifest"))
  assert(!entry.contains("schema_check"))
}
