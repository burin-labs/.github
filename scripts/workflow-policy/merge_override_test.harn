fn read(fs: HarnessFs, path: string) -> string {
  return fs.read_text(path_join(path_normalize(path_join(fs.cwd(), "../..")), path))
}

fn apply_steps(fs: HarnessFs) -> list {
  const workflow = yaml_parse(read(fs, ".github/workflows/merge-override.yml"))
  return workflow.jobs.apply.steps
}

fn step(steps: list, name: string) -> dict {
  const found = steps.filter({ candidate -> candidate.name == name }).to_list()
  assert_eq(len(found), 1, "exactly one step named " + name)
  return found[0]
}

fn position(steps: list, name: string) -> int {
  let index = 0
  for candidate in steps {
    if candidate.name == name {
      return index
    }
    index = index + 1
  }
  throw "no step named " + name
}

fn condition(steps: list, name: string) -> string {
  return trim(regex_replace("\\s+", " ", step(steps, name)["if"] ?? ""))
}

const SIDE_EFFECTS = [
  "Cancel competing workflow runs",
  "Publish successful CI status check",
  "Mint release-app token for privileged merge",
  "Squash-merge pull request",
]

pipeline test_the_decision_precedes_and_gates_every_side_effect(harness: Harness) {
  const steps = apply_steps(harness.fs)
  assert_eq(step(steps, "Decide override").run, "bash scripts/merge-override/run.sh decide")
  for side_effect in SIDE_EFFECTS {
    assert(position(steps, "Decide override") < position(steps, side_effect), side_effect)
  }
  // A refused or crashed decision fails its step, so nothing chained from it runs.
  for side_effect in [
    "Cancel competing workflow runs",
    "Publish successful CI status check",
    "Mint release-app token for privileged merge",
  ] {
    assert(
      condition(steps, side_effect).starts_with("steps.decide.outcome == 'success'"),
      side_effect,
    )
  }
  assert_eq(condition(steps, "Squash-merge pull request"), "steps.app-token.outcome == 'success'")
  // A failed cancellation must not race a published status or a merge.
  for later in ["Publish successful CI status check", "Mint release-app token for privileged merge"] {
    assert(condition(steps, later).contains("steps.cancel.outcome != 'failure'"), later)
  }
}

pipeline test_every_attempt_is_recorded_after_its_side_effects(harness: Harness) {
  const steps = apply_steps(harness.fs)
  const record = step(steps, "Record override")
  assert_eq(record.run, "bash scripts/merge-override/run.sh record")
  assert_eq(
    condition(steps, "Record override"),
    "always() && steps.decide.outputs.active != 'false'",
  )
  assert_eq(
    condition(steps, "Mint release-app token for the org log"),
    condition(steps, "Record override"),
  )
  assert(position(steps, "Remove consumed override labels") < position(steps, "Record override"))
  for name in ["decide", "cancel", "publish", "merge", "cleanup"] {
    assert(
      record.env.OVERRIDE_STEPS.contains(
        "\"" + name + "\": \"$" + "{{ steps." + name + ".outcome }}\"",
      ),
      name,
    )
  }
  assert(record.env.OVERRIDE_LOG_TOKEN.contains("steps.log-token.outputs.token"))
}

pipeline test_the_bootstrap_only_dispatches_harn_with_every_variable_granted(harness: Harness) {
  const bootstrap = read(harness.fs, "scripts/merge-override/run.sh")
  assert(bootstrap.contains("scripts/merge-override/cli.harn\" -- \"$@\""))
  const workflow = read(harness.fs, ".github/workflows/merge-override.yml")
  for line in workflow.split("\n") {
    const text = trim(line)
    if regex_match("^(OVERRIDE_[A-Z_]+|GH_TOKEN):", text) != nil {
      const name = text.split(":")[0]
      assert(bootstrap.contains(name), name + " reaches the workflow but is never granted")
    }
  }
}
