fn source(fs: HarnessFs, path: string) -> string {
  return fs.read_text(path_join(path_normalize(path_join(fs.cwd(), "../..")), path))
}

pipeline test_fleet_owned_bump_reference_keeps_its_paired_input(harness: Harness) {
  const template = source(harness.fs, "templates/dependabot.yml")
  const parsed: DependabotTemplate = schema_expect(
    yaml_parse(template),
    schema_of(DependabotTemplate),
  )
  const actions = parsed.updates.find({ update -> update["package-ecosystem"] == "github-actions" })
  // This exact dependency has a second, coordinated orchestration input.
  // Ordinary Actions remain in the catch-all group and have no ignore.
  assert_eq(
    actions.ignore,
    [{"dependency-name": "burin-labs/harn/.github/workflows/bump-harn.yml"}],
  )
  assert_eq(actions.groups.actions.patterns, ["*"])
  assert(
    source(harness.fs, ".github/dependabot.yml").starts_with(template),
    "organization config must project the canonical template prefix",
  )
}

type DependabotTemplate = {version: int, updates: list<dict>}

pipeline test_consumer_ignore_entries_extend_one_canonical_list(harness: Harness) {
  const template = source(harness.fs, "templates/dependabot.yml")
  assert(
    trim(template).ends_with(
      "- dependency-name: \"burin-labs/harn/.github/workflows/bump-harn.yml\"",
    ),
    "the canonical prefix ends at its owned ignore entry",
  )
  const suffix = "      - dependency-name: \"useblacksmith/stickydisk\"\n"
  const extended: DependabotTemplate = schema_expect(
    yaml_parse(template + suffix),
    schema_of(DependabotTemplate),
  )
  assert_eq(
    extended.updates[0]?.ignore,
    [
      {"dependency-name": "burin-labs/harn/.github/workflows/bump-harn.yml"},
      {"dependency-name": "useblacksmith/stickydisk"},
    ],
  )
  assert_eq(extended.updates[0]?.groups?.actions?.patterns, ["*"])
  const duplicate = try {
    yaml_parse(template + "    ignore:\n" + suffix)
    false
  } catch (_error) {
    true
  }
  assert(duplicate, "the canonical YAML parser refuses the old duplicate-ignore composition")
}
