import { command_output_tail, command_run } from "std/command"
import { complete_command_result } from "../captured-command.harn"
import { ReadRecovery } from "./authorization.harn"
import { download_bound_manifest } from "./bound-manifest.harn"
import { historical_attestation_matches } from "./historical-attestation.harn"
import { GitHub } from "./promotion.harn"

pub type ConsumerRecoveryConfig = {
  token: string,
  repository: string,
  workflow: string,
  reader: string,
}

/**
 * Invoke the immutable shared reader. Its closed output contains public
 * context/counts only; arbitrary subprocess diagnostics never reach logs.
 */
pub fn live_consumer_recovery(
  tools: HarnessTools,
  config: ConsumerRecoveryConfig,
  operation: string = "--recover",
) -> ReadRecovery {
  if !["--recover", "--repair"].contains(operation) {
    throw "unknown consumer recovery operation"
  }
  return fn(context: string, source: string) {
    const result = command_run(
      tools,
      ["node", config.reader, operation],
      {
        capture: {max_inline_bytes: 16384},
        timeout_ms: 1200000,
        env: {
          GH_TOKEN: config.token,
          CANARY_REPOSITORY: config.repository,
          CANARY_WORKFLOW: config.workflow,
          OBSERVER_CONTEXT: context,
          SOURCE_REVISION: source,
          REQUIRE_CURRENT_DEFAULT: operation == "--repair" ? "false" : "true",
        },
      },
    )
    const captured = complete_command_result(result)
    if !captured.success {
      throw "original consumer recovery is unproven"
    }
    const parsed = try {
      json_parse(captured.stdout)
    }
    if !is_ok(parsed) || unwrap(parsed) == nil {
      throw "original consumer recovery returned no measured decision"
    }
    return unwrap(parsed)
  }
}

const API_ROOT = "https://api.github.com"

const API_VERSION = "2026-03-10"

const MAX_JSON_RESPONSE_BYTES = 33554432

type CreatedDraft = {id: int}

fn diagnostic(tools: HarnessTools, result: dict) -> string {
  const stderr = command_output_tail(tools, result, {source: "stderr", length: 12000}).content
  const lines = trim(stderr).split("\n")
  const tail = lines[max(0, len(lines) - 3):len(lines)]
  const text = trim(join(tail, " "))
  return text == "" ? "exit " + to_string(result?.exit_code) : text
}

fn gh(tools: HarnessTools, env: dict, args: list<string>) -> dict {
  return command_run(
    tools,
    ["gh"] + args,
    {capture: {max_inline_bytes: 10000000}, env: env, timeout_ms: 1200000},
  )
}

fn gh_ok(tools: HarnessTools, env: dict, args: list<string>, action: string) -> dict {
  const result = gh(tools, env, args)
  if !result.success {
    throw action + " failed: " + diagnostic(tools, result)
  }
  return result
}

fn request_options(token: string) -> dict {
  return {
    headers: {
      Accept: "application/vnd.github+json",
      Authorization: "Bearer " + token,
      "X-GitHub-Api-Version": API_VERSION,
      "User-Agent": "burin-labs-promote-release",
    },
    timeout_ms: 120000,
    retry: {max: 3, backoff_ms: 1000},
    follow_redirects: true,
    max_redirects: 5,
    max_response_bytes: MAX_JSON_RESPONSE_BYTES,
  }
}

/** GET a REST resource. A 404 is an answer, the resource's absence, so it returns nil. */
fn api_json(net: HarnessNet, token: string, endpoint: string) -> unknown {
  let last_error = "no response"
  for _attempt in [1, 2, 3] {
    const outcome = try {
      net.get(API_ROOT + endpoint, request_options(token))
    }
    if !is_ok(outcome) {
      last_error = to_string(unwrap_err(outcome))
      continue
    }
    const response = unwrap(outcome)
    if response.status == 404 {
      return nil
    }
    if !response.ok {
      last_error = "HTTP " + to_string(response.status)
      continue
    }
    try {
      return json_parse(response.body)
    } catch (error) {
      last_error = "invalid JSON: " + to_string(error)
    }
  }
  throw "GitHub API request " + endpoint + " failed after 3 attempts: " + last_error
}

/** Build the verifier arguments without combining mutually exclusive signer flags. */
pub fn attestation_args(path: string, expect: dict) -> list<string> {
  return ["attestation", "verify", path, "--repo", expect.repository]
    + (expect?.historical == nil ? ["--signer-repo", expect.repository] : [
      "--signer-workflow",
      "github.com/burin-labs/harn/.github/workflows/build-release-binaries.yml",
    ])
    + [
      "--predicate-type",
      expect.predicate_type,
      "--source-digest",
      expect.source_digest,
      "--format",
      "json",
    ]
}

/**
 * Build the production adapter for one repository. gh keeps its config and
 * caches under scratch, inside the sandbox's write roots.
 */
pub fn live_github(
  net: HarnessNet,
  tools: HarnessTools,
  fs: HarnessFs,
  token: string,
  repository: string,
  scratch: string,
  sleep_ms: fn(int) -> nil,
) -> GitHub {
  const env = {
    GH_TOKEN: token,
    GH_CONFIG_DIR: path_join(scratch, "config"),
    XDG_CACHE_HOME: path_join(scratch, "cache"),
    XDG_STATE_HOME: path_join(scratch, "state"),
    XDG_DATA_HOME: path_join(scratch, "data"),
    GH_PROMPT_DISABLED: "1",
    GH_NO_UPDATE_NOTIFIER: "1",
    NO_COLOR: "1",
  }
  return {
    sleep_ms: sleep_ms,
    json: fn(endpoint) { return api_json(net, token, endpoint) },
    download_bound: fn(run_id, name, identity, directory) {
      download_bound_manifest(
        fs,
        fn(argv: list<string>, options: dict) { return command_run(tools, argv, options) },
        fn(endpoint: string) { return api_json(net, token, endpoint) },
        env,
        repository,
        run_id,
        name,
        identity,
        directory,
      )
      return nil
    },
    download: fn(run_id, name, directory) {
      gh_ok(
        tools,
        env,
        [
          "run",
          "download",
          to_string(run_id),
          "--repo",
          repository,
          "--name",
          name,
          "--dir",
          directory,
        ],
        "downloading run artifact " + name,
      )
      return nil
    },
    attest: fn(path, expect) {
      const result = gh(tools, env, attestation_args(path, expect))
      if !result.success {
        return diagnostic(tools, result)
      }
      // A verifier that printed nothing verified nothing.
      const parsed = try {
        json_parse(result.stdout)
      }
      if !is_ok(parsed) || type_of(unwrap(parsed)) != "list" || len(unwrap(parsed)) == 0 {
        return "gh attestation verify reported success without a verified attestation"
      }
      if expect?.historical != nil
        && !historical_attestation_matches(unwrap(parsed), expect.historical) {
        return "no verified attestation binds the historical source and producing workflow"
      }
      return nil
    },
    create_draft: fn(release) {
      require len(release.files) == 0, "draft creation must precede asset uploads"
      const created = gh_ok(
        tools,
        env,
        [
          "api",
          "--method",
          "POST",
          "repos/${repository}/releases",
          "-f",
          "tag_name=${release.tag}",
          "-f",
          "target_commitish=${release.sha}",
          "-f",
          "name=${release.title}",
          "-F",
          "draft=true",
          "-F",
          "prerelease=${release.prerelease}",
          "-F",
          "body=@${release.notes_file}",
        ],
        "creating the draft release",
      )
      const draft = schema_expect(json_parse(created.stdout), schema_of(CreatedDraft))
      require draft.id > 0, "draft creation returned no release identity"
      return draft.id
    },
    upload_assets: fn(release_id, paths) {
      require release_id > 0, "asset upload requires a verified release identity"
      parallel each paths with { max_concurrent: 5 } { path ->
        const name = url_encode(basename(path))
        gh_ok(
          tools,
          env,
          [
            "api",
            "--method",
            "POST",
            "https://uploads.github.com/repos/${repository}/releases/${release_id}/assets?name=${name}",
            "--input",
            path,
            "-H",
            "Content-Type: application/octet-stream",
          ],
          "uploading missing release asset ${basename(path)}",
        )
      }
      return nil
    },
    create_tag: fn(tag, sha, message) {
      const created = gh_ok(
        tools,
        env,
        [
          "api",
          "--method",
          "POST",
          "repos/" + repository + "/git/tags",
          "-f",
          "tag=" + tag,
          "-f",
          "message=" + message,
          "-f",
          "object=" + sha,
          "-f",
          "type=commit",
        ],
        "creating the annotated tag",
      )
      const object = json_parse(created.stdout)
      if object?.object?.sha != sha || type_of(object?.sha) != "string" {
        throw "creating the annotated tag returned " + created.stdout + ", not a tag of " + sha
      }
      gh_ok(
        tools,
        env,
        [
          "api",
          "--method",
          "POST",
          "repos/" + repository + "/git/refs",
          "-f",
          "ref=refs/tags/" + tag,
          "-f",
          "sha=" + object.sha,
        ],
        "creating the tag ref",
      )
      return nil
    },
    publish_draft: fn(id, latest) {
      const result = gh_ok(
        tools,
        env,
        [
          "api",
          "--method",
          "PATCH",
          "repos/" + repository + "/releases/" + to_string(id),
          "-F",
          "draft=false",
          "-f",
          "make_latest=" + (latest ? "true" : "false"),
        ],
        "publishing the draft release",
      )
      return json_parse(result.stdout)
    },
  }
}
