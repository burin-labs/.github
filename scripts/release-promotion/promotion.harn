import { ManifestIdentity } from "./authorization.harn"
import {
  CANDIDATE_MANIFEST_FILE,
  CandidateManifest,
  candidate_manifest_artifact,
  expect_manifest_identity,
  validate_candidate_manifest,
} from "./manifest.harn"
import {
  PublicationInspection,
  ReleasePlan,
  inspect_publication,
  reconcile_publication,
} from "./publication.harn"

/**
 * Everything promotion asks of GitHub. The live adapter implements it with
 * the REST API and the gh CLI; tests implement it with recorded responses.
 */
pub type GitHub = {
  json: fn(string) -> unknown,
  download: fn(int, string, string) -> nil,
  download_bound: fn(int, string, ManifestIdentity, string) -> nil,
  attest: fn(string, dict) -> string?,
  create_draft: fn(dict) -> int,
  sleep_ms: fn(int) -> nil,
  upload_assets: fn(string, list<string>) -> nil,
  create_tag: fn(string, string, string) -> nil,
  publish_draft: fn(int, bool) -> unknown,
}

/**
 * What the caller asked to promote. A tag with a pre-release suffix, such as
 * v1.2.3-rc.1, is a prerelease. Package namespaces never change repository latest.
 */
pub type PromotionRequest = {
  repository: string,
  sha: string,
  run_id: int,
  tag: string,
  namespace: string?,
  prerelease: bool,
}

/** The run facts promotion relies on after it has checked them. */
pub type VerifiedRun = {url: string, attempt: int, manifest_identity?: ManifestIdentity?}

/** Internal authenticated completion reader, never a caller-provided verdict. */
pub type CompletionAuthorization = fn(int) -> ManifestIdentity?

/** A candidate whose manifest and file digests have been checked on disk. */
pub type Candidate = {
  manifest: CandidateManifest,
  manifest_path: string,
  files: list<{kind: string, name: string, path: string, sha256: string}>,
}

fn expect_format(value: string, pattern: string, message: string) -> string {
  if regex_match(pattern, value) == nil {
    throw message
  }
  return value
}

/** Validate the caller's inputs once, at the boundary. */
pub fn parse_request(
  input: {repository: string, sha: string, run_id: string, tag: string},
) -> PromotionRequest {
  const {repository, sha, run_id, tag} = input
  expect_format(repository, "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$", "repository must be owner/name")
  expect_format(sha, "^[0-9a-f]{40}$", "sha must be a full 40-character lowercase commit SHA")
  expect_format(run_id, "^[1-9][0-9]*$", "run-id must be a workflow run id")
  const parts = tag.split("/")
  require len(parts) == 1 || len(parts) == 2, "tag must have at most one package namespace"
  const namespace = if len(parts) == 2 {
    parts[0]!
  } else {
    nil
  }
  if namespace != nil {
    expect_format(
      namespace,
      "^[A-Za-z0-9]+([._-][A-Za-z0-9]+)*$",
      "tag namespace must contain alphanumeric groups separated by '.', '_' or '-'",
    )
    require !namespace.ends_with(".lock"), "tag namespace cannot end in .lock"
  }
  const version = parts[len(parts) - 1]!
  expect_format(
    version,
    "^v[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z][0-9A-Za-z.-]*)?$",
    "tag must look like vX.Y.Z or vX.Y.Z-suffix, optionally after a package namespace: " + tag,
  )
  return {
    repository: repository,
    sha: sha,
    run_id: to_int(run_id),
    tag: tag,
    namespace: namespace,
    prerelease: version.contains("-"),
  }
}

fn run_label(request: PromotionRequest) -> string {
  return "run " + to_string(request.run_id)
}

/**
 * Refuse unless the run belongs to the repository, built that repository's
 * own commit, concluded success, tested exactly the requested commit, and
 * that commit is on the default branch.
 */
pub fn verify_run(
  github: GitHub,
  request: PromotionRequest,
  authorize_completion: CompletionAuthorization? = nil,
) -> VerifiedRun {
  const run = github.json(
    "/repos/" + request.repository + "/actions/runs/" + to_string(request.run_id),
  )
  if run == nil {
    throw run_label(request) + " does not exist in " + request.repository
  }
  const owner = run?.repository?.full_name
  if owner != request.repository {
    throw run_label(request) + " belongs to " + to_string(owner) + ", not " + request.repository
  }
  const head_owner = run?.head_repository?.full_name
  if head_owner != request.repository {
    throw run_label(request) + " built a commit from " + to_string(head_owner) + ", not "
      + request.repository
  }
  const succeeded = run?.status == "completed" && run?.conclusion == "success"
  const recoverable = (run?.status == "completed" && run?.conclusion == "failure")
    || (["queued", "requested", "waiting", "pending", "in_progress"].contains(run?.status)
      && run?.conclusion == nil)
  if !succeeded && (!recoverable || authorize_completion == nil) {
    throw run_label(request) + " did not succeed: status " + to_string(run?.status)
      + ", conclusion "
      + to_string(run?.conclusion)
  }
  if run?.head_sha != request.sha {
    throw run_label(request) + " tested " + to_string(run?.head_sha) + ", not the requested "
      + request.sha
  }
  const repository = github.json("/repos/" + request.repository)
  const branch = repository?.default_branch
  if type_of(branch) != "string" || branch == "" {
    throw request.repository + " reported no default branch"
  }
  const comparison = github.json(
    "/repos/" + request.repository + "/compare/" + url_encode(branch) + "..." + request.sha,
  )
  const relation = comparison?.status
  if relation != "identical" && relation != "behind" {
    throw "commit " + request.sha + " is not on " + branch + " (compare status "
      + to_string(relation)
      + ")"
  }
  const attempt = run?.run_attempt
  if type_of(attempt) != "int" || attempt < 1 {
    throw run_label(request) + " reported no run attempt"
  }
  const identity = authorize_completion == nil ? nil : authorize_completion(attempt)
  return {url: to_string(run?.html_url), attempt: attempt, manifest_identity: identity}
}

fn download_manifest(
  github: GitHub,
  request: PromotionRequest,
  run: VerifiedRun,
  directory: string,
) -> nil {
  const name = candidate_manifest_artifact(request.sha)
  const destination = path_join(directory, "manifest")
  if run.manifest_identity != nil {
    github.download_bound(request.run_id, name, run.manifest_identity, destination)
  } else {
    github.download(request.run_id, name, destination)
  }
}

/** Where a verification directory keeps each downloaded file. */
fn manifest_path(directory: string) -> string {
  return path_join(directory, "manifest", CANDIDATE_MANIFEST_FILE)
}

fn file_path(directory: string, artifact: string, file: string) -> string {
  return path_join(directory, "artifacts", artifact, file)
}

/**
 * Read and validate the downloaded manifest, and require that it names this
 * request: the same repository, commit, and run.
 */
fn load_manifest(
  fs: HarnessFs,
  request: PromotionRequest,
  run: VerifiedRun,
  directory: string,
) -> CandidateManifest {
  const path = manifest_path(directory)
  if !fs.exists(path) {
    throw "run artifact " + candidate_manifest_artifact(request.sha) + " has no "
      + CANDIDATE_MANIFEST_FILE
  }
  let raw = nil
  try {
    raw = json_parse(fs.read_text(path))
  } catch (error) {
    throw CANDIDATE_MANIFEST_FILE + " is not JSON: " + to_string(error)
  }
  const manifest = expect_manifest_identity(
    validate_candidate_manifest(raw),
    {repository: request.repository, source_commit: request.sha, run_id: to_string(request.run_id)},
  )
  if to_int(manifest.runAttempt) > run.attempt {
    throw "manifest runAttempt " + manifest.runAttempt + " is later than the run's attempt "
      + to_string(run.attempt)
  }
  if run.manifest_identity != nil && to_int(manifest.runAttempt) != run.attempt {
    throw "consumer repair manifest must name the authenticated producing attempt"
  }
  return manifest
}

/**
 * Check a downloaded candidate on disk: the manifest validates, names this
 * request, and every file's SHA-256 equals the manifest. Touches no network,
 * so publishing repeats it against the exact bytes it uploads.
 */
pub fn check_candidate(
  fs: HarnessFs,
  request: PromotionRequest,
  run: VerifiedRun,
  directory: string,
) -> Candidate {
  const manifest = load_manifest(fs, request, run, directory)
  let files = []
  let mismatches = []
  for item in manifest.artifacts {
    const candidate = file_path(directory, item.artifact, item.file)
    if !fs.exists(candidate) {
      mismatches = mismatches + [item.file + " is missing from run artifact " + item.artifact]
      continue
    }
    const actual = sha256(fs.read_bytes(candidate))
    if actual != item.sha256 {
      mismatches = mismatches
        + [item.file + " has sha256 " + actual + " but the manifest records " + item.sha256]
      continue
    }
    files = files + [{kind: item.kind, name: item.file, path: candidate, sha256: actual}]
  }
  if len(mismatches) > 0 {
    throw "candidate files do not match the manifest: " + join(mismatches, "; ")
  }
  return {manifest: manifest, manifest_path: manifest_path(directory), files: files}
}

/**
 * Download the run's manifest and files into directory, check them, and verify
 * each file's build attestation. Returns the verified candidate.
 */
pub fn verify_candidate(
  github: GitHub,
  fs: HarnessFs,
  request: PromotionRequest,
  directory: string,
  authorize_completion: CompletionAuthorization? = nil,
) -> Candidate {
  const run = verify_run(github, request, authorize_completion)
  download_manifest(github, request, run, directory)
  const manifest = load_manifest(fs, request, run, directory)
  let artifacts = []
  for item in manifest.artifacts {
    if !artifacts.contains(item.artifact) {
      artifacts = artifacts + [item.artifact]
    }
  }
  for name in artifacts {
    github.download(request.run_id, name, path_join(directory, "artifacts", name))
  }
  const candidate = check_candidate(fs, request, run, directory)
  let refused = []
  for item in candidate.manifest.artifacts {
    const diagnostic = github.attest(
      file_path(directory, item.artifact, item.file),
      {
        repository: request.repository,
        predicate_type: item.attestationPredicateType,
        source_digest: request.sha,
      },
    )
    if diagnostic != nil {
      refused = refused + [item.file + ": " + diagnostic]
    }
  }
  if len(refused) > 0 {
    throw "build attestation did not verify for " + join(refused, "; ")
  }
  fs.write_text(
    path_join(directory, "publication-intent.json"),
    json_stringify(publication_intent(fs, request, candidate)),
  )
  return candidate
}

fn publication_plan(fs: HarnessFs, request: PromotionRequest, candidate: Candidate) -> ReleasePlan {
  const notes = candidate.files.find({ file -> file.kind == "notes" })
  require notes != nil, "the candidate has no notes file for the release body"
  const assets = candidate.files.filter({ file -> file.kind != "notes" }).to_list()
  return {
    repository: request.repository,
    sha: request.sha,
    tag: request.tag,
    prerelease: request.prerelease,
    latest: request.namespace == nil && !request.prerelease,
    notes_file: notes.path,
    body: fs.read_text(notes.path),
    files: assets.map({ file -> {name: file.name, path: file.path, sha256: file.sha256} })
      + [
        {
          name: CANDIDATE_MANIFEST_FILE,
          path: candidate.manifest_path,
          sha256: sha256(fs.read_bytes(candidate.manifest_path)),
        },
      ],
  }
}

type PublicationIntent = {
  schemaVersion: string,
  repository: string,
  sourceCommit: string,
  runId: string,
  runAttempt: string,
  tag: string,
  prerelease: bool,
  manifestSha256: string,
  notesSha256: string,
  assets: list<{file: string, sha256: string}>,
}

fn publication_intent(
  fs: HarnessFs,
  request: PromotionRequest,
  candidate: Candidate,
) -> PublicationIntent {
  const plan = publication_plan(fs, request, candidate)
  return {
    schemaVersion: "burin-labs.release_publication_intent.v1",
    repository: request.repository,
    sourceCommit: request.sha,
    runId: to_string(request.run_id),
    runAttempt: candidate.manifest.runAttempt,
    tag: request.tag,
    prerelease: request.prerelease,
    manifestSha256: sha256(fs.read_bytes(candidate.manifest_path)),
    notesSha256: sha256(plan.body),
    assets: plan.files.map({ file -> {file: file.name, sha256: file.sha256} }),
  }
}

type SealedPublication = {plan: ReleasePlan, intent: PublicationIntent, intent_sha256: string}

pub type CandidateInspection = {
  publication: PublicationInspection,
  producer_run_id: string,
  producer_attempt: string,
  candidate_manifest_sha256: string,
  publication_intent_sha256: string,
}

fn sealed_publication(
  github: GitHub,
  fs: HarnessFs,
  request: PromotionRequest,
  run: VerifiedRun,
  directory: string,
) -> SealedPublication {
  if run.manifest_identity != nil {
    download_manifest(github, request, run, directory)
  }
  const candidate = check_candidate(fs, request, run, directory)
  const intent_text = fs.read_text(path_join(directory, "publication-intent.json"))
  const intent = schema_expect(json_parse(intent_text), schema_of(PublicationIntent))
  require intent == publication_intent(fs, request, candidate),
    "publication intent no longer matches the verified candidate"
  return {
    plan: publication_plan(fs, request, candidate),
    intent: intent,
    intent_sha256: sha256(intent_text),
  }
}

/** Inspect the sealed candidate through the production reader without mutation functions. */
pub fn inspect_candidate(
  github: GitHub,
  fs: HarnessFs,
  request: PromotionRequest,
  run: VerifiedRun,
  directory: string,
) -> CandidateInspection {
  const sealed = sealed_publication(github, fs, request, run, directory)
  return {
    publication: inspect_publication({json: github.json}, sealed.plan),
    producer_run_id: sealed.intent.runId,
    producer_attempt: sealed.intent.runAttempt,
    candidate_manifest_sha256: sealed.intent.manifestSha256,
    publication_intent_sha256: sealed.intent_sha256,
  }
}

/** Recheck the sealed candidate, then reconcile only matching publication state. */
pub fn publish_candidate(
  github: GitHub,
  fs: HarnessFs,
  request: PromotionRequest,
  run: VerifiedRun,
  directory: string,
) -> {tag: string, url: string} {
  const sealed = sealed_publication(github, fs, request, run, directory)
  return reconcile_publication(github, sealed.plan)
}
