import { assert_error_contains } from "std/testing"
import { parse_authorization, verify_authorization } from "./authorization.harn"

const SOURCE = "89512fd930c0af99f13f9295d8b236407ad07244"

/**
 * These controls own request binding only. The pinned shared reader owns
 * deadline, custody, chronology and reached-product authentication.
 */
fn measured() -> dict {
  return {
    context: {
      parent_repository: "burin-labs/harn",
      parent_run_id: "100",
      parent_run_attempt: 1,
      source_revision: SOURCE,
    },
    owned: false,
    deadline: {observed_at: 8200},
    reading: {product: {verdict: "pass"}},
  }
}

pipeline test_original_recovery_binds_the_failed_candidate_request() {
  const context = json_stringify(measured().context)
  const authorization = unwrap(parse_authorization(context))
  let reached = 0
  verify_authorization(
    fn(issued: string, source: string) {
      assert_eq(issued, context)
      assert_eq(source, SOURCE)
      reached = reached + 1
      return measured()
    },
    "burin-labs/harn",
    SOURCE,
    100,
    1,
    authorization,
  )
  assert_eq(reached, 1)
  assert_eq(parse_authorization(""), nil)
  assert_eq(parse_authorization("  "), nil)
}

pipeline test_later_promotion_context_cannot_authorize_an_original_failed_candidate() {
  const context = json_stringify(measured().context)
  const authorization = unwrap(parse_authorization(context))
  for request in [
    {repository: "burin-labs/harn", source: SOURCE, run: 101, attempt: 1},
    {repository: "burin-labs/harn", source: SOURCE, run: 100, attempt: 2},
    {
      repository: "burin-labs/harn",
      source: "92bbaeb1bed4daf93a8911708246fb8c3cd2c780",
      run: 100,
      attempt: 1,
    },
  ] {
    assert_error_contains(
      fn() { verify_authorization(
        fn(_issued: string, _source: string) { return measured() },
        request.repository,
        request.source,
        request.run,
        request.attempt,
        authorization,
      ) },
      "does not bind this producer",
    )
  }
  for decision in [
    nil,
    {},
    measured() + {owned: true},
    measured() + {deadline: nil},
    measured() + {reading: {product: nil}},
    measured() + {reading: {product: {verdict: "fail"}}},
  ] {
    assert_error_contains(
      fn() { verify_authorization(
        fn(_issued: string, _source: string) { return decision },
        "burin-labs/harn",
        SOURCE,
        100,
        1,
        authorization,
      ) },
      "does not bind this producer",
    )
  }
}

fn repaired() -> dict {
  return {
    schema: "harn.release.consumer_repair_decision.v1",
    context: measured().context + {parent_run_id: "101"},
    owned: false,
    reading: {product: {verdict: "pass"}},
    producer: {
      source_sha: SOURCE,
      producer_run: "100",
      producer_attempt: 1,
      verdict: "pass",
      pending: 0,
      failed_jobs: [],
      observed_jobs: 17,
      proven_artifacts: 7,
      manifest: {id: 9, digest: "sha256:" + sha256("immutable manifest archive")},
    },
  }
}

pipeline test_repair_binds_a_new_measurement_to_the_original_archive_producer() {
  const selector = "issued repair selector"
  const authorization = unwrap(parse_authorization("", selector))
  let reached = 0
  verify_authorization(
    fn(issued: string, source: string) {
      assert_eq(issued, selector)
      assert_eq(source, SOURCE)
      reached = reached + 1
      return repaired()
    },
    "burin-labs/harn",
    SOURCE,
    100,
    1,
    authorization,
  )
  assert_eq(reached, 1)
  assert_eq(authorization.mode, "repair")
  assert_error_contains(
    fn() { parse_authorization("original", selector) },
    "one consumer authorization mode",
  )
  const proof = repaired().producer
  for decision in [
    nil,
    {},
    measured(),
    repaired() + {schema: "unobserved"},
    repaired() + {owned: true},
    repaired() + {context: measured().context},
    repaired() + {context: repaired().context + {source_revision: "different"}},
    repaired() + {reading: {product: nil}},
    repaired() + {reading: {product: {verdict: "fail"}}},
    repaired() + {producer: proof + {source_sha: "different"}},
    repaired() + {producer: proof + {producer_run: "101"}},
    repaired() + {producer: proof + {producer_attempt: 2}},
    repaired() + {producer: proof + {verdict: "pending"}},
    repaired() + {producer: proof + {pending: 1}},
    repaired() + {producer: proof + {failed_jobs: ["smoke"]}},
    repaired() + {producer: proof + {observed_jobs: 0}},
    repaired() + {producer: proof + {proven_artifacts: 0}},
    repaired() + {producer: proof + {manifest: {id: 0, digest: proof.manifest.digest}}},
    repaired() + {producer: proof + {manifest: {id: 9, digest: "unmeasured"}}},
  ] {
    assert_error_contains(
      fn() { verify_authorization(
        fn(_issued: string, _source: string) { return decision },
        "burin-labs/harn",
        SOURCE,
        100,
        1,
        authorization,
      ) },
      "does not bind this producer",
    )
  }
}
