import { gha_write_output } from "std/gha"
import { parse_authorization, verify_authorization } from "./authorization.harn"
import { live_consumer_recovery, live_github } from "./live.harn"
import {
  inspect_candidate,
  parse_request,
  publish_candidate,
  verify_candidate,
  verify_run,
} from "./promotion.harn"
import { standalone_completion } from "./standalone.harn"

fn required_env(env: HarnessEnv, name: string) -> string {
  const value = env.get(name)
  if value == nil || trim(value) == "" {
    throw name + " is required"
  }
  return value
}

fn write_output(harness: Harness, name: string, value: string) {
  if !gha_write_output(harness, name, value) {
    throw "GITHUB_OUTPUT is not set, so " + name + " cannot reach the caller"
  }
}

fn main(harness: Harness) {
  harness.net.egress_policy({default: "allow", block_private: "private"})
  const request = parse_request(
    {
      repository: required_env(harness.env, "PROMOTE_REPOSITORY"),
      sha: required_env(harness.env, "PROMOTE_SHA"),
      run_id: required_env(harness.env, "PROMOTE_RUN_ID"),
      tag: required_env(harness.env, "PROMOTE_TAG"),
    },
  )
  const directory = required_env(harness.env, "PROMOTE_DIRECTORY")
  const github = live_github(
    harness.net,
    harness.tools,
    harness.fs,
    required_env(harness.env, "GH_TOKEN"),
    request.repository,
    harness.fs.mkdtemp_in_workspace("promote-release-gh-"),
  )
  const mode = required_env(harness.env, "PROMOTE_MODE")
  const authorization = parse_authorization(
    harness.env.get("PROMOTE_ORIGINAL_CONSUMER_CONTEXT") ?? "",
    harness.env.get("PROMOTE_CONSUMER_REPAIR") ?? "",
  )
  const standalone = harness.env.get("PROMOTE_STANDALONE_HARN") ?? "false"
  require ["true", "false"].contains(standalone), "standalone qualification choice is unreported"
  require standalone != "true" || authorization == nil,
    "standalone publication cannot claim consumer completion"
  require mode != "inspect" || standalone == "true",
    "publication inspection requires standalone Harn qualification"
  const authorize_completion = standalone == "true" ? standalone_completion(
    harness.tools,
    {
      token: required_env(harness.env, "PROMOTE_QUALIFICATION_TOKEN"),
      reader_root: required_env(harness.env, "PROMOTE_HARN_READER_ROOT"),
    },
    request,
  ) : authorization == nil ? nil : fn(attempt: int) { return verify_authorization(
    live_consumer_recovery(
      harness.tools,
      {
        token: required_env(harness.env, "PROMOTE_CONSUMER_TOKEN"),
        repository: required_env(harness.env, "PROMOTE_CONSUMER_REPOSITORY"),
        workflow: required_env(harness.env, "PROMOTE_CONSUMER_WORKFLOW"),
        reader: required_env(harness.env, "PROMOTE_CONSUMER_READER"),
      },
      authorization.mode == "repair" ? "--repair" : "--recover",
    ),
    request.repository,
    request.sha,
    request.run_id,
    attempt,
    authorization,
  ) }
  const historical_repair = standalone != "true" && authorization?.mode == "repair"
  if mode == "verify" {
    const candidate = verify_candidate(
      github,
      harness.fs,
      request,
      directory,
      authorize_completion,
      historical_repair,
    )
    for file in candidate.files {
      harness.stdio.println("verified " + file.name + " sha256 " + file.sha256)
    }
    harness.stdio.println(
      "Run " + to_string(request.run_id) + " is authorized at " + request.sha + " and its "
        + to_string(len(candidate.files))
        + " files match their manifest digests and attestations.",
    )
    return
  }
  if mode == "inspect" {
    const inspection = inspect_candidate(
      github,
      harness.fs,
      request,
      verify_run(github, request, authorize_completion, historical_repair),
      directory,
    )
    harness.stdio.println(json_stringify(inspection))
    require inspection.publication.release_id != nil,
      "publication inspection found no matching release: missing_release=1"
    require inspection.publication.notes_sha256 == inspection.publication.expected_notes_sha256,
      "publication inspection found a changed release body"
    return
  }
  if mode == "publish" {
    const release = publish_candidate(
      github,
      harness.fs,
      request,
      verify_run(github, request, authorize_completion, historical_repair),
      directory,
    )
    write_output(harness, "tag", release.tag)
    write_output(harness, "release-url", release.url)
    harness.stdio.println("Published " + release.tag + ": " + release.url)
    return
  }
  throw "PROMOTE_MODE must be verify or publish, got " + mode
}
