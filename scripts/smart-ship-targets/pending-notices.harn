/** Find open changes whose Smart Ship notice may still need retirement. */
import { parse_args } from "std/cli"
import { command_run } from "std/command"

type NoticeListing = {
  repository: {
    pullRequests: {totalCount: int, pageInfo: {hasNextPage: bool}, nodes: list<{number: int}>},
  }?,
}

const QUERY = """
query($owner: String!, $name: String!) {
  repository(owner: $owner, name: $name) {
    pullRequests(states: OPEN, labels: ["ship-needs-you"], first: 100) {
      totalCount
      pageInfo { hasNextPage }
      nodes { number }
    }
  }
}
"""

/** A partial or malformed census never masquerades as an empty population. */
pub fn pending_notice_numbers(listing: NoticeListing) -> list<int> {
  const pulls = listing.repository?.pullRequests
  require pulls != nil, "pending-notice census has no repository"
  require !pulls.pageInfo.hasNextPage && pulls.totalCount == len(pulls.nodes),
    "pending-notice census is incomplete"
  let numbers = []
  for pull in pulls.nodes {
    require pull.number > 0 && !numbers.contains(pull.number),
      "pending-notice census has an invalid or duplicate change"
    numbers = numbers + [pull.number]
  }
  return numbers
}

fn main(harness: Harness) {
  const parsed = parse_args(argv, [{kind: "option", name: "repo", flags: ["--repo"], default: ""}])
  const parts = to_string(parsed.repo ?? "").split("/")
  require len(parts) == 2 && parts[0] != "" && parts[1] != "", "--repo must be owner/name"
  const result = command_run(
    harness.tools,
    [
      "gh",
      "api",
      "graphql",
      "-f",
      "query=" + QUERY,
      "-f",
      "owner=" + (parts[0] ?? ""),
      "-f",
      "name=" + (parts[1] ?? ""),
    ],
  )
  require result.success, "pending-notice census could not be read"
  const decoded = json_decode(result.stdout, schema_of({data: NoticeListing}))
  require is_ok(decoded), "pending-notice census is malformed"
  const numbers = pending_notice_numbers(unwrap(decoded).data)
  harness.stdio.println(join(numbers.map({ number -> to_string(number) }).to_list(), " "))
}
