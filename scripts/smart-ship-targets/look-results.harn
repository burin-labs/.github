/** Validate one completed look for every PR before authorizing any repairs. */
import { TargetSelection } from "./lib.harn"

pub type LookResult = {
  schema: int,
  repository: string,
  workflow: string,
  run_id: int,
  attempt: int,
  pr: int,
  outcome: string,
}

pub type LookArtifact = {name: string, result: LookResult}

/** GitHub's matrix limit is 256, so split the complete selection into four bounded groups. */
pub fn look_groups(selection: TargetSelection) -> list<list<int>> {
  require len(selection.prs) <= 1000, "look selection exceeds its population bound"
  return range(0, 4).map(
    { group ->
      range(0, len(selection.prs)).filter({ index -> index % 4 == group }).map(
        { index -> unwrap(selection.prs[index]) },
      )
        .to_list()
    },
  )
    .to_list()
}

/** The artifact name and payload both belong to the original run and attempt. */
pub fn look_result_name(selection: TargetSelection, pr: int) -> string {
  return "smart-ship-look-result-" + to_string(selection.run_id) + "-"
    + to_string(selection.attempt)
    + "-"
    + to_string(pr)
}

pub fn deferred_looks(selection: TargetSelection, artifacts: list<LookArtifact>) -> list<int> {
  require len(artifacts) == len(selection.prs), "look result census is incomplete"
  let seen = []
  let deferred = []
  for artifact in artifacts {
    const result = artifact.result
    require result.schema == 1 && result.repository == selection.repository
      && result.workflow == selection.workflow
      && result.run_id == selection.run_id
      && result.attempt == selection.attempt,
      "look result has a foreign run identity"
    require selection.prs.contains(result.pr) && !seen.contains(result.pr)
      && artifact.name == look_result_name(selection, result.pr),
      "look result has an invalid, duplicate, or foreign PR"
    require ["complete", "deferred"].contains(result.outcome), "look did not finish successfully"
    seen = seen + [result.pr]
    if result.outcome == "deferred" {
      deferred = deferred + [result.pr]
    }
  }
  return selection.prs.filter({ pr -> deferred.contains(pr) }).to_list()
}
