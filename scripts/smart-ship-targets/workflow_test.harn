import { read_yaml } from "std/fs"

fn named(steps: list, name: string) -> dict {
  const matches = steps.filter({ step -> step?.name == name }).to_list()
  assert_eq(len(matches), 1, name)
  return matches[0] ?? {}
}

pipeline test_the_exact_selection_is_finalized_before_any_shepherd(harness: Harness) {
  const jobs = read_yaml(harness.fs, "../../.github/workflows/smart-ship.yml").jobs
  const ship = jobs.ship.steps
  const ci = read_yaml(harness.fs, "../../.github/workflows/ci.yml").jobs["ci-status"].steps
  const checkout = named(ship, "Check out the Smart Ship target publisher")
  assert_eq(checkout["with"].repository, "burin-labs/.github")
  assert_eq(checkout["with"].ref, "91ad5a4b9c7fe58823e1433808eda60c5cd48cdb")
  assert_eq(checkout["with"]["persist-credentials"], false)
  assert_eq(named(ci, checkout.name)["with"], checkout["with"])
  const record = named(ship, "Record the selected pull requests")
  const publish = named(ship, "Publish the selected pull requests")
  const shepherd = named(ship, "Shepherd")
  assert_eq(record.env.NUMBERS, "$" + "{{ steps.prs.outputs.numbers }}")
  assert(record.run.contains(".smart-ship-targets/scripts/smart-ship-targets/cli.harn"))
  assert(record.run.contains("--output \"$RUNNER_TEMP/ship-targets/targets.json\""))
  assert_eq(publish["if"], nil)
  assert_eq(publish.uses, "actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a")
  assert_eq(
    publish["with"],
    {
      name: "smart-ship-targets-$" + "{{ github.run_id }}-$" + "{{ github.run_attempt }}",
      path: "$" + "{{ runner.temp }}/ship-targets/targets.json",
      "if-no-files-found": "error",
      "compression-level": 0,
      "retention-days": 1,
    },
  )
  assert_eq(named(ci, publish.name)["with"], publish["with"])
  assert_eq(named(ci, publish.name).uses, publish.uses)
  const discovery = named(ship, "Find the pull requests to look at")
  assert(ship.index_of(discovery) < ship.index_of(record))
  assert(ship.index_of(record) < ship.index_of(publish))
  assert(ship.index_of(publish) < ship.index_of(shepherd))
  // After the looks, only the repair subset stays owned; it is a separate artifact.
  const narrow = named(ship, "Record the pull requests left for repair")
  const narrowed = named(ship, "Publish the pull requests left for repair")
  assert_eq(narrow.env.NUMBERS, "$" + "{{ steps.shepherd.outputs.deferred }}")
  assert(narrow.run.contains("--output \"$RUNNER_TEMP/ship-repair-targets/targets.json\""))
  assert_eq(narrowed.uses, publish.uses)
  assert_eq(
    narrowed["with"].name,
    "smart-ship-targets-$" + "{{ github.run_id }}-$" + "{{ github.run_attempt }}-repair",
  )
  assert(ship.index_of(shepherd) < ship.index_of(narrow))
  assert(ship.index_of(narrow) < ship.index_of(narrowed))
  const repair = named(jobs.repair.steps, "Repair deferred pull requests")
  assert_eq(repair.env.NUMBERS, nil)
  assert_eq(repair.env.DEFERRED, "$" + "{{ matrix.pr }}")
}

/** A cancelled or timed-out repair leaves no PR held behind the rest of its run. */
pipeline test_each_repair_releases_its_pr_however_it_ends(harness: Harness) {
  const jobs = read_yaml(harness.fs, "../../.github/workflows/smart-ship.yml").jobs
  assert_eq(jobs.ship.outputs.deferred_json, "$" + "{{ steps.shepherd.outputs.deferred_json }}")
  assert_eq(jobs.repair.strategy["fail-fast"], false)
  assert_eq(
    jobs.repair.strategy.matrix.pr,
    "$" + "{{ fromJSON(needs.ship.outputs.deferred_json) }}",
  )
  const steps = jobs.repair.steps
  const repair = named(steps, "Repair deferred pull requests")
  const record = named(steps, "Record the finished repair")
  const release = named(steps, "Release the pull request")
  const look = named(steps, "Look at the released pull request again")
  assert_eq(record["if"], "always()")
  assert_eq(release["if"], "always()")
  assert(look["if"].contains("always()"))
  assert_eq(
    release["with"].name,
    "smart-ship-targets-$" + "{{ github.run_id }}-$" + "{{ github.run_attempt }}-repaired-$"
      + "{{ matrix.pr }}",
  )
  assert_eq(release["with"].path, "$" + "{{ runner.temp }}/ship-released/released.json")
  assert(look.run.contains("-f \"pr=$PR\""))
  assert(steps.index_of(repair) < steps.index_of(record))
  assert(steps.index_of(record) < steps.index_of(release))
  // The fresh look must find the PR already released.
  assert(steps.index_of(release) < steps.index_of(look))
}
