import { with_capability_fixtures } from "std/testing"
import { SweepInput, sweep_census } from "./sweep-census"

fn numbers(start: int, end: int) -> list<int> {
  return range(start, end).map({ number -> number }).to_list()
}

fn result(page: dict) -> dict {
  return {
    success: true,
    exit_code: 0,
    stdout: json_stringify({data: {repository: {pullRequests: page}}}),
    stderr: "",
  }
}

fn page(
  numbers: list<int>,
  total: int,
  next: bool,
  cursor: string?,
  updated: string,
  merged: string?,
) -> dict {
  return {
    totalCount: total,
    pageInfo: {hasNextPage: next, endCursor: cursor},
    nodes: numbers.map({ number -> {number: number, updatedAt: updated, mergedAt: merged} })
      .to_list(),
  }
}

fn read(harness: Harness, input: SweepInput, responses: list<dict>) -> list<int> {
  return with_capability_fixtures(
    harness.testing,
    responses.map({ response -> {capability: "tools", method: "run_command", result: response} })
      .to_list(),
    { -> sweep_census(harness.tools, input) },
  )
}

pipeline test_sweep_census_reads_over_30_and_a_measured_empty_population(harness: Harness) {
  const input: SweepInput = {repo: "o/r", label: "ship", state: "OPEN", since: ""}
  const thirty_one = page(numbers(1, 32), 31, false, "end", "2026-10-27T12:00:00Z", nil)
  assert_eq(read(harness, input, [result(thirty_one), result(thirty_one)]), numbers(1, 32))
  const empty = page([], 0, false, nil, "2026-10-27T12:00:00Z", nil)
  assert_eq(read(harness, input, [result(empty), result(empty)]), [])
  const first = page(numbers(1, 101), 101, true, "next", "2026-10-27T12:00:00Z", nil)
  const last = page([101], 101, false, "end", "2026-10-26T12:00:00Z", nil)
  const measured = with_capability_fixtures(
    harness.testing,
    [result(first), result(last), result(first)].map(
      { response -> {capability: "tools", method: "run_command", result: response} },
    )
      .to_list(),
    { ->
      const found = sweep_census(harness.tools, input)
      return {
        found: found,
        calls: harness.testing.calls().map({ call -> json_stringify(call.args) }).to_list(),
      }
    },
  )
  assert_eq(measured.found, numbers(1, 102))
  assert_eq(len(measured.calls), 3)
  assert(measured.calls[1].contains("cursor=next"), "second page must use the returned cursor")
  assert(!measured.calls[2].contains("cursor=next"), "stability read must revisit the first page")
}

pipeline test_merged_sweep_stops_only_after_ordered_older_updates(harness: Harness) {
  const input: SweepInput = {repo: "o/r", label: "ship", state: "MERGED", since: "2026-10-25"}
  const recent = page(
    numbers(1, 101),
    201,
    true,
    "next",
    "2026-10-27T12:00:00Z",
    "2026-10-26T12:00:00Z",
  )
  const old = page(
    numbers(101, 201),
    201,
    true,
    "later",
    "2026-10-24T12:00:00Z",
    "2026-10-23T12:00:00Z",
  )
  assert_eq(read(harness, input, [result(recent), result(old), result(recent)]), numbers(1, 101))
  const unordered = old
    + {
      nodes: old.nodes[0:99]
        + [{number: 200, updatedAt: "2026-10-28T12:00:00Z", mergedAt: "2026-10-26T12:00:00Z"}],
    }
  const inconsistent = old
    + {
      nodes: old.nodes[0:99]
        + [{number: 200, updatedAt: "2026-10-24T12:00:00Z", mergedAt: "2026-10-26T12:00:00Z"}],
    }
  for invalid in [unordered, inconsistent] {
    const attempt = try {
      read(harness, input, [result(recent), result(invalid)])
    }
    assert(
      is_err(attempt),
      "unordered or inconsistent timestamps must not authorize an early cutoff",
    )
  }
}

pipeline test_sweep_census_refuses_partial_changed_and_duplicate_evidence(harness: Harness) {
  const input: SweepInput = {repo: "o/r", label: "ship", state: "OPEN", since: ""}
  const one = page([1], 1, false, "end", "2026-10-27T12:00:00Z", nil)
  const first = page(numbers(1, 101), 101, true, "next", "2026-10-27T12:00:00Z", nil)
  const duplicate = page([1], 101, false, "end", "2026-10-26T12:00:00Z", nil)
  const changed = page([2], 1, false, "end", "2026-10-27T12:00:00Z", nil)
  const errors = result(one)
    + {
      stdout: json_stringify(
        {data: {repository: {pullRequests: one}}, errors: [{message: "partial"}]},
      ),
    }
  for responses in [
    [result(page([1], 2, false, "end", "2026-10-27T12:00:00Z", nil))],
    [result(first), result(duplicate)],
    [result(one), result(changed)],
    [errors],
    [result(one) + {stdout_truncated: true}],
  ] {
    const attempt = try {
      read(harness, input, responses)
    }
    assert(is_err(attempt), "incomplete or changing evidence must refuse")
  }
}
