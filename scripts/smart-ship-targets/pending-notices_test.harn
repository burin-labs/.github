import { pending_notice_numbers } from "./pending-notices"

pipeline test_pending_notice_census_reports_real_numbers_and_a_measured_zero() {
  const listing = {
    repository: {
      pullRequests: {
        totalCount: 2,
        pageInfo: {hasNextPage: false},
        nodes: [{number: 7}, {number: 9}],
      },
    },
  }
  assert_eq(pending_notice_numbers(listing), [7, 9])
  assert_eq(
    pending_notice_numbers(
      {repository: {pullRequests: listing.repository.pullRequests + {totalCount: 0, nodes: []}}},
    ),
    [],
  )
  for invalid in [
    {repository: nil},
    {repository: {pullRequests: listing.repository.pullRequests + {pageInfo: {hasNextPage: true}}}},
    {repository: {pullRequests: listing.repository.pullRequests + {totalCount: 3}}},
    {
      repository: {
        pullRequests: listing.repository.pullRequests + {nodes: [{number: 7}, {number: 7}]},
      },
    },
  ] {
    const refused = try {
      pending_notice_numbers(invalid)
      false
    } catch (_) {
      true
    }
    assert(refused, "a missing, partial, or duplicate census cannot authorize a sweep")
  }
}
