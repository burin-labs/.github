/** Complete, stable pull request census for scheduled Smart Ship looks. */
import { parse_args } from "std/cli"
import { command_run } from "std/command"

type Pull = {number: int, updatedAt: string, mergedAt: string?}

type Page = {totalCount: int, pageInfo: {hasNextPage: bool, endCursor: string?}, nodes: list<Pull>}

type Response = {data: {repository: {pullRequests: Page}?}?, errors?: list<unknown>?}

pub type SweepInput = {repo: string, label: string, state: string, since: string}

const QUERY = """
query($owner: String!, $name: String!, $label: String!, $state: PullRequestState!, $cursor: String) {
  repository(owner: $owner, name: $name) {
    pullRequests(first: 100, after: $cursor, states: [$state], labels: [$label], orderBy: {field: UPDATED_AT, direction: DESC}) {
      totalCount
      pageInfo { hasNextPage endCursor }
      nodes { number updatedAt mergedAt }
    }
  }
}
"""

fn read_page(
  tools: HarnessTools,
  repo: list<string>,
  label: string,
  state: string,
  cursor: string,
) -> Page {
  const args = [
    "gh",
    "api",
    "graphql",
    "-f",
    "query=${QUERY}",
    "-f",
    "owner=${repo[0]}",
    "-f",
    "name=${repo[1]}",
    "-f",
    "label=${label}",
    "-f",
    "state=${state}",
  ]
    + (cursor == "" ? [] : ["-f", "cursor=${cursor}"])
  const result = command_run(tools, args)
  require result.success && !(result?.stdout_truncated ?? false), "sweep census page is unreadable"
  const response: Response = schema_expect(json_parse(result.stdout), schema_of(Response))
  require response.errors == nil || len(response.errors) == 0,
    "sweep census returned GraphQL errors"
  const page = response.data?.repository?.pullRequests
  require page != nil, "sweep census repository or page is absent"
  return unwrap(page)
}

/** Return every open PR, or every merged PR on or after a UTC date. */
pub fn sweep_census(tools: HarnessTools, input: SweepInput) -> list<int> {
  const {repo, label, state, since} = input
  const parts = split(repo, "/")
  require len(parts) == 2 && parts[0] != "" && parts[1] != "", "sweep repository must be owner/name"
  require label != "" && ["OPEN", "MERGED"].contains(state), "sweep label or state is invalid"
  require state == "OPEN" || regex_match("^[0-9]{4}-[0-9]{2}-[0-9]{2}$", since) != nil,
    "merged sweep needs a UTC cutoff date"
  const cutoff = state == "MERGED" ? date_parse("${since}T00:00:00Z") : 0
  let cursor = ""
  let seen_cursors = []
  let numbers = []
  let seen_numbers = []
  let total = -1
  let first: Page? = nil
  let previous: float = 0.0
  let finished = false
  for _ in range(0, 10) {
    const page = read_page(tools, parts, label, state, cursor)
    if first == nil {
      first = page
    }
    require page.totalCount >= 0 && (total < 0 || total == page.totalCount),
      "sweep census total changed between pages"
    total = page.totalCount
    require len(page.nodes) <= 100 && len(seen_numbers) + len(page.nodes) <= total,
      "sweep census exceeds its declared population"
    let crossed_cutoff = false
    for pull in page.nodes {
      require pull.number > 0 && !seen_numbers.contains(pull.number),
        "sweep census has an invalid or duplicate change"
      const updated = date_parse(pull.updatedAt)
      require updated > 0 && (previous == 0 || updated <= previous), "sweep census order is invalid"
      previous = updated
      seen_numbers = seen_numbers + [pull.number]
      if state == "MERGED" {
        require pull.mergedAt != nil, "merged sweep has an unmerged row"
        const merged = date_parse(unwrap(pull.mergedAt))
        require merged > 0 && merged <= updated, "merged sweep timestamps are inconsistent"
        if updated < cutoff {
          crossed_cutoff = true
        }
        if merged >= cutoff {
          numbers = numbers + [pull.number]
        }
      } else {
        numbers = numbers + [pull.number]
      }
    }
    if !page.pageInfo.hasNextPage {
      require len(seen_numbers) == total, "sweep census ended before its declared population"
      finished = true
      break
    }
    require len(page.nodes) == 100 && page.pageInfo.endCursor != nil,
      "sweep census has an incomplete page"
    if crossed_cutoff {
      finished = true
      break
    }
    const next = unwrap(page.pageInfo.endCursor)
    require next != "" && !seen_cursors.contains(next), "sweep census cursor repeated"
    seen_cursors = seen_cursors + [next]
    cursor = next
  }
  require finished, "sweep census exceeded its 1000-row bound"
  require read_page(tools, parts, label, state, "") == first,
    "sweep census changed during enumeration"
  return numbers
}

fn main(harness: Harness) {
  const args = parse_args(
    argv,
    [
      {kind: "option", name: "repo", flags: ["--repo"], default: ""},
      {kind: "option", name: "label", flags: ["--label"], default: "ship"},
      {kind: "option", name: "state", flags: ["--state"], default: ""},
      {kind: "option", name: "since", flags: ["--since"], default: ""},
    ],
  )
  const numbers = sweep_census(
    harness.tools,
    {
      repo: to_string(args.repo),
      label: to_string(args.label),
      state: to_string(args.state),
      since: to_string(args.since),
    },
  )
  harness.stdio.eprintln(
    "sweep census ${to_string(args.state)}: selected=${to_string(len(numbers))}, pending=0, failed=none",
  )
  harness.stdio.println(join(numbers.map({ number -> to_string(number) }).to_list(), " "))
}
