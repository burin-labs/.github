import { with_temp_dir } from "std/testing"
import { selected_targets } from "./lib.harn"

const INPUT = {
  repository: "o/r",
  workflow_ref: "o/r/.github/workflows/smart-ship.yml@refs/heads/main",
  run_id: 150,
  attempt: 2,
  numbers: "7 8",
}

pipeline test_exact_selection_is_bound_to_the_original_run_attempt() {
  assert_eq(
    selected_targets(INPUT),
    {
      schema: 1,
      repository: "o/r",
      workflow: "smart-ship.yml",
      run_id: 150,
      attempt: 2,
      prs: [7, 8],
    },
  )
  assert_eq(selected_targets(INPUT + {numbers: ""}).prs, [])
}

pipeline test_missing_invalid_or_foreign_identity_refuses_publication() {
  for changed in [
    INPUT + {numbers: nil},
    INPUT + {numbers: "7 7"},
    INPUT + {numbers: "0"},
    INPUT + {numbers: "7 nope"},
    INPUT + {numbers: "7\n8"},
    INPUT + {run_id: 0},
    INPUT + {attempt: 0},
    INPUT + {workflow_ref: "other/repo/.github/workflows/smart-ship.yml@refs/heads/main"},
  ] {
    const result = try {
      selected_targets(changed)
    }
    assert(is_err(result), json_stringify(changed))
  }
}

pipeline test_cli_writes_the_original_population_and_refuses_invalid_data(harness: Harness) {
  with_temp_dir(
    harness.fs,
    fn(temp) {
      const output = path_join(temp, "targets.json")
      const env = {
        PATH: harness.env.get("PATH") ?? "",
        HOME: harness.env.get("HOME") ?? "",
        BURIN_SKIP_KEYCHAIN: "1",
        GITHUB_REPOSITORY: INPUT.repository,
        GITHUB_WORKFLOW_REF: INPUT.workflow_ref,
        GITHUB_RUN_ID: to_string(INPUT.run_id),
        GITHUB_RUN_ATTEMPT: to_string(INPUT.attempt),
        NUMBERS: "7 8",
        DEFERRED: "8",
      }
      for numbers in ["7 8", "", "0"] {
        const ran = harness.process.run(
          {
            program: "harn",
            args: [
              "run",
              "--no-sandbox",
              path_join(harness.fs.source_dir(), "cli.harn"),
              "--",
              "--output",
              output,
            ],
            env: env + {NUMBERS: numbers},
            timeout_ms: 30000,
          },
        )
        assert_eq(ran.success, numbers != "0", ran.stdout + ran.stderr)
        if ran.success {
          assert_eq(
            json_parse(harness.fs.read_text(output)),
            selected_targets(INPUT + {numbers: numbers}),
          )
        }
      }
    },
  )
}
