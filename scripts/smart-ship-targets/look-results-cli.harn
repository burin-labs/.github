import { selected_targets } from "./lib.harn"
import {
  LookArtifact,
  LookResult,
  deferred_looks,
  look_groups,
  look_result_name,
} from "./look-results.harn"

fn required(env: HarnessEnv, name: string) -> string {
  const value = env.get(name) ?? ""
  require value != "", name + " is required"
  return value
}

fn selection(env: HarnessEnv, numbers: string?) {
  return selected_targets(
    {
      repository: required(env, "GITHUB_REPOSITORY"),
      workflow_ref: required(env, "GITHUB_WORKFLOW_REF"),
      run_id: to_int(env.get("GITHUB_RUN_ID")) ?? 0,
      attempt: to_int(env.get("GITHUB_RUN_ATTEMPT")) ?? 0,
      numbers: numbers,
    },
  )
}

fn main(harness: Harness) {
  if argv == ["groups"] {
    const selected = selection(harness.env, harness.env.get("NUMBERS"))
    const groups = look_groups(selected)
    const output = "groups_json="
      + json_stringify(
        groups.filter({ group -> len(group) > 0 }).map({ group -> {prs: group} }).to_list(),
      )
      + "\n"
    harness.fs.append(required(harness.env, "GITHUB_OUTPUT"), output)
    harness.stdio.println("look selection: selected=${to_string(len(selected.prs))}, pending=0")
    return
  }
  if argv == ["result"] {
    const selected = selection(harness.env, required(harness.env, "LOOK_PR"))
    require len(selected.prs) == 1, "a look result needs one PR"
    const outcome = required(harness.env, "LOOK_OUTCOME")
    require ["complete", "deferred"].contains(outcome), "look did not finish successfully"
    const pr = selected.prs[0] ?? 0
    const result: LookResult = {
      schema: 1,
      repository: selected.repository,
      workflow: selected.workflow,
      run_id: selected.run_id,
      attempt: selected.attempt,
      pr: pr,
      outcome: outcome,
    }
    const path = required(harness.env, "LOOK_RESULT_PATH")
    harness.fs.mkdir(dirname(path) ?? ".", true)
    harness.fs.write_text(path, json_stringify(result) + "\n")
    harness.stdio.println(look_result_name(selected, pr))
    return
  }
  if argv == ["reduce"] {
    const selected = selection(harness.env, harness.env.get("NUMBERS"))
    const root = required(harness.env, "LOOK_RESULTS_ROOT")
    require harness.fs.exists(root), "look result directory is absent"
    let artifacts: list<LookArtifact> = []
    for path in harness.fs.glob("*/result.json", {base: root}) {
      const result: LookResult = schema_expect(
        json_parse(harness.fs.read_text(path)),
        schema_of(LookResult),
      )
      artifacts = artifacts + [{name: basename(dirname(path)), result: result}]
    }
    const deferred = deferred_looks(selected, artifacts)
    harness.fs.append(
      required(harness.env, "GITHUB_OUTPUT"),
      "deferred=" + join(deferred.map({ pr -> to_string(pr) }).to_list(), " ") + "\n"
        + "deferred_json="
        + json_stringify(deferred)
        + "\n",
    )
    harness.stdio.println(
      "look census: selected=${to_string(len(selected.prs))}, pending=0, failed=none, deferred=${to_string(len(deferred))}",
    )
    return
  }
  throw "expected groups, result, or reduce"
}
