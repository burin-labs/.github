import { with_temp_dir } from "std/testing"
import { selected_targets } from "./lib.harn"
import { look_result_name } from "./look-results.harn"

pipeline test_real_look_result_cli_requires_the_complete_same_attempt_census(harness: Harness) {
  with_temp_dir(
    harness.fs,
    { temp ->
      const root = temp.starts_with("/") ? temp : path_join(harness.fs.cwd(), temp)
      const output = path_join(root, "outputs")
      harness.fs.write_text(output, "")
      const selected = selected_targets(
        {
          repository: "o/r",
          workflow_ref: "o/r/.github/workflows/ship.yml@refs/heads/main",
          run_id: 150,
          attempt: 2,
          numbers: "7 8 9",
        },
      )
      const env = {
        PATH: harness.env.get("PATH") ?? "",
        HOME: harness.env.get("HOME") ?? "",
        GITHUB_REPOSITORY: "o/r",
        GITHUB_WORKFLOW_REF: "o/r/.github/workflows/ship.yml@refs/heads/main",
        GITHUB_RUN_ID: "150",
        GITHUB_RUN_ATTEMPT: "2",
        GITHUB_OUTPUT: output,
        NUMBERS: "7 8 9",
        LOOK_RESULTS_ROOT: root,
      }
      const cli = path_join(harness.fs.source_dir(), "look-results-cli.harn")
      const groups = harness.process.run(
        {
          program: "harn",
          args: ["run", "--no-sandbox", cli, "--", "groups"],
          env: env,
          timeout_ms: 30000,
        },
      )
      assert(groups.success, groups.stderr)
      assert_eq(
        harness.fs.read_text(output),
        "groups_json=[{\"prs\":[7]},{\"prs\":[8]},{\"prs\":[9]}]\n",
      )
      harness.fs.write_text(output, "")
      const empty_groups = harness.process.run(
        {
          program: "harn",
          args: ["run", "--no-sandbox", cli, "--", "groups"],
          env: env + {NUMBERS: ""},
          timeout_ms: 30000,
        },
      )
      assert(empty_groups.success, empty_groups.stderr)
      assert_eq(harness.fs.read_text(output), "groups_json=[]\n")
      harness.fs.write_text(output, "")
      for pr in [7, 8] {
        const path = path_join(root, look_result_name(selected, pr), "result.json")
        const result = harness.process.run(
          {
            program: "harn",
            args: ["run", "--no-sandbox", cli, "--", "result"],
            env: env
              + {
                LOOK_PR: to_string(pr),
                LOOK_OUTCOME: pr == 8 ? "deferred" : "complete",
                LOOK_RESULT_PATH: path,
              },
            timeout_ms: 30000,
          },
        )
        assert(result.success, result.stderr)
        assert(harness.fs.exists(path), "worker must produce its own result")
      }
      const reduce_args = ["run", "--no-sandbox", cli, "--", "reduce"]
      const partial = harness.process.run(
        {program: "harn", args: reduce_args, env: env, timeout_ms: 30000},
      )
      assert(!partial.success, "a missing worker must refuse to authorize repair")
      assert_eq(harness.fs.read_text(output), "", "failure must publish no outputs")
      const last = harness.process.run(
        {
          program: "harn",
          args: ["run", "--no-sandbox", cli, "--", "result"],
          env: env
            + {
              LOOK_PR: "9",
              LOOK_OUTCOME: "complete",
              LOOK_RESULT_PATH: path_join(root, look_result_name(selected, 9), "result.json"),
            },
          timeout_ms: 30000,
        },
      )
      assert(last.success, last.stderr)
      const complete = harness.process.run(
        {program: "harn", args: reduce_args, env: env, timeout_ms: 30000},
      )
      assert(complete.success, complete.stderr)
      assert_eq(harness.fs.read_text(output), "deferred=8\ndeferred_json=[8]\n")
    },
  )
}
