import { command_run } from "std/command"
import { read_yaml } from "std/fs"
import { with_temp_dir } from "std/testing"

/**
 * Run the actual reaper against a stubbed GitHub: it cancels a queued run none
 * of whose jobs started, and leaves one that only reads queued because its
 * later jobs wait for runners.
 */
pipeline test_a_sweep_cancels_only_runs_that_never_started(harness: Harness) {
  const steps = read_yaml(harness.fs, "../../.github/workflows/smart-ship.yml").jobs.ship.steps
  const reaper = steps.find({ step -> step?.name == "Cancel stale queued Smart Ship runs" }).run
  assert(type_of(reaper) == "string" && reaper != "")
  for row in [
    // A wake stuck on a down pool: its probe was skipped, its look never started.
    {jobs: "[]", cancelled: true},
    {
      jobs: "[{\"status\":\"completed\",\"conclusion\":\"skipped\"},{\"status\":\"queued\"}]",
      cancelled: true,
    },
    // A sweep whose look finished and whose repairs wait for or hold runners.
    {
      jobs: "[{\"status\":\"completed\",\"conclusion\":\"success\"},{\"status\":\"queued\"}]",
      cancelled: false,
    },
    {jobs: "[{\"status\":\"in_progress\"},{\"status\":\"queued\"}]", cancelled: false},
    // Unreadable jobs leave the run alone.
    {jobs: "unreadable", cancelled: false},
  ] {
    with_temp_dir(
      harness.fs,
      { temp ->
        const root = temp.starts_with("/") ? temp : path_join(harness.fs.cwd(), temp)
        const calls = root + "/calls"
        const source = root + "/reaper.sh"
        harness.fs.write_text(calls, "")
        harness.fs.write_text(root + "/jobs.json", "{\"jobs\":" + row.jobs + "}")
        harness.fs.write_text(source, reaper)
        harness.fs.write_text(root + "/date", "#!/bin/sh\nprintf '%s\\n' '2026-10-24T07:13:00Z'\n")
        harness.fs.write_text(
          root + "/gh",
          """
#!/bin/sh
printf '%s\n' "$*" >> "$FIXTURE_CALLS"
case "$*" in
  "run list"*) printf '%s\n' 41 ;;
  "api repos/example/repo/actions/runs/41/jobs"*)
    if [ "$(cat "$FIXTURE_ROOT/jobs.json")" = '{"jobs":unreadable}' ]; then exit 22; fi
    filter="$(printf '%s\n' "$@" | tail -n 1)"
    jq "$filter" "$FIXTURE_ROOT/jobs.json"
    ;;
  "run cancel 41 -R example/repo") ;;
  *) exit 93 ;;
esac
""",
        )
        assert(
          command_run(harness.tools, {argv: ["/bin/chmod", "+x", root + "/gh", root + "/date"]})
            .success,
        )
        const result = command_run(
          harness.tools,
          {
            argv: [
              "/usr/bin/env",
              "-i",
              "PATH=" + root + ":/opt/homebrew/bin:/usr/bin:/bin",
              "REPO=example/repo",
              "RUN_ID=99",
              "WORKFLOW_REF=example/repo/.github/workflows/smart-ship.yml@refs/heads/main",
              "FIXTURE_CALLS=" + calls,
              "FIXTURE_ROOT=" + root,
              "/bin/bash",
              source,
            ],
          },
        )
        assert(result.success, row.jobs + ": " + to_string(result))
        const observed = harness.fs.read_text(calls)
        assert(
          observed.contains("actions/runs/41/jobs"),
          "the job census must be reached: " + observed,
        )
        assert_eq(observed.contains("run cancel 41"), row.cancelled, row.jobs + ": " + observed)
      },
    )
  }
}
