import { command_run } from "std/command"
import { read_yaml } from "std/fs"
import { with_temp_dir } from "std/testing"

/** Run the actual bootstrap collector; never let a partial sweep look empty. */
pipeline test_target_collection_requires_every_census_before_publishing(harness: Harness) {
  const workflow = read_yaml(harness.fs, "../../.github/workflows/smart-ship.yml")
  const collector = workflow.jobs.ship.steps.find({ step -> step?.id == "prs" }).run
  assert(type_of(collector) == "string" && collector != "")
  for row in [
    {mode: "open-failed", calls: 1, success: false, output: ""},
    {mode: "merged-failed", calls: 2, success: false, output: ""},
    {mode: "success", calls: 3, success: true, output: "numbers=15 7 9"},
    {mode: "notice-failed", calls: 3, success: false, output: ""},
    {mode: "empty", calls: 3, success: true, output: "numbers="},
    {mode: "direct", calls: 0, success: true, output: "numbers=11"},
    // A finished run on main looks only at the PRs the lister says wait on main.
    {mode: "main-waiting", calls: 0, success: true, output: "numbers=4 5"},
    {mode: "main-none", calls: 0, success: true, output: "numbers="},
    {mode: "main-unreadable", calls: 3, success: true, output: "numbers=15 7 9"},
    {mode: "main-failed", calls: 0, success: false, output: ""},
  ] {
    with_temp_dir(
      harness.fs,
      { temp ->
        const root = temp.starts_with("/") ? temp : path_join(harness.fs.cwd(), temp)
        const calls = root + "/calls"
        const output = root + "/output"
        const event = root + "/event.json"
        const source = root + "/collector.sh"
        harness.fs.write_text(calls, "")
        harness.fs.write_text(output, "")
        harness.fs.write_text(
          event,
          json_stringify(
            if row.mode == "direct" {
              {pull_request: {number: 11}}
            } else if row.mode.starts_with("main-") {
              {workflow_run: {event: "push", head_branch: "main", pull_requests: []}}
            } else {
              {}
            },
          ),
        )
        harness.fs.mkdir(root + "/scripts")
        harness.fs.write_text(
          root + "/scripts/harnw",
          """
#!/bin/sh
case "$*" in
  *".smart-ship-census/scripts/smart-ship-targets/sweep-census.harn -- --repo example/repo"*)
    printf '%s\n' "$*" >> "$FIXTURE_CALLS"
    case "$*" in
      *"--label ship --state OPEN")
        if [ "$FIXTURE_MODE" = open-failed ]; then exit 22; fi
        if [ "$FIXTURE_MODE" != empty ]; then echo 7; fi ;;
      *"--label ship --state MERGED --since 2026-10-10")
        if [ "$FIXTURE_MODE" = merged-failed ]; then exit 23; fi
        if [ "$FIXTURE_MODE" != empty ]; then echo 9; fi ;;
      *"--label ship-needs-you --state OPEN")
        if [ "$FIXTURE_MODE" = notice-failed ]; then exit 96; fi
        if [ "$FIXTURE_MODE" != empty ]; then echo "7 15"; fi ;;
      *) exit 93 ;;
    esac
    exit 0
    ;;
  *"scripts/smart-ship-waiting.harn -- --repo example/repo --label ship") ;;
  *) exit 94 ;;
esac
echo "harn: fetched"
case "$FIXTURE_MODE" in
  main-waiting) echo "4 5" ;;
  main-none) echo "" ;;
  main-unreadable) echo "--all" ;;
  *) exit 95 ;;
esac
""",
        )
        harness.fs.write_text(source, collector)
        harness.fs.write_text(root + "/date", "#!/bin/sh\nprintf '%s\\n' '2026-10-10'\n")
        assert(
          command_run(
            harness.tools,
            {argv: ["/bin/chmod", "+x", root + "/date", root + "/scripts/harnw"]},
          ).success,
        )
        const result = command_run(
          harness.tools,
          {
            argv: [
              "/usr/bin/env",
              "-i",
              "PATH=" + root + ":/opt/homebrew/bin:/usr/bin:/bin",
              "GITHUB_EVENT_PATH=" + event,
              "GITHUB_OUTPUT=" + output,
              "REPO=example/repo",
              "LABEL=ship",
              "FIXTURE_MODE=" + row.mode,
              "FIXTURE_CALLS=" + calls,
              "/bin/bash",
              source,
            ],
            cwd: root,
          },
        )
        assert_eq(result.success, row.success, row.mode + ": " + to_string(result))
        const emitted = trim(harness.fs.read_text(output))
        assert_eq(emitted, row.output, row.mode)
        const observed = trim(harness.fs.read_text(calls))
        const count = observed == "" ? 0 : len(split(observed, "\n"))
        assert_eq(count, row.calls, row.mode)
        if row.calls > 0 {
          assert(observed.contains("--label ship --state OPEN"), "open census must be reached")
        }
        if row.calls >= 2 {
          assert(observed.contains("--state MERGED"), "merged census must be reached")
        }
        if row.calls == 3 {
          assert(
            observed.contains("--label ship-needs-you --state OPEN"),
            "notice census must be reached",
          )
        }
      },
    )
  }
}
