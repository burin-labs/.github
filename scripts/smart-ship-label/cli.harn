import { read_yaml } from "std/fs"
import { live_github } from "../merge-override/github.harn"
import { reconcile, ship_label } from "./policy.harn"

fn required_env(env: HarnessEnv, name: string) -> string {
  const value = trim(env.get(name) ?? "")
  if value == "" {
    throw name + " is required"
  }
  return value
}

fn option(name: string) -> string {
  const index = argv.index_of(name)
  if index < 0 || index + 1 >= len(argv) {
    throw name + " is required"
  }
  return argv[index + 1]
}

fn main(harness: Harness) {
  const repository = option("--repo")
  const expected_label = option("--label")
  const registry = option("--registry")
  const github = live_github(
    pick(harness, ["fs", "tools"]),
    required_env(harness.env, "GH_TOKEN"),
    harness.fs.mkdtemp_in_workspace("smart-ship-label-gh-"),
  )
  const spec = ship_label(read_yaml(harness.fs, registry))
  if expected_label != spec.name {
    throw "ship-label input " + expected_label + " disagrees with canonical label " + spec.name
  }
  const result = reconcile(github, repository, spec)
  harness.stdio.println(json_stringify(result))
}
