import { read_yaml } from "std/fs"
import { CONTROL_POLICY_SOURCE, control_policy_source, ship_label } from "./policy.harn"

fn expression(value: string) -> string {
  return "$" + "{{ " + value + " }}"
}

fn named(steps: list, name: string) -> dict {
  const matches = steps.filter(fn(step) { return step?.name == name }).to_list()
  assert_eq(len(matches), 1, name)
  return matches[0] ?? {}
}

pipeline test_repair_bootstrap_provisions_the_declared_package_manager(harness: Harness) {
  const workflow = read_yaml(harness.fs, "../../.github/workflows/smart-ship.yml")
  const steps = workflow.jobs.ship.steps
  const node = named(steps, "Set up Node")
  const package_manager = named(steps, "Set up the repair package manager")
  const shepherd = named(steps, "Shepherd")
  assert_eq(package_manager["if"], "inputs.repair && steps.prs.outputs.numbers != ''")
  assert_eq(package_manager.uses, "pnpm/action-setup@ea17c68df8912ef543352723c149a84f56e3d413")
  // The action reads packageManager from the checked-out repository instead
  // of duplicating a version here or installing its controller dependencies.
  assert_eq(package_manager["with"].run_install, false)
  assert_eq(package_manager["with"].dest, expression("runner.temp") + "/smart-ship-pnpm")
  assert_eq(package_manager["with"]?.version, nil)
  assert(steps.index_of(node) < steps.index_of(package_manager))
  assert(steps.index_of(package_manager) < steps.index_of(shepherd))
}

/** Unset, the shepherd reads its own queue removals as a person's (burin-code#10624). */
pipeline test_shepherd_knows_the_bot_its_token_acts_as(harness: Harness) {
  const workflow = read_yaml(harness.fs, "../../.github/workflows/smart-ship.yml")
  const steps = workflow.jobs.ship.steps
  const shepherd = named(steps, "Shepherd")
  assert_eq(named(steps, "Mint the release app token").id, "app")
  assert_eq(shepherd.env.GH_TOKEN, expression("steps.app.outputs.token"))
  assert_eq(shepherd.env.BURIN_SHIP_BOT_LOGIN, expression("steps.app.outputs.app-slug"))
}

pipeline test_shared_workflow_reconciles_its_canonical_label_before_discovery(harness: Harness) {
  const workflow = read_yaml(harness.fs, "../../.github/workflows/smart-ship.yml")
  const steps = workflow.jobs.ship.steps
  const checkout = named(steps, "Check out the Smart Ship control policy")
  assert_eq(control_policy_source(checkout["with"]), CONTROL_POLICY_SOURCE)
  assert_eq(checkout["with"].path, ".smart-ship-runner")
  assert_eq(checkout["with"]["persist-credentials"], false)
  const reconcile_step = named(steps, "Reconcile the Smart Ship control label")
  assert_eq(reconcile_step.env.GH_TOKEN, expression("steps.app.outputs.token"))
  assert_eq(reconcile_step.env.REPO, expression("github.repository"))
  assert(reconcile_step.run.contains("scripts/smart-ship-label/cli.harn"))
  assert(reconcile_step.run.contains("--label \"" + expression("inputs.ship-label") + "\""))
  assert(reconcile_step.run.contains("--registry .smart-ship-runner/.github/labels.yml"))
  const reconcile_index = steps.index_of(reconcile_step)
  const discovery_index = steps.index_of(named(steps, "Find the pull requests to look at"))
  assert(reconcile_index >= 0 && reconcile_index < discovery_index)
  assert_eq(ship_label(read_yaml(harness.fs, "../../.github/labels.yml")).name, "ship")
}

pipeline test_wrong_repository_or_caller_revision_is_refused() {
  assert_eq(control_policy_source(CONTROL_POLICY_SOURCE), CONTROL_POLICY_SOURCE)
  for checkout in [
    {repository: "example/consumer", ref: CONTROL_POLICY_SOURCE.ref},
    {repository: CONTROL_POLICY_SOURCE.repository, ref: expression("github.workflow_sha")},
    {repository: CONTROL_POLICY_SOURCE.repository, ref: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"},
    {repository: CONTROL_POLICY_SOURCE.repository},
    nil,
  ] {
    const refusal = try {
      control_policy_source(checkout)
      ""
    } catch (error) {
      to_string(error)
    }
    assert(refusal.contains("control policy source"), refusal)
  }
}

pipeline test_only_private_callers_can_hand_in_an_owned_runner(harness: Harness) {
  const workflow = read_yaml(harness.fs, "../../.github/workflows/smart-ship.yml")
  const input = workflow.on.workflow_call.inputs["owned-runner"]
  assert_eq(input.type, "string")
  assert_eq(input["default"], "")
  const runs_on = workflow.jobs.ship["runs-on"]
  // Hosted is both the default and the fallback, and an owned runner needs a
  // caller on the private allowlist: a public repository's run must never
  // land on an owned host, whatever it passes.
  assert(runs_on.ends_with("|| 'ubuntu-24.04' }}"), runs_on)
  const listed = regex_captures("contains\\(fromJSON\\('(\\[[^']*\\])'\\), github\\.repository\\)", runs_on)
  assert_eq(len(listed), 1, runs_on)
  assert_eq(json_parse(listed[0].groups[0]), ["burin-labs/burin-code", "burin-labs/harn-cloud"])
  assert(runs_on.contains("inputs.owned-runner != '' && contains("), runs_on)
}
