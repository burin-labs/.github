/**
 * The override's GitHub reads and writes, over a `GitHub` client so tests can
 * replay a recorded world. Policy lives in policy.harn.
 */
import { GitHub } from "./github.harn"
import {
  ACTIVE_RUN_STATUSES,
  Actor,
  Facts,
  Incident,
  MAIN_RED_TITLES,
  QUEUE_BYPASS_LABELS,
  REQUIRED_CHECK,
  Request,
  decide,
  issue_events_from_pages,
  log_entry_markdown,
  log_issue_title,
  main_red_signal,
  queue_wedged_signal,
  release_train_signal,
  resolve_request,
  select_competing_runs,
  unmeasured,
} from "./policy.harn"

pub const LOG_LABEL = "override-log"

const CANCEL_WAIT_MS = 600000

const FORCE_CANCEL_AFTER_MS = 120000

const REVIEW_QUERY =
  "query($owner:String!,$name:String!,$number:Int!){repository(owner:$owner,name:$name){pullRequest(number:$number){reviewDecision}}}"

const DEQUEUE_MUTATION =
  "mutation($id:ID!){dequeuePullRequest(input:{id:$id}){mergeQueueEntry{id}}}"

pub type Input = {
  repository: string,
  organization: string,
  pr: int,
  head_sha: string,
  run_url: string,
  /** ISO time of the decision, the clock the queue-wedge threshold reads. */
  now: string,
}

fn issue(input: Input) -> string {
  return "repos/" + input.repository + "/issues/" + to_string(input.pr)
}

fn flat(pages: list) -> list {
  let items = []
  for page in pages {
    if type_of(page) != "list" {
      throw "paginated census page was not an array"
    }
    items = items + page
  }
  return items
}

/** The attached override request: labels on the PR and the events that attached them. */
pub fn current_request(gh: GitHub, input: Input) -> Request {
  const labels = (gh.read(issue(input))?.labels ?? []).map({ label -> label?.name })
  return resolve_request(
    labels,
    issue_events_from_pages(gh.pages(issue(input) + "/events?per_page=100")),
  )
}

/** A login's admin standing; an unreadable role reads as `none`, which refuses. */
fn actor(gh: GitHub, input: Input, login: string) -> Actor {
  const role = try {
    gh.read("orgs/" + input.organization + "/memberships/" + login)?.role ?? "none"
  } catch (error) {
    "none"
  }
  const permission = try {
    gh.read("repos/" + input.repository + "/collaborators/" + login + "/permission")?.permission
      ?? "none"
  } catch (error) {
    "none"
  }
  return {login: login, membership_role: role, repository_permission: permission}
}

const QUEUE_QUERY =
  "query($owner:String!,$name:String!,$branch:String!){repository(owner:$owner,name:$name){mergeQueue(branch:$branch){entries(first:100){totalCount nodes{enqueuedAt pullRequest{number}}}}}}"

const MAIN_RUN_WINDOW = 50

/** Percent-encode the characters an issue-title search term carries. */
fn query_term(title: string) -> string {
  return "%22" + title.replace(" ", "+").replace("[", "%5B").replace("]", "%5D") + "%22"
}

fn main_red(gh: GitHub, input: Input, base_branch: string) {
  let issues = []
  let runs = []
  let errors = []
  for title in MAIN_RED_TITLES {
    try {
      const found = gh.read(
        "search/issues?q=repo:" + input.repository + "+is:issue+is:open+in:title+"
          + query_term(title),
      )
      const matches = (found?.items ?? []).filter(
        { item -> to_string(item?.title).starts_with(title) },
      )
        .to_list()
      if len(matches) == 0 && found?.incomplete_results == true {
        throw "the issue search was incomplete"
      }
      issues = issues + matches
    } catch (error) {
      errors = errors + ["issue search for `" + title + "`: " + to_string(error)]
    }
  }
  try {
    runs = gh.read(
      "repos/" + input.repository + "/actions/runs?branch=" + base_branch
        + "&exclude_pull_requests=true&per_page="
        + to_string(MAIN_RUN_WINDOW),
    )?.workflow_runs
      ?? []
  } catch (error) {
    errors = errors + ["base branch runs: " + to_string(error)]
  }
  return main_red_signal(issues, runs, errors)
}

fn release_train(gh: GitHub, input: Input, labels: list) {
  try {
    const files = flat(
      gh.pages(
        "repos/" + input.repository + "/pulls/" + to_string(input.pr) + "/files?per_page=100",
      ),
    )
    return release_train_signal(
      files.map({ file -> to_string(file?.filename) }),
      labels.map({ label -> to_string(label?.name) }),
    )
  } catch (error) {
    return unmeasured("pull request files: " + to_string(error))
  }
}

fn queue_wedged(gh: GitHub, input: Input, base_branch: string) {
  try {
    const owner_name = input.repository.split("/")
    const queue = gh.graphql(
      QUEUE_QUERY,
      {owner: owner_name[0], name: owner_name[1], branch: base_branch},
    )?.repository?.mergeQueue?.entries
    if queue == nil {
      return {state: "no", detail: "the base branch has no merge queue"}
    }
    const entries = queue?.nodes ?? []
    const entry = entries.filter({ item -> item?.pullRequest?.number == input.pr }).to_list()[0]
    let active = []
    // Active merge group runs matter only once the entry is old enough to be wedged.
    if entry != nil {
      for status in ACTIVE_RUN_STATUSES {
        active = active
          + (gh.read(
            "repos/" + input.repository + "/actions/runs?event=merge_group&status=" + status
              + "&per_page=100",
          )?.workflow_runs
            ?? [])
            .filter(
              { run ->
                to_string(run?.head_branch).starts_with("gh-readonly-queue/" + base_branch + "/")
              },
            )
            .to_list()
      }
    }
    return queue_wedged_signal(
      entries,
      to_int(queue?.totalCount ?? len(entries)),
      input.pr,
      active,
      input.now,
    )
  } catch (error) {
    return unmeasured("merge queue: " + to_string(error))
  }
}

/** Every incident signal, each measured on its own so one failed read hides no other. */
fn measure_incident(gh: GitHub, input: Input, base_branch: string, labels: list) -> Incident {
  if base_branch == "" {
    const missing = unmeasured("the pull request names no base branch")
    return {
      main_red: missing,
      release_train: release_train(gh, input, labels),
      queue_wedged: missing,
    }
  }
  return {
    main_red: main_red(gh, input, base_branch),
    release_train: release_train(gh, input, labels),
    queue_wedged: queue_wedged(gh, input, base_branch),
  }
}

/** Measure everything the decision reads. Nil when no override label is attached. */
pub fn measure(gh: GitHub, input: Input) -> Facts? {
  const request = current_request(gh, input)
  if request.label == nil {
    return nil
  }
  const pull = gh.read("repos/" + input.repository + "/pulls/" + to_string(input.pr))
  const owner_name = input.repository.split("/")
  const review = gh.graphql(
    REVIEW_QUERY,
    {owner: owner_name[0], name: owner_name[1], number: input.pr},
  )
  return {
    repository: input.repository,
    pr: input.pr,
    pr_title: to_string(pull?.title ?? ""),
    pr_url: to_string(pull?.html_url ?? ""),
    pr_state: pull?.merged == true ? "merged" : to_string(pull?.state ?? "unknown"),
    base_repository: to_string(pull?.base?.repo?.full_name ?? input.repository),
    head_repository: to_string(pull?.head?.repo?.full_name ?? "a deleted fork"),
    labeled_head_sha: input.head_sha,
    current_head_sha: to_string(pull?.head?.sha ?? ""),
    request: request,
    actors: request.actors.map({ login -> actor(gh, input, login) }),
    review_decision: review?.repository?.pullRequest?.reviewDecision,
    check_runs: flat(
      gh.pages(
        "repos/" + input.repository + "/commits/" + input.head_sha + "/check-runs?per_page=100",
      )
        .map({ page -> page?.check_runs ?? [] }),
    ),
    comments: flat(gh.pages(issue(input) + "/comments?per_page=100")),
    incident: QUEUE_BYPASS_LABELS.contains(request.label) ? measure_incident(
      gh,
      input,
      to_string(pull?.base?.ref ?? ""),
      pull?.labels ?? [],
    ) : nil,
  }
}

/** The audit record before side effects; `finish_record` adds the outcome. */
pub fn draft_record(facts: Facts, input: Input, now: string) -> dict {
  const decision = decide(facts)
  const label = facts.request.label ?? ""
  return {
    decision: decision,
    record: {
      schema: 1,
      repository: input.repository,
      pr: input.pr,
      pr_title: facts.pr_title,
      pr_url: facts.pr_url,
      label: label,
      labels: facts.request.labels,
      actors: facts.request.actors,
      labeled_at: facts.request.labeled_at[label] ?? "",
      decided_at: now,
      head_sha: input.head_sha,
      review_decision: facts.review_decision,
      checks: decision.checks,
      incident: decision.incident,
      reason: decision.reason,
      reason_source: decision.reason_source,
      refusals: decision.refusals,
      warnings: decision.warnings,
      run_url: input.run_url,
    },
  }
}

/** A record for an attempt whose decision never completed. */
pub fn fallback_record(input: Input, label: string, actor: string, error: string) -> dict {
  return {
    schema: 1,
    repository: input.repository,
    pr: input.pr,
    pr_title: "",
    pr_url: "",
    label: label,
    labels: [label],
    actors: [actor],
    labeled_at: "",
    decided_at: "",
    head_sha: input.head_sha,
    review_decision: nil,
    checks: {ci_status: "unmeasured", total: 0, passing: 0, failing: [], pending: []},
    reason: "unmeasured",
    reason_source: "none",
    refusals: [],
    warnings: [],
    run_url: input.run_url,
    error: error,
  }
}

/**
 * Fold step results into the record. `steps` maps a step name to its outcome;
 * a refusal outranks a failed step, and any failed step makes it `errored`.
 */
pub fn finish_record(draft: dict, steps: dict, effects: dict, now: string) -> dict {
  let actions = []
  if (effects?.cancelled ?? "") != "" {
    actions = actions + ["cancelled " + effects.cancelled + " competing workflow run(s)"]
  }
  if steps?.publish == "success" {
    actions = actions + ["published a successful `" + REQUIRED_CHECK + "` check"]
  }
  if (effects?.merge_commit ?? "") != "" {
    actions = actions + ["squash-merged without the merge queue"]
  }
  const removed = effects?.removed_labels ?? []
  if len(removed) > 0 {
    actions = actions + ["removed " + join(removed.map({ label -> "`" + label + "`" }), ", ")]
  }
  const failed = steps.entries().filter({ entry -> entry.value == "failure" }).map(
    { entry -> entry.key },
  )
    .to_list()
    .sorted()
  let error = draft?.error ?? ""
  // A refusal fails the decide step on purpose; that is the outcome, not an error.
  if error == "" && len(failed) > 0 && len(draft.refusals) == 0 {
    error = "step(s) failed: " + join(failed, ", ") + "; see the run"
  }
  const outcome = len(draft.refusals) > 0 ? "refused" : error != "" ? "errored" : "applied"
  return draft
    + {
      outcome: outcome,
      error: error,
      actions: actions,
      merge_commit: effects?.merge_commit ?? "",
      recorded_at: now,
    }
}

/**
 * Ask GitHub to stop one run. A 409 means the run is no longer cancellable,
 * usually because it finished or is already stopping; the caller's wait loop
 * re-reads it until it reports completed.
 */
fn request_stop(gh: GitHub, repo: string, id: int, action: string) {
  try {
    gh.send("POST", repo + "/actions/runs/" + to_string(id) + "/" + action, {})
  } catch (error) {
    if to_string(error).contains("(HTTP 409)") {
      return
    }
    if gh.read(repo + "/actions/runs/" + to_string(id))?.status != "completed" {
      throw "could not " + action + " workflow run " + to_string(id) + ": " + to_string(error)
    }
  }
}

/** Stop the active workflow runs on the head, other than this override's own. */
pub fn cancel_competing(gh: GitHub, input: Input, run_id: int, sleep_ms: fn(int) -> nil) -> int {
  const repo = "repos/" + input.repository
  const workflow_id = gh.read(repo + "/actions/runs/" + to_string(run_id))?.workflow_id
  if type_of(workflow_id) != "int" {
    throw "could not read this override run's workflow id"
  }
  let status_pages = {}
  for status in ["requested", "queued", "in_progress", "waiting", "pending"] {
    status_pages = status_pages
      + {
        [status]: gh.pages(
          repo + "/actions/runs?head_sha=" + input.head_sha + "&status=" + status + "&per_page=100",
        ),
      }
  }
  const selection = select_competing_runs(run_id, workflow_id, status_pages)
  for id in selection.competing_run_ids {
    request_stop(gh, repo, id, "cancel")
  }
  // One budget for every run. A large run often outlives an ordinary cancel's
  // first two minutes, so each run still going then gets one force-cancel.
  let waited = 0
  let forced = []
  for id in selection.competing_run_ids {
    while gh.read(repo + "/actions/runs/" + to_string(id))?.status != "completed" {
      if waited >= CANCEL_WAIT_MS {
        throw "workflow run " + to_string(id) + " did not stop within "
          + to_string(CANCEL_WAIT_MS / 1000)
          + " seconds, including a force-cancel"
      }
      if waited >= FORCE_CANCEL_AFTER_MS && !forced.contains(id) {
        forced = forced + [id]
        request_stop(gh, repo, id, "force-cancel")
      }
      sleep_ms(5000)
      waited = waited + 5000
    }
  }
  return selection.pending_count
}

pub fn publish_status(gh: GitHub, input: Input, record: dict) {
  gh.send(
    "POST",
    "repos/" + input.repository + "/check-runs",
    {
      name: REQUIRED_CHECK,
      head_sha: input.head_sha,
      status: "completed",
      conclusion: "success",
      output: {
        title: "Merge override",
        summary: "Published by merge override `" + record.label + "` requested by "
          + join(record.actors.map({ login -> "@" + login }), ", ")
          + ". Reason: "
          + record.reason,
      },
    },
  )
}

/**
 * Squash-merge the exact labeled head (`sha`), so a retry can never land another commit.
 * Concurrent overrides each get 405 "Base branch was modified" as siblings land; full jitter spreads them out.
 */
const BASE_MOVED = "Base branch was modified"

const RETRY_BUDGET_MS = 180000

const RETRY_FIRST_MS = 2000

const RETRY_CAP_MS = 30000

type PullState = {state: string, merged: bool, merge_commit_sha?: string?, head: {sha: string}}

/** The merge commit if the decided head already merged, "" while the pull request is still open. */
fn landed(value: unknown, head_sha: string) -> string {
  const pull: PullState = schema_expect(value, schema_of(PullState))
  if pull.merged && pull.head.sha != head_sha {
    throw "the pull request merged at " + pull.head.sha + ", not the decided head " + head_sha
  }
  if pull.merged {
    if pull.merge_commit_sha == nil {
      throw "the pull request merged without a merge commit"
    }
    return pull.merge_commit_sha
  }
  if pull.state != "open" {
    throw "the pull request was closed before the override could merge it"
  }
  return ""
}

pub fn merge_pull(
  gh: GitHub,
  input: Input,
  record: dict,
  sleep_ms: fn(int) -> nil,
  draw: fn(int, int) -> int,
) -> string {
  const path = "repos/" + input.repository + "/pulls/" + to_string(input.pr)
  const pull = gh.read(path)
  try {
    gh.graphql(DEQUEUE_MUTATION, {id: pull?.node_id})
  } catch (error) {
    // Not queued: nothing to dequeue.
  }
  const body = {
    merge_method: "squash",
    sha: input.head_sha,
    commit_title: to_string(pull?.title) + " (#" + to_string(input.pr) + ")",
    commit_message: "Merged with override label `" + record.label + "` by "
      + join(record.actors.map({ login -> "@" + login }), ", ")
      + ".\nReason: "
      + record.reason,
  }
  let sha = ""
  let waited = 0
  let window = RETRY_FIRST_MS
  while sha == "" {
    try {
      const merged = gh.send("PUT", path + "/merge", body)?.sha
      if type_of(merged) != "string" || merged == "" {
        throw "the merge response carried no commit"
      }
      sha = to_string(merged)
    } catch (error) {
      if !contains(to_string(error), BASE_MOVED) || waited >= RETRY_BUDGET_MS {
        throw error
      }
      // The one-second floor bounds the attempt count however the draws fall.
      const delay = 1000 + draw(0, window)
      sleep_ms(delay)
      waited = waited + delay
      window = min(RETRY_CAP_MS, window * 2)
      sha = landed(gh.read(path), input.head_sha)
    }
  }
  return sha
}

/**
 * Remove the labels this attempt consumed. A label re-applied after this
 * attempt resolved (a newer event) belongs to the next attempt and stays.
 */
pub fn remove_consumed_labels(gh: GitHub, input: Input, label_events: dict) -> list<string> {
  const current = current_request(gh, input)
  let removed = []
  for entry in label_events.entries() {
    if current.label_events[entry.key] != entry.value {
      continue
    }
    gh.send("DELETE", issue(input) + "/labels/" + entry.key, {})
    removed = removed + [entry.key]
  }
  return removed.sorted()
}

/** Append the record to the quarter's issue in the org log, creating it on first use. */
pub fn append_log(gh: GitHub, log_repository: string, record: dict) -> string {
  const title = log_issue_title(record.recorded_at)
  const repo = "repos/" + log_repository
  const existing = flat(gh.pages(repo + "/issues?labels=" + LOG_LABEL + "&state=all&per_page=100"))
    .filter({ item -> item?.title == title && item?.pull_request == nil })
    .to_list()
  let number = len(existing) > 0 ? existing.map({ item -> item.number }).sorted()[0] : nil
  if number == nil {
    number = gh.send(
      "POST",
      repo + "/issues",
      {
        title: title,
        labels: [LOG_LABEL],
        body:
          "Every merge override attempt this quarter, written by the merge override workflow. One comment per attempt; do not edit or delete comments.",
      },
    )?.number
  }
  const comment = gh.send(
    "POST",
    repo + "/issues/" + to_string(number) + "/comments",
    {body: log_entry_markdown(record)},
  )
  return comment?.html_url ?? ""
}

pub fn comment_on_pull(gh: GitHub, input: Input, body: string) {
  gh.send("POST", issue(input) + "/comments", {body: body})
}
