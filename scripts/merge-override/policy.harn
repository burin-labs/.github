/**
 * Merge override policy: which attached label acts, who may apply it, what it
 * does, and the audit record every attempt leaves.
 *
 * An override is an admin's decision, or the fleet control App's. The policy
 * refuses only what is unsafe whoever asks: a non-admin actor, a fork head, a head that moved after the
 * label, a pull request that is no longer open, missing required approval
 * (except `force-merge`), and `bypass-merge-queue` on a head whose `CI status`
 * is not green, because that label promises CI passed and `force-merge` is the
 * label that says it did not. The two labels that land outside the merge queue
 * (`bypass-merge-queue`, `force-merge`) are also refused unless measured state
 * shows an incident: main is red, the pull request is a release-train pull
 * request, or the queue is wedged. The reason text never counts as evidence, and
 * an unmeasurable signal never reads as an incident. Everything else (other red
 * checks, a missing reason) is recorded as a warning and never refuses.
 *
 * Every function here is pure; `measure` in decide.harn reads GitHub.
 */
pub const LABELS = ["bypass-ci", "bypass-merge-queue", "force-merge"]

/** When several labels are attached at once, the strongest acts and all are consumed. */
pub const LABEL_PRECEDENCE = ["force-merge", "bypass-merge-queue", "bypass-ci"]

pub const ACTIVE_RUN_STATUSES = ["requested", "queued", "in_progress", "waiting", "pending"]

pub const REQUIRED_CHECK = "CI status"

pub const REASON_PREFIX = "override:"

pub const NO_REASON = "no reason given"

/** The labels that land a pull request outside the merge queue. */
pub const QUEUE_BYPASS_LABELS = ["bypass-merge-queue", "force-merge"]

/** An open issue whose title starts with one of these says the base branch is red. */
pub const MAIN_RED_TITLES = ["[CI] Main is red", "[CI] Main red inside a cancelled run"]

/** The workflow whose newest conclusive run on the base branch says whether it is red. */
pub const MAIN_CI_WORKFLOW = "CI"

/** The automated reviewer's own marker on a review that did not finish for a head. */
pub const REVIEW_UNFINISHED_MARKER = "automated-review-unfinished: "

/** The only account whose review can carry that marker; a collaborator's copy is not evidence. */
pub const REVIEWER_LOGIN = "harn-release-bot[bot]"

pub const RELEASE_BLOCKER_LABEL = "release-blocker"

/** A pull request that changes this file is a Harn repin. */
pub const REPIN_FILE = ".harn-version"

/** A pull request touching only these files is a version-only release or dev bump. */
pub const RELEASE_BUMP_FILES = [
  "VERSION",
  "Sources/BurinApp/Info.plist",
  "site/src/data/release-info.json",
]

/** A queued pull request with no running merge group for this long has a wedged queue. */
pub const QUEUE_WEDGE_MINUTES = 90

/** GitHub counts these conclusions as satisfying a required check. */
const PASSING = ["success", "neutral", "skipped"]

const BLOCKING_REVIEW = ["REVIEW_REQUIRED", "CHANGES_REQUESTED"]

const LIST_CAP = 20

pub type Request = {
  label: string?,
  labels: list<string>,
  actors: list<string>,
  /** Label name to the id of the issue event that attached it. */
  label_events: dict,
  /** Label name to that event's timestamp. */
  labeled_at: dict,
}

pub type Actor = {login: string, membership_role: string, repository_permission: string}

/** Everything the decision reads, measured once before any side effect. */
pub type Facts = {
  repository: string,
  pr: int,
  pr_title: string,
  pr_url: string,
  pr_state: string,
  base_repository: string,
  head_repository: string,
  /** The head the label event saw. */
  labeled_head_sha: string,
  /** The head the pull request has now. */
  current_head_sha: string,
  request: Request,
  actors: list<Actor>,
  /** GraphQL `reviewDecision`; nil when the base requires no review. */
  review_decision: string?,
  check_runs: list,
  comments: list,
  /** Measured only for a queue-bypass label; nil otherwise. */
  incident: Incident?,
}

/** One incident signal: `yes`, `no`, or `unmeasured` (the read failed), with the evidence. */
pub type Signal = {state: string, detail: string}

pub type Incident = {
  main_red: Signal,
  release_train: Signal,
  queue_wedged: Signal,
  reviewer_down: Signal,
}

pub type Plan = {cancel_workflows: bool, publish_ci_status: bool, merge: bool}

pub type CheckSummary = {
  ci_status: string,
  total: int,
  passing: int,
  failing: list<string>,
  pending: list<string>,
}

pub type Decision = {
  verdict: string,
  refusals: list<string>,
  warnings: list<string>,
  plan: Plan,
  reason: string,
  reason_source: string,
  checks: CheckSummary,
  incident: Incident?,
}

fn latest_label_event(events: list, label: string) -> dict? {
  let latest = nil
  for event in events {
    if event?.label?.name != label {
      continue
    }
    if latest == nil
      || [event?.created_at ?? "", event?.id ?? 0] > [latest?.created_at ?? "", latest?.id ?? 0] {
      latest = event
    }
  }
  return latest
}

/**
 * Validate a `gh api --paginate --slurp` issue-event census: a non-empty list
 * of pages, each a list of events with unique positive ids.
 */
pub fn issue_events_from_pages(pages: unknown) -> list {
  if type_of(pages) != "list" || len(pages) == 0 {
    throw "issue-event census must contain at least one page"
  }
  let events = []
  for page in pages {
    if type_of(page) != "list" {
      throw "issue-event census page was not an array"
    }
    events = events + page
  }
  let ids = []
  for event in events {
    const id = event?.id
    if type_of(id) != "int" || id <= 0 {
      throw "issue-event census item omitted a positive event id"
    }
    if ids.contains(id) {
      throw "issue-event census contained a duplicate event id"
    }
    ids = ids + [id]
  }
  return events
}

/**
 * Resolve one serialized attempt from the labels attached when the run holds
 * the per-PR lock. GitHub keeps one pending member of a concurrency group, so
 * the surviving run consumes every attached label; issue events keep each
 * label's actor even when the run that event created was replaced.
 */
pub fn resolve_request(attached: list, events: list) -> Request {
  const labels = LABELS.filter({ label -> attached.contains(label) }).to_list()
  if len(labels) == 0 {
    return {label: nil, labels: [], actors: [], label_events: {}, labeled_at: {}}
  }
  let actors = []
  let label_events = {}
  let labeled_at = {}
  for label in labels {
    const latest = latest_label_event(events, label)
    const login = latest?.actor?.login
    if latest?.event != "labeled" || type_of(login) != "string" {
      throw "could not identify the actor for attached label " + label
    }
    if !actors.contains(login) {
      actors = actors + [login]
    }
    label_events = label_events + {[label]: latest.id}
    labeled_at = labeled_at + {[label]: latest?.created_at ?? ""}
  }
  return {
    label: LABEL_PRECEDENCE.filter({ label -> labels.contains(label) }).to_list()[0],
    labels: labels,
    actors: actors.sorted(),
    label_events: label_events,
    labeled_at: labeled_at,
  }
}

pub fn plan(label: string) -> Plan {
  if label == "bypass-ci" {
    return {cancel_workflows: true, publish_ci_status: true, merge: false}
  }
  if label == "bypass-merge-queue" {
    return {cancel_workflows: false, publish_ci_status: false, merge: true}
  }
  if label == "force-merge" {
    return {cancel_workflows: true, publish_ci_status: true, merge: true}
  }
  throw "unknown override label: " + label
}

fn latest_check(runs: list, name: string) -> dict? {
  let latest = nil
  for run in runs {
    if run?.name != name {
      continue
    }
    const stamp = run?.completed_at ?? run?.started_at ?? ""
    if latest == nil || stamp > (latest?.completed_at ?? latest?.started_at ?? "") {
      latest = run
    }
  }
  return latest
}

fn capped(names: list) -> list<string> {
  const sorted = names.sorted()
  if len(sorted) <= LIST_CAP {
    return sorted
  }
  return sorted[0:LIST_CAP] + ["and " + to_string(len(sorted) - LIST_CAP) + " more"]
}

/** The override's own job, which is always running while it decides and red after a refusal. */
pub const OVERRIDE_JOB = "Apply merge override"

/** Head check states at decision time: the evidence an auditor asks for. */
pub fn summarize_checks(check_runs: list) -> CheckSummary {
  let names = []
  for run in check_runs {
    const name = to_string(run?.name)
    if name == OVERRIDE_JOB || name.ends_with("/ " + OVERRIDE_JOB) {
      continue
    }
    if !names.contains(run?.name) {
      names = names + [run?.name]
    }
  }
  let passing = 0
  let failing = []
  let pending = []
  for name in names {
    const run = latest_check(check_runs, name)
    if run?.status != "completed" {
      pending = pending + [name]
    } else if PASSING.contains(run?.conclusion) {
      passing = passing + 1
    } else {
      failing = failing + [name + " (" + to_string(run?.conclusion) + ")"]
    }
  }
  const required = latest_check(check_runs, REQUIRED_CHECK)
  const ci_status =
    required == nil ? "missing" : required?.status != "completed" ? "in_flight" : to_string(
    required?.conclusion ?? "unknown",
  )
  return {
    ci_status: ci_status,
    total: len(names),
    passing: passing,
    failing: capped(failing),
    pending: capped(pending),
  }
}

/**
 * The newest comment by a label actor whose body starts with `override:`. The
 * reason is that comment's first line after the prefix.
 */
pub fn override_reason(comments: list, actors: list) -> string? {
  let latest = nil
  for comment in comments {
    const body = trim(comment?.body ?? "")
    if !actors.contains(comment?.user?.login) || !body.lower().starts_with(REASON_PREFIX) {
      continue
    }
    if latest == nil || (comment?.created_at ?? "") >= (latest?.created_at ?? "") {
      latest = comment
    }
  }
  if latest == nil {
    return nil
  }
  const text = trim(trim(latest.body)[len(REASON_PREFIX):].split("\n")[0])
  if text == "" {
    return nil
  }
  return len(text) > 500 ? text[0:500] + "..." : text
}

pub fn unmeasured(error: unknown) -> Signal {
  return {state: "unmeasured", detail: to_string(error)}
}

/**
 * Whether the base branch is red. `issues` are the open issues found by title;
 * `runs` are the newest-first workflow runs on the base branch. A source that
 * could not be read is passed as an `errors` entry: it never reads as "no", so
 * a red it might have shown cannot be missed.
 */
pub fn main_red_signal(issues: list, runs: list, errors: list) -> Signal {
  for issue in issues {
    return {
      state: "yes",
      detail: "open issue #" + to_string(issue?.number) + " " + to_string(issue?.title),
    }
  }
  let newest = nil
  for run in runs {
    if run?.name == MAIN_CI_WORKFLOW
      && ["success", "failure", "timed_out"].contains(run?.conclusion)
      && (newest == nil || (run?.created_at ?? "") > (newest?.created_at ?? "")) {
      newest = run
    }
  }
  if newest != nil && newest.conclusion != "success" {
    return {
      state: "yes",
      detail: "the last conclusive `" + MAIN_CI_WORKFLOW + "` run on the base branch "
        + to_string(newest.conclusion)
        + ": "
        + to_string(newest?.html_url),
    }
  }
  if len(errors) > 0 {
    return unmeasured(join(errors, "; "))
  }
  return {
    state: "no",
    detail: newest == nil ? "no open main-red issue and no conclusive `" + MAIN_CI_WORKFLOW
      + "` run on the base branch" : "no open main-red issue; the last conclusive `"
      + MAIN_CI_WORKFLOW
      + "` run succeeded",
  }
}

/** Whether the pull request is a repin, a version-only bump, or labeled `release-blocker`. */
pub fn release_train_signal(files: list<string>, labels: list<string>) -> Signal {
  if labels.contains(RELEASE_BLOCKER_LABEL) {
    return {state: "yes", detail: "labeled `" + RELEASE_BLOCKER_LABEL + "`"}
  }
  if files.contains(REPIN_FILE) {
    return {state: "yes", detail: "repin: changes `" + REPIN_FILE + "`"}
  }
  if len(files) > 0 && files.all({ file -> RELEASE_BUMP_FILES.contains(file) }) {
    return {state: "yes", detail: "version-only release or dev bump"}
  }
  return {
    state: "no",
    detail: "changes " + to_string(len(files)) + " file(s) outside the release train",
  }
}

/**
 * Whether the automated reviewer is down for this head: it posted its
 * "did not finish" marker for the current head and nothing has approved that
 * head since. Only the reviewer's own account can carry the marker: anyone
 * else can type the same text. An approval of the head, human or bot, means the reviewer is no
 * longer what blocks the merge, and a head with no review at all is just a
 * review that has not run yet, which reads as `no`.
 */
pub fn reviewer_down_signal(reviews: list, head: string) -> Signal {
  const marker = REVIEW_UNFINISHED_MARKER + head
  let unfinished = false
  for review in reviews {
    if review?.commit_id != head {
      continue
    }
    if review?.state == "APPROVED" {
      return {state: "no", detail: "the current head already has an approval"}
    }
    if review?.user?.login == REVIEWER_LOGIN && to_string(review?.body).contains(marker) {
      unfinished = true
    }
  }
  if unfinished {
    return {state: "yes", detail: "the automated review did not finish for head " + head[0:12]}
  }
  return {state: "no", detail: "the automated review has not failed on the current head"}
}

/**
 * Whether the merge queue is wedged for this pull request: it has sat queued
 * past the threshold while no merge-group run is active on the base branch.
 * `entries` are the queue's entries; `queue_total` is the queue's reported size,
 * so a truncated census never reads as "not queued".
 */
pub fn queue_wedged_signal(
  entries: list,
  queue_total: int,
  pr: int,
  active_merge_group_runs: list,
  now: string,
) -> Signal {
  const entry = entries.filter({ item -> item?.pullRequest?.number == pr }).to_list()[0]
  if entry == nil {
    if queue_total > len(entries) {
      return unmeasured(
        "the queue census holds " + to_string(len(entries)) + " of " + to_string(queue_total)
          + " entries",
      )
    }
    return {state: "no", detail: "the pull request is not in the merge queue"}
  }
  const minutes = to_int((date_parse(now) - date_parse(entry.enqueuedAt)) / 60)
  if minutes < QUEUE_WEDGE_MINUTES {
    return {
      state: "no",
      detail: "queued " + to_string(minutes) + " min, under the " + to_string(QUEUE_WEDGE_MINUTES)
        + " min threshold",
    }
  }
  if len(active_merge_group_runs) > 0 {
    return {
      state: "no",
      detail: "queued " + to_string(minutes) + " min but "
        + to_string(len(active_merge_group_runs))
        + " merge group run(s) are active",
    }
  }
  return {
    state: "yes",
    detail: "queued " + to_string(minutes) + " min with no active merge group run",
  }
}

fn incident_refusal(label: string, incident: Incident?) -> string? {
  if incident == nil {
    return "`" + label
      + "` lands outside the merge queue only during an incident, and no incident evidence was measured"
  }
  const signals = [
    {name: "main is red", signal: incident.main_red},
    {name: "release-train pull request", signal: incident.release_train},
    {name: "merge queue wedged", signal: incident.queue_wedged},
    {name: "automated reviewer down", signal: incident.reviewer_down},
  ]
  if signals.any({ pair -> pair.signal.state == "yes" }) {
    return nil
  }
  const evidence = join(
    signals.map({ pair -> pair.name + ": " + pair.signal.state + " (" + pair.signal.detail + ")" }),
    "; ",
  )
  if signals.any({ pair -> pair.signal.state == "unmeasured" }) {
    return "`" + label
      + "` lands outside the merge queue only during an incident, and the evidence could not be fully measured, so it is refused rather than guessed. "
      + evidence
  }
  return "`" + label
    + "` was not applied: no incident was found ("
    + evidence
    + "). It lands outside the merge queue only when main is red, this is a release-train pull request, the queue is wedged, or the automated reviewer failed to finish on this head."
}

/**
 * The fleet control App. GitHub reports an App's membership and repository
 * permission as `none`, so the admin read refuses it by construction; it is
 * named instead. The `[bot]` suffix is reserved, so no person holds this login.
 */
pub const CONTROL_APP_LOGIN = "burin-control[bot]"

fn is_admin(actor: Actor) -> bool {
  return actor.login == CONTROL_APP_LOGIN
    || actor.membership_role == "admin"
    || actor.repository_permission == "admin"
}

/** Apply the policy. Refusals are the hard checks; warnings only reach the record. */
pub fn decide(facts: Facts) -> Decision {
  const label = facts.request.label
  if label == nil {
    throw "decide needs an active override request"
  }
  const checks = summarize_checks(facts.check_runs)
  let refusals = []
  for actor in facts.actors {
    if !is_admin(actor) {
      refusals = refusals
        + [
          "@" + actor.login + " is not an organization or repository admin (organization role "
            + actor.membership_role
            + ", repository permission "
            + actor.repository_permission
            + ")",
        ]
    }
  }
  if facts.head_repository != facts.base_repository {
    refusals = refusals
      + ["the head lives in fork " + facts.head_repository + ", not " + facts.base_repository]
  }
  if facts.pr_state != "open" {
    refusals = refusals + ["the pull request is " + facts.pr_state + ", not open"]
  }
  if facts.current_head_sha != facts.labeled_head_sha {
    refusals = refusals
      + [
        "the head moved from " + facts.labeled_head_sha[0:12] + " to "
          + facts.current_head_sha[0:12]
          + " after the label was applied",
      ]
  }
  if label != "force-merge" && BLOCKING_REVIEW.contains(facts.review_decision) {
    refusals = refusals
      + [
        "the base branch requires approval and the review decision is "
          + to_string(facts.review_decision),
      ]
  }
  if label == "bypass-merge-queue" && checks.ci_status != "success" {
    refusals = refusals
      + [
        "`" + REQUIRED_CHECK + "` is " + checks.ci_status
          + " on the head; `bypass-merge-queue` lands only a green head, so use `force-merge` to land it anyway",
      ]
  }
  if QUEUE_BYPASS_LABELS.contains(label) {
    const refusal = incident_refusal(label, facts.incident)
    if refusal != nil {
      refusals = refusals + [refusal]
    }
  }
  const reason = override_reason(facts.comments, facts.request.actors)
  let warnings = []
  if reason == nil {
    warnings = warnings + [NO_REASON]
  }
  if len(checks.failing) > 0 {
    warnings = warnings + ["head checks not passing: " + join(checks.failing, ", ")]
  }
  if len(checks.pending) > 0 {
    warnings = warnings + ["head checks still running: " + join(checks.pending, ", ")]
  }
  return {
    verdict: len(refusals) == 0 ? "proceed" : "refused",
    refusals: refusals,
    warnings: warnings,
    plan: plan(label),
    reason: reason ?? NO_REASON,
    reason_source: reason == nil ? "none" : "comment",
    checks: checks,
    incident: facts.incident,
  }
}

/**
 * Select the active workflow runs on the head that a cancelling override must
 * stop. `status_pages` maps each active status to a `--paginate --slurp`
 * census; a census that cannot reach its own reported total throws instead of
 * reading as "nothing to cancel". Runs of the override's own workflow are
 * never competitors.
 */
pub fn select_competing_runs(
  current_run_id: int,
  current_workflow_id: int,
  status_pages: dict,
) -> dict {
  if current_run_id <= 0 || current_workflow_id <= 0 {
    throw "current run and workflow ids must be positive"
  }
  let by_id = {}
  for status in ACTIVE_RUN_STATUSES {
    const pages = status_pages[status]
    if type_of(pages) != "list" || len(pages) == 0 {
      throw status + " workflow-run census is missing"
    }
    let runs = []
    let totals = []
    for page in pages {
      if type_of(page?.workflow_runs) != "list" || type_of(page?.total_count) != "int" {
        throw status + " workflow-run census page omitted workflow_runs or total_count"
      }
      runs = runs + page.workflow_runs
      if !totals.contains(page.total_count) {
        totals = totals + [page.total_count]
      }
    }
    if len(totals) != 1 {
      throw status + " workflow-run census total_count changed during pagination"
    }
    if len(runs) != totals[0] {
      throw status + " workflow-run census measured " + to_string(len(runs)) + " of "
        + to_string(totals[0])
        + " reported runs"
    }
    for run in runs {
      if type_of(run?.id) != "int" || type_of(run?.workflow_id) != "int" {
        throw status + " workflow-run census contained a run without ids"
      }
      // A run can advance between status queries; the later read wins.
      by_id = by_id + {[to_string(run.id)]: run}
    }
  }
  let competing = []
  let siblings = []
  for run in by_id.values() {
    if run.workflow_id == current_workflow_id {
      if run.id != current_run_id {
        siblings = siblings + [run.id]
      }
    } else {
      competing = competing + [run.id]
    }
  }
  return {
    competing_run_ids: competing.sorted(),
    override_run_ids: siblings.sorted(),
    pending_count: len(competing),
    measured_run_count: len(by_id.keys()),
  }
}

/** Calendar quarter of an ISO timestamp, the org log's issue key. */
pub fn quarter(iso: string) -> string {
  const month = to_int(iso[5:7])
  return iso[0:4] + "-Q" + to_string((month - 1) / 3 + 1)
}

pub fn log_issue_title(iso: string) -> string {
  return "Merge overrides " + quarter(iso)
}

fn bullet_list(items: list) -> string {
  return len(items) == 0 ? "none" : join(items, "; ")
}

/** Why an incident-only label is held to the queue; shown in the comment's details. */
const QUEUE_BYPASS_RATIONALE =
  "Landing outside the merge queue rebuilds every queued merge group and cancels the verdicts main needs, and the queue already lands approved, green pull requests. Evidence is measured, never taken from the reason text. Main is red when an open `[CI] Main is red` issue exists or the newest conclusive `"
  + MAIN_CI_WORKFLOW
  + "` run on the base branch failed. A pull request is release-train when it repins, only bumps the version, or is labeled `"
  + RELEASE_BLOCKER_LABEL
  + "`. The queue is wedged when the pull request has been queued over "
  + to_string(QUEUE_WEDGE_MINUTES)
  + " min with no merge group running. The reviewer is down when it posted its did-not-finish marker for the current head and nothing has approved that head since."

fn signal_line(name: string, signal: Signal) -> string {
  return name + ": " + signal.state + " (" + signal.detail + ")"
}

/**
 * The PR comment and step summary for one attempt: the outcome and the reason
 * first, the audit trail behind a toggle.
 */
pub fn record_markdown(record: dict) -> string {
  const heading = {applied: "applied", refused: "refused", errored: "errored"}[record.outcome]
  const checks = record.checks
  const actors = join(record.actors.map({ actor -> "@" + actor }), ", ")
  let lines = [
    "### Merge override " + heading + ": `" + record.label + "`",
    "",
    "- Requested by " + actors,
    "- Reason: " + record.reason,
  ]
  if len(record.refusals) > 0 {
    lines = lines + record.refusals.map({ refusal -> "- " + refusal })
  }
  if record.error != "" {
    lines = lines + ["- Error: " + record.error]
  }
  if record.merge_commit != "" {
    lines = lines + ["- Merged as `" + record.merge_commit + "`"]
  }
  if record.reason_source == "none" {
    lines = lines
      + [
        "",
        actors
          + " please reply with a one-line `override: <reason>` comment for the change record.",
      ]
  }
  if record.outcome != "applied" {
    lines = lines + ["", "Re-apply `" + record.label + "` once the cause above is fixed."]
  }
  let detail = [
    "- Requested at: " + record.labeled_at,
    "- Head: `" + record.head_sha + "`",
    "- Checks on the head: `" + REQUIRED_CHECK + "` " + checks.ci_status + "; "
      + to_string(checks.passing)
      + " of "
      + to_string(checks.total)
      + " passing; failing: "
      + bullet_list(checks.failing)
      + "; running: "
      + bullet_list(checks.pending),
    "- Review decision: " + (record.review_decision ?? "no review required"),
  ]
  if record?.incident != nil {
    detail = detail
      + [
        "- Incident evidence:",
        "  - " + signal_line("main red", record.incident.main_red),
        "  - " + signal_line("release train", record.incident.release_train),
        "  - " + signal_line("reviewer down", record.incident.reviewer_down),
        "  - " + signal_line("queue wedged", record.incident.queue_wedged),
      ]
  }
  detail = detail + ["- Actions: " + bullet_list(record.actions)]
  if len(record.warnings) > 0 {
    detail = detail + ["- Warnings: " + join(record.warnings, "; ")]
  }
  detail = detail + ["- Run: " + record.run_url]
  if record.outcome == "refused" && QUEUE_BYPASS_LABELS.contains(record.label) {
    detail = detail + ["", QUEUE_BYPASS_RATIONALE]
  }
  return join(lines, "\n") + "\n\n<details><summary>Audit record</summary>\n\n"
    + join(detail, "\n")
    + "\n\n</details>"
}

/** One org-log comment: a readable line plus the machine record. */
pub fn log_entry_markdown(record: dict) -> string {
  const summary = record.outcome + " `" + record.label + "` on " + record.repository + "#"
    + to_string(record.pr)
    + " by "
    + join(record.actors.map({ actor -> "@" + actor }), ", ")
    + ": "
    + record.reason
  return summary + "\n\n```json\n" + json_stringify(record) + "\n```"
}
