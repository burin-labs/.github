/** Real locked lifecycle transactions, with inert source and archive readers. */
import { CommandResult, command_run } from "std/command"
import { lifecycle_github_readers } from "./lifecycle-github.harn"
import {
  ArchiveDisposition,
  ArchiveRemoval,
  LifecycleCensus,
  LifecycleReaders,
  reclaim_entries,
  reserve_attempt,
} from "./lifecycle.harn"
import {
  RECOVERY_SCHEMA,
  RecoveryCustody,
  RecoveryIdentity,
  RecoveryRecord,
  RecoveryReference,
  RecoverySnapshot,
  RecoveryStoreLock,
  recovery_custody_decision,
  recovery_store_lock,
} from "./recovery.harn"
import { WorkerReceipt, WorkerRuntime, worker_retirement, worker_runtime } from "./worker.harn"

type JournalProgress = {
  schema: string,
  intent: unknown,
  archives?: list<ArchiveDisposition>,
  result: unknown,
}

type LifecycleTestNames = list<string>

type CompletedJournal = {
  intent: {custody: RecoveryCustody, record: RecoveryRecord},
  result: {status: string},
}

pipeline test_lifecycle_counts_full_store_and_reserves_before_model(harness: Harness) {
  run_case(harness, "capacity")
}

pipeline test_lifecycle_rechecks_source_before_removing_owned_work(harness: Harness) {
  run_case(harness, "source-changed")
  run_case(harness, "source-mutates")
}

pipeline test_lifecycle_preserves_running_producer_and_null_worker_cleanup(harness: Harness) {
  run_case(harness, "producer-active")
  run_case(harness, "worker-null")
}

pipeline test_lifecycle_resumes_one_durable_intent_and_preserves_unknown_absence(harness: Harness) {
  run_case(harness, "resume")
  run_case(harness, "interrupted-absence")
}

pipeline test_lifecycle_recovers_same_intent_after_actual_transaction_owner_death(
  harness: Harness,
) {
  const root = fixture(harness)
  const crashed = transaction(harness, root, "crash-intent")
  assert(crashed.success, crashed.stderr)
  assert(crashed.stdout.contains("lifecycle-exact-owner-SIGKILL"))
  assert(harness.fs.exists("${root}/123-1-9/work"))
  const journal = harness.fs.list_dir("${root}.lifecycle")
  assert_eq(len(journal), 1, "the real killed process must have durably reserved one intent")
  const inode = harness.fs.stat("${root}.lock").identity
  const recovered = transaction(harness, root, "recover-intent")
  assert(recovered.success, recovered.stderr)
  assert(recovered.stdout.contains("lifecycle-recover-intent-confirmed"))
  assert_eq(harness.fs.list_dir("${root}.lifecycle"), journal)
  assert_eq(harness.fs.stat("${root}.lock").identity, inode)
}

