/** The landing gate is the one place a wrong answer merges unreviewed or red code. */
import { Repo, decide } from "./ship.harn"

fn pr(over: dict = {}) -> Repo {
  const pull = {
    id: "PR_1",
    number: 9,
    title: "t",
    state: "OPEN",
    isDraft: false,
    isCrossRepository: false,
    isInMergeQueue: false,
    headRefName: "b",
    headRefOid: "abc",
    baseRefName: "main",
    mergeStateStatus: "CLEAN",
    reviewDecision: "APPROVED",
    labels: {nodes: [{name: "ship"}]},
    latestOpinionatedReviews: {nodes: [{state: "APPROVED", commit: {oid: "abc"}}]},
    comments: {nodes: []},
    reviewThreads: {nodes: []},
    commits: {
      nodes: [
        {
          commit: {
            statusCheckRollup: {
              contexts: {nodes: [{name: "CI status", status: "COMPLETED", conclusion: "SUCCESS"}]},
            },
          },
        },
      ],
    },
  }
  return {
    nameWithOwner: "o/r",
    defaultBranchRef: {name: "main"},
    mergeQueue: nil,
    pullRequest: pull + over,
  }
}

const RED = {
  commits: {
    nodes: [
      {
        commit: {
          statusCheckRollup: {
            contexts: {
              nodes: [
                {name: "CI status", status: "COMPLETED", conclusion: "FAILURE", databaseId: 7},
              ],
            },
          },
        },
      },
    ],
  },
}

pipeline test_only_an_approved_green_open_labeled_head_merges(harness: Harness) {
  assert_eq(decide(pr(), "clear", false).action, "merge")
  const own = {
    name: "ship / ship (9)",
    status: "IN_PROGRESS",
    checkSuite: {workflowRun: {workflow: {name: "Smart Ship"}}},
  }
  const ci = {name: "CI status", status: "COMPLETED", conclusion: "SUCCESS"}
  const looking = {
    mergeStateStatus: "UNSTABLE",
    commits: {nodes: [{commit: {statusCheckRollup: {contexts: {nodes: [ci, own]}}}}]},
  }
  assert_eq(
    decide(pr(looking), "clear", false, "Smart Ship").action,
    "merge",
    "a look never waits on itself",
  )
  assert_eq(
    decide(pr(looking), "clear", false, "Other").action,
    "stop",
    "another workflow still pends",
  )
  const refusals = [
    {reviewDecision: "REVIEW_REQUIRED", mergeStateStatus: "BLOCKED"},
    {
      reviewDecision: nil,
      latestOpinionatedReviews: {
        nodes: [
          {state: "APPROVED", commit: {oid: "abc"}},
          {state: "CHANGES_REQUESTED", commit: {oid: "abc"}},
        ],
      },
    },
    {headRefOid: "def"},
    {reviewDecision: "APPROVED", headRefOid: "def"},
    {labels: {nodes: [{name: "ship"}, {name: "hold"}]}},
    {labels: {nodes: []}},
    {isCrossRepository: true},
    {isDraft: true},
    {baseRefName: "release"},
    {mergeStateStatus: "UNKNOWN"},
    {
      commits: {
        nodes: [
          {
            commit: {
              statusCheckRollup: {contexts: {nodes: [{name: "CI status", status: "IN_PROGRESS"}]}},
            },
          },
        ],
      },
    },
    {
      reviewThreads: {
        nodes: [
          {isResolved: false, path: "a.rs", comments: {nodes: [{databaseId: 3, body: "why?"}]}},
        ],
      },
    },
  ]
  for over in refusals {
    assert(decide(pr(over), "clear", true).action != "merge", to_string(over))
  }
}

pipeline test_a_release_lease_holds_every_other_merge(harness: Harness) {
  const head = "a" * 40
  const lease =
    fn(repo, base, number, sha, method) { return "release-merge-lease v2 repo=${repo} base=${base} base_oid=${"1" * 40} candidate_pr=${number} candidate_head=${sha} generation=g tag=v1 merge_method=${method} " }
  const holder = pr(
    {
      headRefOid: head,
      latestOpinionatedReviews: {nodes: [{state: "APPROVED", commit: {oid: head}}]},
    },
  )
  assert_eq(
    decide(holder, lease("o/r", "main", 9, head, "squash"), false).action,
    "merge",
    "the holder lands",
  )
  const others = [
    lease("o/x", "main", 9, head, "squash"),
    lease("o/r", "next", 9, head, "squash"),
    lease("o/r", "main", 4, head, "squash"),
    lease("o/r", "main", 9, "b" * 40, "squash"),
    lease("o/r", "main", 9, head, "merge"),
    "unreadable",
    "release-merge-lease v1 candidate_pr=9",
  ]
  for held in others {
    assert_eq(decide(holder, held, false).action, "stop", held)
  }
}

pipeline test_a_blocked_head_gets_one_bounded_repair(harness: Harness) {
  assert_eq(decide(pr(RED), "clear", true).action, "repair")
  assert_eq(decide(pr(RED), "clear", false).action, "stop", "no model key, no repair")
  assert_eq(decide(pr(RED + {reviewDecision: "REVIEW_REQUIRED"}), "clear", true).action, "repair")
  assert_eq(
    decide(pr({reviewDecision: "REVIEW_REQUIRED", mergeStateStatus: "BLOCKED"}), "clear", true)
      .action,
    "stop",
    "green waits for review",
  )
  const answered = {comments: {nodes: [{body: "x <!-- smart-ship head=abc -->"}]}}
  assert_eq(decide(pr(RED + answered), "clear", true).reason, "already answered at this head")
  const spent = {
    comments: {
      nodes: [
        {body: "<!-- smart-ship head=a -->"},
        {body: "<!-- smart-ship head=b -->"},
        {body: "<!-- smart-ship head=c -->"},
      ],
    },
  }
  assert_eq(decide(pr(RED + spent), "clear", true).action, "stop")
}
