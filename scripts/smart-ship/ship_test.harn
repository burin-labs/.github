/** The landing gate is the one place a wrong answer merges unreviewed or red code. */
import { command_run } from "std/command"
import { read_yaml } from "std/fs"
import { LifecycleReaders } from "./lifecycle.harn"
import { NEEDS_YOU } from "./needs-you.harn"
import { recovery_record, recovery_store_entries, recovery_store_lock } from "./recovery.harn"
import {
  Look,
  Repo,
  checkout,
  decide,
  diff_refusal,
  look,
  quiet,
  recovery_source,
  sh,
  stage_repair,
  stage_resolution,
} from "./ship.harn"
import { run_worker, worker_retirement, worker_runtime } from "./worker.harn"

fn page(nodes: list) {
  return {totalCount: len(nodes), nodes: nodes}
}

/** Post-checkpoint edits must invalidate custody even when an earlier index remains. */
pipeline test_recovery_source_remeasures_tracked_untracked_and_index_changes(harness: Harness) {
  const f = divergent(harness, false)
  assert_eq(divergent_look(harness, f, false, "", "", true).result.action, "repair")
  const work = "${f.dir}/work"
  const first = recovery_source(harness, work)
  assert_eq(recovery_source(harness, work), first, "unchanged nonempty source stays measurable")
  harness.fs.write_text("${work}/pr/recovery-new-file", "unfinished source")
  const untracked = recovery_source(harness, work)
  assert(untracked.tree != first.tree, "new untracked source must change the captured tree")
  harness.fs.write_text("${work}/pr/recovery-new-file", "changed source")
  const tracked = recovery_source(harness, work)
  assert(tracked.tree != untracked.tree, "source changed after staging must be measured again")
  sh(harness.tools, ["git", "add", "--", "recovery-new-file"], {}, "${work}/pr")
  const staged = recovery_source(harness, work)
  assert_eq(staged.tree, tracked.tree, "staging the same source does not change its tree")
  assert(
    staged.agent_index_sha256 != tracked.agent_index_sha256,
    "an index change independently invalidates the earlier receipt",
  )
}

pipeline test_recovery_source_preserves_ambiguous_files_and_refuses_index_links(harness: Harness) {
  const f = divergent(harness, false)
  assert_eq(divergent_look(harness, f, false, "", "", true).result.action, "repair")
  const work = "${f.dir}/work"
  const before = recovery_source(harness, work)
  assert(before.tree != "", "the real source snapshot must be reached first")
  harness.fs.mkdir("${work}/pr/.harn", true)
  harness.fs.write_text("${work}/pr/.harn/unfinished-source", "keep this work")
  assert(
    is_err(
      try {
        recovery_source(harness, work)
      },
    ),
    "ambiguous source must retain the entry",
  )
  assert_eq(harness.fs.read_text("${work}/pr/.harn/unfinished-source"), "keep this work")
  const index = "${work}/pr/.git/index"
  sh(harness.tools, ["mv", "--", index, "${index}.original"])
  const outside = "${f.dir}/outside-index"
  harness.fs.write_text(outside, "never read or change this")
  sh(harness.tools, ["ln", "-s", outside, index])
  const refused = try {
    recovery_source(harness, work)
  }
  assert(is_err(refused), "a symlinked agent index must not become measured custody")
  assert(contains(to_string(unwrap_err(refused)), "index could not be measured"))
  assert_eq(harness.fs.read_text(outside), "never read or change this")
}

pipeline test_recovery_source_preserves_ignored_authored_files_beside_disposable_caches(
  harness: Harness,
) {
  const f = divergent(harness, false)
  assert_eq(divergent_look(harness, f, false, "", "", true).result.action, "repair")
  const work = "${f.dir}/work"
  harness.fs.write_text("${work}/pr/.gitignore", "local-notes/\n__pycache__/\n")
  const first = recovery_source(harness, work)
  harness.fs.mkdir("${work}/pr/__pycache__")
  harness.fs.write_text("${work}/pr/__pycache__/module.pyc", "disposable cache")
  assert_eq(
    recovery_source(harness, work),
    first,
    "an explicitly classified disposable cache does not invent source changes",
  )
  harness.fs.mkdir("${work}/pr/local-notes")
  harness.fs.write_text("${work}/pr/local-notes/unfinished.txt", "unpublished authored source")
  const measured = try {
    recovery_source(harness, work)
  }
  assert(is_err(measured), "ignored authored bytes must keep recovery source unconfirmed")
  assert_eq(
    harness.fs.read_text("${work}/pr/local-notes/unfinished.txt"),
    "unpublished authored source",
  )
}

pipeline test_recovery_source_refuses_tracked_submodules_without_nested_custody(harness: Harness) {
  const root = harness.fs.mkdtemp_in_workspace("smart-ship-recovery-submodule-")
  const child = "${root}/child"
  const work = "${root}/work"
  const pristine = "${work}/pristine"
  const pr = "${work}/pr"
  const git = [
    "git",
    "-c",
    "user.name=Fixture",
    "-c",
    "user.email=fixture@example.invalid",
    "-c",
    "commit.gpgsign=false",
    "-c",
    "protocol.file.allow=always",
  ]
  harness.fs.mkdir(child)
  sh(harness.tools, git + ["init", "--quiet", "--initial-branch=main"], {}, child)
  harness.fs.write_text("${child}/tracked.txt", "published nested source")
  sh(harness.tools, git + ["add", "."], {}, child)
  sh(harness.tools, git + ["commit", "--quiet", "-m", "nested source"], {}, child)
  harness.fs.mkdir(pristine, true)
  sh(harness.tools, git + ["init", "--quiet", "--initial-branch=main"], {}, pristine)
  sh(harness.tools, git + ["submodule", "add", "--quiet", child, "vendor"], {}, pristine)
  sh(harness.tools, git + ["commit", "--quiet", "-am", "superproject"], {}, pristine)
  sh(harness.tools, git + ["clone", "--quiet", pristine, pr], {}, root)
  sh(harness.tools, git + ["submodule", "update", "--init", "--quiet"], {}, pr)
  const index = sh(harness.tools, git + ["ls-files", "--stage"], {}, pristine)
  assert(index.contains("160000 "), "the canonical index must contain the real tracked gitlink")
  harness.fs.write_text("${pr}/vendor/tracked.txt", "unpublished nested source")
  const refused = stage_repair(harness, work)
  assert(refused.contains("tracked submodule"), "unconfirmed nested source must refuse staging")
  assert(
    is_err(
      try {
        recovery_source(harness, work)
      },
    ),
  )
  assert_eq(
    sh(harness.tools, git + ["ls-files", "--stage"], {}, pristine),
    index,
    "the refusal must precede any trusted index mutation",
  )
  assert_eq(harness.fs.read_text("${pr}/vendor/tracked.txt"), "unpublished nested source")
}

pipeline test_recovery_source_requires_preserved_staged_versions(harness: Harness) {
  for state in ["original", "working", "unpreserved", "deleted", "mode", "unmerged"] {
    const f = divergent(harness, state == "unmerged")
    assert_eq(divergent_look(harness, f, false, "", "", true).result.action, "repair")
    const work = "${f.dir}/work"
    const pr = "${work}/pr"
    const path = state == "deleted" || state == "mode" ? "file.txt" : "staged\tname\nfile.txt"
    if state != "unmerged" {
      harness.fs.write_text("${pr}/${path}", "working authored bytes")
    }
    if state == "unpreserved" {
      harness.fs.write_text("${pr}/${path}", "unique staged authored bytes")
      sh(harness.tools, ["git", "add", "--", path], {}, pr)
      harness.fs.write_text("${pr}/${path}", "working authored bytes")
    } else if state == "working" {
      sh(harness.tools, ["git", "add", "--", path], {}, pr)
    } else if state == "deleted" {
      sh(harness.tools, ["git", "rm", "--cached", "--force", "--", path], {}, pr)
    } else if state == "mode" {
      sh(harness.tools, ["git", "update-index", "--chmod=+x", "--", path], {}, pr)
    }
    const agent_index = harness.fs.read_bytes("${pr}/.git/index")
    const observed = try {
      recovery_source(harness, work)
    }
    if ["original", "working"].contains(state) {
      const snapshot = unwrap(observed)
      assert(snapshot.tree != "" && snapshot.agent_index_sha256 == sha256(agent_index), state)
    } else {
      assert(is_err(observed), "${state}: unpublished staged source must remain unconfirmed")
    }
    assert_eq(
      harness.fs.read_bytes("${pr}/.git/index"),
      agent_index,
      "${state}: source admission must never rewrite the agent's index",
    )
    if state != "unmerged" {
      assert_eq(harness.fs.read_text("${pr}/${path}"), "working authored bytes")
    }
  }
}

pipeline test_recovery_source_refuses_unpublished_agent_heads_and_refs(harness: Harness) {
  for retained in ["ref", "head"] {
    const f = divergent(harness, false)
    assert_eq(divergent_look(harness, f, false, "", "", true).result.action, "repair")
    const work = "${f.dir}/work"
    const pr = "${work}/pr"
    assert(recovery_source(harness, work).tree != "", "unchanged checkout is measurable first")
    harness.fs.write_text("${pr}/file.txt", "unpublished committed source A")
    sh(harness.tools, ["git", "add", "--", "file.txt"], {}, pr)
    sh(
      harness.tools,
      [
        "git",
        "-c",
        "user.name=Fixture",
        "-c",
        "user.email=fixture@example.invalid",
        "-c",
        "commit.gpgsign=false",
        "commit",
        "--quiet",
        "-m",
        "local authored source",
      ],
      {},
      pr,
    )
    const authored = sh(harness.tools, ["git", "rev-parse", "HEAD"], {}, pr)
    if retained == "ref" {
      sh(harness.tools, ["git", "update-ref", "refs/heads/authored", authored], {}, pr)
      sh(harness.tools, ["git", "checkout", "--quiet", "--detach", f.head], {}, pr)
    }
    harness.fs.write_text("${pr}/file.txt", "working source B")
    sh(harness.tools, ["git", "add", "--", "file.txt"], {}, pr)
    const observed = try {
      recovery_source(harness, work)
    }
    assert(is_err(observed), "${retained}: unpublished Git-owned source must remain unconfirmed")
    assert_eq(
      sh(harness.tools, ["git", "show", "${authored}:file.txt"], {}, pr),
      "unpublished committed source A",
    )
    assert_eq(harness.fs.read_text("${pr}/file.txt"), "working source B")
  }
}

pipeline test_recovery_source_requires_initial_git_metadata_and_unchanged_refs(harness: Harness) {
  for state in [
    "missing",
    "wrong-head",
    "removed-ref",
    "retargeted-ref",
    "symbolic-head",
    "broken-ref",
  ] {
    const f = divergent(harness, false)
    assert_eq(divergent_look(harness, f, false, "", "", true).result.action, "repair")
    const work = "${f.dir}/work"
    const pr = "${work}/pr"
    const original = recovery_source(harness, work)
    assert(original.tree != "", "known source custody must precede refusal controls")
    const metadata = "${work}/job.json"
    const prepared = json_parse(harness.fs.read_text(metadata))
    const refs = keys(prepared.recovery_git.refs).sorted()
    assert(len(refs) > 0, "the actual clone must supply a nonempty initial ref census")
    const reference = refs.filter({ name -> name != "refs/remotes/origin/HEAD" })[0] ?? ""
    assert(reference != "", "the changed ref must be an actual direct clone ref")
    if state == "missing" {
      harness.fs.write_text(metadata, json_stringify({head: prepared.head}))
    } else if state == "wrong-head" {
      harness.fs.write_text(
        metadata,
        json_stringify({head: f.base_oid, recovery_git: prepared.recovery_git}),
      )
    } else if state == "removed-ref" {
      sh(harness.tools, ["git", "update-ref", "--no-deref", "-d", reference], {}, pr)
    } else if state == "retargeted-ref" {
      const prior = prepared.recovery_git.refs[reference].oid
      const changed = prior == f.head ? f.base_oid : f.head
      sh(harness.tools, ["git", "update-ref", "--no-deref", reference, changed], {}, pr)
    } else if state == "symbolic-head" {
      sh(harness.tools, ["git", "update-ref", "refs/heads/same", f.head], {}, pr)
      sh(harness.tools, ["git", "symbolic-ref", "HEAD", "refs/heads/same"], {}, pr)
    } else {
      harness.fs.mkdir("${pr}/.git/refs/heads", true)
      harness.fs.write_text("${pr}/.git/refs/heads/broken", "unconfirmed ref\n")
    }
    assert(
      is_err(
        try {
          recovery_source(harness, work)
        },
      ),
      "${state}: Git custody must remain unconfirmed",
    )
  }
}

pipeline test_recovery_source_does_not_execute_agent_configured_index_hooks(harness: Harness) {
  const f = divergent(harness, false)
  assert_eq(divergent_look(harness, f, false, "", "", true).result.action, "repair")
  const work = "${f.dir}/work"
  const pr = "${work}/pr"
  const first = recovery_source(harness, work)
  const marker = "${f.dir}/agent-hook-executed"
  const hook = "${f.dir}/agent-fsmonitor"
  harness.fs.write_text(hook, "#!/bin/sh\nprintf reached > '${marker}'\n")
  sh(harness.tools, ["chmod", "+x", hook])
  sh(harness.tools, ["git", "config", "core.fsmonitor", hook], {}, pr)
  assert_eq(
    recovery_source(harness, work),
    first,
    "agent-local index hooks must not influence the trusted census",
  )
  assert(!harness.fs.exists(marker), "source observation must not execute an agent-configured hook")
}

pipeline test_recovery_source_uses_original_head_after_publication_stages_a_merge(
  harness: Harness,
) {
  const f = divergent(harness, true)
  assert_eq(divergent_look(harness, f, false, "", "", true).result.action, "repair")
  const work = "${f.dir}/work"
  const pr = "${work}/pr"
  const original = sh(harness.tools, ["git", "show", "${f.head}:file.txt"], {}, pr)
  harness.fs.write_text("${pr}/file.txt", "${original}\n")
  sh(harness.tools, ["git", "add", "--", "file.txt"], {}, pr)
  harness.fs.write_text("${pr}/file.txt", "resolved publication source\n")
  f.git(["checkout", "--quiet", "-b", "merged", f.head])
  f.git(["merge", "--quiet", "-X", "theirs", "-m", "merge", "main"])
  const merge_oid = f.git(["rev-parse", "HEAD"])
  f.git(["checkout", "--quiet", "main"])
  stage_resolution(harness, work, merge_oid, {})
  assert_eq(sh(harness.tools, ["git", "rev-parse", "HEAD"], {}, "${work}/pristine"), merge_oid)
  const snapshot = recovery_source(harness, work, merge_oid, f.head)
  assert(snapshot.tree != "", "staged original source remains held by the actual prepared parent")
  assert(
    is_err(
      try {
        recovery_source(harness, work, merge_oid, merge_oid)
      },
    ),
    "a publication merge cannot replace the original prepared identity",
  )
}

pipeline test_stop_reasons_name_the_current_cause() {
  const conflict = decide(pr({mergeStateStatus: "DIRTY"}), "clear", false)
  assert_eq(conflict.reason, "merge conflict with main; repair is off here")
  const mixed = decide(
    pr(
      checks(
        [
          {name: "Tests", status: "COMPLETED", conclusion: "FAILURE"},
          {name: "Lint", status: "IN_PROGRESS"},
        ],
      ),
    ),
    "clear",
    false,
  )
  assert_eq(mixed.reason, "failing checks: Tests; pending checks: Lint")
  assert_eq(
    decide(pr({reviewDecision: "CHANGES_REQUESTED"}), "clear", false).reason,
    "a writer requested changes at this head",
  )
  assert_eq(
    decide(pr({reviewDecision: "REVIEW_REQUIRED"}), "clear", false).reason,
    "green; waiting for a writer's approval of this head",
  )
  assert_eq(
    decide(pr({reviewDecision: "UNKNOWN"}), "clear", false).reason,
    "review decision is unmeasured: UNKNOWN",
  )
}

type NeedsYouFixture = {
  merged?: bool,
  paged?: bool,
  no_label?: bool,
  changed_head?: bool,
  duplicate_page?: bool,
  confirm_comment?: bool,
  confirm_label?: bool,
}

fn needs_you_look(harness: Harness, fixture: NeedsYouFixture = {}) -> dict {
  harness.testing.http_mock_clear()
  const api = "https://api.github.com"
  const owned = {databaseId: 17, body: "Old failing checks\n${NEEDS_YOU}", viewerDidAuthor: true}
  const recent = {databaseId: 18, body: "Later note", viewerDidAuthor: false}
  const comments = fixture.paged == true ? {
    totalCount: 2,
    nodes: [recent],
    pageInfo: {hasPreviousPage: true, startCursor: "older"},
  } : page([owned])
  const state = pr(
    {
      state: fixture.merged == true ? "MERGED" : "OPEN",
      labels: page(
        fixture.no_label == true ? [{name: "ship"}] : [{name: "ship"}, {name: "ship-needs-you"}],
      ),
      comments: comments,
    },
  )
  let responses = [{status: 200, body: json_stringify({data: {repository: state}})}]
  if fixture.paged == true {
    responses = responses
      + [
        {
          status: 200,
          body: json_stringify(
            {
              data: {
                repository: {
                  pullRequest: {
                    headRefOid: fixture.changed_head == true ? "moved" : "abc",
                    state: state.pullRequest.state,
                    comments: {
                      totalCount: 2,
                      nodes: [fixture.duplicate_page == true ? recent : owned],
                      pageInfo: {hasPreviousPage: false, startCursor: "first"},
                    },
                  },
                },
              },
            },
          ),
        },
      ]
  }
  responses = responses
    + [
      {
        status: 200,
        body: json_stringify({data: {mergePullRequest: {pullRequest: {state: "MERGED"}}}}),
      },
    ]
  harness.testing.http_mock("POST", api + "/graphql", {responses: responses})
  harness.testing.http_mock(
    "GET",
    api + "/repos/o/r/git/matching-refs/release-merge-lease/main",
    {status: 200, body: "[]"},
  )
  const resolved =
    "**Smart Ship:** No longer needs you. Shipping continues through the normal checks and protected merge.\n\nHead: `abc`.\n\n${NEEDS_YOU}"
  harness.testing.http_mock(
    "PATCH",
    api + "/repos/o/r/issues/comments/17",
    {
      status: 200,
      body: json_stringify(
        {id: 17, body: fixture.confirm_comment ?? true ? resolved : "unconfirmed"},
      ),
    },
  )
  harness.testing.http_mock(
    "DELETE",
    api + "/repos/o/r/issues/9/labels/ship-needs-you",
    {
      status: 200,
      body: json_stringify(
        fixture.confirm_label ?? true ? [{name: "ship"}] : [{name: "ship-needs-you"}],
      ),
    },
  )
  const result = try {
    look(
      harness,
      {
        repo: "o/r",
        number: 9,
        token: "fixture-token",
        work: "",
        publish: false,
        repair: false,
        run_id: "",
        opts: {installation_token: "fixture-token", budget: {state_dir: ""}},
        git_host: "file:///nonexistent-smart-ship-host/",
        nonce: "",
      },
    )
  }
  return {result: result, calls: harness.testing.http_mock_calls({include_sensitive: true})}
}

pipeline test_a_green_or_merged_head_clears_needs_you_through_the_real_look(harness: Harness) {
  for fixture in [{}, {merged: true}, {paged: true}, {paged: true, no_label: true}] {
    const seen = needs_you_look(harness, fixture)
    assert(is_ok(seen.result), to_string(seen.result))
    const writes = seen.calls.filter({ call -> call.method == "PATCH" || call.method == "DELETE" })
    assert_eq(len(writes), fixture?.no_label == true ? 1 : 2)
    assert_eq(writes[0].method, "PATCH", "post the resolution before removing the label")
    assert(contains(writes[0].body, "No longer needs you"))
    if fixture?.no_label != true {
      assert_eq(writes[1].method, "DELETE")
    }
    const merges = seen.calls.filter(
      { call -> call.method == "POST" && contains(call.body ?? "", "mutation($id:") },
    )
    assert_eq(len(merges), fixture?.merged == true ? 0 : 1)
    if len(merges) == 1 {
      const merged = schema_expect(json_parse(merges[0].body), schema_of(ObservedReviewMerge))
      assert_eq(
        merged.variables.head,
        "abc",
        "the protected merge remains bound to the observed head",
      )
    }
  }
}

pipeline test_unconfirmed_needs_you_cleanup_never_proceeds_to_merge(harness: Harness) {
  for fixture in [
    {confirm_comment: false},
    {confirm_label: false},
    {paged: true, changed_head: true},
    {paged: true, duplicate_page: true},
    {paged: true, no_label: true, confirm_comment: false},
  ] {
    const seen = needs_you_look(harness, fixture)
    assert(is_err(seen.result), to_string(seen.result))
    assert(
      !seen.calls.any(
        { call -> call.method == "POST" && contains(call.body ?? "", "mutation($id:") },
      ),
    )
    if fixture?.confirm_comment == false || fixture?.paged == true {
      assert(
        !seen.calls.any({ call -> call.method == "DELETE" }),
        "unconfirmed cause or comment identity preserves the label",
      )
    }
  }
}

fn checks(nodes: list, total: int = -1) {
  const rollup = {
    contexts: {
      totalCount: total < 0 ? len(nodes) : total,
      pageInfo: {hasNextPage: false},
      nodes: nodes,
    },
  }
  return {
    commits: {
      nodes: [{commit: {oid: "abc", signature: {isValid: true}, statusCheckRollup: rollup}}],
    },
  }
}

const GREEN = {name: "CI status", status: "COMPLETED", conclusion: "SUCCESS"}

type ObservedReviewQuery = {query: string}

type ObservedReviewMerge = {variables: {head: string}}

fn red() {
  return checks([{name: "CI status", status: "COMPLETED", conclusion: "FAILURE", databaseId: 7}])
}

fn pr(over: dict = {}) -> Repo {
  const pull = {
    id: "PR_1",
    number: 9,
    title: "t",
    body: "",
    state: "OPEN",
    isDraft: false,
    isCrossRepository: false,
    isInMergeQueue: false,
    headRefName: "b",
    headRefOid: "abc",
    baseRefName: "main",
    baseRef: {target: {oid: "1" * 40}},
    mergeStateStatus: "CLEAN",
    reviewDecision: nil,
    labels: page([{name: "ship"}]),
    latestOpinionatedReviews: page(
      [{state: "APPROVED", body: author_receipt("abc"), author: {type: "Bot", login: "reviewer"}}],
    ),
    comments: page([]),
    reviewThreads: page([]),
  }
  return {
    nameWithOwner: "o/r",
    defaultBranchRef: {name: "main"},
    mergeQueue: nil,
    pullRequest: pull + checks([GREEN]) + over,
  }
}

pipeline test_only_an_approved_green_open_labeled_head_merges(harness: Harness) {
  assert_eq(decide(pr(), "clear", false).action, "merge")
  const own = {
    name: "ship / ship (9)",
    status: "IN_PROGRESS",
    checkSuite: {workflowRun: {workflow: {id: "W_ship", name: "Smart Ship"}}},
  }
  const looking = {mergeStateStatus: "UNSTABLE"} + checks([GREEN, own])
  assert_eq(
    decide(pr(looking), "clear", false, "W_ship").action,
    "merge",
    "a look never waits on itself",
  )
  assert_eq(
    decide(pr(looking), "clear", false, "W_other").action,
    "stop",
    "another workflow still pends",
  )
  assert_eq(
    decide(pr(looking), "clear", false, "Smart Ship").action,
    "stop",
    "a display name never names the look",
  )
  assert_eq(
    decide(pr(looking), "clear", false, "").action,
    "stop",
    "an unresolved look counts its own checks",
  )
  const refusals = [
    {reviewDecision: "REVIEW_REQUIRED", mergeStateStatus: "BLOCKED"},
    {
      latestOpinionatedReviews: page(
        [
          {state: "APPROVED", commit: {oid: "abc"}},
          {state: "CHANGES_REQUESTED", commit: {oid: "abc"}},
        ],
      ),
    },
    {latestOpinionatedReviews: page([])},
    {headRefOid: "def"},
    {reviewDecision: "APPROVED", headRefOid: "def"},
    {labels: page([{name: "ship"}, {name: "hold"}])},
    {labels: page([])},
    {isCrossRepository: true},
    {isDraft: true},
    {baseRefName: "release"},
    {mergeStateStatus: "UNKNOWN"},
    {mergeStateStatus: "DIRTY"},
    checks([]),
    checks([{name: "CI status", status: "IN_PROGRESS"}]),
    checks([{name: "CI status", status: "COMPLETED", conclusion: "CANCELLED"}]),
    {
      commits: {
        nodes: [
          {
            commit: {
              oid: "abc",
              signature: {isValid: false},
              statusCheckRollup: {contexts: {...page([GREEN]), pageInfo: {hasNextPage: false}}},
            },
          },
        ],
      },
    },
    {reviewThreads: page([{isResolved: false, path: "a.rs", comments: page([])}])},
  ]
  for over in refusals {
    assert(decide(pr(over), "clear", true).action != "merge", to_string(over))
  }
}

fn author_receipt(head: string, repository: string = "o/r", number: int = 9) -> string {
  const receipt = {
    schema: "review.author_evidence.v1",
    repository_digest: sha256_hex(repository),
    pr: number,
    head_sha: head,
    replies: [],
  }
  return "<!-- automated-review-author-evidence: ${json_stringify(receipt)} -->"
}

pipeline test_rebound_automated_approvals_cannot_supply_reviewed_source_identity() {
  for aggregate in [nil, "APPROVED"] {
    for body in [
      author_receipt("previous-source"),
      author_receipt("abc", "other/repository"),
      author_receipt("abc", "o/r", 10),
      "",
      "<!-- automated-review-author-evidence: { -->",
    ] {
      const decision = decide(
        pr(
          {
            reviewDecision: aggregate,
            latestOpinionatedReviews: page(
              [
                {
                  state: "APPROVED",
                  commit: {oid: "abc"},
                  author: {type: "Bot", login: "reviewer"},
                  body: body,
                },
              ],
            ),
          },
        ),
        "clear",
        false,
      )
      assert(!decision.facts.approved, "mutable provider commit identity must not bind this body")
      assert(decision.action != "merge", "the real observation-to-decision path must refuse")
    }
  }
}

pipeline test_legitimate_human_approval_uses_the_protected_policy_decision() {
  const decision = decide(
    pr(
      {
        reviewDecision: "APPROVED",
        latestOpinionatedReviews: page(
          [
            {
              state: "APPROVED",
              commit: {oid: "earlier-source"},
              author: {type: "User", login: "human-reviewer"},
              body: "Looks good.",
            },
          ],
        ),
      },
    ),
    "clear",
    false,
  )
  assert(
    decision.facts.approved,
    "GitHub's actual protected-review policy admits this human review",
  )
  assert_eq(decision.action, "merge")
  assert_eq(decision.facts.review_evidence.policy_bound, 1)
  assert_eq(decision.facts.review_evidence.source_bound, 0)
}

pipeline test_unknown_review_authority_and_explicit_policy_vetoes_stay_visible() {
  for author in [nil, {type: "Organization", login: "unknown"}, {type: "User", login: "human"}] {
    const decision = decide(
      pr(
        {
          latestOpinionatedReviews: page(
            [{state: "APPROVED", author: author, body: author_receipt("abc")}],
          ),
        },
      ),
      "clear",
      false,
    )
    assert_eq(decision.action, "stop")
    assert_eq(decision.facts.review_evidence.approvals_seen, 1)
    assert_eq(len(decision.facts.review_evidence.unbound), 1)
  }
  for aggregate in ["REVIEW_REQUIRED", "CHANGES_REQUESTED", "UNRECOGNIZED"] {
    const decision = decide(pr({reviewDecision: aggregate}), "clear", false)
    assert_eq(decision.action, "stop")
    assert(decision.facts.review_evidence.vetoed)
    assert_eq(decision.facts.review_evidence.source_bound, 1)
  }
  const empty = decide(pr({latestOpinionatedReviews: page([])}), "clear", false)
  assert_eq(empty.facts.review_evidence.approvals_seen, 0)
  assert_eq(empty.action, "stop")
}

pipeline test_actual_look_fetches_source_evidence_and_refuses_rebound_bot_reviews(
  harness: Harness,
) {
  const api = "https://api.github.com"
  const work = harness.fs.mkdtemp_in_workspace("review-source-look-")
  const fixtures = [
    {
      author: {type: "Bot", login: "reviewer"},
      body: author_receipt("previous-source"),
      aggregate: "APPROVED",
      action: "stop",
    },
    {
      author: {type: "Bot", login: "reviewer"},
      body: author_receipt("abc"),
      aggregate: nil,
      action: "merge",
    },
    {
      author: {type: "User", login: "human"},
      body: "Looks good.",
      aggregate: "APPROVED",
      action: "merge",
    },
  ]
  for fixture in fixtures {
    harness.testing.http_mock_clear()
    const state = pr(
      {
        reviewDecision: fixture.aggregate,
        latestOpinionatedReviews: page(
          [{state: "APPROVED", body: fixture.body, author: fixture.author, commit: {oid: "abc"}}],
        ),
      },
    )
    harness.testing.http_mock(
      "POST",
      api + "/graphql",
      {
        responses: [
          {status: 200, body: json_stringify({data: {repository: state}})},
          {
            status: 200,
            body: json_stringify({data: {mergePullRequest: {pullRequest: {state: "MERGED"}}}}),
          },
        ],
      },
    )
    harness.testing.http_mock(
      "GET",
      api + "/repos/o/r/git/matching-refs/release-merge-lease/main",
      {status: 200, body: "[]"},
    )
    harness.testing.http_mock(
      "POST",
      api + "/repos/o/r/issues/9/comments",
      {status: 201, body: "{}"},
    )
    const decision = look(
      harness,
      {
        repo: "o/r",
        number: 9,
        token: "fixture-token",
        work: work,
        publish: false,
        repair: false,
        run_id: "",
        opts: {installation_token: "fixture-token", budget: {state_dir: ""}},
        git_host: "file:///nonexistent-smart-ship-host/",
        nonce: "",
      },
    )
    assert_eq(decision.action, fixture.action)
    const calls = harness.testing.http_mock_calls({include_sensitive: true})
    const query = schema_expect(json_parse(calls[0].body), schema_of(ObservedReviewQuery)).query
    assert(
      query.contains("state body author { type: __typename login }"),
      "the actual read requests actor and authored evidence",
    )
    const merges = calls.filter(
      { call -> call.method == "POST" && call.body.contains("mergePullRequest") },
    )
    assert_eq(len(merges), fixture.action == "merge" ? 1 : 0)
    if fixture.action == "merge" {
      const request = schema_expect(json_parse(merges[0].body), schema_of(ObservedReviewMerge))
      assert_eq(
        request.variables.head,
        "abc",
        "the actual merge is still bound to the observed head",
      )
    }
  }
}

// The approved head, the base tip, a base merge on top of the approved head, and other commits.
const APPROVED = "a1" * 20

const BASE_TIP = "b2" * 20

const MERGED = "c3" * 20

const OTHER = "d4" * 20

const FORK_POINT = "e5" * 20

const LIB_PATCH =
  "@@ -10,6 +10,9 @@ pub fn parse(input: &str) -> Result<Ast> {\n     let tokens = lex(input)?;\n+    if tokens.is_empty() {\n+        return Err(Error::Empty);\n+    }\n     build(tokens)\n }"

const TEST_PATCH =
  "@@ -0,0 +1,4 @@\n+#[test]\n+fn empty_input_is_an_error() {\n+    assert!(parse(\"\").is_err());\n+}"

/** One entry of a REST compare `files` list, as GitHub returns it. */
fn changed(filename: string, status: string, patch: string?) {
  const file = {
    sha: sha256_hex(filename + (patch ?? ""))[0:40],
    filename: filename,
    status: status,
    additions: 3,
    deletions: 0,
    changes: 3,
    blob_url: "https://github.com/o/r/blob/x/" + filename,
    raw_url: "https://github.com/o/r/raw/x/" + filename,
    contents_url: "https://api.github.com/repos/o/r/contents/" + filename,
  }
  return patch == nil ? file : file + {patch: patch}
}

/** The PR's own files at the approved head. */
fn pr_files() -> list {
  return [
    changed("src/parse.rs", "modified", LIB_PATCH),
    changed("tests/parse.rs", "added", TEST_PATCH),
  ]
}

/** A REST compare response, `GET /repos/o/r/compare/{base}...{head}`. */
fn compared(status: string, ahead: int, behind: int, files: list) {
  return {
    url: "https://api.github.com/repos/o/r/compare/x...y",
    status: status,
    ahead_by: ahead,
    behind_by: behind,
    total_commits: ahead,
    merge_base_commit: {sha: FORK_POINT},
    commits: [],
    files: files,
  }
}

fn tree_of(commit: string) -> string {
  return sha256_hex("tree " + commit)[0:40]
}

fn blob(name: string) -> string {
  return sha256_hex("blob " + name)[0:40]
}

/** One item of a recursive git tree, as `GET /repos/o/r/git/trees/{sha}?recursive=1` lists it. */
fn entry(path: string, mode: string = "100644", kind: string = "blob", sha: string = "") {
  return {
    path: path,
    mode: mode,
    type: kind,
    sha: sha == "" ? blob(path) : sha,
    size: 120,
    url: "https://api.github.com/repos/o/r/git/blobs/x",
  }
}

/**
 * The whole tree of `commit`. Main changed README.md between the approved head and the live
 * head; the PR's own files are the same blobs at both unless `over` replaces them.
 */
fn tree_at(commit: string, over: list = [], truncated: bool = false) {
  const readme = entry(
    "README.md",
    "100644",
    "blob",
    blob(commit == APPROVED ? "README old" : "README new"),
  )
  const items = [
    readme,
    entry("src", "040000", "tree"),
    entry("src/parse.rs"),
    entry("tests", "040000", "tree"),
    entry("tests/parse.rs"),
  ]
  const paths = over.map({ o -> o.path }).to_list()
  return {
    sha: tree_of(commit),
    url: "https://api.github.com/repos/o/r/git/trees/" + tree_of(commit),
    tree: items.filter({ i -> !paths.contains(i.path) }).to_list()
      + over.filter({ o -> o.mode != "" }).to_list(),
    truncated: truncated,
  }
}

/** A git data commit, `GET /repos/o/r/git/commits/{sha}`. */
fn git_commit(sha: string, parents: list) {
  return {
    sha: sha,
    node_id: "C_" + sha[0:8],
    message: len(parents) == 2 ? "Merge branch 'main' into b" : "Tighten parsing",
    tree: {sha: tree_of(sha), url: "https://api.github.com/repos/o/r/git/trees/" + tree_of(sha)},
    parents: parents.map(
      { p -> {sha: p, url: "https://api.github.com/repos/o/r/git/commits/" + p} },
    )
      .to_list(),
    verification: {verified: true, reason: "valid"},
  }
}

/**
 * A whole look at a green, signed live head whose only writer approval names APPROVED. `rest`
 * maps a REST path to its response body; a path it leaves out answers 404, as GitHub does.
 */
fn carried_look(harness: Harness, rest: dict, over: dict = {}) {
  harness.testing.http_mock_clear()
  const api = "https://api.github.com"
  const live = {
    headRefOid: MERGED,
    baseRef: {target: {oid: BASE_TIP}},
    mergeStateStatus: "CLEAN",
    latestOpinionatedReviews: page(
      [
        {
          state: "APPROVED",
          body: "Approved.\n" + author_receipt(APPROVED),
          author: {type: "Bot", login: "burin-control"},
        },
      ],
    ),
  }
    + checks([GREEN])
  harness.testing.http_mock(
    "POST",
    api + "/graphql",
    {
      responses: [
        {status: 200, body: json_stringify({data: {repository: pr(live + over)}})},
        {
          status: 200,
          body: json_stringify({data: {mergePullRequest: {pullRequest: {state: "MERGED"}}}}),
        },
      ],
    },
  )
  for base in ["main", "release"] {
    harness.testing.http_mock(
      "GET",
      api + "/repos/o/r/git/matching-refs/release-merge-lease/" + base,
      {status: 200, body: "[]"},
    )
  }
  for {key: path, value: body} in rest.entries() {
    harness.testing.http_mock(
      "GET",
      api + path,
      body == nil ? {status: 404, body: "{\"message\":\"Not Found\"}"} : {
        status: 200,
        body: json_stringify(body),
      },
    )
  }
  harness.testing.http_mock("POST", api + "/repos/o/r/issues/9/comments", {status: 201, body: "{}"})
  const decision = look(
    harness,
    {
      repo: "o/r",
      number: 9,
      token: "fixture-token",
      work: harness.fs.mkdtemp_in_workspace("carry-look-"),
      publish: false,
      repair: false,
      run_id: "",
      opts: {installation_token: "fixture-token", budget: {state_dir: ""}},
      git_host: "file:///nonexistent-smart-ship-host/",
      nonce: "",
    },
  )
  const calls = harness.testing.http_mock_calls({include_sensitive: true})
  const merges = calls.filter({ c -> c.method == "POST" && c.body.contains("mergePullRequest") })
    .to_list()
  const compares = calls.filter({ c -> c.url.contains("/compare/") }).to_list()
  const posted = calls.filter({ c -> c.method == "POST" && contains(c.url, "/issues/9/comments") })
    .map({ c -> schema_expect(json_parse(c.body), schema_of(Posted)).body })
    .to_list()
  return {decision: decision, merges: merges, compares: len(compares), posted: posted}
}

const STALE_MARK = "<!-- smart-ship stale-approval="

/**
 * harn#11013 sat green and CLEAN for 1.5 hours because its only bound approval named the head
 * before a merge of main, and Smart Ship said nothing while GitHub showed it approved. A head that
 * would otherwise land now says why it waits, once per head, and nothing else posts that note.
 */
pipeline test_a_green_head_says_once_when_its_approval_names_an_earlier_head(harness: Harness) {
  const ours = { body -> {body: body, viewerDidAuthor: true} }
  // The carry is refused (the history is unreadable), so the approval stays bound to APPROVED.
  const stale = carried_look(harness, {})
  assert_eq(stale.decision.reason, "green; waiting for a writer's approval of this head")
  assert_eq(len(stale.merges), 0)
  assert_eq(len(stale.posted), 1, to_string(stale.posted))
  const note = stale.posted[0]
  assert(
    note.contains(
      "approval on record is for ${APPROVED[0:12]}, but the head is now ${MERGED[0:12]}",
    ),
    note,
  )
  assert(note.contains("approve the current head again") && note.contains("rebind"), note)
  assert(note.contains(STALE_MARK + MERGED + " -->"), note)
  const again = carried_look(harness, {}, {comments: page([ours(note)])})
  assert_eq(again.posted, [], "the same head is told once")
  const elsewhere = carried_look(
    harness,
    {},
    {comments: page([{body: note, viewerDidAuthor: false}])},
  )
  assert_eq(len(elsewhere.posted), 1, "only Smart Ship's own note answers the head")
  const moved = carried_look(
    harness,
    {},
    {comments: page([ours("earlier\n\n${STALE_MARK}${OTHER} -->")])},
  )
  assert_eq(len(moved.posted), 1, "a new head with the same problem is told again")
  assert(moved.posted[0].contains(STALE_MARK + MERGED), moved.posted[0])
  const control = {type: "Bot", login: "burin-control"}
  const vetoed = [
    {state: "APPROVED", body: author_receipt(APPROVED), author: control},
    {state: "CHANGES_REQUESTED", body: "Not yet.", author: {type: "Bot", login: "reviewer"}},
  ]
  const silent = [
    ["no approval at all is the ordinary wait", {latestOpinionatedReviews: page([])}],
    ["a PR not labeled ship is never written to", {labels: page([])}],
    ["a failing required check is not otherwise mergeable", red()],
    ["a writer's change request vetoes the approval", {latestOpinionatedReviews: page(vetoed)}],
  ]
  for row in silent {
    const seen = carried_look(harness, {}, row[1])
    assert_eq(seen.decision.action, "stop", row[0])
    assert_eq(seen.posted, [], row[0])
  }
  const bound = [{state: "APPROVED", body: author_receipt(MERGED), author: control}]
  const current = carried_look(harness, {}, {latestOpinionatedReviews: page(bound)})
  assert_eq(current.decision.action, "merge", "an approval bound to the live head merges as before")
  assert_eq(len(current.merges), 1)
  assert_eq(current.posted, [])
}

/** The REST reads of a live head that merged the base once into the approved head. */
fn one_base_merge(
  at_live: list? = nil,
  live_tree: list = [],
  at_approved: list? = nil,
  approved_tree: list = [],
) -> dict {
  return {
    ["/repos/o/r/git/commits/${MERGED}"]: git_commit(MERGED, [APPROVED, BASE_TIP]),
    ["/repos/o/r/git/commits/${APPROVED}"]: git_commit(APPROVED, [FORK_POINT]),
    ["/repos/o/r/compare/${BASE_TIP}...${BASE_TIP}"]: compared("identical", 0, 0, []),
    ["/repos/o/r/compare/${BASE_TIP}...${APPROVED}"]: compared(
      "diverged",
      1,
      4,
      at_approved ?? pr_files(),
    ),
    ["/repos/o/r/compare/${BASE_TIP}...${MERGED}"]: compared("ahead", 2, 0, at_live ?? pr_files()),
    [TREE_PATH + tree_of(APPROVED) + "?recursive=1"]: tree_at(APPROVED, approved_tree),
    [TREE_PATH + tree_of(MERGED) + "?recursive=1"]: tree_at(MERGED, live_tree),
  }
}

const TREE_PATH = "/repos/o/r/git/trees/"

/**
 * Merging main into a PR branch moves its head and once voided the approval, so every PR waited
 * for a person to approve again. A writer's approval now carries across merges of the base when
 * the PR's own patches are unchanged, and the decision log says so.
 */
pipeline test_an_approval_carries_across_a_clean_merge_of_the_base(harness: Harness) {
  const seen = carried_look(harness, one_base_merge())
  assert_eq(seen.decision.action, "merge", seen.decision.evidence_line)
  assert_eq(len(seen.merges), 1)
  const merged = schema_expect(json_parse(seen.merges[0].body), schema_of(ObservedReviewMerge))
  assert_eq(merged.variables.head, MERGED, "the merge is bound to the live head")
  assert(seen.decision.facts.review_evidence.carried)
  const line = seen.decision.evidence_line
  assert(line.contains("approved=true"), line)
  assert(
    line.contains(
      "carried=yes (approved head ${APPROVED} to live head ${MERGED} across base merges ${MERGED}; 2 PR files compared, diff and tree entries identical)",
    ),
    line,
  )
  // Main moved twice: the first-parent chain is two base merges, each bringing in base history.
  const twice = one_base_merge()
    + {
      ["/repos/o/r/git/commits/${MERGED}"]: git_commit(MERGED, [OTHER, BASE_TIP]),
      ["/repos/o/r/git/commits/${OTHER}"]: git_commit(OTHER, [APPROVED, FORK_POINT]),
      ["/repos/o/r/compare/${BASE_TIP}...${FORK_POINT}"]: compared("behind", 0, 6, []),
    }
  const again = carried_look(harness, twice)
  assert_eq(again.decision.action, "merge", again.decision.evidence_line)
  assert(
    again.decision.evidence_line.contains("across base merges ${MERGED}, ${OTHER};"),
    again.decision.evidence_line,
  )
}

/** Anything but a clean merge of the base, or anything unread, keeps the wait for approval. */
pipeline test_an_approval_does_not_carry_past_anything_else(harness: Harness) {
  const edited = changed(
    "src/parse.rs",
    "modified",
    replace(LIB_PATCH, "Error::Empty", "Error::Blank"),
  )
  const commit_path = "/repos/o/r/git/commits/${MERGED}"
  const lots = range(0, 300).map(
    { i -> changed("src/gen/m${i}.rs", "added", "@@ -0,0 +1 @@\n+// ${i}") },
  )
    .to_list()
  const rows = [
    [
      "a merge that rewrites a PR file",
      one_base_merge(
        [edited, pr_files()[1]],
        [entry("src/parse.rs", "100644", "blob", blob("resolved"))],
      ),
      "diff for src/parse.rs differs",
    ],
    [
      "a merge that also edits a file the PR does not change",
      one_base_merge(
        pr_files() + [changed("README.md", "modified", "@@ -1 +1 @@\n-a\n+b")],
        [entry("README.md", "100644", "blob", blob("README edited"))],
      ),
      "diff for README.md differs",
    ],
    [
      // `git merge -s ours main`: the live README is the approved head's blob, so the trees agree,
      // but the PR's diff now reverts main's README change and the squash would land the revert.
      "a merge that keeps the PR side of a file main changed",
      one_base_merge(
        pr_files() + [changed("README.md", "modified", "@@ -1 +1 @@\n-README new\n+README old")],
        [entry("README.md", "100644", "blob", blob("README old"))],
      ),
      "diff for README.md differs",
    ],
    [
      // Main also edited src/parse.rs; the merge kept the PR's version whole, reverting main's edit.
      "a merge that keeps the PR's version of a file main also changed",
      one_base_merge(
        [
          changed(
            "src/parse.rs",
            "modified",
            LIB_PATCH + "\n@@ -40,1 +43,1 @@\n-    main_fix();\n+    old_call();",
          ),
          pr_files()[1],
        ],
      ),
      "diff for src/parse.rs differs",
    ],
    [
      // The PR set the binary to B; main then edited it and the merge kept B. Both compares show
      // `modified` with no patch and both trees hold B, so only refusing a patchless file is sound.
      "a binary the PR modified and main edited after the fork",
      one_base_merge(
        [changed("assets/logo.png", "modified", nil), pr_files()[1]],
        [entry("assets/logo.png", "100644", "blob", blob("logo B"))],
        [changed("assets/logo.png", "modified", nil), pr_files()[1]],
        [entry("assets/logo.png", "100644", "blob", blob("logo B"))],
      ),
      "file has no patch to compare: assets/logo.png",
    ],
    [
      // The PR removed a binary that main later edited (fork-point blob differs from the base tip's).
      "a patchless removal of a file main edited",
      one_base_merge(
        [changed("assets/old.bin", "removed", nil), pr_files()[1]],
        [],
        [changed("assets/old.bin", "removed", nil), pr_files()[1]],
      ),
      "file has no patch to compare: assets/old.bin",
    ],
    [
      "a patchless pure rename of a file main edited under its old name",
      one_base_merge(
        [
          changed("assets/new.bin", "renamed", nil) + {previous_filename: "assets/old.bin"},
          pr_files()[1],
        ],
        [entry("assets/new.bin", "100644", "blob", blob("old bin at fork"))],
        [
          changed("assets/new.bin", "renamed", nil) + {previous_filename: "assets/old.bin"},
          pr_files()[1],
        ],
        [entry("assets/new.bin", "100644", "blob", blob("old bin at fork"))],
      ),
      "file has no patch to compare: assets/new.bin",
    ],
    [
      "a mode-only change GitHub reports with an empty patch",
      one_base_merge(
        [changed("scripts/run.sh", "modified", ""), pr_files()[1]],
        [entry("scripts/run.sh", "100755")],
        [changed("scripts/run.sh", "modified", ""), pr_files()[1]],
        [entry("scripts/run.sh", "100755")],
      ),
      "file has no patch to compare: scripts/run.sh",
    ],
    [
      "a path the diff names as modified that neither tree holds",
      one_base_merge(
        pr_files() + [changed("docs/parse.md", "modified", "@@ -1 +1 @@\n-a\n+b")],
        [],
        pr_files() + [changed("docs/parse.md", "modified", "@@ -1 +1 @@\n-a\n+b")],
      ),
      "does not match the diff for docs/parse.md",
    ],
    [
      "a merge that makes a PR file executable, hunks unchanged",
      one_base_merge(nil, [entry("src/parse.rs", "100755")]),
      "entry for src/parse.rs differs",
    ],
    [
      "a merge that turns a PR file into a symlink, hunks unchanged",
      one_base_merge(nil, [entry("src/parse.rs", "120000")]),
      "entry for src/parse.rs differs",
    ],
    [
      "a merge that turns a PR file into a submodule pointer, hunks unchanged",
      one_base_merge(nil, [entry("src/parse.rs", "160000", "commit", OTHER)]),
      "entry for src/parse.rs differs",
    ],
    [
      "a PR file present at the approved head and absent at the live head",
      one_base_merge(nil, [entry("tests/parse.rs", "")]),
      "does not match the diff for tests/parse.rs",
    ],
    [
      "a truncated tree at the live head",
      one_base_merge()
        + {[TREE_PATH + tree_of(MERGED) + "?recursive=1"]: tree_at(MERGED, [], true)},
      "is truncated",
    ],
    [
      "an unreadable tree at the approved head",
      one_base_merge() + {[TREE_PATH + tree_of(APPROVED) + "?recursive=1"]: nil},
      "Not Found",
    ],
    [
      "a non-merge commit after the approved head",
      one_base_merge() + {[commit_path]: git_commit(MERGED, [APPROVED])},
      "is not a two-parent merge",
    ],
    [
      "a non-merge commit beneath a base merge",
      one_base_merge()
        + {
          [commit_path]: git_commit(MERGED, [OTHER, BASE_TIP]),
          ["/repos/o/r/git/commits/${OTHER}"]: git_commit(OTHER, [APPROVED]),
        },
      "${OTHER} is not a two-parent merge",
    ],
    [
      "a merge of a branch other than the base",
      one_base_merge()
        + {
          [commit_path]: git_commit(MERGED, [APPROVED, OTHER]),
          ["/repos/o/r/compare/${BASE_TIP}...${OTHER}"]: compared("diverged", 3, 1, []),
        },
      "brings in ${OTHER}, which is not main history",
    ],
    [
      "a base-merge history whose first parent is the base, not the PR branch",
      one_base_merge() + {[commit_path]: git_commit(MERGED, [BASE_TIP, APPROVED])},
      "brings in ${APPROVED}, which is not main history",
    ],
    [
      "an approved head that is not an ancestor",
      one_base_merge()
        + {
          [commit_path]: git_commit(MERGED, [OTHER, BASE_TIP]),
          ["/repos/o/r/git/commits/${OTHER}"]: git_commit(OTHER, [FORK_POINT]),
        },
      "approved head ${APPROVED} is not reached first",
    ],
    [
      "a failed compare of the live head",
      one_base_merge() + {["/repos/o/r/compare/${BASE_TIP}...${MERGED}"]: nil},
      "Not Found",
    ],
    ["an unreadable merge commit", one_base_merge() + {[commit_path]: nil}, "Not Found"],
    [
      "a compare that may be cut off at 300 files",
      one_base_merge(lots),
      "may be cut off at 300 files",
    ],
    [
      "a compare that lists no files",
      one_base_merge()
        + {
          ["/repos/o/r/compare/${BASE_TIP}...${MERGED}"]: compared("ahead", 2, 0, [])
            + {files: nil},
        },
      "lists no files",
    ],
  ]
  for row in rows {
    const seen = carried_look(harness, row[1])
    assert_eq(seen.decision.action, "stop", row[0])
    assert_eq(seen.decision.reason, "green; waiting for a writer's approval of this head", row[0])
    assert_eq(len(seen.merges), 0, row[0])
    assert(!seen.decision.facts.review_evidence.carried, row[0])
    const line = seen.decision.evidence_line
    assert(
      line.contains("approved=false") && line.contains("carried=no (") && line.contains(row[2]),
      "${row[0]}: ${line}",
    )
  }
  const reviewer = {type: "Bot", login: "burin-control"}
  const reviews = [
    [
      "a dismissed approval",
      [{state: "DISMISSED", body: author_receipt(APPROVED), author: reviewer}],
    ],
    [
      "a newer change request by the writer",
      [{state: "CHANGES_REQUESTED", body: "Not yet.", author: reviewer}],
    ],
    [
      "an approval bound to another PR",
      [{state: "APPROVED", body: author_receipt(APPROVED, "o/r", 10), author: reviewer}],
    ],
    [
      "a person's approval with no protected decision",
      [{state: "APPROVED", body: author_receipt(APPROVED), author: {type: "User", login: "h"}}],
    ],
  ]
  for row in reviews {
    const seen = carried_look(harness, one_base_merge(), {latestOpinionatedReviews: page(row[1])})
    assert_eq(seen.decision.action, "stop", row[0])
    assert_eq(len(seen.merges), 0, row[0])
    assert_eq(seen.compares, 0, "${row[0]}: nothing names an earlier head, so no history is read")
  }
  for over in [{isCrossRepository: true}, {baseRefName: "release"}] {
    const seen = carried_look(harness, one_base_merge(), over)
    assert_eq(seen.decision.action, "stop", to_string(over))
    assert_eq(seen.compares, 0, "a fork or a non-default base never reads history to carry")
  }
}

pipeline test_signature_failure_names_the_signature_without_requesting_another_review() {
  const head = pr().pullRequest.commits.nodes[0].commit
  for fixture in [
    {signature: {isValid: false, state: "UNKNOWN_KEY"}, state: "UNKNOWN_KEY"},
    {signature: {isValid: false, state: "INVALID"}, state: "INVALID"},
    {signature: {isValid: false}, state: "UNMEASURED"},
    {signature: nil, state: "MISSING"},
  ] {
    const decision = decide(
      pr(
        {
          reviewDecision: "APPROVED",
          commits: {nodes: [{commit: {...head, signature: fixture.signature}}]},
        },
      ),
      "clear",
      false,
    )
    assert_eq(decision.action, "stop")
    assert(decision.facts.approved)
    assert(!decision.facts.signed)
    assert_eq(decision.reason, "head signature is not verified (${fixture.state})")
  }
  const unreviewed = decide(pr({latestOpinionatedReviews: page([])}), "clear", false)
  assert(unreviewed.facts.signed)
  assert(!unreviewed.facts.approved)
  assert_eq(unreviewed.reason, "green; waiting for a writer's approval of this head")
}

/** A superseded failure once held an approved, green head blocked on every look. */
pipeline test_only_the_newest_attempt_of_a_check_counts(harness: Harness) {
  const run = { workflow, name, conclusion, id ->
    {
      name: name,
      status: "COMPLETED",
      conclusion: conclusion,
      databaseId: id,
      checkSuite: {
        app: {id: "actions"},
        workflowRun: {workflow: {id: "W_" + workflow, name: workflow}},
      },
    }
  }
  const superseded = checks(
    [
      run("PR gates", "Public metadata privacy", "FAILURE", 10),
      run("PR gates", "Public metadata privacy", "SUCCESS", 11),
      GREEN,
    ],
  )
  assert_eq(decide(pr(superseded), "clear", false).action, "merge", "a later pass clears it")
  const still_red = checks(
    [
      run("PR gates", "Public metadata privacy", "SUCCESS", 10),
      run("PR gates", "Public metadata privacy", "FAILURE", 11),
      GREEN,
    ],
  )
  const d = decide(pr(still_red), "clear", false)
  assert_eq(
    d.reason,
    "failing checks: Public metadata privacy; repair is off here",
    "the newest attempt still blocks",
  )
  assert_eq(len(d.facts.failing), 1)
  const two_workflows = checks(
    [run("Lint", "check", "FAILURE", 10), run("Test", "check", "SUCCESS", 11), GREEN],
  )
  assert_eq(
    decide(pr(two_workflows), "clear", false).action,
    "stop",
    "one workflow's pass never clears another's failure",
  )
  const old_look = checks([run("Smart Ship", "ship / looks (9) / look (9)", "FAILURE", 12), GREEN])
  assert_eq(
    decide(pr(old_look), "clear", false, "W_Smart Ship").action,
    "merge",
    "an old look of its own never blocks",
  )
  assert_eq(
    decide(pr(old_look), "clear", false, "W_other").action,
    "stop",
    "another workflow's does",
  )
  const namesake = {
    name: "security",
    status: "COMPLETED",
    conclusion: "FAILURE",
    databaseId: 10,
    checkSuite: {
      app: {id: "other-app"},
      workflowRun: {workflow: {id: "W_namesake", name: "Smart Ship"}},
    },
  }
  assert_eq(
    decide(pr(checks([namesake, GREEN])), "clear", false, "W_Smart Ship").action,
    "stop",
    "another workflow named Smart Ship cannot hide a failure",
  )
}

/** Display names are not identity: only a known producer's newer attempt clears its own failure. */
pipeline test_only_the_same_known_producer_supersedes(harness: Harness) {
  const by = { suite, conclusion, id ->
    {name: "verify", status: "COMPLETED", conclusion: conclusion, databaseId: id, checkSuite: suite}
  }
  const workflow = { id -> {app: {id: "actions"}, workflowRun: {workflow: {id: id, name: "CI"}}} }
  const app = { id -> {app: {id: id}, workflowRun: nil} }
  const distinct = [
    [by(workflow("W_a"), "FAILURE", 10), by(workflow("W_b"), "SUCCESS", 11)],
    [by(app("A_a"), "FAILURE", 10), by(app("A_b"), "SUCCESS", 11)],
    [by(nil, "FAILURE", 10), by(nil, "SUCCESS", 11)],
    [
      by({workflowRun: {workflow: {id: "W_a", name: "CI"}}}, "FAILURE", 10),
      by(workflow("W_a"), "SUCCESS", 11),
    ],
  ]
  for pair in distinct {
    assert_eq(decide(pr(checks(pair + [GREEN])), "clear", false).action, "stop", to_string(pair))
  }
  assert_eq(
    decide(
      pr(checks([by(app("A_a"), "FAILURE", 10), by(app("A_a"), "SUCCESS", 11), GREEN])),
      "clear",
      false,
    ).action,
    "merge",
    "an external app's own rerun clears it",
  )
  const status = { state, at ->
    {name: "legacy", state: state, createdAt: at, creator: {login: "bot"}}
  }
  const one = "2026-10-29T01:00:00Z"
  const two = "2026-10-29T02:00:00Z"
  assert_eq(
    decide(pr(checks([status("FAILURE", one), status("SUCCESS", two), GREEN])), "clear", false)
      .action,
    "merge",
    "a newer status clears its older failure",
  )
  const unordered = [
    [status("FAILURE", two), status("SUCCESS", one)],
    [status("FAILURE", one), status("SUCCESS", one)],
    [{name: "legacy", state: "FAILURE", creator: {login: "bot"}}, status("SUCCESS", two)],
    [
      {name: "legacy", state: "FAILURE", createdAt: one},
      {name: "legacy", state: "SUCCESS", createdAt: two},
    ],
  ]
  for pair in unordered {
    assert_eq(decide(pr(checks(pair + [GREEN])), "clear", false).action, "stop", to_string(pair))
  }
}

/** One CI run on head abc, shaped like burin-labs/harn#10987's two runs of its CI workflow. */
fn ci_run(
  suite: string,
  run_id: int,
  names: list,
  conclusion: string,
  over: dict = {},
  total: int = -1,
) -> list {
  const shape = {
    id: suite,
    status: "COMPLETED",
    conclusion: conclusion,
    commit: {oid: "abc"},
    checkRuns: {totalCount: total < 0 ? len(names) : total},
    app: {id: "MDM6QXBwMTUzNjg="},
    workflowRun: {databaseId: run_id, event: "pull_request", workflow: {id: "W_ci", name: "CI"}},
  }
    + over
  return names.map(
    { name ->
      {
        name: name,
        status: "COMPLETED",
        conclusion: conclusion,
        databaseId: run_id * 1000,
        checkSuite: shape,
      }
    },
  )
    .to_list()
}

fn consumer_measurements(suite_over: dict = {}, aggregate_over: dict = {}) -> list {
  const names = [
    "Consumer check / Consumer canary",
    "Consumer base check / Consumer canary",
    "CI status",
    "lint",
  ]
  const suite = {
    workflowRun: {
      databaseId: 42,
      event: "pull_request",
      workflow: {id: "W_kwDORxdAHc4PAxHq", name: "CI"},
    },
  }
    + suite_over
  let rows = []
  for c in ci_run("CS_consumer", 42, names, "FAILURE", suite) {
    rows = rows
      + [
        c
          + {
            databaseId: 100 + len(rows),
            conclusion: c.name == "CI status" || c.name == "lint" ? "SUCCESS" : "FAILURE",
          }
          + (c.name == "CI status" ? aggregate_over : {}),
      ]
  }
  return rows
}

fn consumer_pr(rows: list, total: int = -1) -> Repo {
  return pr(
    checks(rows, total)
      + {
        latestOpinionatedReviews: page(
          [
            {
              state: "APPROVED",
              body: author_receipt("abc", "burin-labs/harn"),
              author: {type: "Bot", login: "reviewer"},
            },
          ],
        ),
      },
  )
    + {nameWithOwner: "burin-labs/harn"}
}

pipeline test_the_owning_aggregate_admits_only_its_measured_consumer_failures() {
  const rows = consumer_measurements()
  const inherited = decide(consumer_pr(rows), "clear", false)
  assert_eq(inherited.action, "merge", "the same-run aggregate owns inherited consumer failures")
  assert_eq(len(inherited.facts.failing), 0)
  assert_eq(len(inherited.facts.measurements), 2, "negative measurements stay visible")
  // A causal failure and an absent measurement both make the owning aggregate red.
  for conclusion in ["FAILURE", "SKIPPED", "NEUTRAL", "CANCELLED", nil] {
    assert_eq(
      decide(consumer_pr(consumer_measurements({}, {conclusion: conclusion})), "clear", false)
        .action,
      "stop",
    )
  }
  const refused = [
    consumer_measurements({}, {status: "IN_PROGRESS"}),
    consumer_measurements({}, {checkSuite: nil}),
    consumer_measurements({}, {checkSuite: {id: "CS_foreign"}}),
    consumer_measurements({}, {name: "another aggregate"}),
    consumer_measurements({}, {state: "SUCCESS"}),
    consumer_measurements({commit: {oid: "def"}}),
    consumer_measurements({app: nil}),
    consumer_measurements({app: {id: "another-app"}}),
    consumer_measurements(
      {
        workflowRun: {
          databaseId: 42,
          event: "push",
          workflow: {id: "W_kwDORxdAHc4PAxHq", name: "CI"},
        },
      },
    ),
    consumer_measurements(
      {
        workflowRun: {
          databaseId: 42,
          event: "schedule",
          workflow: {id: "W_kwDORxdAHc4PAxHq", name: "CI"},
        },
      },
    ),
    consumer_measurements(
      {
        workflowRun: {
          databaseId: 42,
          event: "pull_request",
          workflow: {id: "another-workflow", name: "CI"},
        },
      },
    ),
    consumer_measurements({checkRuns: {totalCount: 5}}),
    rows.filter({ c -> c.name != "CI status" }).to_list(),
    rows + [rows[0]],
    rows.map(
      { c ->
        c.name == "Consumer check / Consumer canary" ? c
          + {name: "Consumer check / Another gate"} : c
      },
    )
      .to_list(),
    rows.map(
      { c -> c.name == "Consumer check / Consumer canary" ? c + {conclusion: "TIMED_OUT"} : c },
    )
      .to_list(),
    rows + [{name: "unrelated", status: "COMPLETED", conclusion: "FAILURE"}],
    rows + [{name: "unrelated", status: "IN_PROGRESS"}],
  ]
  for checks in refused {
    assert_eq(decide(consumer_pr(checks), "clear", false).action, "stop", to_string(checks))
  }
  assert_eq(decide(consumer_pr(rows, 5), "clear", false).action, "stop", "partial rollup refuses")
  assert_eq(
    decide(pr(checks(rows)), "clear", false).action,
    "stop",
    "another repository cannot borrow Harn's policy",
  )
}

/**
 * A run cancelled before its matrix expanded leaves a check named `matrix.name` that no later
 * run reuses. Only a newer run of the same workflow, head and event that finished green, with
 * every check it reports read and terminal, sets that placeholder aside.
 */
pipeline test_a_newer_whole_green_run_supersedes_a_cancelled_placeholder() {
  const jobs = ["build", "lint", "test (linux)", "test (macos)", "CI status"]
  const cancelled = ci_run("CS_old", 41568316925, jobs + ["matrix.name"], "CANCELLED")
  const fresh = { over, total ->
    checks(cancelled + ci_run("CS_new", 41568644189, jobs, "SUCCESS", over, total))
  }
  assert_eq(
    decide(pr(fresh({}, -1)), "clear", false).action,
    "merge",
    "the real case: a placeholder from a cancelled run under a whole green rerun",
  )
  const run = { id, event, workflow ->
    {workflowRun: {databaseId: id, event: event, workflow: {id: workflow, name: "CI"}}}
  }
  const refusals = [
    ["the newer run is still finishing", {status: "IN_PROGRESS", conclusion: nil}, -1],
    ["the newer run reports a check nobody read", {}, len(jobs) + 1],
    ["the newer run is on another head", {commit: {oid: "def"}}, -1],
    ["the newer run is another workflow", run(41568644189, "pull_request", "W_other"), -1],
    ["the newer run answers another event", run(41568644189, "push", "W_ci"), -1],
    ["the green run is the older one", run(41568316924, "pull_request", "W_ci"), -1],
    ["the green run's app is unknown", {app: nil}, -1],
  ]
  for row in refusals {
    const seen = decide(pr(fresh(row[1], row[2])), "clear", false)
    assert_eq(seen.action, "stop", row[0])
    assert(
      contains(seen.reason, "need a fresh push: ") && contains(seen.reason, "matrix.name"),
      row[0],
    )
  }
  const green = cancelled + ci_run("CS_new", 41568644189, jobs, "SUCCESS")
  const failing = green
    + [{name: "docs", status: "COMPLETED", conclusion: "FAILURE", databaseId: 9}]
  assert_eq(
    decide(pr(checks(failing)), "clear", false).reason,
    "failing checks: docs; repair is off here",
    "a current failure still blocks",
  )
  const pending = green + [{name: "late", status: "IN_PROGRESS", databaseId: 9}]
  assert_eq(decide(pr(checks(pending)), "clear", false).reason, "pending checks: late")
}

pipeline test_a_page_it_did_not_read_refuses(harness: Harness) {
  const unread = [
    checks([GREEN], 2),
    {reviewThreads: {totalCount: 1, nodes: []}},
    {labels: {totalCount: 2, nodes: [{name: "ship"}]}},
    {latestOpinionatedReviews: {totalCount: 2, nodes: [{state: "APPROVED", commit: {oid: "abc"}}]}},
  ]
  for over in unread {
    const d = decide(pr(over), "clear", true)
    assert_eq(d.action, "stop", to_string(over))
    assert(contains(d.reason, "completely"), d.reason)
  }
}

pipeline test_a_release_lease_holds_every_other_merge(harness: Harness) {
  const head = "a" * 40
  const lease =
    fn(repo, base, base_oid, number, sha, method) { return "release-merge-lease v2 repo=${repo} base=${base} base_oid=${base_oid} candidate_pr=${number} candidate_head=${sha} generation=g tag=v1 merge_method=${method}" }
  const base = "1" * 40
  const holder = pr(
    {
      headRefOid: head,
      latestOpinionatedReviews: page(
        [{state: "APPROVED", body: author_receipt(head), author: {type: "Bot", login: "reviewer"}}],
      ),
    },
  )
  assert_eq(
    decide(holder, lease("o/r", "main", base, 9, head, "squash"), false).action,
    "merge",
    "the holder lands",
  )
  const others = [
    lease("o/x", "main", base, 9, head, "squash"),
    lease("o/r", "next", base, 9, head, "squash"),
    lease("o/r", "main", "2" * 40, 9, head, "squash"),
    lease("o/r", "main", base, 4, head, "squash"),
    lease("o/r", "main", base, 9, "b" * 40, "squash"),
    lease("o/r", "main", base, 9, head, "merge"),
    "release-merge-lease v1 candidate_pr=9",
  ]
  for held in others {
    assert_eq(decide(holder, held, false).action, "stop", held)
  }
}

pipeline test_a_blocked_head_gets_one_bounded_repair(harness: Harness) {
  assert_eq(decide(pr(red()), "clear", true).action, "repair")
  const conflicted = {mergeStateStatus: "DIRTY"}
    + checks([{name: "CI status", status: "IN_PROGRESS"}])
  assert_eq(
    decide(pr(conflicted), "clear", true).action,
    "repair",
    "a conflict is repaired without waiting on checks",
  )
  assert_eq(decide(pr(conflicted), "clear", false).action, "stop")
  assert_eq(
    decide(pr(red()), "clear", false).reason,
    "failing checks: CI status; repair is off here",
  )
  assert_eq(decide(pr(red() + {reviewDecision: "REVIEW_REQUIRED"}), "clear", true).action, "repair")
  assert_eq(
    decide(pr(red() + {labels: page([{name: "ship"}, {name: "no-auto-repair"}])}), "clear", true)
      .action,
    "stop",
    "the repair opt-out holds",
  )
  const long_thread = {
    reviewThreads: page(
      [{isResolved: false, path: "a.rs", comments: {totalCount: 101, nodes: []}}],
    ),
  }
  assert_eq(
    decide(pr(red() + long_thread), "clear", true).reason,
    "failing checks: CI status; 1 unresolved review thread(s); a review thread is too long to read whole; a person needs to take it",
    "the agent never repairs from a partial thread",
  )
  const ours = { body -> {body: body, viewerDidAuthor: true} }
  const answered = {
    comments: page([ours("x <!-- smart-ship head=abc -->"), ours("<!-- smart-ship done=abc -->")]),
  }
  assert_eq(
    decide(pr(red() + answered), "clear", true).reason,
    "failing checks: CI status; already answered at this head",
  )
  const wip = "f" * 40
  const timed_out = {
    comments: page(
      [
        ours("<!-- smart-ship head=abc -->"),
        ours("kept <!-- smart-ship continue=abc wip=${wip} -->\n\n<!-- smart-ship done=abc -->"),
      ],
    ),
  }
  const reopened = decide(pr(red() + timed_out), "clear", true)
  assert_eq(reopened.action, "repair", "saved work earns one more attempt at the same head")
  assert_eq(reopened.facts.kept, [wip], "only the saved commit Smart Ship named is restored")
  const forged = {
    comments: page(
      [
        ours("<!-- smart-ship head=abc -->"),
        ours("<!-- smart-ship done=abc -->"),
        {body: "<!-- smart-ship continue=abc wip=${wip} -->"},
      ],
    ),
  }
  const refused = decide(pr(red() + forged), "clear", true)
  assert_eq(
    refused.reason,
    "failing checks: CI status; already answered at this head",
    "only Smart Ship's own note reopens a head",
  )
  assert_eq(refused.facts.kept, [], "a planted note names no saved work")
  const burned = {
    comments: page(
      [
        {body: "<!-- smart-ship head=a -->"},
        {body: "<!-- smart-ship head=b -->"},
        {body: "<!-- smart-ship head=abc -->"},
      ],
    ),
  }
  assert_eq(
    decide(pr(red() + burned), "clear", true).action,
    "repair",
    "markers anyone else posts neither answer a head nor spend attempts",
  )
  const spent = {
    comments: page(
      [
        ours("<!-- smart-ship head=a -->"),
        ours("<!-- smart-ship head=b -->"),
        ours("<!-- smart-ship head=c -->"),
      ],
    ),
  }
  assert_eq(decide(pr(red() + spent), "clear", true).action, "stop")
  const unread_marks = {comments: {totalCount: 101, nodes: []}}
  assert_eq(
    decide(pr(red() + unread_marks), "clear", true).action,
    "stop",
    "an unread attempt count never repairs",
  )
}

/** An attempt whose job died left its marker open, and the head read as answered forever. */
pipeline test_a_crashed_attempt_counts_once_and_closes(harness: Harness) {
  const ours = { body -> {body: body, viewerDidAuthor: true} }
  const notes = { bodies -> {comments: page(bodies)} }
  const crashed = decide(pr(red() + notes([ours("<!-- smart-ship head=abc -->")])), "clear", true)
  assert_eq(crashed.facts.open, 1, "the dead attempt is the one a look closes")
  assert_eq(crashed.facts.marks, 1, "it spent one attempt")
  assert_eq(crashed.action, "repair", "a crash is not an answer")
  const closed = decide(
    pr(
      red() + notes([ours("<!-- smart-ship head=abc -->"), ours("<!-- smart-ship ended=abc -->")]),
    ),
    "clear",
    true,
  )
  assert_eq([closed.facts.open, closed.facts.marks, closed.action], [0, 1, "repair"], "closed once")
  const three = notes(
    [
      ours("<!-- smart-ship head=abc -->"),
      ours("<!-- smart-ship ended=abc -->"),
      ours("<!-- smart-ship head=abc -->"),
      ours("<!-- smart-ship ended=abc -->"),
      ours("<!-- smart-ship head=abc -->"),
    ],
  )
  const spent = decide(pr(red() + three), "clear", true)
  assert_eq(
    spent.reason,
    "failing checks: CI status; repair attempts used up; a person needs to take it",
  )
  assert_eq(spent.facts.open, 1, "the last one still closes")
  const planted = notes(
    [ours("<!-- smart-ship head=abc -->"), {body: "<!-- smart-ship done=abc -->"}],
  )
  const p = decide(pr(red() + planted), "clear", true)
  assert_eq([p.facts.open, p.action], [1, "repair"], "only Smart Ship's own note closes or answers")
}

type Posted = {body: string}

type PreparedJob = {nonce: string, head: string}

/** The real look, not a stub, binds its freshly prepared job to the supplied nonce. */
pipeline test_real_repair_look_binds_prepared_nonce(harness: Harness) {
  real_repair(harness, false)
}

/** An interrupted run left its checkout behind; the next attempt still clones and repairs. */
pipeline test_real_repair_survives_a_stale_checkout(harness: Harness) {
  real_repair(harness, true)
}

/** A whole repair look against a local git remote and a fake GitHub. */
fn real_repair(harness: Harness, stale: bool) {
  const dir = harness.fs.mkdtemp_in_workspace("real-prepare-nonce-")
  const remote = dir + "/o/r.git"
  harness.fs.mkdir(dir + "/o", true)
  harness.fs.mkdir(remote)
  const git = { args ->
    sh(
      harness.tools,
      ["git", "-c", "user.name=t", "-c", "user.email=t@t", "-c", "commit.gpgsign=false"] + args,
      {},
      remote,
    )
  }
  git(["init", "--quiet", "--initial-branch=main"])
  harness.fs.write_text(remote + "/file.txt", "content\n")
  git(["add", "file.txt"])
  git(["commit", "--quiet", "-m", "fixture"])
  const head = git(["rev-parse", "HEAD"])
  const red_check = checks([{name: "CI status", status: "COMPLETED", conclusion: "FAILURE"}])
  const commit = red_check.commits.nodes[0].commit + {oid: head}
  const state = pr(red_check + {headRefOid: head, commits: {nodes: [{commit: commit}]}})
  const api = "https://api.github.com"
  harness.testing.http_mock_clear()
  harness.testing.http_mock(
    "POST",
    api + "/graphql",
    {status: 200, body: json_stringify({data: {repository: state}})},
  )
  harness.testing.http_mock(
    "GET",
    api + "/repos/o/r/git/matching-refs/release-merge-lease/main",
    {status: 200, body: "[]"},
  )
  harness.testing.http_mock(
    "GET",
    api + "/repos/o/r/git/matching-refs/smart-ship/wip/9",
    {status: 200, body: "[]"},
  )
  harness.testing.http_mock("POST", api + "/repos/o/r/issues/9/comments", {status: 201, body: "{}"})
  const work = dir + "/work"
  if stale {
    harness.fs.mkdir(work + "/base", true)
    harness.fs.write_text(work + "/base/old-job", "left by an interrupted runner\n")
  }
  const result = look(
    harness,
    {
      repo: "o/r",
      number: 9,
      token: "fixture-token",
      work: work,
      publish: false,
      repair: true,
      run_id: "",
      opts: {installation_token: "fixture-token", budget: {state_dir: ""}},
      git_host: "file://" + dir + "/",
      nonce: "unique-fixture-nonce",
    },
  )
  if stale {
    assert(harness.fs.exists(work + "/base/old-job"), "unconfirmed earlier work stays recoverable")
  }
  assert_eq(result.action, "repair")
  const prepared = schema_expect(
    json_parse(harness.fs.read_text(work + "/job.json")),
    schema_of(PreparedJob),
  )
  assert_eq(prepared.nonce, "unique-fixture-nonce")
  assert_eq(prepared.head, head)
  assert(harness.fs.exists(work + "/pr/.git/ship-task.json"), "the actual repair task was written")
}

/** A whole look against a fake GitHub serving this PR state; returns the comments it posted. */
fn look_at(harness: Harness, comments: list, repair: bool, over: dict = {}) {
  harness.testing.http_mock_clear()
  const state = {data: {repository: pr(red() + {comments: page(comments)} + over)}}
  const api = "https://api.github.com"
  harness.testing.http_mock("POST", api + "/graphql", {status: 200, body: json_stringify(state)})
  harness.testing.http_mock(
    "GET",
    api + "/repos/o/r/git/matching-refs/release-merge-lease/main",
    {status: 200, body: "[]"},
  )
  harness.testing.http_mock("POST", api + "/repos/o/r/issues/9/comments", {status: 201, body: "{}"})
  const job = {
    repo: "o/r",
    number: 9,
    token: "fixture-token",
    work: harness.fs.mkdtemp_in_workspace("smart-ship-look-"),
    publish: false,
    repair: repair,
    run_id: "",
    opts: {installation_token: "fixture-token", budget: {state_dir: ""}},
    // No host serves this, so a repair's checkout fails the way a dead clone does.
    git_host: "file:///nonexistent-smart-ship-host/",
    nonce: "",
  }
  const result = try {
    look(harness, job)
  }
  const posted = harness.testing.http_mock_calls({include_sensitive: true}).filter(
    { c -> c.method == "POST" && contains(c.url, "/issues/9/comments") },
  )
    .map({ c -> schema_expect(json_parse(c.body), schema_of(Posted)).body })
    .to_list()
  return {result: result, posted: posted}
}

/**
 * The look itself closes a dead attempt once, starts the next within the cap, and stops at it.
 * A look once closed attempts on PRs it does not shepherd, and from a partial comment census.
 */
pipeline test_only_an_admitted_whole_census_closes_an_attempt(harness: Harness) {
  const started = {body: "<!-- smart-ship head=abc -->", viewerDidAuthor: true}
  const active = look_at(harness, [started], false)
  assert_eq(len(active.posted), 1, "an admitted PR with its whole history closes once")
  assert(contains(active.posted[0], "smart-ship ended=abc"), active.posted[0])
  const unlabeled = look_at(harness, [started], true, {labels: page([])})
  assert_eq(unlabeled.posted, [], "an unlabeled PR is never written to")
  for hold in ["do-not-merge", "hold"] {
    const held = look_at(harness, [started], true, {labels: page([{name: "ship"}, {name: hold}])})
    assert_eq(held.posted, [], "a PR held by ${hold} is never written to")
  }
  let visible = [started]
  for _ in 0..99 {
    visible = visible + [{body: "ordinary comment", viewerDidAuthor: false}]
  }
  const partial = look_at(harness, [], true, {comments: {totalCount: 101, nodes: visible}})
  assert_eq(partial.posted, [], "a partial census closes nothing")
  assert(is_err(partial.result), "an unreadable needs-you history must stop the look")
  assert(contains(to_string(partial.result), "needs-you comment census is incomplete"))
  assert_eq(
    decide(pr(red() + {comments: {totalCount: 101, nodes: visible}}), "clear", true).reason,
    "failing checks: CI status; repair attempts used up; a person needs to take it",
    "and its unread attempts read as used up",
  )
}

pipeline test_a_look_closes_a_crashed_attempt_once(harness: Harness) {
  const ours = { body -> {body: body, viewerDidAuthor: true} }
  const started = ours("<!-- smart-ship head=abc -->")
  const ended = ours("<!-- smart-ship ended=abc -->")
  const first = look_at(harness, [started], false)
  assert_eq(len(first.posted), 1, to_string(first.posted))
  assert(contains(first.posted[0], "smart-ship ended=abc"), first.posted[0])
  assert_eq(unwrap(first.result).reason, "failing checks: CI status; repair is off here")
  const again = look_at(harness, [started, ended], false)
  assert_eq(again.posted, [], "a later look posts no duplicate")
  const next = look_at(harness, [started, ended], true)
  assert(is_err(next.result), "a failed checkout reaches the look's caller")
  assert_eq(len(next.posted), 2, to_string(next.posted))
  assert(
    contains(next.posted[0], "attempt 2 of 3") && contains(next.posted[0], "smart-ship head=abc"),
    next.posted[0],
  )
  assert(
    contains(next.posted[1], "could not start") && contains(next.posted[1], "smart-ship ended=abc"),
    next.posted[1],
  )
  const third = look_at(harness, [started, ended, started, ended, started], true)
  assert_eq(len(third.posted), 1, "the third crash is closed and no fourth attempt starts")
  assert(contains(third.posted[0], "smart-ship ended=abc"), third.posted[0])
  assert_eq(
    unwrap(third.result).reason,
    "failing checks: CI status; repair attempts used up; a person needs to take it",
  )
  const capped = look_at(harness, [started, ended, started, ended, started, ended], true)
  assert_eq(capped.posted, [], "a capped head posts nothing")
}

/**
 * A remote that would serve a blobless clone, whose head and main each change one line of f.txt
 * from an ancestor neither endpoint tree holds; `head_line` "" leaves the head's line alone.
 */
fn diverged(harness: Harness, head_line: string) {
  const dir = harness.fs.mkdtemp_in_workspace("smart-ship-checkout-")
  const remote = dir + "/remote"
  const git = { argv ->
    sh(harness.tools, ["git", "-c", "user.name=t", "-c", "user.email=t@t"] + argv, {}, remote)
  }
  harness.fs.mkdir(remote)
  git(["init", "--quiet", "--initial-branch=main"])
  git(["config", "uploadpack.allowFilter", "true"])
  git(["config", "uploadpack.allowAnySHA1InWant", "true"])
  const commit = { first, last, message ->
    harness.fs.write_text(remote + "/f.txt", "${first}\n2\n3\n4\n5\n6\n7\n8\n9\n${last}\n")
    git(["add", "f.txt"])
    git(["commit", "--quiet", "-m", message])
  }
  commit("ancestor", "10", "start")
  git(["checkout", "--quiet", "-b", "head"])
  commit("intermediate", "10", "intermediate")
  commit("ours", head_line == "" ? "10" : head_line, "ours")
  const head = git(["rev-parse", "HEAD"])
  git(["checkout", "--quiet", "main"])
  commit("ancestor", "theirs", "theirs")
  return {dir: dir, url: "file://" + remote, head: head}
}

// With lazy fetch off, a read that needs an object the clone lacks fails instead of fetching it.
const OFFLINE = {GIT_NO_LAZY_FETCH: "1"}

/**
 * A blobless clone once failed a conflicted repair: the merge base's blob sat in neither endpoint
 * tree, and the agent's working copy has no way to fetch it.
 */
pipeline test_a_conflict_merges_with_its_ancestors_in_the_clone(harness: Harness) {
  const fixture = diverged(harness, "ours")
  const got = checkout(
    harness.tools,
    fixture.url,
    {},
    fixture.dir + "/work",
    fixture.head,
    "main",
    true,
  )
  assert_eq(got.conflicted, ["f.txt"])
  assert(contains(got.sides, "ours") && contains(got.sides, "theirs"), got.sides)
}

/**
 * A clean PR's checkout once returned before anything hydrated its history, so comparing the head
 * with its merge base, or reading an intermediate commit, failed in the agent's offline copy.
 */
pipeline test_a_clean_head_reads_its_whole_history_offline(harness: Harness) {
  const fixture = diverged(harness, "")
  const got = checkout(
    harness.tools,
    fixture.url,
    {},
    fixture.dir + "/work",
    fixture.head,
    "main",
    false,
  )
  assert_eq(got.conflicted, [], "the clean path")
  const pr = fixture.dir + "/work/pr"
  const read = { argv -> sh(harness.tools, ["git"] + argv, OFFLINE, pr) }
  const ancestor = read(["merge-base", "HEAD", "origin/main"])
  for rev in [ancestor, "HEAD^", "HEAD", "origin/main"] {
    read(["cat-file", "-e", read(["rev-parse", rev + ":f.txt"])])
  }
  const since = read(["diff", ancestor, "HEAD", "--", "f.txt"])
  assert(contains(since, "-ancestor") && contains(since, "+ours"), since)
  assert(
    contains(read(["log", "-p", ancestor + "..HEAD"]), "+intermediate"),
    "every commit's change reads",
  )
  assert(contains(read(["diff", ancestor, "origin/main"]), "+theirs"), "the base's side reads too")
}

/** The scan once read only the first 50 KB of a diff, so a credential further in was published. */
pipeline test_a_credential_deep_in_a_diff_is_never_published(harness: Harness) {
  const dir = harness.fs.mkdtemp_in_workspace("smart-ship-diff-")
  const git = { argv ->
    sh(harness.tools, ["git", "-c", "user.name=t", "-c", "user.email=t@t"] + argv, {}, dir)
  }
  git(["init", "--quiet"])
  harness.fs.write_text(dir + "/notes.txt", "start\n")
  git(["add", "notes.txt"])
  git(["commit", "--quiet", "-m", "start"])
  const filler = "a" * 60000
  harness.fs.write_text(dir + "/notes.txt", "start\n${filler}\n")
  git(["add", "notes.txt"])
  assert_eq(diff_refusal(harness.tools, dir, "HEAD"), "", "a clean diff past 50 KB is read whole")
  harness.fs.write_text(dir + "/notes.txt", "start\n${filler}\nghp_" + "Z" * 36 + "\n")
  git(["add", "notes.txt"])
  assert_eq(
    diff_refusal(harness.tools, dir, "HEAD"),
    "its diff holds something shaped like a credential",
  )
  harness.fs.write_text(dir + "/notes.txt", "start\n" + "b" * 1100000 + "\n")
  git(["add", "notes.txt"])
  assert(contains(diff_refusal(harness.tools, dir, "HEAD"), "cap"), "an oversized fix is refused")
  // A NUL byte makes Git encode the file as a binary patch, which hid the same fake token.
  harness.fs.write_text(dir + "/notes.txt", "start\n")
  harness.fs.write_text(dir + "/blob.bin", "head\0ghp_" + "Z" * 36 + "\0tail")
  git(["add", "notes.txt", "blob.bin"])
  assert(
    contains(diff_refusal(harness.tools, dir, "HEAD"), "binary content"),
    "a binary is refused",
  )
}

/** A modified tracked binary is refused, as is one a `diff` attribute would show as text. */
pipeline test_binary_changes_are_refused_whatever_the_attributes(harness: Harness) {
  const dir = harness.fs.mkdtemp_in_workspace("smart-ship-binary-")
  const git = { argv ->
    sh(
      harness.tools,
      ["git", "-c", "user.name=t", "-c", "user.email=t@t", "-c", "commit.gpgsign=false"] + argv,
      {},
      dir,
    )
  }
  git(["init", "--quiet"])
  harness.fs.write_text(dir + "/.gitattributes", "*.dat diff\n")
  harness.fs.write_text(dir + "/logo.png", "\0old image\0")
  git(["add", ".gitattributes", "logo.png"])
  git(["commit", "--quiet", "-m", "base"])
  harness.fs.write_text(dir + "/logo.png", "\0new image\0")
  git(["add", "logo.png"])
  assert(
    contains(diff_refusal(harness.tools, dir, "HEAD"), "logo.png"),
    "a modified binary is refused",
  )
  git(["reset", "--quiet"])
  harness.fs.write_text(dir + "/blob.dat", "\0" + base64_encode("ghp_" + "Z" * 36) + "\0")
  git(["add", "blob.dat"])
  assert(
    contains(diff_refusal(harness.tools, dir, "HEAD"), "blob.dat"),
    "attributes cannot hide a binary",
  )
  // Git samples only the first 8000 bytes for a NUL; the blob is read whole.
  git(["reset", "--quiet"])
  harness.fs.write_text(
    dir + "/late.dat",
    "a" * 9000 + "\0" + base64_encode("ghp_" + "Z" * 36) + "\0",
  )
  git(["add", "late.dat"])
  assert(
    contains(diff_refusal(harness.tools, dir, "HEAD"), "late.dat"),
    "a late NUL is still binary",
  )
}

/** A prepared repair checkout over the divergent fixture. */
fn prepared(harness: Harness, conflict: bool) {
  const f = divergent(harness, conflict)
  assert_eq(divergent_look(harness, f, false, "", "", true).result.action, "repair")
  return f + {work: f.dir + "/work", pr_dir: f.dir + "/work/pr"}
}

fn staged_names(harness: Harness, work: string, against: string) -> string {
  return sh(
    harness.tools,
    ["git", "diff", "--cached", "--name-status", "--no-renames", against],
    {},
    work + "/pristine",
  )
}

/**
 * The cache policy once dropped every new path under `.harn` or a cache directory, so a genuine new
 * source file vanished from a successful repair. Only exact cache shapes are left out now; any
 * other path there stops the repair and is named.
 */
pipeline test_an_ambiguous_new_file_stops_the_repair(harness: Harness) {
  const cases = [
    ".harn/workflows/new.harn",
    "conformance/tests/scenarios/s1/.harn/skills/x/SKILL.md",
    "node_modules/pkg/index.js",
    "stray.pyc",
    ".env",
  ]
  for path in cases {
    const f = prepared(harness, false)
    harness.fs.write_text(f.pr_dir + "/file.txt", "real fix\n")
    const parts = split(path, "/")
    if len(parts) > 1 {
      harness.fs.mkdir(f.pr_dir + "/" + join(parts.slice(0, len(parts) - 1), "/"), true)
    }
    harness.fs.write_text(f.pr_dir + "/" + path, "intended\n")
    const refused = to_string(stage_repair(harness, f.work))
    assert(contains(refused, "cannot classify") && contains(refused, path), path + ": " + refused)
  }
}

/** Move a tracked file into Harn's run state, optionally editing it on the way. */
fn move_into_cache(harness: Harness, pr_dir: string, edit: bool) {
  harness.fs.mkdir(pr_dir + "/.harn/state", true)
  assert(
    harness.process.run(
      {program: "/bin/mv", args: [pr_dir + "/file.txt", pr_dir + "/.harn/state/file.txt"]},
    ).success,
  )
  if edit {
    harness.fs.write_text(pr_dir + "/.harn/state/file.txt", "moved and edited\n")
  }
}

/**
 * A tracked file moved into a cache path would commit as a bare deletion. Matching content missed
 * an edited move, so any deletion beside a cache file stops the repair.
 */
pipeline test_a_tracked_file_moved_into_a_cache_stops_the_repair(harness: Harness) {
  for edit in [false, true] {
    const f = prepared(harness, false)
    move_into_cache(harness, f.pr_dir, edit)
    const refused = to_string(stage_repair(harness, f.work))
    assert(
      contains(refused, "deleted tracked files") && contains(refused, ".harn/state/file.txt"),
      refused,
    )
  }
}

/** Checkpoint and publish both refuse a deletion beside a cache file and keep the work. */
pipeline test_a_deletion_beside_a_cache_publishes_nothing_and_keeps_the_work(harness: Harness) {
  for outcome in ["timeout", "fixed"] {
    const f = prepared(harness, false)
    move_into_cache(harness, f.pr_dir, true)
    harness.fs.write_text(
      f.pr_dir + "/.git/ship-result.json",
      json_stringify({outcome: outcome, summary: "s", spend: "0.01"}),
    )
    const branch = [
      "GET",
      "/repos/o/r/git/ref/heads/b",
      {status: 200, body: json_stringify({ref: "refs/heads/b", object: {sha: f.head}})},
    ]
    const seen = divergent_look(harness, f, true, "", "", true, "", [branch])
    assert_eq(seen.result.action, "publish_failed", outcome)
    assert(
      contains(seen.result.reason, "deleted tracked files"),
      outcome + ": " + seen.result.reason,
    )
    assert_eq(committed_paths(seen.calls), "", outcome + ": nothing reached GitHub")
    assert_eq(
      harness.fs.read_text(f.pr_dir + "/.harn/state/file.txt"),
      "moved and edited\n",
      outcome + ": work kept",
    )
  }
}

/** A nested repository would commit as a broken gitlink; the repair stops and names it. */
pipeline test_a_nested_repository_stops_the_repair(harness: Harness) {
  const f = prepared(harness, false)
  harness.fs.mkdir(f.pr_dir + "/vendor/dep", true)
  sh(harness.tools, ["git", "init", "--quiet"], {}, f.pr_dir + "/vendor/dep")
  harness.fs.write_text(f.pr_dir + "/vendor/dep/x.txt", "x\n")
  const refused = to_string(stage_repair(harness, f.work))
  assert(contains(refused, "nested repository") && contains(refused, "vendor/dep/"), refused)
}

/** A conflicted checkpoint holds the base merge; a binary the base changed is not the repair's. */
pipeline test_a_conflicted_checkpoint_keeps_the_bases_binaries(harness: Harness) {
  const f = divergent(harness, true)
  harness.fs.write_text(f.remote + "/logo.png", "\0base image\0")
  f.git(["add", "logo.png"])
  f.git(["commit", "--quiet", "-m", "base binary"])
  assert_eq(divergent_look(harness, f, false, "", "", true).result.action, "repair")
  harness.fs.write_text(f.dir + "/work/pr/file.txt", "half resolved\n")
  harness.fs.write_text(
    f.dir + "/work/pr/.git/ship-result.json",
    json_stringify({outcome: "timeout", summary: "ran out of time", spend: "0.01"}),
  )
  const sent = committed_paths(divergent_look(harness, f, true, "", "", true).calls)
  assert(contains(sent, base64_encode("half resolved\n")), "the checkpoint was sent: " + sent)
}

/** The resolution stages onto the merge's tree, so a tracked base file in a cache path stays. */
pipeline test_a_resolution_keeps_tracked_base_files_in_cache_paths(harness: Harness) {
  const f = divergent(harness, true)
  harness.fs.mkdir(f.remote + "/pkg/__pycache__", true)
  harness.fs.write_text(f.remote + "/pkg/__pycache__/base.pyc", "tracked by the base\n")
  f.git(["add", "pkg"])
  f.git(["commit", "--quiet", "-m", "base tracks a cache file"])
  assert_eq(divergent_look(harness, f, false, "", "", true).result.action, "repair")
  const work = f.dir + "/work"
  harness.fs.write_text(work + "/pr/file.txt", "resolved\n")
  // GitHub's merge of the base, made locally: the base's side of the conflict, then the merge.
  f.git(["checkout", "--quiet", "-b", "merged", f.head])
  f.git(["merge", "--quiet", "-X", "theirs", "-m", "merge", "main"])
  const merge_oid = f.git(["rev-parse", "HEAD"])
  f.git(["checkout", "--quiet", "main"])
  stage_resolution(harness, work, merge_oid, {})
  const staged = staged_names(harness, work, merge_oid)
  assert(contains(staged, "file.txt"), staged)
  assert(!contains(staged, "base.pyc"), "the base's tracked file is kept: " + staged)
}

/** The repair's write set: one real edit, one new test, and the junk its tools left behind. */
fn leave_repair_and_junk(harness: Harness, pr_dir: string, outcome: string) {
  harness.fs.write_text(pr_dir + "/file.txt", "real fix\n")
  harness.fs.mkdir(pr_dir + "/tests", true)
  harness.fs.write_text(pr_dir + "/tests/test_new.py", "def test_new(): pass\n")
  harness.fs.mkdir(pr_dir + "/.harn/state/snapshots", true)
  harness.fs.write_text(pr_dir + "/.harn/state/snapshots/x", "agent snapshot\n")
  harness.fs.mkdir(pr_dir + "/pkg/__pycache__", true)
  harness.fs.write_text(pr_dir + "/pkg/__pycache__/m.pyc", "compiled\n")
  harness.fs.write_text(
    pr_dir + "/.git/ship-result.json",
    json_stringify({outcome: outcome, summary: "s", spend: "0.01"}),
  )
}

fn committed_paths(calls: list) -> string {
  return join(
    calls.filter({ c -> c.method == "POST" && contains(c.body ?? "", "createCommitOnBranch") })
      .map({ c -> c.body })
      .to_list(),
    "\n",
  )
}

/**
 * Staging once ran `git add -A`, so agent state and caches rode along on checkpoints and
 * published repairs. Both now commit the real edit and the new test only.
 */
pipeline test_a_repair_commits_only_its_intended_changes(harness: Harness) {
  for outcome in ["timeout", "fixed"] {
    const f = divergent(harness, false)
    assert_eq(divergent_look(harness, f, false, "", "", true).result.action, "repair")
    leave_repair_and_junk(harness, f.dir + "/work/pr", outcome)
    // The fixed repair commits onto the PR branch, which GitHub reports at the head.
    const branch = [
      "GET",
      "/repos/o/r/git/ref/heads/b",
      {status: 200, body: json_stringify({ref: "refs/heads/b", object: {sha: f.head}})},
    ]
    const sent = committed_paths(divergent_look(harness, f, true, "", "", true, "", [branch]).calls)
    assert(contains(sent, base64_encode("real fix\n")), outcome + ": the real edit is committed")
    assert(contains(sent, "tests/test_new.py"), outcome + ": a genuine new file is committed")
    assert(!contains(sent, ".harn/"), outcome + ": agent state is not committed")
    assert(!contains(sent, "__pycache__"), outcome + ": caches are not committed")
  }
}

/** A checkpoint staged by the repair resumes with its genuine edits and none of the junk. */
pipeline test_a_resumed_checkpoint_restores_only_genuine_edits(harness: Harness) {
  const f = divergent(harness, false)
  assert_eq(divergent_look(harness, f, false, "", "", true).result.action, "repair")
  const work = f.dir + "/work"
  leave_repair_and_junk(harness, work + "/pr", "timeout")
  divergent_look(harness, f, true, "", "", true)
  // GitHub's signed commit is mocked, so commit the very index the checkpoint sent.
  const subject =
    "Smart Ship unfinished repair for #9 at ${f.head}, on base ${f.base_oid}, checkout clean"
  sh(
    harness.tools,
    [
      "git",
      "-c",
      "user.name=t",
      "-c",
      "user.email=t@t",
      "-c",
      "commit.gpgsign=false",
      "commit",
      "--quiet",
      "-m",
      subject,
    ],
    {},
    work + "/pristine",
  )
  f.git(["fetch", "--quiet", work + "/pristine", "HEAD"])
  const wip = f.git(["rev-parse", "FETCH_HEAD"])
  f.git(["update-ref", "refs/smart-ship/wip/9", wip])
  assert(harness.process.run({program: "/bin/rm", args: ["-rf", work]}).success)
  assert_eq(divergent_look(harness, f, false, wip, wip, true).result.action, "repair")
  const pr_dir = work + "/pr"
  assert_eq(harness.fs.read_text(pr_dir + "/file.txt"), "real fix\n")
  assert(harness.fs.exists(pr_dir + "/tests/test_new.py"), "the new test is restored")
  assert(!harness.fs.exists(pr_dir + "/.harn"), "agent state is not restored")
  assert(!harness.fs.exists(pr_dir + "/pkg/__pycache__"), "caches are not restored")
}

/** Execute the selected workflow shells with real flock and the canonical physical lock owner. */
fn workflow_transaction_fixture(harness: {fs: HarnessFs, process: HarnessProcess}) {
  const dir = harness.fs.mkdtemp_in_workspace("smart-ship-workflow-transaction-")
  const controller = dir + "/controller"
  harness.fs.mkdir(controller)
  harness.fs.mkdir(dir + "/bin")
  harness.fs.mkdir(dir + "/runner-temp")
  const owner = harness.fs.source_dir()
  for file in ["harn.toml", "harn.lock"] {
    harness.fs.write_text(controller + "/" + file, harness.fs.read_text(owner + "/" + file))
  }
  // A fixed random source lets the actual look shell encounter an occupied reservation.
  harness.fs.write_text(dir + "/bin/od", "#!/bin/sh\nprintf '%s' '" + "a" * 32 + "'\n")
  assert(harness.process.run({program: "chmod", args: ["755", dir + "/bin/od"]}).success)
  harness.fs.write_text(
    controller + "/ship.harn",
    "import { recovery_store_lock, recovery_store_assert_owned } from "
      + json_stringify(owner + "/recovery.harn")
      + "\n"
      + """
fn main(harness: Harness) {
  const root = harness.env.get("SHIP_RETAIN_ROOT") ?? ""
  const nonce = harness.env.get("SHIP_NONCE") ?? ""
  const work = harness.env.get("SHIP_WORK") ?? ""
  const mode = harness.env.get("SHIP_MODE") ?? "look"
  const lock = recovery_store_lock({fs: harness.fs, tools: harness.tools}, root, nonce)
  recovery_store_assert_owned(harness.fs, lock)
  const pr = harness.env.get("PR") ?? ""
  require regex_match("^[1-9][0-9]*$", pr) != nil, "unmeasured workflow PR"
  if mode == "look" {
    assert_eq(work, root + "/123-1-" + pr + "-" + nonce + "/work")
    const outcome = harness.env.get("LOOK") ?? "prepared"
    require outcome != "failed", "controlled look failure"
    if outcome == "prepared" {
      require !harness.fs.exists(work), "occupied reservation must not be overwritten"
      recovery_store_assert_owned(harness.fs, lock)
      harness.fs.mkdir(work, true)
      recovery_store_assert_owned(harness.fs, lock)
      harness.fs.write_text(work + "/.owner", nonce + "\n")
      recovery_store_assert_owned(harness.fs, lock)
      harness.fs.write_text(work + "/job.json", json_stringify({nonce: nonce}))
    }
  }
  const log = harness.fs.source_dir() + "/transactions"
  const previous = harness.fs.exists(log) ? join(harness.fs.read_lines(log), "\n") + "\n" : ""
  recovery_store_assert_owned(harness.fs, lock)
  harness.fs.write_text(log, previous + mode + "\n")
  require mode != "publish" || harness.env.get("PUBLISH") != "failure", "controlled publication failure"
  harness.stdio.println("physical-transaction:" + mode)
}
""",
  )
  return {
    dir: dir,
    controller: controller,
    root: dir + "/retained",
    work: dir + "/retained/123-1-9-" + "a" * 32 + "/work",
    nonce: "a" * 32,
  }
}

fn workflow_transaction_run(
  harness: Harness,
  f: dict,
  name: string,
  outcome: string = "prepared",
  pr: string = "9",
  work: string = "",
) {
  const steps = read_yaml(harness.fs, "../../.github/workflows/smart-ship.yml").jobs.ship.steps
  const step = steps.filter({ s -> s?.name == name }).to_list()[0]
  const script = f.dir + "/selected-" + sha256(name) + ".sh"
  harness.fs.write_text(script, step.run)
  const output = f.dir + "/output"
  harness.fs.write_text(output, "")
  return harness.process.run(
    {
      program: "bash",
      args: [script],
      cwd: f.controller,
      timeout_ms: 30000,
      env: {
        PATH: f.dir + "/bin:" + to_string(harness.env.get("PATH") ?? ""),
        SHIP_HARN: harness.process.find_executable("harn") ?? "",
        SHIP_RETAIN_ROOT: f.root,
        SHIP_WORK: work == "" ? f.work : work,
        SHIP_NONCE: f.nonce,
        SHIP_MODE:
          name == "Look at the pull request" ? "look" : name == "Publish the repair" ? "publish" : "finalize",
        GH_TOKEN: "inert-controller-token",
        REPO: "o/r",
        PR: pr,
        GITHUB_RUN_ID: "123",
        GITHUB_RUN_ATTEMPT: "1",
        GITHUB_OUTPUT: output,
        LOOK: outcome,
        PUBLISH: outcome,
      },
    },
  )
}

/**
 * Only a look that prepared this nonce may run or publish; finalization also follows failed looks.
 */
pipeline test_only_a_prepared_repair_runs_or_publishes(harness: Harness) {
  const steps = read_yaml(harness.fs, "../../.github/workflows/smart-ship.yml").jobs.ship.steps
  const step = { name -> steps.filter({ s -> s?.name == name }).to_list()[0] }
  const prepared = "steps.look.outputs.prepared == 'true'"
  assert_eq(step("Look at the pull request").id, "look")
  assert_eq(step("Repair without credentials").id, "repair")
  assert_eq(step("Repair without credentials").if, "inputs.repair && ${prepared}")
  assert_eq(
    step("Publish the repair").if,
    "always() && inputs.repair && ${prepared}",
    "a prepared repair publishes even after the agent fails",
  )
  assert_eq(step("Publish the repair").id, "publish")
  assert_eq(step("Finalize recovery custody").if, "always() && steps.look.outputs.nonce != ''")
  assert_eq(step("Finalize recovery custody").env.SHIP_NONCE, "\${{ steps.look.outputs.nonce }}")
  const retained_root = "\${{ runner.temp }}/../.smart-ship-retained"
  assert_eq(step("Look at the pull request").env.SHIP_RETAIN_ROOT, retained_root)
  assert_eq(step("Finalize recovery custody").env.SHIP_RETAIN_ROOT, retained_root)
  for name in ["Repair without credentials", "Publish the repair", "Finalize recovery custody"] {
    assert_eq(step(name).env.SHIP_WORK, "\${{ steps.look.outputs.work }}", name)
  }
  for name in ["prepared", "stopped", "failed", "stale"] {
    const f = workflow_transaction_fixture(pick(harness, ["fs", "process"]))
    if name == "stale" {
      harness.fs.mkdir(f.work, true)
      harness.fs.write_text(f.work + "/job.json", "{\"nonce\":\"from-an-earlier-job\"}")
    }
    const ran = workflow_transaction_run(
      harness,
      f,
      "Look at the pull request",
      name == "stale" ? "prepared" : name,
    )
    assert_eq(ran.success, ["prepared", "stopped"].contains(name), name + ": " + ran.stderr)
    const outputs = harness.fs.read_lines(f.dir + "/output")
    assert_eq(outputs.contains("prepared=true"), name == "prepared", name)
    assert(outputs.contains("nonce=" + f.nonce), "a failed admission can still finalize")
    assert(
      outputs.contains("work=" + f.work),
      "the selected look emits its stable reservation path",
    )
    const finalized = workflow_transaction_run(harness, f, "Finalize recovery custody")
    assert(
      finalized.success && finalized.stdout.contains("physical-transaction:finalize"),
      finalized.stderr,
    )
    assert_eq(harness.fs.exists(f.work), ["prepared", "stale"].contains(name), name)
    if name == "stale" {
      assert(harness.fs.read_text(f.work + "/job.json").contains("from-an-earlier-job"))
    }
  }
}

/** The shell never removes source or controller records, even after a successful publish. */
pipeline test_cleanup_preserves_an_unpublished_repair_and_its_records(harness: Harness) {
  for outcome in ["failure", "cancelled", "success"] {
    const f = workflow_transaction_fixture(pick(harness, ["fs", "process"]))
    const looked = workflow_transaction_run(harness, f, "Look at the pull request")
    assert(looked.success, looked.stderr)
    harness.fs.write_text(f.work + "/unfinished", "repair work")
    harness.fs.write_text(f.controller + "/record", "controller record")
    const published = workflow_transaction_run(harness, f, "Publish the repair", outcome)
    assert_eq(published.success, outcome != "failure", published.stderr)
    const finalized = workflow_transaction_run(harness, f, "Finalize recovery custody")
    assert(
      finalized.success && finalized.stdout.contains("physical-transaction:finalize"),
      finalized.stderr,
    )
    assert_eq(harness.fs.read_text(f.work + "/unfinished"), "repair work")
    assert_eq(harness.fs.read_text(f.controller + "/record"), "controller record")
    assert_eq(
      harness.fs.read_lines(f.controller + "/transactions"),
      ["look", "publish", "finalize"],
    )
  }
}

/** GitHub clears runner.temp after a job, so failed work must leave that directory. */
pipeline test_failed_work_survives_runner_temp_cleanup(harness: Harness) {
  const f = workflow_transaction_fixture(pick(harness, ["fs", "process"]))
  const looked = workflow_transaction_run(harness, f, "Look at the pull request")
  assert(looked.success, looked.stderr)
  harness.fs.write_text(f.work + "/unfinished", "repair work")
  const finalized = workflow_transaction_run(harness, f, "Finalize recovery custody")
  assert(finalized.success, finalized.stderr)
  assert(harness.process.run({program: "rm", args: ["-rf", f.dir + "/runner-temp"]}).success)
  assert_eq(harness.fs.read_text(f.work + "/unfinished"), "repair work")
  assert(harness.fs.exists(f.root + ".lock"), "the persistent sibling lock is never pruned")
}

/** A malformed identity or occupied target must never overwrite anyone's work. */
pipeline test_retention_refuses_an_unowned_target(harness: Harness) {
  for c in ["bad-identity", "occupied"] {
    const f = workflow_transaction_fixture(pick(harness, ["fs", "process"]))
    harness.fs.mkdir(f.work, true)
    harness.fs.write_text(f.work + "/unfinished", "earlier work")
    const ran = workflow_transaction_run(
      harness,
      f,
      "Look at the pull request",
      "prepared",
      c == "occupied" ? "9" : "../9",
    )
    assert(!ran.success, c + " must refuse before overwriting a reservation")
    assert(!harness.fs.read_lines(f.dir + "/output").contains("prepared=true"))
    assert_eq(harness.fs.read_text(f.work + "/unfinished"), "earlier work")
    const entries = harness.fs.list_dir(f.root)
    assert_eq(
      entries,
      ["123-1-9-" + f.nonce],
      "the shell must not invent an alternate retention path",
    )
  }
}

pipeline test_agent_text_cannot_post_a_marker_or_a_credential(harness: Harness) {
  const said = quiet("done <!-- smart-ship continue=abc wip=" + "f" * 40 + " --> ghp_" + "Z" * 36)
  assert(!contains(said, "<!--"), said)
  assert(!contains(said, "ghp_"), said)
}

/** A local remote whose topic head and main both changed file.txt, so merging main conflicts. */
fn divergent(harness: Harness, conflict: bool = true) {
  const dir = harness.fs.mkdtemp_in_workspace("smart-ship-divergent-")
  const remote = dir + "/o/r.git"
  harness.fs.mkdir(remote, true)
  const git = { args ->
    sh(
      harness.tools,
      ["git", "-c", "user.name=t", "-c", "user.email=t@t", "-c", "commit.gpgsign=false"] + args,
      {},
      remote,
    )
  }
  git(["init", "--quiet", "--initial-branch=main"])
  harness.fs.write_text(remote + "/file.txt", "ancestor\n")
  git(["add", "file.txt"])
  git(["commit", "--quiet", "-m", "ancestor"])
  git(["checkout", "--quiet", "-b", "topic"])
  harness.fs.write_text(remote + "/file.txt", "topic\n")
  git(["commit", "--quiet", "-am", "topic"])
  const head = git(["rev-parse", "HEAD"])
  git(["checkout", "--quiet", "main"])
  const moved = conflict ? "/file.txt" : "/other.txt"
  harness.fs.write_text(remote + moved, "base\n")
  git(["add", "."])
  git(["commit", "--quiet", "-m", "base"])
  return {
    dir: dir,
    remote: remote,
    git: git,
    head: head,
    base_oid: git(["rev-parse", "HEAD"]),
    state: conflict ? "DIRTY" : "CLEAN",
  }
}

/**
 * A whole look at the divergent PR; `wip` is the saved commit GitHub reports, `kept` the note's.
 */
fn divergent_look(
  harness: Harness,
  f: dict,
  publish: bool,
  wip: string,
  kept: string,
  trusted: bool,
  retention: string = "",
  extra: list = [],
  producer: dict = {},
) {
  const red_check = checks([{name: "CI status", status: "COMPLETED", conclusion: "FAILURE"}])
  const commit = red_check.commits.nodes[0].commit + {oid: f.head}
  const notes = kept == "" ? [] : [
    {viewerDidAuthor: trusted, body: "<!-- smart-ship continue=${f.head} wip=${kept} -->"},
  ]
  const state = pr(
    red_check
      + {
        headRefOid: f.head,
        mergeStateStatus: f.state,
        comments: page(notes),
        commits: {nodes: [{commit: commit}]},
      },
  )
  const api = "https://api.github.com"
  const refs = wip == "" ? [] : [{ref: "refs/smart-ship/wip/9", object: {sha: wip}}]
  harness.testing.http_mock_clear()
  harness.testing.http_mock(
    "POST",
    api + "/graphql",
    {status: 200, body: json_stringify({data: {repository: state}})},
  )
  harness.testing.http_mock(
    "GET",
    api + "/repos/o/r/git/matching-refs/release-merge-lease/main",
    {status: 200, body: "[]"},
  )
  harness.testing.http_mock(
    "GET",
    api + "/repos/o/r/git/matching-refs/smart-ship/wip/9",
    {status: 200, body: json_stringify(refs)},
  )
  harness.testing.http_mock(
    "DELETE",
    api + "/repos/o/r/git/refs/smart-ship/wip/9",
    {status: 204, body: ""},
  )
  harness.testing.http_mock("POST", api + "/repos/o/r/issues/9/comments", {status: 201, body: "{}"})
  // The saved commit's scratch branch: absent, then created.
  harness.testing.http_mock(
    "GET",
    api + "/repos/o/r/git/ref/heads/smart-ship/*",
    {status: 404, body: "{\"message\":\"Not Found\"}"},
  )
  harness.testing.http_mock(
    "POST",
    api + "/repos/o/r/git/refs",
    {status: 201, body: "{\"ref\":\"refs/heads/smart-ship/wip\"}"},
  )
  for m in extra {
    harness.testing.http_mock(m[0], api + m[1], m[2])
  }
  for method in ["GET", "POST", "PATCH", "PUT", "DELETE"] {
    harness.testing.http_mock(
      method,
      api + "/*",
      {status: 500, body: "{\"message\":\"unexpected\"}"},
    )
  }
  const result = look(
    harness,
    schema_expect(
      {
        repo: "o/r",
        number: 9,
        token: "fixture-token",
        work: f.dir + "/work",
        publish: publish,
        repair: true,
        run_id: "",
        opts: {installation_token: "fixture-token", budget: {state_dir: ""}},
        git_host: "file://" + f.dir + "/",
        nonce: "fixture-nonce",
        retention: retention,
      }
        + producer,
      schema_of(Look),
    ),
  )
  return {result: result, calls: harness.testing.http_mock_calls({include_sensitive: true})}
}

/** Publication records actual custody before a later reporting failure can retain the work. */
@test(cases: [{name: "confirmed", args: ["confirmed"]}, {name: "moved-reference", args: ["moved-reference"]}, {name: "dirty-source", args: ["dirty-source"]}, {name: "comment-failed", args: ["comment-failed"]}, {name: "worker-unconfirmed", args: ["worker-unconfirmed"]}])
@heavy(threads: 2)
pipeline test_recovery_publication_records_only_confirmed_unchanged_source(
  harness: Harness,
  state: string,
) {
  const f = divergent(harness, false)
  const work = "${f.dir}/work"
  const nonce = "a" * 32
  harness.fs.mkdir(work, true)
  harness.fs.write_text("${work}/.owner", "${nonce}\n")
  const producer = {run_id: "123", run_attempt: 1, nonce: nonce}
  const own = [
    ["GET", "/repos/o/r/actions/runs/123", {status: 200, body: "{\"workflow_id\":7}"}],
    [
      "GET",
      "/repos/o/r/actions/workflows/7",
      {status: 200, body: "{\"node_id\":\"own-workflow\"}"},
    ],
  ]
  assert_eq(
    divergent_look(harness, f, false, "", "", true, "", own, producer).result.action,
    "repair",
  )
  const prepared = json_parse(harness.fs.read_text("${work}/job.json"))
  assert_eq(prepared.recovery.run_id, 123, "the actual prepare path must capture its producer")
  assert_eq(prepared.recovery.nonce, nonce)
  harness.fs.write_text("${work}/agent/repair.harn", "fn main(harness: Harness) {}\n")
  const caps = pick(harness, ["fs", "tools"])
  const runtime = worker_runtime(caps, harness.process.find_executable("harn") ?? "")
  const worker = run_worker(caps, work, prepared.recovery, runtime, 30000)
  assert(
    worker_retirement(caps, work, prepared.recovery, runtime).retired,
    "the actual canonical command owner must first measure retirement",
  )
  if state == "worker-unconfirmed" {
    harness.fs.write_text(
      "${work}/worker.json",
      json_stringify(worker + {status: "starting", process_cleanup: nil, exit_code: nil}),
    )
  }
  const tree = sh(harness.tools, ["git", "rev-parse", "${f.head}^{tree}"], {}, "${work}/pristine")
  if state == "dirty-source" {
    harness.fs.write_text("${work}/pr/unfinished-source", "keep this unpublished source")
  }
  harness.fs.write_text(
    "${work}/pr/.git/ship-result.json",
    json_stringify({outcome: "unrelated", summary: "No repair needed", spend: "0.00"}),
  )
  const remote_sha = state == "moved-reference" ? f.base_oid : f.head
  const extra = own
    + [
      ["GET", "/repos/o/r/git/matching-refs/smart-ship/previous/9/", {status: 200, body: "[]"}],
      [
        "GET",
        "/repos/o/r/actions/runs/123/attempts/1",
        {
          status: 200,
          body: json_stringify(
            {id: 123, run_attempt: 1, status: "in_progress", repository: {full_name: "o/r"}},
          ),
        },
      ],
      [
        "GET",
        "/repos/o/r/git/ref/${url_encode("heads/b")}",
        {
          status: 200,
          body: json_stringify({ref: "refs/heads/b", object: {sha: remote_sha, type: "commit"}}),
        },
      ],
      [
        "GET",
        "/repos/o/r/git/commits/${remote_sha}",
        {status: 200, body: json_stringify({sha: remote_sha, tree: {sha: tree}})},
      ],
      [
        "POST",
        "/repos/o/r/issues/9/comments",
        {status: state == "comment-failed" ? 500 : 201, body: "{}"},
      ],
    ]
  const seen = try {
    divergent_look(harness, f, true, "", "", true, "", extra, producer)
  }
  const path = "${work}/recovery.json"
  if ["confirmed", "comment-failed"].contains(state) {
    assert(harness.fs.exists(path), "${state}: exact published custody must be durably recorded")
    const record = recovery_record(json_parse(harness.fs.read_text(path)))
    assert_eq(record.identity, prepared.recovery)
    assert_eq(record.custody.sha, f.head)
    assert_eq(record.snapshot.tree, tree)
    if state == "confirmed" {
      assert_eq(unwrap(seen).result.action, "published")
    } else {
      assert(is_err(seen), "the later comment failure must not be called successful publication")
    }
  } else {
    assert_eq(unwrap(seen).result.action, "publish_failed", state)
    assert(!harness.fs.exists(path), "unconfirmed custody must not create an eligible receipt")
    if state == "worker-unconfirmed" {
      assert(
        contains(unwrap(seen).result.reason, "worker retirement is unconfirmed"),
        "missing retirement must stop before source publication",
      )
    }
  }
  assert(harness.fs.exists(work), "recording or refusing custody must never delete the source")
  if state == "dirty-source" {
    assert_eq(harness.fs.read_text("${work}/pr/unfinished-source"), "keep this unpublished source")
  }
}

/** Finalization must leave an unconfirmed shared clone at its original object-relative path. */
pipeline test_a_retained_checkout_can_read_its_git_objects(harness: Harness) {
  const f = divergent(harness, false)
  assert_eq(divergent_look(harness, f, false, "", "", true).result.action, "repair")
  const work = f.dir + "/work"
  const transaction = workflow_transaction_fixture(pick(harness, ["fs", "process"]))
  const finalized = workflow_transaction_run(
    harness,
    transaction,
    "Finalize recovery custody",
    "prepared",
    "9",
    work,
  )
  assert(
    finalized.success && finalized.stdout.contains("physical-transaction:finalize"),
    finalized.stderr,
  )
  const git = harness.process.run(
    {program: "git", args: ["-C", work + "/pr", "cat-file", "-e", f.head], timeout_ms: 30000},
  )
  assert(git.success, "retained checkout cannot read its head: " + git.stderr)
}

/** Retention must not write through an alternate path planted by the agent. */
pipeline test_a_retained_checkout_never_follows_an_alternate_symlink(harness: Harness) {
  const f = divergent(harness, false)
  assert_eq(divergent_look(harness, f, false, "", "", true).result.action, "repair")
  const work = f.dir + "/work"
  const alternate = work + "/pr/.git/objects/info/alternates"
  assert(harness.process.run({program: "/bin/mv", args: [alternate, alternate + ".old"]}).success)
  const outside = f.dir + "/outside"
  harness.fs.write_text(outside, "untouched")
  assert(harness.process.run({program: "/bin/ln", args: ["-s", outside, alternate]}).success)
  const transaction = workflow_transaction_fixture(pick(harness, ["fs", "process"]))
  const finalized = workflow_transaction_run(
    harness,
    transaction,
    "Finalize recovery custody",
    "prepared",
    "9",
    work,
  )
  assert(
    finalized.success && finalized.stdout.contains("physical-transaction:finalize"),
    finalized.stderr,
  )
  assert_eq(harness.fs.read_text(outside), "untouched")
  assert(harness.process.run({program: "/bin/test", args: ["-L", alternate]}).success)
}

/** Full recovery storage stops before an attempt marker, checkout or model spend. */
pipeline test_full_recovery_storage_stops_only_the_repair(harness: Harness) {
  const root = harness.fs.mkdtemp_in_workspace("smart-ship-cap-")
  const module = harness.fs.project_root() ?? ""
  const entry = "${root}/../capacity-${basename(root)}.harn"
  const owner =
    harness.fs.exists("${module}/ship_test.harn") ? module : "${module}/scripts/smart-ship"
  harness.fs.write_text(
    entry,
    "import { full_storage_case } from ${json_stringify("${owner}/ship_test.harn")}\n"
      + "fn main(harness: Harness) { full_storage_case(harness, argv[0] ?? \"\") }\n",
  )
  const result = command_run(
    harness.tools,
    [
      "flock",
      "--exclusive",
      "--nonblock",
      "--no-fork",
      "${root}.lock",
      harness.process.find_executable("harn") ?? "",
      "run",
      "--standalone",
      "--no-sandbox",
      entry,
      "--",
      root,
    ],
    {timeout_ms: 60000, max_inline_bytes: 65536},
  )
  assert(result.success, result.stderr)
  assert(result.stdout.contains("full-storage-green-merge-confirmed"))
}

pub fn full_storage_case(harness: Harness, root: string) -> nil {
  const caps = pick(harness, ["fs", "tools"])
  const nonce = "a" * 32
  const lock = recovery_store_lock(caps, root, nonce)
  assert_eq(recovery_store_entries(harness.fs, lock), [], "measure the actual empty store first")
  for i in 0..5 {
    harness.fs.mkdir(root + "/saved-" + to_string(i))
  }
  assert_eq(len(recovery_store_entries(harness.fs, lock)), 5, "measure every retained entry")
  const link = root + "-link"
  assert(harness.process.run({program: "/bin/ln", args: ["-s", root, link]}).success)
  let refused = false
  try {
    recovery_store_lock(caps, link, nonce)
  } catch (_) {
    refused = true
  }
  assert(refused, "a symlinked retention root is refused")
  const readers: LifecycleReaders = {
    archive_scope: {repository: "o/r", number: 9},
    observe: { _ ->
      throw "legacy entries must not reach the remote reader"
    },
    source: { _, _ ->
      throw "legacy entries must not reach the source reader"
    },
  }
  const transaction = {
    lock: lock,
    runtime: worker_runtime(caps, harness.process.find_executable("harn") ?? ""),
    readers: readers,
  }
  const f = divergent(harness, false)
  const seen = divergent_look(
    harness,
    f,
    false,
    "",
    "",
    true,
    root,
    [],
    {run_id: "123", run_attempt: 1, nonce: nonce, recovery: transaction},
  )
  assert_eq(seen.result.action, "storage_full")
  assert(contains(seen.result.reason, "no repair was started"), seen.result.reason)
  assert(!harness.fs.exists(f.dir + "/work/job.json"), "no agent task was prepared")
  assert(
    !seen.calls.any(
      { call -> call.method == "POST" && contains(call.body ?? "", "smart-ship head=") },
    ),
  )
  const api = "https://api.github.com"
  harness.testing.http_mock_clear()
  harness.testing.http_mock(
    "POST",
    api + "/graphql",
    {
      responses: [
        {status: 200, body: json_stringify({data: {repository: pr()}})},
        {
          status: 200,
          body: json_stringify({data: {mergePullRequest: {pullRequest: {state: "MERGED"}}}}),
        },
      ],
    },
  )
  harness.testing.http_mock(
    "GET",
    api + "/repos/o/r/git/matching-refs/release-merge-lease/main",
    {status: 200, body: "[]"},
  )
  const green = look(
    harness,
    {
      repo: "o/r",
      number: 9,
      token: "fixture-token",
      work: f.dir + "/other",
      publish: false,
      repair: true,
      run_id: "",
      opts: {installation_token: "fixture-token", budget: {state_dir: ""}},
      git_host: "file://" + f.dir + "/",
      nonce: nonce,
      retention: root,
      recovery: transaction,
    },
  )
  assert_eq(green.action, "merge", "green PRs still land when recovery storage is full")
  assert(
    harness.testing.http_mock_calls({include_sensitive: true}).any(
      { call -> call.method == "POST" && contains(call.body ?? "", "mergePullRequest") },
    ),
    "the actual merge API was reached",
  )
  assert_eq(
    len(recovery_store_entries(harness.fs, lock)),
    5,
    "green merge must preserve unknown work",
  )
  harness.stdio.println("full-storage-green-merge-confirmed")
}

/**
 * A conflicted head once threw its saved work away: the next look deleted the trusted same-head
 * WIP instead of restoring it. An untrusted or other-head WIP is not restored, but remains owned.
 * A trusted WIP on an unknown or moved base is preserved and passed as context to a fresh merge.
 */
pipeline test_a_conflicted_repair_resumes_only_its_own_saved_merge(harness: Harness) {
  for c in ["trusted", "untrusted", "wrong-head", "other-base", "base-moved", "no-base"] {
    const f = divergent(harness)
    f.git(["checkout", "--quiet", "topic"])
    if c == "wrong-head" {
      f.git(["checkout", "--quiet", "-b", "wrong-parent", "HEAD^"])
    }
    harness.fs.write_text(f.remote + "/file.txt", "saved unfinished resolution\n")
    harness.fs.write_text(f.remote + "/added.txt", "new saved file\n")
    f.git(["add", "file.txt", "added.txt"])
    const saved_on = if c == "other-base" {
      "1" * 40
    } else if c == "base-moved" {
      f.git(["rev-parse", "main^"])
    } else {
      f.base_oid
    }
    const subject =
      c == "no-base" ? "unfinished" : "Smart Ship unfinished repair for #9 at ${f.head}, on base ${saved_on}"
    f.git(["commit", "--quiet", "-m", subject])
    const wip = f.git(["rev-parse", "HEAD"])
    f.git(["update-ref", "refs/smart-ship/wip/9", wip])
    f.git(["checkout", "--quiet", "main"])
    if ["other-base", "base-moved", "no-base"].contains(c) {
      const seen = divergent_look(harness, f, false, wip, wip, true)
      assert_eq(seen.result.action, "repair", c)
      assert(
        !seen.calls.any(
          { call -> call.method == "DELETE" && contains(call.url, "/git/refs/smart-ship/wip/9") },
        ),
        c,
      )
      assert(
        contains(harness.fs.read_text(f.dir + "/work/pr/file.txt"), "<<<<<<<"),
        c + ": current base is fresh",
      )
      assert(
        contains(
          harness.fs.read_text(f.dir + "/work/pr/.git/ship-previous.diff"),
          "saved unfinished resolution",
        ),
        c,
      )
      assert(
        contains(
          harness.fs.read_text(f.dir + "/work/pr/.git/ship-task.json"),
          "previous attempt's checkpoint",
        ),
        c,
      )
      if c == "base-moved" {
        harness.fs.write_text(
          f.dir + "/work/pr/.git/ship-result.json",
          json_stringify({outcome: "timeout", summary: "unfinished", spend: "0.01"}),
        )
        const again = divergent_look(harness, f, true, wip, wip, true)
        assert_eq(again.result.action, "publish_failed")
        assert(
          !again.calls.any(
            { call ->
              ["PATCH", "DELETE"].contains(call.method)
                && contains(call.url, "/git/refs/smart-ship/wip/9")
            },
          ),
        )
      }
      continue
    }
    const seen = divergent_look(harness, f, false, wip, wip, c != "untrusted")
    assert_eq(seen.result.action, "repair", c)
    const pr_dir = f.dir + "/work/pr"
    const restored = harness.fs.read_text(pr_dir + "/file.txt") == "saved unfinished resolution\n"
      && harness.fs.exists(pr_dir + "/added.txt")
    const resumed = contains(
      harness.fs.read_text(pr_dir + "/.git/ship-task.json"),
      "This continues an earlier attempt that ran out of time",
    )
    const deleted = seen.calls.any(
      { call -> call.method == "DELETE" && contains(call.url, "/git/refs/smart-ship/wip/9") },
    )
    assert_eq([restored, resumed, deleted], [c == "trusted", c == "trusted", false], c)
    if c != "trusted" {
      assert(contains(harness.fs.read_text(pr_dir + "/file.txt"), "<<<<<<<"), c + ": fresh merge")
      const prepared = json_parse(harness.fs.read_text(f.dir + "/work/job.json"))
      assert(
        prepared.previous_wip == wip,
        "an unconfirmed checkpoint must remain owned before a fresh repair starts",
      )
    }
  }
}

/** Saved filenames must be restored literally, including newlines and Git pathspec syntax. */
pipeline test_a_saved_repair_restores_literal_filenames(harness: Harness) {
  const f = divergent(harness, false)
  f.git(["checkout", "--quiet", "topic"])
  const names = ["newline\nname.txt", "literal[*].txt", ":(glob)magic.txt", "-leading-dash.txt"]
  for name in names {
    harness.fs.write_text(f.remote + "/" + name, "unfinished " + name + "\n")
  }
  f.git(["rm", "--quiet", "file.txt"])
  f.git(["add", "--all"])
  f.git(
    [
      "commit",
      "--quiet",
      "-m",
      "Smart Ship unfinished repair for #9 at ${f.head}, on base ${f.base_oid}, checkout clean",
    ],
  )
  const wip = f.git(["rev-parse", "HEAD"])
  f.git(["update-ref", "refs/smart-ship/wip/9", wip])
  f.git(["checkout", "--quiet", "main"])
  const seen = divergent_look(harness, f, false, wip, wip, true)
  assert_eq(seen.result.action, "repair")
  for name in names {
    assert_eq(harness.fs.read_text(f.dir + "/work/pr/" + name), "unfinished " + name + "\n", name)
  }
  assert(!harness.fs.exists(f.dir + "/work/pr/file.txt"), "saved deletion is restored")
  assert(
    contains(
      harness.fs.read_text(f.dir + "/work/pr/.git/ship-task.json"),
      "This continues an earlier attempt",
    ),
  )
}

pipeline test_a_renamed_checkpoint_restores_both_sides_of_the_rename(harness: Harness) {
  const f = divergent(harness, false)
  f.git(["checkout", "--quiet", "topic"])
  const contents = harness.fs.read_text(f.remote + "/file.txt")
  f.git(["mv", "--", "file.txt", "renamed.txt"])
  f.git(
    [
      "commit",
      "--quiet",
      "-m",
      "Smart Ship unfinished repair for #9 at ${f.head}, on base ${f.base_oid}, checkout clean",
    ],
  )
  const wip = f.git(["rev-parse", "HEAD"])
  f.git(["update-ref", "refs/smart-ship/wip/9", wip])
  f.git(["checkout", "--quiet", "main"])
  const seen = divergent_look(harness, f, false, wip, wip, true)
  assert_eq(seen.result.action, "repair")
  assert_eq(harness.fs.read_text(f.dir + "/work/pr/renamed.txt"), contents)
  assert(!harness.fs.exists(f.dir + "/work/pr/file.txt"))
}

pipeline test_checkpoint_credential_scan_reads_the_renamed_bytes(harness: Harness) {
  const f = divergent(harness, false)
  f.git(["checkout", "--quiet", "topic"])
  harness.fs.write_text(f.remote + "/file.txt", "ghp_" + "Z" * 36 + "\n")
  f.git(["add", "--", "file.txt"])
  f.git(["commit", "--quiet", "-m", "record the scanner control"])
  const before = f.git(["rev-parse", "HEAD"])
  f.git(["mv", "--", "file.txt", "renamed.txt"])
  assert_eq(
    diff_refusal(harness.tools, f.remote, before),
    "its diff holds something shaped like a credential",
  )
}

/**
 * A timed-out repair of a conflicted head once kept nothing: only a clean head's tree was saved.
 * Its merge in progress is now committed as the WIP; every saved tree names the base it was on.
 */
pipeline test_a_timed_out_repair_saves_its_tree_and_base(harness: Harness) {
  for conflict in [true, false] {
    timed_out_save(harness, conflict)
  }
}

/** Successful publication must preserve an older checkpoint whose own custody is unconfirmed. */
pipeline test_a_fixed_repair_preserves_an_unconfirmed_prior_checkpoint(harness: Harness) {
  for available in [true, false] {
    const f = divergent(harness, false)
    f.git(["checkout", "--quiet", "topic"])
    harness.fs.write_text("${f.remote}/file.txt", "earlier work\n")
    f.git(["commit", "--quiet", "-am", "unconfirmed earlier repair"])
    const wip = f.git(["rev-parse", "HEAD"])
    f.git(["update-ref", "refs/smart-ship/wip/9", wip])
    f.git(["checkout", "--quiet", "main"])
    assert_eq(divergent_look(harness, f, false, wip, wip, false).result.action, "repair")
    harness.fs.write_text("${f.dir}/work/pr/file.txt", "new repair\n")
    harness.fs.write_text(
      "${f.dir}/work/pr/.git/ship-result.json",
      json_stringify({outcome: "fixed", summary: "fixed", spend: "0.00"}),
    )
    const red = checks([{name: "CI status", status: "COMPLETED", conclusion: "FAILURE"}])
    const state = pr(
      red
        + {
          headRefOid: f.head,
          commits: {nodes: [{commit: red.commits.nodes[0].commit + {oid: f.head}}]},
        },
    )
    const newer = "b" * 40
    const archive = "refs/smart-ship/previous/9/${wip}"
    const extra = [
      [
        "POST",
        "/graphql",
        {
          responses: [
            {status: 200, body: json_stringify({data: {repository: state}})},
            {
              status: 200,
              body: json_stringify(
                {
                  data: {
                    createCommitOnBranch: {
                      commit: {
                        oid: newer,
                        url: "https://example.invalid/commit",
                        signature: {isValid: true, state: "VALID", wasSignedByGitHub: true},
                      },
                      ref: {name: "b"},
                    },
                  },
                },
              ),
            },
          ],
        },
      ],
      [
        "GET",
        "/repos/o/r/git/ref/heads/b",
        {status: 200, body: json_stringify({ref: "refs/heads/b", object: {sha: f.head}})},
      ],
      [
        "GET",
        "/repos/o/r/git/matching-refs/smart-ship/previous/9/${wip}",
        {
          status: available ? 200 : 500,
          body: available ? json_stringify([{ref: archive, object: {sha: wip}}]) : "{}",
        },
      ],
    ]
    const seen = divergent_look(harness, f, true, wip, wip, false, "", extra)
    const archive_reads = seen.calls.filter(
      { call ->
        call.method == "GET"
          && contains(call.url, "/git/matching-refs/smart-ship/previous/9/${wip}")
      },
    )
      .to_list()
    const commits = seen.calls.filter(
      { call ->
        call.method == "POST"
          && contains(call.body ?? "", "createCommitOnBranch")
      },
    )
      .to_list()
    const deletes = seen.calls.filter(
      { call ->
        call.method == "DELETE"
          && contains(call.url, "/git/refs/smart-ship/wip/9")
      },
    )
      .to_list()
    assert_eq(len(archive_reads), 1, "the actual publication path must verify earlier custody")
    if available {
      assert_eq(seen.result.action, "published", seen.result.reason ?? "")
      assert_eq(len(commits), 1, "the positive must reach signed publication")
      assert_eq(
        f.git(["rev-parse", "refs/smart-ship/wip/9"]),
        wip,
        "the previous repair's unconfirmed custody must remain reachable",
      )
    } else {
      assert_eq(seen.result.action, "publish_failed")
      assert_eq(len(commits), 0, "unconfirmed earlier custody stops before publishing")
      assert_eq(len(deletes), 0, "unconfirmed earlier custody must never delete its ref")
      assert_eq(f.git(["rev-parse", "refs/smart-ship/wip/9"]), wip)
    }
    assert_eq(len(deletes), 0, "successful publication alone must never delete a prior checkpoint")
    assert_eq(harness.fs.read_text("${f.dir}/work/pr/file.txt"), "new repair\n")
  }
}

/** A fresh reconciliation that times out keeps both checkpoints and can continue. */
pipeline test_a_second_timeout_archives_prior_work_before_continuing(harness: Harness) {
  const f = divergent(harness, true)
  f.git(["checkout", "--quiet", "topic"])
  harness.fs.write_text(f.remote + "/file.txt", "earlier work\n")
  f.git(
    [
      "commit",
      "--quiet",
      "-am",
      "Smart Ship unfinished repair for #9 at ${f.head}, on base " + "1" * 40 + ", checkout merged",
    ],
  )
  const wip = f.git(["rev-parse", "HEAD"])
  f.git(["update-ref", "refs/smart-ship/wip/9", wip])
  f.git(["checkout", "--quiet", "main"])
  assert_eq(divergent_look(harness, f, false, wip, wip, true).result.action, "repair")
  harness.fs.write_text(f.dir + "/work/pr/file.txt", "new progress\n")
  harness.fs.write_text(
    f.dir + "/work/pr/.git/ship-result.json",
    json_stringify({outcome: "timeout", summary: "unfinished", spend: "0.01"}),
  )
  const red_check = checks([{name: "CI status", status: "COMPLETED", conclusion: "FAILURE"}])
  const commit = red_check.commits.nodes[0].commit + {oid: f.head}
  const state = pr(
    red_check
      + {headRefOid: f.head, mergeStateStatus: "DIRTY", commits: {nodes: [{commit: commit}]}},
  )
  const api = "https://api.github.com"
  const newer = "b" * 40
  const archive = "refs/smart-ship/previous/9/${wip}"
  harness.testing.http_mock_clear()
  harness.testing.http_mock(
    "POST",
    api + "/graphql",
    {
      responses: [
        {status: 200, body: json_stringify({data: {repository: state}})},
        {
          status: 200,
          body: json_stringify(
            {
              data: {
                createCommitOnBranch: {
                  commit: {
                    oid: newer,
                    url: "https://example.invalid/commit",
                    signature: {isValid: true, state: "VALID", wasSignedByGitHub: true},
                  },
                  ref: {name: "smart-ship/wip-9"},
                },
              },
            },
          ),
        },
      ],
    },
  )
  harness.testing.http_mock(
    "GET",
    api + "/repos/o/r/git/matching-refs/smart-ship/wip/9",
    {status: 200, body: json_stringify([{ref: "refs/smart-ship/wip/9", object: {sha: wip}}])},
  )
  harness.testing.http_mock(
    "GET",
    api + "/repos/o/r/git/matching-refs/smart-ship/previous/9/${wip}",
    {status: 200, body: "[]"},
  )
  harness.testing.http_mock(
    "GET",
    api + "/repos/o/r/git/ref/heads/smart-ship/*",
    {status: 404, body: "{}"},
  )
  harness.testing.http_mock(
    "POST",
    api + "/repos/o/r/git/refs",
    {
      responses: [
        {status: 201, body: json_stringify({ref: archive, object: {sha: wip}})},
        {status: 201, body: "{}"},
      ],
    },
  )
  harness.testing.http_mock(
    "PATCH",
    api + "/repos/o/r/git/refs/smart-ship/wip/9",
    {status: 200, body: "{}"},
  )
  harness.testing.http_mock(
    "DELETE",
    api + "/repos/o/r/git/refs/heads/smart-ship/*",
    {status: 204, body: ""},
  )
  harness.testing.http_mock("POST", api + "/repos/o/r/issues/9/comments", {status: 201, body: "{}"})
  const result = look(
    harness,
    {
      repo: "o/r",
      number: 9,
      token: "fixture-token",
      work: f.dir + "/work",
      publish: true,
      repair: true,
      run_id: "",
      opts: {installation_token: "fixture-token", budget: {state_dir: ""}},
      git_host: "file://" + f.dir + "/",
      nonce: "fixture-nonce",
    },
  )
  assert_eq(result.action, "published")
  let archived = false
  let patched_after = false
  let continued = false
  for call in harness.testing.http_mock_calls({include_sensitive: true}) {
    if call.method == "POST" && contains(call.url, "/git/refs")
      && contains(call.body ?? "", archive) {
      archived = true
    }
    if call.method == "PATCH" && contains(call.url, "/git/refs/smart-ship/wip/9") {
      patched_after = archived && contains(call.body ?? "", newer)
    }
    if call.method == "POST" && contains(call.url, "/issues/9/comments")
      && contains(call.body ?? "", "smart-ship continue=") {
      continued = contains(call.body ?? "", newer) && contains(call.body ?? "", archive)
    }
  }
  assert(
    archived && patched_after && continued,
    "the prior ref is archived before the new continuation",
  )
}

/** A clean checkout contains no base merge, so its edits survive a moved base. */
pipeline test_a_clean_checkpoint_resumes_after_the_base_moves(harness: Harness) {
  const f = divergent(harness, false)
  f.git(["checkout", "--quiet", "topic"])
  harness.fs.write_text(f.remote + "/file.txt", "saved clean edit\n")
  f.git(["add", "file.txt"])
  const old_base = f.git(["rev-parse", "main^"])
  f.git(
    [
      "commit",
      "--quiet",
      "-m",
      "Smart Ship unfinished repair for #9 at ${f.head}, on base ${old_base}, checkout clean",
    ],
  )
  const wip = f.git(["rev-parse", "HEAD"])
  f.git(["update-ref", "refs/smart-ship/wip/9", wip])
  f.git(["checkout", "--quiet", "main"])
  const seen = divergent_look(harness, f, false, wip, wip, true)
  assert_eq(seen.result.action, "repair")
  assert_eq(harness.fs.read_text(f.dir + "/work/pr/file.txt"), "saved clean edit\n")
  assert(
    !seen.calls.any(
      { call -> call.method == "DELETE" && contains(call.url, "/git/refs/smart-ship/wip/9") },
    ),
  )
}

/** An unmeasured merge state must not lay a saved merge over a clean checkout. */
pipeline test_an_unknown_merge_state_keeps_the_saved_merge(harness: Harness) {
  const f = divergent(harness, true)
  f.git(["checkout", "--quiet", "topic"])
  harness.fs.write_text(f.remote + "/file.txt", "saved merge\n")
  f.git(
    [
      "commit",
      "--quiet",
      "-am",
      "Smart Ship unfinished repair for #9 at ${f.head}, on base ${f.base_oid}, checkout merged",
    ],
  )
  const wip = f.git(["rev-parse", "HEAD"])
  f.git(["update-ref", "refs/smart-ship/wip/9", wip])
  f.git(["checkout", "--quiet", "main"])
  const seen = divergent_look(harness, f + {state: "UNKNOWN"}, false, wip, wip, true)
  assert_eq(seen.result.action, "repair")
  assert_eq(harness.fs.read_text(f.dir + "/work/pr/file.txt"), "topic\n")
  assert(contains(harness.fs.read_text(f.dir + "/work/pr/.git/ship-previous.diff"), "saved merge"))
  assert(
    !seen.calls.any(
      { call -> call.method == "DELETE" && contains(call.url, "/git/refs/smart-ship/wip/9") },
    ),
  )
}

/** A previously clean checkpoint is not overlaid on a checkout that now conflicts. */
pipeline test_a_clean_checkpoint_is_not_overlaid_on_a_conflict(harness: Harness) {
  const f = divergent(harness, true)
  f.git(["checkout", "--quiet", "topic"])
  harness.fs.write_text(f.remote + "/file.txt", "saved edit\n")
  f.git(
    [
      "commit",
      "--quiet",
      "-am",
      "Smart Ship unfinished repair for #9 at ${f.head}, on base ${f.base_oid}, checkout clean",
    ],
  )
  const wip = f.git(["rev-parse", "HEAD"])
  f.git(["update-ref", "refs/smart-ship/wip/9", wip])
  f.git(["checkout", "--quiet", "main"])
  const seen = divergent_look(harness, f, false, wip, wip, true)
  assert_eq(seen.result.action, "repair")
  assert(contains(harness.fs.read_text(f.dir + "/work/pr/file.txt"), "<<<<<<<"))
  assert(contains(harness.fs.read_text(f.dir + "/work/pr/.git/ship-previous.diff"), "saved edit"))
}

/** A fresh attempt never receives a partial or credential-shaped previous patch. */
pipeline test_previous_patch_must_be_whole_and_secret_free(harness: Harness) {
  for c in ["credential", "oversized"] {
    const f = divergent(harness, true)
    f.git(["checkout", "--quiet", "topic"])
    const content = c == "credential" ? "ghp_" + "Z" * 40 : "x" * 1100000
    harness.fs.write_text(f.remote + "/file.txt", content)
    f.git(
      [
        "commit",
        "--quiet",
        "-am",
        "Smart Ship unfinished repair for #9 at ${f.head}, on base " + "1" * 40
          + ", checkout merged",
      ],
    )
    const wip = f.git(["rev-parse", "HEAD"])
    f.git(["update-ref", "refs/smart-ship/wip/9", wip])
    f.git(["checkout", "--quiet", "main"])
    let failure = ""
    try {
      divergent_look(harness, f, false, wip, wip, true)
    } catch (e) {
      failure = to_string(e)
    }
    assert(contains(failure, "kept for recovery"), c + ": " + failure)
    assert(
      !harness.fs.exists(f.dir + "/work/pr/.git/ship-previous.diff"),
      c + ": patch not handed to agent",
    )
    assert(
      !harness.testing.http_mock_calls({include_sensitive: true}).any(
        { call -> call.method == "DELETE" && contains(call.url, "/git/refs/smart-ship/wip/9") },
      ),
      c + ": checkpoint preserved",
    )
  }
}

/** An explicit give-up must not create a checkpoint or reopen paid retries. */
pipeline test_a_stuck_repair_does_not_reopen_itself(harness: Harness) {
  const f = divergent(harness, false)
  assert_eq(divergent_look(harness, f, false, "", "", true).result.action, "repair")
  harness.fs.write_text(f.dir + "/work/pr/file.txt", "partial edit\n")
  harness.fs.write_text(
    f.dir + "/work/pr/.git/ship-result.json",
    json_stringify({outcome: "stuck", summary: "cannot proceed", spend: "0.01"}),
  )
  const seen = divergent_look(harness, f, true, "", "", true)
  assert_eq(seen.result.action, "publish_failed")
  assert(
    !seen.calls.any(
      { call -> call.method == "POST" && contains(call.body ?? "", "createCommitOnBranch") },
    ),
  )
  assert(
    !seen.calls.any(
      { call -> call.method == "POST" && contains(call.body ?? "", "smart-ship continue=") },
    ),
  )
}

/** A wall-clock kill leaves no result file, but its edited tree still needs a signed checkpoint. */
pipeline test_a_killed_repair_saves_a_signed_checkpoint(harness: Harness) {
  const f = divergent(harness, true)
  assert_eq(divergent_look(harness, f, false, "", "", true).result.action, "repair")
  harness.fs.write_text(f.dir + "/work/pr/file.txt", "half resolved\n")
  const red_check = checks([{name: "CI status", status: "COMPLETED", conclusion: "FAILURE"}])
  const commit = red_check.commits.nodes[0].commit + {oid: f.head}
  const state = pr(
    red_check
      + {headRefOid: f.head, mergeStateStatus: "DIRTY", commits: {nodes: [{commit: commit}]}},
  )
  const api = "https://api.github.com"
  const wip = "b" * 40
  harness.testing.http_mock_clear()
  harness.testing.http_mock(
    "POST",
    api + "/graphql",
    {
      responses: [
        {status: 200, body: json_stringify({data: {repository: state}})},
        {
          status: 200,
          body: json_stringify(
            {
              data: {
                createCommitOnBranch: {
                  commit: {
                    oid: wip,
                    url: "https://example.invalid/commit",
                    signature: {isValid: true, state: "VALID", wasSignedByGitHub: true},
                  },
                  ref: {name: "smart-ship/wip-9"},
                },
              },
            },
          ),
        },
      ],
    },
  )
  harness.testing.http_mock(
    "GET",
    api + "/repos/o/r/git/ref/heads/smart-ship/*",
    {status: 404, body: "{}"},
  )
  harness.testing.http_mock("POST", api + "/repos/o/r/git/refs", {status: 201, body: "{}"})
  harness.testing.http_mock(
    "GET",
    api + "/repos/o/r/git/matching-refs/smart-ship/wip/9",
    {status: 200, body: "[]"},
  )
  harness.testing.http_mock(
    "DELETE",
    api + "/repos/o/r/git/refs/heads/smart-ship/*",
    {status: 204, body: ""},
  )
  harness.testing.http_mock("POST", api + "/repos/o/r/issues/9/comments", {status: 201, body: "{}"})
  const result = look(
    harness,
    {
      repo: "o/r",
      number: 9,
      token: "fixture-token",
      work: f.dir + "/work",
      publish: true,
      repair: true,
      run_id: "",
      opts: {installation_token: "fixture-token", budget: {state_dir: ""}},
      git_host: "file://" + f.dir + "/",
      nonce: "fixture-nonce",
    },
  )
  const calls = harness.testing.http_mock_calls({include_sensitive: true})
  assert_eq(result.action, "published")
  assert(
    calls.any(
      { c ->
        c.method == "POST" && contains(c.url, "/git/refs")
          && contains(c.body ?? "", "refs/smart-ship/wip/9")
          && contains(c.body ?? "", wip)
      },
    ),
    "checkpoint ref",
  )
  assert(
    calls.any(
      { c ->
        c.method == "POST" && contains(c.url, "/issues/9/comments")
          && contains(c.body ?? "", "smart-ship continue=")
          && contains(c.body ?? "", "spend: unknown")
      },
    ),
    "the checkpoint and unknown spend are recorded",
  )
}

fn timed_out_save(harness: Harness, conflict: bool) {
  const f = divergent(harness, conflict)
  assert_eq(divergent_look(harness, f, false, "", "", true).result.action, "repair")
  const pr_dir = f.dir + "/work/pr"
  harness.fs.write_text(pr_dir + "/file.txt", "half resolved\n")
  harness.fs.write_text(
    pr_dir + "/.git/ship-result.json",
    json_stringify({outcome: "timeout", summary: "ran out of time", spend: "0.01"}),
  )
  const seen = divergent_look(harness, f, true, "", "", true)
  const commits = seen.calls.filter(
    { call ->
      call.method == "POST" && contains(call.url, "/graphql")
        && contains(call.body ?? "", "createCommitOnBranch")
    },
  )
    .to_list()
  assert_eq(len(commits), 1, "the unfinished tree went to GitHub as the saved commit")
  assert(contains(commits[0].body, "on base ${f.base_oid}"), commits[0].body)
  const checkout = conflict ? "merged" : "clean"
  assert(contains(commits[0].body, "checkout ${checkout}"), commits[0].body)
  assert(contains(commits[0].body, base64_encode("half resolved\n")), commits[0].body)
  // The fake GitHub answers the commit with a PR, so saving fails: that is publish_failed, not published.
  assert_eq(seen.result.action, "publish_failed")
}

/** A caught publish failure was once returned as published and exited 0; it now fails the step. */
pipeline test_a_failed_publish_is_answered_once_and_not_published(harness: Harness) {
  const work = harness.fs.mkdtemp_in_workspace("smart-ship-publish-failed-")
  harness.fs.mkdir(work + "/pr/.git", true)
  harness.fs.write_text(
    work + "/job.json",
    json_stringify({head: "abc", base_oid: "1" * 40, conflicted: [], threads: []}),
  )
  harness.fs.write_text(
    work + "/pr/.git/ship-result.json",
    json_stringify({outcome: "fixed", summary: "fixed it", spend: "0.02"}),
  )
  harness.testing.http_mock_clear()
  const api = "https://api.github.com"
  harness.testing.http_mock(
    "POST",
    api + "/graphql",
    {status: 200, body: json_stringify({data: {repository: pr(red())}})},
  )
  harness.testing.http_mock("POST", api + "/repos/o/r/issues/9/comments", {status: 201, body: "{}"})
  const result = look(
    harness,
    {
      repo: "o/r",
      number: 9,
      token: "fixture-token",
      work: work,
      publish: true,
      repair: true,
      run_id: "",
      opts: {installation_token: "fixture-token", budget: {state_dir: ""}},
      git_host: "file:///nonexistent-smart-ship-host/",
      nonce: "",
    },
  )
  assert_eq(result.action, "publish_failed")
  assert(result.error != "", "the error travels with the outcome")
  const posted = harness.testing.http_mock_calls({include_sensitive: true}).filter(
    { c -> c.method == "POST" && contains(c.url, "/issues/9/comments") },
  )
    .map({ c -> schema_expect(json_parse(c.body), schema_of(Posted)).body })
    .to_list()
  assert_eq(len(posted), 1)
  assert(contains(posted[0], "Publishing the repair failed"), posted[0])
  assert(contains(posted[0], "<!-- smart-ship done=abc -->"), "the attempt is answered once")
}

/** A moved head cannot accept the repair; keep the checkout instead of reporting success. */
pipeline test_a_moved_head_does_not_discard_the_unpublished_repair(harness: Harness) {
  const work = harness.fs.mkdtemp_in_workspace("smart-ship-moved-head-")
  harness.fs.mkdir(work + "/pr/.git", true)
  harness.fs.write_text(
    work + "/job.json",
    json_stringify({head: "old-head", base_oid: "1" * 40, conflicted: [], threads: []}),
  )
  harness.fs.write_text(
    work + "/pr/.git/ship-result.json",
    json_stringify({outcome: "fixed", summary: "fixed it", spend: "0.02"}),
  )
  harness.testing.http_mock_clear()
  const api = "https://api.github.com"
  harness.testing.http_mock(
    "POST",
    api + "/graphql",
    {status: 200, body: json_stringify({data: {repository: pr(red())}})},
  )
  harness.testing.http_mock("POST", api + "/repos/o/r/issues/9/comments", {status: 201, body: "{}"})
  const result = look(
    harness,
    {
      repo: "o/r",
      number: 9,
      token: "fixture-token",
      work: work,
      publish: true,
      repair: true,
      run_id: "",
      opts: {installation_token: "fixture-token", budget: {state_dir: ""}},
      git_host: "file:///nonexistent-smart-ship-host/",
      nonce: "",
    },
  )
  assert_eq(result.action, "publish_failed")
  assert(contains(result.reason, "moved, closed or was held"), result.reason)
}

/** An unknown agent outcome is not a completed publication. */
pipeline test_an_unknown_agent_outcome_does_not_discard_work(harness: Harness) {
  const work = harness.fs.mkdtemp_in_workspace("smart-ship-unknown-outcome-")
  harness.fs.mkdir(work + "/pr/.git", true)
  harness.fs.write_text(
    work + "/job.json",
