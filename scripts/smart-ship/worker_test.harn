/** Real worker execution and closed retirement evidence, without live providers. */
import { command_run } from "std/command"
import { RecoveryIdentity } from "./recovery.harn"
import {
  WorkerReceipt,
  WorkerRetirement,
  WorkerRuntime,
  run_worker,
  worker_retirement,
  worker_runtime,
} from "./worker.harn"

type MainOutcome = {exit_code: int, report: WorkerRetirement}

pipeline test_worker_retirement_follows_identical_artifact_after_trusted_reinstallation(
  harness: Harness,
) {
  const actual = runtime(harness)
  const caps = pick(harness, ["fs", "tools"])
  const f = fixture(pick(harness, ["fs"]), "fn main(harness: Harness) {}\n")
  const good = executed(caps, f, actual, 30000)
  assert(
    worker_retirement(caps, f.work, f.identity, actual).retired,
    "original actual retirement must be reached",
  )
  const source_before = harness.fs.read_text("${f.work}/job.json")
  const receipt_before = harness.fs.read_text("${f.work}/worker.json")
  harness.fs.mkdir("${f.work}/reinstalled")
  const installed = "${f.work}/reinstalled/harn"
  harness.fs.copy(actual.executable, installed)
  const current = worker_runtime(caps, installed)
  assert_eq(current.sha256, actual.sha256)
  assert_eq(current.version, actual.version)
  assert_eq(current.source_revision, actual.source_revision)
  assert(
    current.executable != actual.executable && current.file_identity != actual.file_identity,
    "the exact artifact must really have a new path and physical file identity",
  )
  const observed = worker_retirement(caps, f.work, f.identity, current)
  assert(
    observed.retired,
    "identical freshly confirmed artifact must retain historical worker retirement",
  )
  assert_eq(observed.receipt, good, "historical executable and inode remain audit evidence")
  assert_eq(harness.fs.read_text("${f.work}/job.json"), source_before)
  assert_eq(harness.fs.read_text("${f.work}/worker.json"), receipt_before)
  for changed in [
    current + {sha256: "0" * 64},
    current + {version: "0.10.199"},
    current + {source_revision: "c" * 40},
  ] {
    assert(
      !worker_retirement(caps, f.work, f.identity, changed).retired,
      "changed artifact/version/source must not receive relocation credit",
    )
  }
}

pipeline test_worker_main_preserves_inner_failure_after_durable_retirement(harness: Harness) {
  const actual = runtime(harness)
  const root = harness.fs.project_root()
  const directory = harness.fs.exists("${root}/worker.harn") ? root : "${root}/scripts/smart-ship"
  for state in ["normal", "failed"] {
    const f = fixture(
      pick(harness, ["fs"]),
      state == "normal" ? "fn main(harness: Harness) { harness.stdio.println(\"private worker output\") }\n" : "fn main(harness: Harness) { throw \"private worker failure text\" }\n",
    )
    harness.fs.mkdir("${f.work}/home")
    const driver = "${f.work}/main.py"
    harness.fs.write_text(
      driver,
      """
import json, os, subprocess, sys
runtime, module, work = sys.argv[1:]
with open(work + "/job.json") as stream:
    identity = json.load(stream)["recovery"]
environment = {"PATH": os.path.dirname(runtime) + ":/usr/bin:/bin", "HOME": work + "/home",
               "FAKE_KEY": "inert-worker-main-key", "SHIP_WORK": work,
               "GITHUB_REPOSITORY": identity["repository"], "GITHUB_RUN_ID": str(identity["run_id"]),
               "GITHUB_RUN_ATTEMPT": str(identity["run_attempt"]), "SHIP_PR": str(identity["number"]),
               "SHIP_NONCE": identity["nonce"]}
arguments = [runtime, "run", "--no-sandbox", "--environment-policy", "granted", "--grant",
             "openai=env:FAKE_KEY,expose=OPENAI_API_KEY,for=harn"]
for name in ("SHIP_WORK", "GITHUB_REPOSITORY", "GITHUB_RUN_ID", "GITHUB_RUN_ATTEMPT", "SHIP_PR", "SHIP_NONCE"):
    arguments += ["--grant", name.lower() + "=env:" + name + ",expose=" + name + ",to=in_process"]
arguments.append(module)
result = subprocess.run(arguments, cwd=os.path.dirname(module), env=environment, capture_output=True, timeout=90)
report = json.loads(result.stdout)
assert "private worker output" not in result.stdout.decode()
assert "private worker failure text" not in result.stderr.decode()
with open(work + "/main-outcome.json", "w") as stream:
    json.dump({"exit_code": result.returncode, "report": report}, stream)
""",
    )
    const launched = command_run(
      harness.tools,
      ["python3", driver, actual.executable, "${directory}/worker.harn", f.work],
      {timeout_ms: 100000, max_inline_bytes: 262144},
    )
    assert(launched.success, launched.stderr)
    const outcome = schema_expect(
      json_parse(harness.fs.read_text("${f.work}/main-outcome.json")),
      schema_of(MainOutcome),
    )
    assert(
      outcome.report.retired,
      "actual canonical main must first confirm owned worker retirement",
    )
    const receipt = schema_expect(
      json_parse(harness.fs.read_text("${f.work}/worker.json")),
      schema_of(WorkerReceipt),
    )
    assert_eq(
      outcome.report.receipt,
      receipt,
      "the workflow result must retain the exact durable receipt",
    )
    assert_eq(receipt.identity, f.identity)
    if state == "normal" {
      assert_eq(receipt.exit_code, 0)
      assert_eq(outcome.exit_code, 0)
    } else {
      assert(
        receipt.exit_code != 0,
        "the actual inner must fail before testing its workflow projection",
      )
      assert(outcome.exit_code != 0, "failed inner must not become successful workflow step")
    }
  }
}

fn runtime(harness: Harness) -> WorkerRuntime {
  return worker_runtime(
    pick(harness, ["fs", "tools"]),
    harness.process.find_executable("harn") ?? "",
  )
}

fn fixture(harness: {fs: HarnessFs}, body: string) {
  const work = harness.fs.mkdtemp_in_workspace("smart-ship-worker-")
  const identity: RecoveryIdentity = {
    repository: "o/r",
    number: 9,
    run_id: 123,
    run_attempt: 1,
    nonce: "a" * 32,
    head: "b" * 40,
  }
  harness.fs.mkdir("${work}/agent")
  harness.fs.mkdir("${work}/pr")
  harness.fs.mkdir("${work}/pr/.git")
  harness.fs.write_text("${work}/.owner", "${identity.nonce}\n")
  harness.fs.write_text(
    "${work}/job.json",
    json_stringify({nonce: identity.nonce, head: identity.head, recovery: identity}),
  )
  harness.fs.write_text("${work}/agent/repair.harn", body)
  return {work: work, identity: identity}
}

/** Real outer grants are established by a trusted launcher, not inherited by test mode. */
fn executed(
  harness: {fs: HarnessFs, tools: HarnessTools},
  f: {work: string, identity: RecoveryIdentity},
  actual: WorkerRuntime,
  timeout_ms: int,
  kill_outer: bool = false,
) -> WorkerReceipt {
  const root = harness.fs.project_root()
  const directory = harness.fs.exists("${root}/worker.harn") ? root : "${root}/scripts/smart-ship"
  const module = "${directory}/worker.harn"
  const recovery = "${directory}/recovery.harn"
  const entry = "${f.work}/outer.harn"
  const driver = "${f.work}/outer.py"
  harness.fs.mkdir("${f.work}/home")
  harness.fs.write_text(
    entry,
    "import { worker_runtime, run_worker } from " + json_stringify(module) + "\n"
      + "import { RecoveryIdentity } from "
      + json_stringify(recovery)
      + "\n"
      + "fn main(harness: Harness) {\n const caps = pick(harness, [\"fs\", \"tools\"])\n"
      + " const identity = schema_expect(json_parse("
      + json_stringify(json_stringify(f.identity))
      + "), schema_of(RecoveryIdentity))\n"
      + " const runtime = worker_runtime(caps, "
      + json_stringify(actual.executable)
      + ")\n"
      + " run_worker(caps, "
      + json_stringify(f.work)
      + ", identity, runtime, ${timeout_ms})\n}\n",
  )
  harness.fs.write_text(
    driver,
    """
import json, os, select, signal, subprocess, sys
runtime, entry, home, work, mode = sys.argv[1:]
environment = {"PATH": os.path.dirname(runtime) + ":/usr/bin:/bin", "HOME": home,
               "OPENAI_API_KEY": "inert-worker-test-sentinel"}
arguments = [runtime, "run", "--no-sandbox", "--environment-policy", "granted",
             "--grant", "openai=env:OPENAI_API_KEY,expose=OPENAI_API_KEY,for=harn", entry]
if mode == "normal":
    result = subprocess.run(arguments, env=environment, capture_output=True, timeout=90)
    sys.stdout.buffer.write(result.stdout)
    sys.stderr.buffer.write(result.stderr)
    raise SystemExit(result.returncode)
fifo = work + "/pr/ready.fifo"
os.mkfifo(fifo)
reader = os.open(fifo, os.O_RDONLY | os.O_NONBLOCK)
child = subprocess.Popen(arguments, env=environment, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
owned = None
try:
    assert select.select([reader], [], [], 30)[0], "actual inner readiness was not reached"
    pid = int(os.read(reader, 64))
    owned = os.pidfd_open(pid)
    assert not select.select([owned], [], [], 0)[0], "known live inner payload required"
    outer = os.pidfd_open(child.pid)
    signal.pidfd_send_signal(outer, signal.SIGKILL)
    os.close(outer)
    child.communicate(timeout=15)
    assert child.returncode == -signal.SIGKILL
    assert select.select([owned], [], [], 10)[0], "guardian did not retire the exact owned payload"
    with open(work + "/owner-death.json", "w") as stream:
        json.dump({"outer_signal": "SIGKILL", "owned_payload_exited": True}, stream)
finally:
    os.close(reader)
    if child.poll() is None:
        child.kill()
        child.wait(timeout=10)
    if owned is not None:
        if not select.select([owned], [], [], 0)[0]:
            signal.pidfd_send_signal(owned, signal.SIGKILL)
        os.close(owned)
""",
  )
  const result = command_run(
    harness.tools,
    [
      "python3",
      driver,
      actual.executable,
      entry,
      "${f.work}/home",
      f.work,
      kill_outer ? "kill" : "normal",
    ],
    {timeout_ms: 100000, max_inline_bytes: 262144},
  )
  assert(result.success, result.stderr)
  return schema_expect(
    json_parse(harness.fs.read_text("${f.work}/worker.json")),
    schema_of(WorkerReceipt),
  )
}

pipeline test_worker_outer_death_keeps_the_flushed_reservation_unconfirmed(harness: Harness) {
  const actual = runtime(harness)
  const f = fixture(pick(harness, ["fs"]), "fn main(harness: Harness) {}\n")
  harness.fs.write_text(
    "${f.work}/pr/hold.py",
    """
import os, signal
signal.signal(signal.SIGTERM, signal.SIG_IGN)
signal.alarm(45)
with open("ready.fifo", "w") as stream:
    stream.write(str(os.getpid()))
signal.pause()
""",
  )
  harness.fs.write_text(
    "${f.work}/agent/repair.harn",
    "import { command_run } from \"std/command\"\nfn main(harness: Harness) { command_run(harness.tools, {argv: [\"python3\", "
      + json_stringify("${f.work}/pr/hold.py")
      + "], cwd: "
      + json_stringify("${f.work}/pr")
      + "}) }\n",
  )
  const receipt = executed(pick(harness, ["fs", "tools"]), f, actual, 30000, true)
  assert_eq(receipt.status, "starting")
  assert_eq(receipt.process_cleanup, nil)
  const physical = json_parse(harness.fs.read_text("${f.work}/owner-death.json"))
  assert_eq(physical, {outer_signal: "SIGKILL", owned_payload_exited: true})
  const decision = worker_retirement(pick(harness, ["fs", "tools"]), f.work, f.identity, actual)
  assert(
    !decision.retired,
    "physical diagnostic exit must not manufacture a canonical terminal receipt",
  )
  assert_eq(decision.receipt, receipt)
}

pipeline test_worker_records_actual_normal_failed_and_timed_out_retirement(harness: Harness) {
  const actual = runtime(harness)
  const caps = pick(harness, ["fs", "tools"])
  for state in ["normal", "failed", "timeout"] {
    const body =
      state == "timeout" ? "import { command_run } from \"std/command\"\nfn main(harness: Harness) { command_run(harness.tools, [\"sleep\", \"60\"]) }\n" : state
      == "failed" ? "fn main(harness: Harness) { throw \"synthetic worker failure\" }\n" : "fn main(harness: Harness) { harness.stdio.println(\"private model prose excluded from receipt\") }\n"
    const f = fixture(pick(harness, ["fs"]), body)
    const receipt = executed(
      pick(harness, ["fs", "tools"]),
      f,
      actual,
      state == "timeout" ? 1500 : 30000,
    )
    assert_eq(receipt.identity, f.identity)
    assert_eq(receipt.runtime, actual)
    const decision = worker_retirement(caps, f.work, f.identity, actual)
    assert(decision.retired, "${state}: ${decision.reason}")
    assert_eq(decision.receipt, receipt)
    if state == "normal" {
      assert_eq(receipt.exit_code, 0)
      assert(!receipt.timed_out)
    } else if state == "failed" {
      assert(receipt.exit_code != 0, "retirement is independent of worker success")
    } else {
      assert_eq(receipt.status, "timed_out")
      assert(receipt.timed_out)
    }
    const text = harness.fs.read_text("${f.work}/worker.json")
    assert(!text.contains("private model prose") && !text.contains("synthetic worker failure"))
    assert_eq(
      keys(json_parse(text)).sorted(),
      ["schema", "identity", "runtime", "status", "exit_code", "timed_out", "process_cleanup"]
        .sorted(),
    )
  }
}

pipeline test_worker_refuses_unowned_sources_and_changed_or_linked_runtimes_before_launch(
  harness: Harness,
) {
  const actual = runtime(harness)
  const caps = pick(harness, ["fs", "tools"])
  for state in [
    "owner",
    "prepared",
    "entry-link",
    "runtime-sha",
    "runtime-missing",
    "runtime-link",
    "runtime-replaced",
    "receipt-link",
  ] {
    const f = fixture(
      pick(harness, ["fs"]),
      "fn main(harness: Harness) { harness.fs.write_text(\".git/launched\", \"reached\") }\n",
    )
    let selected = actual
    if state == "owner" {
      harness.fs.write_text("${f.work}/.owner", "c" * 32 + "\n")
    } else if state == "prepared" {
      harness.fs.write_text(
        "${f.work}/job.json",
        json_stringify(
          {nonce: f.identity.nonce, head: f.identity.head, recovery: f.identity + {run_attempt: 2}},
        ),
      )
    } else if state == "entry-link" {
      harness.fs.delete("${f.work}/agent/repair.harn")
      const linked = command_run(
        harness.tools,
        ["ln", "-s", "${f.work}/job.json", "${f.work}/agent/repair.harn"],
      )
      assert(linked.success)
    } else if state == "runtime-sha" {
      selected = actual + {sha256: "0" * 64}
    } else if state == "runtime-missing" {
      selected = actual + {executable: "${f.work}/harn"}
    } else if state == "runtime-replaced" {
      harness.fs.write_text(
        "${f.work}/harn",
        "#!/bin/sh\nprintf executed > '${f.work}/untrusted-binary-executed'\n",
      )
      assert(command_run(harness.tools, ["chmod", "+x", "${f.work}/harn"]).success)
      selected = actual + {executable: "${f.work}/harn"}
    } else if state == "runtime-link" {
      const linked = command_run(harness.tools, ["ln", "-s", actual.executable, "${f.work}/harn"])
      assert(linked.success)
      selected = actual + {executable: "${f.work}/harn"}
    } else {
      const linked = command_run(
        harness.tools,
        ["ln", "-s", "${f.work}/job.json", "${f.work}/worker.json"],
      )
      assert(linked.success)
    }
    assert(
      is_err(
        try {
          run_worker(caps, f.work, f.identity, selected, 30000)
        },
      ),
      state,
    )
    assert(
      !harness.fs.exists("${f.work}/pr/.git/launched"),
      "${state}: refused worker must not run",
    )
    assert(
      !harness.fs.exists("${f.work}/untrusted-binary-executed"),
      "changed runtime must not even be queried",
    )
  }
}

pipeline test_worker_retirement_retains_absent_unknown_and_inconsistent_evidence(harness: Harness) {
  const actual = runtime(harness)
  const caps = pick(harness, ["fs", "tools"])
  const f = fixture(pick(harness, ["fs"]), "fn main(harness: Harness) {}\n")
  assert(
    !worker_retirement(caps, f.work, f.identity, actual).retired,
    "missing is not measured zero",
  )
  const good = executed(pick(harness, ["fs", "tools"]), f, actual, 30000)
  assert(
    worker_retirement(caps, f.work, f.identity, actual).retired,
    "known positive must be reached",
  )
  for state in [
    "missing-report",
    "unknown",
    "no-custody",
    "survivor",
    "omitted",
    "starting",
    "wrong-attempt",
    "wrong-runtime",
  ] {
    let changed: WorkerReceipt = good
    if state == "missing-report" {
      changed = good + {process_cleanup: nil}
    } else if state == "unknown" {
      changed = good + {process_cleanup: good.process_cleanup + {survivor_count: nil}}
    } else if state == "no-custody" {
      changed = good
        + {
          process_cleanup: good.process_cleanup
            + {census_complete: false, guardian_custody_complete: false},
        }
    } else if state == "survivor" {
      changed = good + {process_cleanup: good.process_cleanup + {survivor_count: 1}}
    } else if state == "omitted" {
      changed = good + {process_cleanup: good.process_cleanup + {omitted_child_count: 1}}
    } else if state == "starting" {
      changed = good + {status: "starting", process_cleanup: nil, exit_code: nil}
    } else if state == "wrong-attempt" {
      changed = good + {identity: good.identity + {run_attempt: 2}}
    } else {
      changed = good + {runtime: good.runtime + {sha256: "0" * 64}}
    }
    harness.fs.write_text("${f.work}/worker.json", json_stringify(changed))
    assert(!worker_retirement(caps, f.work, f.identity, actual).retired, state)
  }
  harness.fs.delete("${f.work}/worker.json")
  const linked = command_run(
    harness.tools,
    ["ln", "-s", "${f.work}/job.json", "${f.work}/worker.json"],
  )
  assert(linked.success)
  assert(
    !worker_retirement(caps, f.work, f.identity, actual).retired,
    "a symlink is not a worker receipt",
  )
}

pipeline test_worker_model_transport_keeps_shell_network_key_and_receipt_access_denied(
  harness: Harness,
) {
  const actual = runtime(harness)
  const root = harness.fs.project_root()
  const directory = harness.fs.exists("${root}/worker.harn") ? root : "${root}/scripts/smart-ship"
  const scratch = harness.fs.mkdtemp_in_workspace("smart-ship-worker-network-")
  const driver = "${scratch}/network.py"
  harness.fs.write_text(
    driver,
    """
import hashlib, json, os, subprocess, sys, threading
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
base, module, runtime, expected = sys.argv[1:]
work = Path(base) / "work"
work.mkdir()
for part in ("agent", "pr", "home"):
    (work / part).mkdir()
identity = {"repository": "o/r", "number": 9, "run_id": 123, "run_attempt": 1,
            "nonce": "a" * 32, "head": "b" * 40}
(work / ".owner").write_text(identity["nonce"] + "\n")
(work / "job.json").write_text(json.dumps({"nonce": identity["nonce"], "head": identity["head"], "recovery": identity}))
assert hashlib.sha256(Path(runtime).read_bytes()).hexdigest() == expected
calls = []
class Provider(BaseHTTPRequestHandler):
    def do_POST(self):
        request = json.loads(self.rfile.read(int(self.headers["Content-Length"])))
        calls.append({"path": self.path, "authorized": self.headers.get("Authorization") == "Bearer inert-worker-key"})
        body = json.dumps({"id": "inert", "model": request["model"], "choices": [{"index": 0,
                "message": {"role": "assistant", "content": "inert model transport reached"}, "finish_reason": "stop"}],
                "usage": {"prompt_tokens": 1, "completion_tokens": 1, "total_tokens": 2}}).encode()
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)
    def log_message(self, *args):
        pass
server = ThreadingHTTPServer(("127.0.0.1", 0), Provider)
threading.Thread(target=server.serve_forever, daemon=True).start()
port = server.server_address[1]
config = work / "agent/providers.toml"
config.write_text('[providers.probe]\nbase_url = "http://127.0.0.1:' + str(port) + '/v1"\nchat_endpoint = "/chat/completions"\nauth_style = "bearer"\nauth_env = "OPENAI_API_KEY"\n[models."probe-model"]\nname = "Inert fixture"\nprovider = "probe"\nwire_model = "probe-model"\ncontext_window = 8192\n')
shell = work / "pr/shell.py"
shell.write_text('''import json, os, socket
s = None
try:
    s = socket.socket()
    s.settimeout(2)
    s.connect(("127.0.0.1", PORT))
    connected = True
except OSError:
    connected = False
finally:
    if s is not None:
        s.close()
try:
    open("../worker.json").read()
    receipt_read = True
except OSError:
    receipt_read = False
try:
    open("../outside-jail", "w").write("bad")
    outside_write = True
except OSError:
    outside_write = False
print(json.dumps({"key_present": "OPENAI_API_KEY" in os.environ, "connected": connected,
                  "receipt_read": receipt_read, "outside_write": outside_write}))
'''.replace("PORT", str(port)))
proof = work / "pr/proof.json"
source = 'import { command_run } from "std/command"\nfn main(harness: Harness) {\n'
source += 'const call = harness.llm.call("inert probe", nil, {provider: "probe", model: "probe-model", stream: false})\n'
source += 'const child = command_run(harness.tools, {argv: ["python3", ' + json.dumps(str(shell)) + '], cwd: ' + json.dumps(str(work / "pr")) + '})\n'
source += 'harness.fs.write_text(' + json.dumps(str(proof)) + ', json_stringify({model_reached: call.text == "inert model transport reached", key_present: harness.env.get("OPENAI_API_KEY") != nil, shell: json_parse(child.stdout), sandbox: child.sandbox}))\n}\n'
(work / "agent/repair.harn").write_text(source)
environment = {"PATH": str(Path(runtime).parent) + ":/usr/bin:/bin", "HOME": str(work / "home"),
               "FAKE_KEY": "inert-worker-key", "PROVIDERS": str(config), "SHIP_WORK": str(work),
               "GITHUB_REPOSITORY": "o/r", "GITHUB_RUN_ID": "123", "GITHUB_RUN_ATTEMPT": "1",
               "SHIP_PR": "9", "SHIP_NONCE": identity["nonce"]}
arguments = [runtime, "run", "--no-sandbox", "--environment-policy", "granted", "--grant",
             "openai=env:FAKE_KEY,expose=OPENAI_API_KEY,for=harn", "--grant",
             "providers=env:PROVIDERS,expose=HARN_PROVIDERS_CONFIG,for=harn"]
for name in ("SHIP_WORK", "GITHUB_REPOSITORY", "GITHUB_RUN_ID", "GITHUB_RUN_ATTEMPT", "SHIP_PR", "SHIP_NONCE"):
    arguments += ["--grant", name.lower() + "=env:" + name + ",expose=" + name + ",to=in_process"]
arguments.append(module)
try:
    result = subprocess.run(arguments, env=environment, cwd=str(Path(module).parent), capture_output=True, timeout=90)
    assert result.returncode == 0, result.stderr.decode()
    assert proof.exists(), "actual model and shell projections were not reached"
    observed = json.loads(proof.read_text())
    assert observed["model_reached"] is True and observed["key_present"] is True
    assert calls == [{"path": "/v1/chat/completions", "authorized": True}]
    assert observed["shell"] == {"key_present": False, "connected": False, "receipt_read": False, "outside_write": False}
    assert observed["sandbox"]["enforced"] is True
    assert observed["sandbox"]["network"] == {"status": "policy", "direct_network": False, "tcp_loopback": False, "managed_proxy": False}
    decision = json.loads(result.stdout)
    assert decision["retired"] is True
    assert decision["receipt"]["runtime"]["sha256"] == expected
    receipt_text = (work / "worker.json").read_text()
    assert "inert-worker-key" not in receipt_text and "inert model transport reached" not in receipt_text
    print(json.dumps({"requests": len(calls), "model_reached": True, "shell_denied": True,
                      "receipt_private": True, "retired": True}))
finally:
    server.shutdown()
    server.server_close()
""",
  )
  const result = command_run(
    harness.tools,
    ["python3", driver, scratch, "${directory}/worker.harn", actual.executable, actual.sha256],
    {timeout_ms: 100000, max_inline_bytes: 262144},
  )
  assert(result.success, result.stderr)
  assert_eq(
    json_parse(result.stdout),
    {requests: 1, model_reached: true, shell_denied: true, receipt_private: true, retired: true},
  )
}
